	<translation id="8846746259444262774">ការដំឡើងបរាជ័យ</translation>
	<translation id="7263815009235541549">ការដំឡើងបានបញ្ចប់ដោយជោគជ័យ។ សូមបិទឧបករណ៍របស់អ្នកជាមុនសិន បន្ទាប់មកយកមេឌៀដំឡើងណាមួយចេញ ហើយបើកវាម្តងទៀត ដើម្បីចាប់ផ្ដើម <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>។</translation>
	<translation id="3380151284134965398">អូ៎ មានអ្វីមួយខុសប្រក្រតី ហើយការដំឡើងមិនបានបញ្ចប់ទេ។ សូមព្យាយាមដំណើរការឡើងវិញ។ ប្រសិនបើកំហុសដដែលនេះនៅតែបន្តកើតមាន សូមទាក់ទង JemaOS Support ជាមួយនឹងកំណត់ហេតុខាងលើ។</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> នឹងត្រូវបានដំឡើងនៅលើភាគថាសដែលបានជ្រើសរើសនៃថាសរឹងរបស់អ្នក។ នៅក្រោមគ្រោងការណ៍ពហុចាប់ផ្ដើមបច្ចុប្បន្ន នេះអាចដំណើរការបានលុះត្រាតែឧបករណ៍របស់អ្នកគាំទ្រ UEFI ហើយថាសរឹងរបស់អ្នកត្រូវបានធ្វើទ្រង់ទ្រាយជាមួយ GPT ។</translation>
	<translation id="7831363758161884243">ភាគថាសគោលដៅនឹងត្រូវបានលុបចោល; អ្នកក៏ត្រូវបញ្ជាក់ភាគថាស EFI សកម្មរបស់អ្នកផងដែរ (ជាធម្មតាធ្វើដោយស្វ័យប្រវត្តិ) ដោយសារកម្មវិធីដំឡើងត្រូវការកែប្រែការកំណត់ប្រព័ន្ធចាប់ផ្ដើម។</translation>
	<translation id="5670799238446305550">ជ្រើសរើស <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ភាគថាសគោលដៅ</translation>
	<translation id="3695537760133394753">ភាគថាស</translation>
	<translation id="5610519566593708119">ជ្រើសរើសភាគថាស EFI</translation>
	<translation id="3367650349940010965">មិនមានភាគថាសសម្រាប់ថាសដែលបានជ្រើសរើសទេ។</translation>
	<translation id="7453223384507098390">មិនមានភាគថាស EFI សម្រាប់ថាសដែលបានជ្រើសរើសទេ។</translation>
	<translation id="1854532683465500847">ទំហំនៃភាគថាសដែលបានជ្រើសរើសគឺតិចជាង 20GB ការដំឡើងអាចនឹងបរាជ័យ</translation>
	<translation id="4144613075340468247">ភាគថាសដែលបានជ្រើសរើសត្រូវបានភ្ជាប់ទៅ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot ដំឡើងវាម្តងទៀតអាចនឹងបរាជ័យ</translation>
	<translation id="5793361052649920836">បន្ទាប់ពីដំឡើងរួច តើអ្នកចង់ចាប់ផ្ដើម <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ដោយរបៀបណា?</translation>
	<translation id="4273235330352963866">ដំឡើង និងកំណត់រចនាសម្ព័ន្ធ rEFInd សម្រាប់ខ្ញុំ (បានណែនាំ)</translation>
	<translation id="1858708492548921044">rEFInd គឺជាកម្មវិធីគ្រប់គ្រងការចាប់ផ្ដើមដែលផ្តល់នូវចំណុចប្រទាក់ក្រាហ្វិកដ៏ស្រស់ស្អាតសម្រាប់ជម្រើសចាប់ផ្ដើមប្រព័ន្ធប្រតិបត្តិការ នៅពេលដែលកុំព្យូទ័ររបស់អ្នកចាប់ផ្តើមឡើង អ្នកនឹងអាចជ្រើសរើសប្រព័ន្ធប្រតិបត្តិការដែលអ្នកចង់បានដើម្បីចាប់ផ្ដើមជាមួយវា។ សម្រាប់ព័ត៌មានបន្ថែមទាក់ទងនឹង rEFInd សូមមើលគេហទំព័ររបស់វា។</translation>
	<translation id="3861924051442564602">បន្ថែមជម្រើសម៉ឺនុយចាប់ផ្ដើម UEFI សម្រាប់ខ្ញុំ</translation>
	<translation id="8622370666798589804">នៅពេលដែលកុំព្យូទ័ររបស់អ្នកចាប់ផ្តើមឡើង អ្នកប្រហែលជាអាចចូលទៅក្នុងម៉ឺនុយជម្រើសចាប់ផ្ដើម UEFI (ភាគច្រើនទំនងជាដោយការចុច hotkey) ជម្រើសនេះបន្ថែម <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ជាធាតុចូលទៅក្នុងម៉ឺនុយនោះ។ (គាំទ្រតែម៉ូដែលមួយចំនួននៃ BIOS និង UEFI កម្មវិធីបង្កប់) ។</translation>
