<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) प्लॅटफॉर्म <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">रिमोट डेस्कटॉप</translation>
<translation id="6898090158927982244">तुमचे Linux अद्यतनित आहे</translation>
<translation id="4886703929102211360">Linux (बीटा) घटकासाठी एक महत्त्वाचे अपडेट उपलब्ध आहे. हे अपडेट लवकरात लवकर इन्स्टॉल करण्याची जोरदार शिफारस केली जाते, अन्यथा तुमचे Linux (बीटा) काम करणे थांबवू शकते.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> सेटिंग्ज</translation>
<translation id="8362858344151826493">JemaOS खाते, बॅकअप, विविध</translation>
<translation id="9150429437595727962">Wi-Fi सेटिंग्ज</translation>
<translation id="4938972461544498524">टचपॅड सेटिंग्ज</translation>
<translation id="1210024513248363065">रिमोट सेवा</translation>
<translation id="2878862288885588535">रिमोट निदान सेवा</translation>
<translation id="7409197984340676806">रिमोट निदान सेवा अधिकृत JemaOS समर्थन प्रतिनिधींना सिस्टम समस्या ओळखण्यास अनुमती देते. सध्या, रिमोट निदान सेवा फक्त अधिकृत JemaOS समर्थन प्रतिनिधीच सुरू करू शकतात.</translation>
<translation id="1791028023086176332">कृपया हा क्रमांक अधिकृत JemaOS समर्थन प्रतिनिधींसोबत शेअर करा</translation>
<translation id="6279304275399437025">रिमोट निदान सेवा सुरू होत आहे...</translation>
<translation id="1501882165699826662">कृपया रिमोट निदान सेवा थांबवा आणि पुन्हा प्रयत्न करा</translation>
<translation id="3100283258447375201">अधिक माहिती</translation>
<translation id="4070039109671307724">विविध</translation>
<translation id="7326893024940073254">"पुन्हा सुरू करा" बटण</translation>
<translation id="3002423764319968103">सिस्टम मेनूमध्ये "पुन्हा सुरू करा" बटण दाखवा</translation>
<translation id="6243454903512423518">"स्क्रीन फिरवा" बटण</translation>
<translation id="6491049336868978729">तुम्ही आत्ता टॅबलेट मोडमध्ये नाही, "स्क्रीन फिरवा" बटण लपवले आहे</translation>
