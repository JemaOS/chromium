<translation id="3514011352559420398">Methodd yr adfer</translation>
<translation id="7535980903266533458">Cadwch y copi wrth gefn ar eich dyfais neu storfa allanol</translation>
<translation id="604001903249547235">Copi wrth gefn yn y cwmwl</translation>
<translation id="8885702701336541611">Llwythwch y copi wrth gefn i storfa gwmwl JemaOS</translation>
<translation id="3939744430096549862">Gwneud copi wrth gefn i'r cwmwl</translation>
