     <ph name="LINE_BREAK1" />
     ແພລດຟອມ <ph name="JEMAOS_PLATFORM_VERSION" />
     <ph name="LINE_BREAK2" />
     Chromium <ph name="PRODUCT_VERSION" /></translation>
<translation id="2896503748067813182">ການສະໝັກທົດລອງ</translation>
<translation id="4362781408813685579">ການສະໝັກທີ່ໃຊ້ງານໄດ້</translation>
<translation id="1141274201089997510">ການສະໝັກໝົດອາຍຸ</translation>
<translation id="2553683254139782404">ສະບັບບໍ່ແມ່ນການຄ້າ</translation>
<translation id="8466048683756385518">ສະບັບລິຂະສິດອົງກອນ (ທົດລອງ)</translation>
<translation id="2853871047705932424">ສະບັບລິຂະສິດອົງກອນ</translation>
<translation id="5239675900317881945">ສະບັບລິຂະສິດອົງກອນ (ໝົດອາຍຸ)</translation>
<translation id="189101945990408398">Intel ຮຸ່ນເກົ່າ</translation>
<translation id="6816405236809604904">Intel ຮຸ່ນໃໝ່</translation>
<translation id="6169452478137972655">ກຣາຟິກ AMD</translation>
<translation id="6183637837838262693">Intel ບາງ</translation>
<translation id="1270291881045478104">ເປີດ JemaOS AI</translation>
<translation id="2013780539677437932">ເປີດ ຫຼື ປິດຄຸນສົມບັດທັງໝົດທີ່ກ່ຽວຂ້ອງກັບ JemaOS AI</translation>
