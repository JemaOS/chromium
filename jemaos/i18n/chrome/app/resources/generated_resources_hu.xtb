<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="hu">
	<translation id="7386402409475121504">Hozzon létre helyi JemaOS-fiókot</translation>
	<translation id="3760308806144055927">Jelentkezzen be helyi JemaOS-fiókjába</translation>
	<translation id="3325117507482096812">Kérjük, adjon meg egy jelszót</translation>
	<translation id="1838206877831947154">A jelszavaid nem egyeznek</translation>
	<translation id="2158276988029582286">Hozzon létre egy új helyi fiókot</translation>
	<translation id="8592849747346274067">Jelentkezzen be egy meglévő fiókba</translation>
	<translation id="482190417986201746">A megadott felhasználónév vagy jelszó helytelen</translation>
	<translation id="6603987686259425085"><ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>bejelentkezhet JemaOS helyi fiókjával<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">A(z) <ph name="EMAIL_ADDRESS">$1</ph> e-mail már létezik. Kérjük, próbálja újra egy másik e-mail címmel.</translation>
	<translation id="7215016743510876720">Helyi fiók használata</translation>
	<translation id="6657635042185516718">Továbbra is használja az online fiókot</translation>
	<translation id="6867476688065565618">Váltson helyi fiókra?</translation>
	<translation id="4840454774882557974">Ha úgy dönt, hogy helyi fiókot használ, a hasznos funkciók közé tartozik az adatok és beállítások több eszköz között történő szinkronizálása, valamint a webalkalmazások automatikus bejelentkezése a JemaOS-fiókkal nem fog működni.</translation>
	<translation id="8951507920859729424">Javasoljuk, hogy használjon online fiókot a JemaOS maximális kihasználásához.</translation>
	<translation id="479773200536372215">Nem tud majd hozzáadni Google-fiókokat, mert hiányoznak a Google API-kulcsok. A részletekért lásd: <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Nem tud majd hozzáadni JemaOS-fiókokat, mert hiányoznak a JemaOS API-kulcsok. A részletekért lásd: <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Adatvédelmi nyilatkozat</translation>
	<translation id="4907736162587268100">Az adatvédelmi nyilatkozat tartalma</translation>
	<translation id="5988344732274877691">Iratkozzon fel a (nagyon ritkán, ígért) JemaOS hírlevélre</translation>
	<translation id="1706203008474708805">Csatlakozzon a JemaOS felhasználói élményt javító tervéhez</translation>
	<translation id="1147139514756087229">Jelentkezzen be helyi fiókkal</translation>
	<translation id="2054784944085654098">Biztonsági mentés fájl létrehozása most. Ez eltarthat egy ideig; kérlek várj…</translation>
	<translation id="3554401467586751874">A biztonsági másolatfájl sikeresen létrejött</translation>
	<translation id="2349211327705667074">Biztonsági másolat fájl megtekintése</translation>
	<translation id="3049367131589710124">Hibanapló megtekintése</translation>
	<translation id="1079017345574916945">Távoli asztal</translation>
	<translation id="3064478898280877715">App Store</translation>
	<translation id="5890206344045530832">Telepítő</translation>
	<translation id="2173278076276376488">Ez a segédprogram segít a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> értékű telepítésében az eszköz belső tárhelyére.</translation>
	<translation id="5323182426977498659">Figyelmeztetés! Ez az eljárás destruktív, és nem vonható vissza. Felhívjuk figyelmét, hogy nem vállalunk felelősséget az esetleges adatvesztésért, és nem nyújtunk sürgős technikai támogatást, saját felelősségére járjon el.</translation>
	<translation id="8517836015601969896">Teljes lemez telepítés</translation>
	<translation id="7300045760790370189">Telepítse a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> szoftvert egy teljes merevlemez lefoglalásához, a cél merevlemez összes adata törlődik.</translation>
	<translation id="8762511733918256595">Multi-boot telepítés</translation>
	<translation id="248900698427753678">Telepítse a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> alkalmazást a merevlemez egy meglévő partíciójára, ahol a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> más operációs rendszerekkel párhuzamosan létezhet. A célpartíción lévő összes adat törlődik.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> lesz telepítve a kiválasztott merevlemezre; a céllemezen lévő összes adat törlődik.</translation>
	<translation id="4039091757234555415">Lemez</translation>
	<translation id="7783580523889684697">Nincs elérhető lemez</translation>
	<translation id="8217653566575018388">A telepítés befejeződött</translation>
	<translation id="8846746259444262774">A telepítés nem sikerült</translation>
	<translation id="7263815009235541549">A telepítés sikeresen befejeződött. Először kapcsolja ki az eszközt, majd távolítsa el a telepítési adathordozókat, majd kapcsolja be újra a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> indításához.</translation>
	<translation id="3380151284134965398">Hoppá, valami hiba történt, és a telepítés nem fejeződött be. Kérjük, próbálja újra a folyamatot. Ha ugyanaz a hiba továbbra is fennáll, forduljon a JemaOS ügyfélszolgálatához a fenti naplóval.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> lesz telepítve a merevlemez kiválasztott partíciójára. A jelenlegi többszörös rendszerindítási séma szerint ez csak akkor történhet meg, ha az eszköze támogatja az UEFI-t, és a merevlemezek GPT-vel vannak formázva.</translation>
	<translation id="7831363758161884243">A célpartíció törlésre kerül; meg kell adni az aktív EFI-partíciót is (általában automatikusan), mivel a telepítőnek módosítania kell a rendszerindítási konfigurációkat.</translation>
	<translation id="5670799238446305550">Válassza ki a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> célpartíciót</translation>
	<translation id="3695537760133394753">Partíció</translation>
	<translation id="5610519566593708119">Válassza az EFI partíciót</translation>
	<translation id="3367650349940010965">A kiválasztott lemezhez nem érhetők el partíciók</translation>
	<translation id="7453223384507098390">A kiválasztott lemezhez nem érhetők el EFI-partíciók</translation>
	<translation id="1854532683465500847">A kiválasztott partíció mérete kisebb, mint 20 GB, a telepítés sikertelen lehet</translation>
	<translation id="4144613075340468247">A kiválasztott partíció fel lett csatolva a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> többszörös rendszerindításra, az újbóli telepítés sikertelen lehet</translation>
	<translation id="5793361052649920836">A telepítés után hogyan szeretné elindítani a(z) <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> rendszert?</translation>
	<translation id="4273235330352963866">Az rEFInd telepítése és konfigurálása nekem (ajánlott)</translation>
	<translation id="1858708492548921044">Az rEFInd egy rendszerindítás-kezelő program, amely szép grafikus felületet kínál az operációs rendszer indítási opcióihoz, amikor a számítógép elindul, így kiválaszthatja a kívánt operációs rendszert, amellyel elindul. Az rEFInd-vel kapcsolatos további információkért látogasson el a honlapjára.</translation>
	<translation id="3861924051442564602">Adjon hozzá egy UEFI rendszerindító menü opciót számomra</translation>
	<translation id="8622370666798589804">Amikor a számítógép elindul, be tud lépni az UEFI rendszerindítási beállítások menüjébe (valószínűleg egy gyorsbillentyű megnyomásával), ez az opció hozzáadja a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> elemet a menühöz. (Csak a BIOS és az UEFI firmware egyes modelljeit támogatja).</translation>
	<translation id="1569398690544416170">Itt ne csinálj semmit, én magam fogom beállítani</translation>
	<translation id="3554866444001249532">Ez a telepítőszkript csak a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> EFI-partícióra való indításához szükséges .efi fájlokat helyezi el, Önnek kell konfigurálnia, hogyan indítsa el egyedül.</translation>
	<translation id="7492832751164189534">Kényszer kilépés</translation>
	<translation id="5159534860632584026">A telepítési folyamat leállt</translation>
	<translation id="8686749782014838344">Nem sikerült lekérni a lemezadatokat</translation>
	<translation id="5688543378771259173">A telepítés leáll...</translation>
	<translation id="5350452134936384991">Telepítés USB-n</translation>
	<translation id="8008470485414925603">Telepítse a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> elemet egy USB-lemezre; a cél USB-lemezen lévő összes adat törlődik.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> lesz telepítve a kiválasztott USB-lemezre; a céllemezen lévő összes adat törlődik.</translation>
	<translation id="5725593226060700263">Nincs elérhető USB-lemez</translation>
	<translation id="4357040841587078287">Azt észleltük, hogy a JemaOS ezen példányát egy letöltött képfájlból futtatja. A JemaOS által kínált legátfogóbb támogatási szolgáltatások (beleértve az Over-The-Air frissítéseket) kihasználásához nyomatékosan javasoljuk, hogy indítsa el a „Telepítő” funkciót a JemaOS teljes lemezes telepítéséhez egy külön tárolóeszközre.</translation>
	<translation id="1246398339704431302"><ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>továbbra is használhatja a JemaOS ezen példányát<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, a telepítési folyamat a rendszer későbbi szakaszában is végrehajtható, azonban a telepítés után az összes adatot újra töröljük erről az oldalról.</translation>
	<translation id="3654532222088291133">Ahelyett, hogy beírná JemaOS-fiókja jelszavát a bejelentkezéshez, létrehozhat egy <ph name="DEVICE_TYPE">$1$<ex>Chromebook</ex></ph> jelszót ehhez az eszközhöz</translation>
	<translation id="8377684629839541977">Használja a JemaOS fiók jelszavát</translation>

