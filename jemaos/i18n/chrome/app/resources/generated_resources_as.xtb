<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="as">
	<translation id="7386402409475121504">আপোনাৰ স্থানীয় JemaOS একাউণ্ট সৃষ্টি কৰক</translation>
	<translation id="3760308806144055927">আপোনাৰ স্থানীয় JemaOS একাউণ্টত চাইন ইন কৰক</translation>
	<translation id="3325117507482096812">অনুগ্ৰহ কৰি এটা পাছৱৰ্ড ইনপুট কৰক</translation>
	<translation id="1838206877831947154">আপোনাৰ পাছৱৰ্ডসমূহ মিল নাই</translation>
	<translation id="2158276988029582286">এটা নতুন স্থানীয় একাউণ্ট সৃষ্টি কৰক</translation>
	<translation id="8592849747346274067">এটা বৰ্তমানৰ একাউণ্টত চাইন ইন কৰক</translation>
	<translation id="482190417986201746">আপুনি দিয়া ব্যৱহাৰকাৰীৰ নাম বা পাছৱৰ্ড ভুল</translation>
	<translation id="6603987686259425085">আপুনি <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>এটা JemaOS স্থানীয় একাউণ্টৰ সৈতে চাইন ইন কৰিব পাৰে<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph> ।</translation>
	<translation id="3598802966230712759">ইমেইল <ph name="EMAIL_ADDRESS">$1</ph> ইতিমধ্যে আছে। অনুগ্ৰহ কৰি আন এটা ইমেইলৰ সৈতে পুনৰ চেষ্টা কৰক।</translation>
	<translation id="7215016743510876720">স্থানীয় একাউণ্ট ব্যৱহাৰ কৰক</translation>
	<translation id="6657635042185516718">অনলাইন একাউণ্ট ব্যৱহাৰ কৰি যাওক</translation>
	<translation id="6867476688065565618">স্থানীয় একাউণ্টলৈ সলনি কৰক?</translation>
	<translation id="4840454774882557974">যদি আপুনি এটা স্থানীয় একাউণ্ট ব্যৱহাৰ কৰিবলৈ বাছনি কৰে, উপযোগী বৈশিষ্ট্যসমূহে আপোনাৰ ডাটা আৰু পছন্দসমূহ একাধিক ডিভাইচসমূহৰ মাজেৰে সমন্বয় কৰা আৰু আপোনাৰ JemaOS একাউণ্ট ব্যৱহাৰ কৰি ৱেব এপসমূহ স্বয়ংক্ৰিয়ভাৱে চাইন ইন কৰাটো অন্তৰ্ভুক্ত কৰে।</translation>
	<translation id="8951507920859729424">আমি JemaOS সম্পূৰ্ণৰূপে ব্যৱহাৰ কৰিবলৈ এটা অনলাইন একাউণ্ট ব্যৱহাৰ কৰাৰ পৰামৰ্শ দিওঁ।</translation>
	<translation id="479773200536372215">গুগল এপিআই কি নোহোৱাৰ বাবে আপুনি গুগল একাউণ্ট যোগ কৰিব নোৱাৰিব। বিৱৰণৰ বাবে <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> চাওক।</translation>
	<translation id="1198491307547164157">আপুনি JemaOS একাউণ্টসমূহ যোগ কৰিব নোৱাৰিব কাৰণ JemaOS API কি'সমূহ অনুপস্থিত। বিৱৰণৰ বাবে <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> চাওক।</translation>
	<translation id="5042404702659901995">গোপনীয়তা বিবৃতি</translation>
	<translation id="4907736162587268100">গোপনীয়তা বিবৃতিৰ বিষয়বস্তু</translation>
	<translation id="5988344732274877691">JemaOS ৰ বাবে (অতি কম, প্ৰতিশ্ৰুতিবদ্ধ) বাতৰি কাকতৰ বাবে চাইন আপ কৰক</translation>
	<translation id="1706203008474708805">JemaOS ব্যৱহাৰকাৰী অভিজ্ঞতা উন্নয়ন পৰিকল্পনাত যোগদান কৰক</translation>
	<translation id="1147139514756087229">স্থানীয় একাউণ্টৰ সৈতে চাইন ইন কৰক</translation>
	<translation id="2054784944085654098">এতিয়া বেকআপ ফাইল সৃষ্টি কৰা হৈছে। ইয়াৰ বাবে কিছু সময় লাগিব পাৰে; অনুগ্ৰহ কৰি অপেক্ষা কৰক...</translation>
	<translation id="3554401467586751874">বেকআপ ফাইল সফলভাৱে সৃষ্টি কৰা হৈছিল</translation>
	<translation id="2349211327705667074">বেকআপ ফাইল চাওক</translation>
	<translation id="6337433855796857931">বেকআপ বিফল হ'ল</translation>
	<translation id="3049367131589710124">ত্ৰুটি লগ চাওক</translation>
	<translation id="1079017345574916945">দূৰৱৰ্তী ডেস্কটপ</translation>
	<translation id="3064478898280877715">এপ ষ্ট'ৰ</translation>
	<translation id="2747689477259164256">জেমাঅ'এছ এআই</translation>
	<translation id="5890206344045530832">ইনষ্টলাৰ</translation>
	<translation id="2173278076276376488">এই সঁজুলিয়ে আপোনাক এই ডিভাইচৰ অভ্যন্তৰীণ সংৰক্ষণত <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> সংস্থাপন কৰাত সহায় কৰিব।</translation>
	<translation id="5323182426977498659">সতৰ্কবাণী! এই পদ্ধতি ধ্বংসাত্মক আৰু ইয়াক বাতিল কৰিব নোৱাৰি। অনুগ্ৰহ কৰি মন কৰক যে আপোনাৰ সম্ভাৱ্য তথ্য হেৰুৱাৰ বাবে আমি কোনো দায়িত্ব ল'ব নোৱাৰো বা কোনো জৰুৰী কাৰিকৰী সমৰ্থন প্ৰদান নকৰো, আপোনাৰ নিজৰ দায়িত্বত আগবাঢ়িম।</translation>
	<translation id="8517836015601969896">সম্পূৰ্ণ ডিষ্ক সংস্থাপন</translation>
	<translation id="7300045760790370189">এটা সম্পূৰ্ণ হাৰ্ড ডিষ্ক দখল কৰিবলে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> সংস্থাপন কৰক, লক্ষ্য হাৰ্ড ডিস্কৰ সকলো তথ্য মচি পেলোৱা হ'ব।</translation>
	<translation id="8762511733918256595">বহু-বুট সংস্থাপন</translation>
	<translation id="248900698427753678">এটা হাৰ্ড ডিষ্কৰ এটা বৰ্ত্তমানৰ বিভাজনত <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> সংস্থাপন কৰক, য'ত <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> অন্য OS ৰ সৈতে সমান্তৰালভাৱে থাকিব পাৰে । লক্ষ্য বিভাজনৰ সকলো তথ্য মচি পেলোৱা হ'ব ।</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপোনাৰ নিৰ্বাচিত হাৰ্ড ড্ৰাইভত সংস্থাপন কৰা হ'ব; লক্ষ্য ডিষ্কৰ সকলো তথ্য মচি পেলোৱা হ'ব ।</translation>
	<translation id="4039091757234555415">ডিস্ক</translation>
	<translation id="7783580523889684697">কোনো ডিষ্ক উপলব্ধ নহয়</translation>
	<translation id="8217653566575018388">সংস্থাপন সম্পূৰ্ণ হ'ল</translation>
	<translation id="8846746259444262774">সংস্থাপন বিফল হ'ল</translation>
	<translation id="7263815009235541549">সংস্থাপন সফলভাৱে সমাপ্ত হৈছে। অনুগ্ৰহ কৰি আপোনাৰ ডিভাইচ প্ৰথমে বন্ধ কৰক, তাৰ পিছত যিকোনো সংস্থাপন মাধ্যম আঁতৰাওক, আৰু ইয়াক পুনৰায় অন কৰক <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বুট কৰিবলে ।</translation>
	<translation id="3380151284134965398">উফ, কিবা এটা ভুল হৈছে আৰু ইনষ্টলেচন সম্পূৰ্ণ হোৱা নাই। অনুগ্ৰহ কৰি প্ৰক্ৰিয়াটো পুনৰ চেষ্টা কৰক। যদি একে ভুল থাকে, অনুগ্ৰহ কৰি ওপৰৰ লগৰ সৈতে JemaOS সমৰ্থনৰ বাবে হাত আগবঢ়াওক ।</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপোনাৰ হাৰ্ড ড্ৰাইভৰ নিৰ্বাচিত বিভাজনত সংস্থাপন কৰা হব । বৰ্ত্তমানৰ বহু-বুট আঁচনিৰ অন্তৰ্গত, ই কেৱল আগবাঢ়িব পাৰে যদি আপোনাৰ ডিভাইচে UEFI সমৰ্থন কৰে আৰু আপোনাৰ হাৰ্ড ডিষ্কসমূহ GPT ৰ সৈতে বিন্যাস কৰা হয় ।</translation>
	<translation id="7831363758161884243">লক্ষ্য বিভাজন মচি পেলোৱা হ'ব; আপুনি আপোনাৰ সক্ৰিয় EFI বিভাজন ধাৰ্য্য কৰিব লাগিব (সাধাৰণতে স্বয়ংক্ৰিয়ভাৱে কৰা) কাৰণ সংস্থাপকে ব্যৱস্থাপ্ৰণালীৰ বুট বিন্যাসসমূহ পৰিবৰ্তন কৰিব লাগিব ।</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> লক্ষ্য বিভাজন নিৰ্ব্বাচন কৰক</translation>
	<translation id="3695537760133394753">বিভাজন</translation>
	<translation id="5610519566593708119">EFI বিভাজন নিৰ্ব্বাচন কৰক</translation>
	<translation id="3367650349940010965">নিৰ্বাচিত ডিষ্কৰ বাবে কোনো বিভাজন উপলব্ধ নহয়</translation>
	<translation id="7453223384507098390">নিৰ্বাচিত ডিষ্কৰ বাবে কোনো EFI বিভাজন উপলব্ধ নহয়</translation>
	<translation id="1854532683465500847">নিৰ্বাচিত বিভাজনৰ আকাৰ 20GB তকৈ কম, সংস্থাপন বিফল হব পাৰে</translation>
	<translation id="4144613075340468247">নিৰ্বাচিত বিভাজনক <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বহু-বুটলৈ তুলি লোৱা হৈছে, ইয়াত পুনৰ সংস্থাপন বিফল হব পাৰে</translation>
	<translation id="5793361052649920836">সংস্থাপনৰ পিছত, আপুনি <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> কেনেকৈ বুট কৰিব বিচাৰে?</translation>
	<translation id="4273235330352963866">মোৰ বাবে rEFInd সংস্থাপন আৰু বিন্যাস কৰক (উপদেশিত)</translation>
	<translation id="1858708492548921044">rEFInd এটা বুট ব্যৱস্থাপক প্ৰগ্ৰাম যি OS বুট বিকল্পসমূহৰ বাবে এটা সুন্দৰ গ্ৰাফিকেল আন্তঃপৃষ্ঠ প্ৰদান কৰে যেতিয়া আপোনাৰ PC আৰম্ভ হয়, আপুনি ইয়াৰ সৈতে বুট কৰিবলে আপোনাৰ পছন্দৰ OS নিৰ্ব্বাচন কৰিব পাৰিব। rEFInd সম্পৰ্কে অধিক তথ্যৰ বাবে, অনুগ্ৰহ কৰি ইয়াৰ হোমপেজ চাওক।</translation>
	<translation id="3861924051442564602">মোৰ বাবে এটা UEFI বুট মেনু বিকল্প যোগ কৰক</translation>
	<translation id="8622370666798589804">যেতিয়া আপোনাৰ PC আৰম্ভ হয় আপুনি UEFI বুট বিকল্পসমূহ মেনুত প্ৰৱেশ কৰিব পাৰিব (সম্ভৱতঃ এটা হটকি টিপি), এই বিকল্পই <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> সেই মেনুত এটা প্ৰৱেশ হিচাপে যোগ কৰে। (কেৱল BIOS আৰু UEFI ফাৰ্মৱেৰৰ কিছুমান আৰ্হি সমৰ্থন কৰে) ।</translation>
	<translation id="1569398690544416170">ইয়াত একো নকৰিব, মই নিজেই কনফিগাৰ কৰিম</translation>
	<translation id="3554866444001249532">এই সংস্থাপন স্ক্ৰিপ্ট কেৱল আপোনাৰ EFI বিভাজনলৈ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বুট কৰাৰ বাবে প্ৰয়োজনীয় .efi নথিপত্ৰসমূহ ৰাখিব, আপুনি ইয়াক নিজে কেনেকৈ বুট কৰিব লাগে বিন্যাস কৰিব লাগিব ।</translation>
	<translation id="7492832751164189534">বলপূৰ্বক চাকৰি এৰি দিলে</translation>
	<translation id="5159534860632584026">সংস্থাপন প্ৰক্ৰিয়া সমাপ্ত কৰা হৈছে</translation>
	<translation id="8686749782014838344">ডিষ্কৰ তথ্য লাভ কৰাত ব্যৰ্থ</translation>
	<translation id="5688543378771259173">সংস্থাপন সমাপ্ত কৰা হৈছে...</translation>
	<translation id="5350452134936384991">USB ত সংস্থাপন কৰক</translation>
	<translation id="8008470485414925603">এটা USB ডিষ্কত <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> সংস্থাপন কৰক; লক্ষ্য USB ডিষ্কৰ সকলো তথ্য মচি পেলোৱা হ'ব ।</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপোনাৰ নিৰ্বাচিত USB ডিষ্কত সংস্থাপন কৰা হ'ব; লক্ষ্য ডিষ্কৰ সকলো তথ্য মচি পেলোৱা হ'ব ।</translation>
	<translation id="5725593226060700263">কোনো USB ডিস্ক উপলব্ধ নহয়</translation>
	<translation id="4357040841587078287">আমি ধৰা পেলাইছো যে আপুনি এটা ডাউনলোড কৰা ছবি ফাইলৰ পৰা JemaOS ৰ এই কপি চলাই আছে। JemaOS এ প্ৰদান কৰিব পৰা আটাইতকৈ বিস্তৃত সমৰ্থন বৈশিষ্ট্যসমূহ (অভাৰ-দ্য-এয়াৰ আপডেইটসমূহ অন্তৰ্ভুক্ত কৰি) ব্যৱহাৰ কৰিবলে, আমি আপোনাক এটা পৃথক সংৰক্ষণ ডিভাইচলৈ JemaOS ৰ এটা সম্পূৰ্ণ-ডিস্ক সংস্থাপন সম্পাদন কৰিবলে "ইনস্টলাৰ" ফলন আৰম্ভ কৰিবলৈ দৃঢ়ভাৱে পৰামৰ্শ দিওঁ।</translation>
	<translation id="1246398339704431302">আপুনি <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>JemaOS ৰ এই কপি যিকোনো প্ৰকাৰে ব্যৱহাৰ কৰি থাকিব পাৰে<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, সংস্থাপন প্ৰক্ৰিয়া চিস্টেমৰ পিছৰ পৰ্যায়ত এক্সিকিউট কৰিব পাৰি, অৱশ্যে, সংস্থাপনৰ পিছত আপোনাৰ সকলো তথ্য মচি পেলোৱা হ'ব আৰু আপুনি এই পৃষ্ঠাৰ পৰা পুনৰ আৰম্ভ কৰিব।</translation>
	<translation id="3654532222088291133">চাইন ইন কৰিবলৈ আপোনাৰ JemaOS একাউণ্টৰ গুপ্তশব্দ প্ৰৱেশ কৰাৰ পৰিবৰ্তে, আপুনি এই ডিভাইচৰ বাবে এটা <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> গুপ্তশব্দ সৃষ্টি কৰিব পাৰিব</translation>
	<translation id="8377684629839541977">JemaOS একাউণ্টৰ পাছৱৰ্ড ব্যৱহাৰ কৰক</translation>

