<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="bg">
	<translation id="7386402409475121504">Създайте своя локален JemaOS акаунт</translation>
	<translation id="3760308806144055927">Влезте в локалния си JemaOS акаунт</translation>
	<translation id="3325117507482096812">Моля, въведете парола</translation>
	<translation id="1838206877831947154">Вашите пароли не съвпадат</translation>
	<translation id="2158276988029582286">Създайте нов локален акаунт</translation>
	<translation id="8592849747346274067">Влезте в съществуващ акаунт</translation>
	<translation id="482190417986201746">Потребителското име или паролата, които сте въвели, са неправилни</translation>
	<translation id="6603987686259425085">Можете да <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>влезете с локален акаунт в JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Имейл <ph name="EMAIL_ADDRESS">$1</ph> вече съществува. Моля, опитайте отново с друг имейл.</translation>
	<translation id="7215016743510876720">Използвайте локален акаунт</translation>
	<translation id="6657635042185516718">Продължете да използвате онлайн акаунта</translation>
	<translation id="6867476688065565618">Превключване към локален акаунт?</translation>
	<translation id="4840454774882557974">Ако решите да използвате локален акаунт, полезните функции включват синхронизиране на вашите данни и предпочитания на множество устройства и автоматично влизане в уеб приложения с вашия JemaOS акаунт няма да работят.</translation>
	<translation id="8951507920859729424">Препоръчваме да използвате онлайн акаунт, за да използвате JemaOS максимално.</translation>
	<translation id="479773200536372215">Няма да можете да добавяте акаунти в Google, защото липсват ключове за API на Google. Вижте <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> за подробности.</translation>
	<translation id="1198491307547164157">Няма да можете да добавяте JemaOS акаунти, защото липсват JemaOS API ключове. Вижте <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> за подробности.</translation>
	<translation id="5042404702659901995">Декларация за поверителност</translation>
	<translation id="4907736162587268100">Съдържание на декларацията за поверителност</translation>
	<translation id="5988344732274877691">Регистрирайте се за (много рядък, обещан) бюлетин за JemaOS</translation>
	<translation id="1706203008474708805">Присъединете се към плана за подобряване на потребителското изживяване на JemaOS</translation>
	<translation id="1147139514756087229">Влезте с локален акаунт</translation>
	<translation id="2054784944085654098">В момента се създава архивен файл. Това може да отнеме известно време; моля изчакайте...</translation>
	<translation id="3554401467586751874">Архивният файл е създаден успешно</translation>
	<translation id="2349211327705667074">Вижте архивния файл</translation>
	<translation id="3049367131589710124">Преглед на регистъра на грешките</translation>
	<translation id="1079017345574916945">Отдалечен работен плот</translation>
	<translation id="3064478898280877715">Магазин за приложения</translation>
	<translation id="5890206344045530832">Инсталатор</translation>
	<translation id="2173278076276376488">Тази помощна програма ще ви помогне да инсталирате <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> във вътрешната памет на това устройство.</translation>
	<translation id="5323182426977498659">Внимание! Тази процедура е разрушителна и не може да бъде отменена. Моля, обърнете внимание, че ние няма да носим никаква отговорност за вашата потенциална загуба на данни, нито ще предоставим спешна техническа поддръжка, продължете на ваш собствен риск.</translation>
	<translation id="8517836015601969896">Пълна дискова инсталация</translation>
	<translation id="7300045760790370189">Инсталирайте <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, за да заемете цял твърд диск, всички данни на целевия твърд диск ще бъдат изтрити.</translation>
	<translation id="8762511733918256595">Multi-boot инсталация</translation>
	<translation id="248900698427753678">Инсталирайте <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> в съществуващ дял на твърд диск, където <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> може да съществува паралелно с друга операционна система. Всички данни в целевия дял ще бъдат изтрити.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ще бъде инсталиран на вашия избран твърд диск; всички данни на целевия диск ще бъдат изтрити.</translation>
	<translation id="4039091757234555415">диск</translation>
	<translation id="7783580523889684697">Няма наличен диск</translation>
	<translation id="8217653566575018388">Инсталацията е завършена</translation>
	<translation id="8846746259444262774">Инсталирането е неуспешно</translation>
	<translation id="7263815009235541549">Инсталацията завърши успешно. Моля, първо изключете устройството си, след това премахнете всички инсталационни носители и го включете отново, за да стартирате <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ами сега, нещо се обърка и инсталацията не завърши. Моля, опитайте отново процеса. Ако същата грешка продължава, моля, свържете се с поддръжката на JemaOS с горния журнал.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ще бъде инсталиран на избрания дял на вашия твърд диск. При текущата схема за многократно зареждане това може да продължи само ако вашето устройство поддържа UEFI и вашите твърди дискове са форматирани с GPT.</translation>
	<translation id="7831363758161884243">Целевият дял ще бъде изтрит; трябва също така да посочите вашия активен EFI дял (обикновено се прави автоматично), тъй като инсталаторът трябва да промени конфигурациите за зареждане на системата.</translation>
	<translation id="5670799238446305550">Изберете <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> целеви дял</translation>
	<translation id="3695537760133394753">дял</translation>
	<translation id="5610519566593708119">Изберете EFI дял</translation>
	<translation id="3367650349940010965">Няма налични дялове за избрания диск</translation>
	<translation id="7453223384507098390">Няма налични EFI дялове за избрания диск</translation>
	<translation id="1854532683465500847">Размерът на избрания дял е по-малък от 20 GB, инсталацията може да е неуспешна</translation>
	<translation id="4144613075340468247">Избраният дял е монтиран към <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> мулти-зареждане, повторното инсталиране към него може да е неуспешно</translation>
	<translation id="5793361052649920836">След инсталирането, как бихте искали да стартирате <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Инсталирайте и конфигурирайте rEFInd за мен (препоръчително)</translation>
	<translation id="1858708492548921044">rEFInd е програма за управление на зареждане, която предлага приятен графичен интерфейс за опции за зареждане на ОС, когато вашият компютър се стартира, вие ще можете да изберете желаната от вас ОС, която да стартира с него. За повече информация относно rEFInd, моля, вижте началната му страница.</translation>
	<translation id="3861924051442564602">Добавете опция от менюто за стартиране на UEFI за мен</translation>
	<translation id="8622370666798589804">Когато компютърът ви се стартира, може да успеете да влезете в менюто с опции за зареждане на UEFI (най-вероятно чрез натискане на клавишна комбинация), тази опция добавя <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> като запис към това меню. (Поддържа само някои модели BIOS и UEFI фърмуер).</translation>
	<translation id="1569398690544416170">Не правете нищо тук, ще го конфигурирам сам</translation>
	<translation id="3554866444001249532">Този инсталационен скрипт ще постави само необходимите .efi файлове за зареждане на <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> във вашия EFI дял, ще трябва да конфигурирате как да го зареждате сами.</translation>
	<translation id="7492832751164189534">Принудително напускане</translation>
	<translation id="5159534860632584026">Процесът на инсталиране е прекратен</translation>
	<translation id="8686749782014838344">Неуспешно получаване на информация за диска</translation>
	<translation id="5688543378771259173">Инсталацията се прекратява...</translation>
	<translation id="5350452134936384991">Инсталирайте в USB</translation>
	<translation id="8008470485414925603">Инсталирайте <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на USB диск; всички данни на целевия USB диск ще бъдат изтрити.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ще бъде инсталиран на вашия избран USB диск; всички данни на целевия диск ще бъдат изтрити.</translation>
	<translation id="5725593226060700263">Няма наличен USB диск</translation>
	<translation id="4357040841587078287">Установихме, че използвате това копие на JemaOS от изтеглен файл с изображение. За да използвате най-изчерпателните функции за поддръжка (включително актуализации по въздуха), които JemaOS може да предложи, силно препоръчваме да стартирате функцията „Инсталатор“, за да извършите инсталация на JemaOS на пълен диск на отделно устройство за съхранение.</translation>
	<translation id="1246398339704431302">Можете <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>да продължите да използвате това копие на JemaOS така или иначе<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, инсталационният процес може да се изпълни на по-късен етап в системата, но всичките ви данни ще бъдат изтрити след инсталирането и ще започнете отново от тази страница.</translation>
	<translation id="3654532222088291133">Вместо да въвеждате паролата за акаунта си в JemaOS, за да влезете, можете да създадете парола за <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> за това устройство</translation>
	<translation id="8377684629839541977">Използвайте парола за JemaOS акаунт</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Автоматично поддържане на <ph name="DEVICE_OS" /> актуален</translation>
<translation id="2347352406101856238">Актуализацията на <ph name="DEVICE_OS" /> е включена</translation>
<translation id="185834232609012804">Актуализацията на <ph name="DEVICE_OS" /> е изключена</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Платформа <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Отдалечен работен плот</translation>
<translation id="6898090158927982244">Вашият Linux е актуален</translation>
<translation id="4886703929102211360">Налична е критична актуализация за компонента Linux (beta). Силно препоръчително е да инсталирате тази актуализация възможно най-скоро, в противен случай вашият Linux (beta) може да спре да работи.</translation>
<translation id="6694016202036959050">Настройки на <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">Акаунт в JemaOS, архивиране, разни</translation>
<translation id="9150429437595727962">Настройки на Wi-Fi</translation>
<translation id="4938972461544498524">Настройки на тъчпада</translation>
<translation id="1210024513248363065">Отдалечени услуги</translation>
<translation id="2878862288885588535">Услуга за отдалечена диагностика</translation>
<translation id="7409197984340676806">Услугата за отдалечена диагностика позволява на официалните представители на поддръжката на JemaOS да идентифицират системни проблеми. В момента услугата за отдалечена диагностика може да бъде стартирана само от официални представители на поддръжката на JemaOS.</translation>
<translation id="1791028023086176332">Моля, споделете този номер с официалните представители на поддръжката на JemaOS</translation>
<translation id="6279304275399437025">Стартиране на услугата за отдалечена диагностика...</translation>
<translation id="1501882165699826662">Моля, спрете услугата за отдалечена диагностика и опитайте отново</translation>
<translation id="3100283258447375201">Повече информация</translation>
<translation id="4070039109671307724">Разни</translation>
<translation id="7326893024940073254">Бутон „Рестартиране“</translation>
<translation id="3002423764319968103">Показване на бутон „Рестартиране“ в системното меню</translation>
<translation id="6243454903512423518">Бутон „Завъртане на екрана“</translation>
<translation id="6491049336868978729">В момента не сте в режим на таблет, бутонът „Завъртане на екрана“ е скрит</translation>
<translation id="5496012402277579695">Показване на бутон „Завъртане на екрана“ в системното меню</translation>
<translation id="5882838977344999606">Превключвател на режим таблет/лаптоп</translation>
<translation id="472164133625585606">Показване на превключвател на режим таблет/лаптоп в системното меню</translation>
<translation id="1851103550468466960">Активиране на Widevine</translation>
<translation id="4058176713282795846">Активирайте Widevine, за да стриймвате защитено премиум съдържание. <ph name="BEGIN_LINK_LEARN_MORE" />Научете повече<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Изберете „libwidevine.so“</translation>
<translation id="4838463656205005584">Неуспешно активиране на Widevine...</translation>
<translation id="2164041826798266548">Инсталирането на модула Widevine CDM не бе успешно. Моля, проверете връзката си и опитайте отново.</translation>
<translation id="4106982328079440606">Настройки на акаунта в JemaOS</translation>
<translation id="6468776556018764845">Експериментални функции</translation>
<translation id="3487615413425326553">Заобикаляне на проверките на доверен платформен модул (TPM)</translation>
<translation id="4817176087932811573">Някои функции може да не работят поради несъвместим TPM чип във вашето устройство; като заобиколно решение можете да заобиколите проверките на TPM.</translation>
<translation id="3356003366173774486">Автоматично влизане</translation>
<translation id="6218459410891191693">Разрешаване на текущия акаунт да влиза автоматично в работния плот при рестартиране на устройството</translation>
<translation id="6620839363422062843">Не може да се активира за този акаунт; автоматичното влизане вече е активно за други акаунти на това устройство</translation>
<translation id="6734500226490446035">Не може да се активира за този акаунт; възникна неизвестна грешка при инициализирането на файловите системи за този акаунт. Моля, опитайте да рестартирате или да създадете нов акаунт</translation>
<translation id="5464880042146818691">Не може да се активира за този акаунт; опцията за автоматично влизане е налична само за акаунти от тип „Локален акаунт“.</translation>
<translation id="3335654854106476749">Моля, добавете парола за влизане в настройките <ph name="BEGIN_LINK" />Поверителност и сигурност<ph name="END_LINK" />, преди да активирате автоматичното влизане.</translation>
<translation id="5586831602198585601">Вече е налична по-нова версия на JemaOS за актуализация. Вашият абонамент JemaOS for You обаче е изтекъл; необходим ви е активен абонамент, за да актуализирате JemaOS.</translation>
<translation id="3869860597719956574">Вече е налична нова основна версия на JemaOS за актуализация. Трябва да заплатите еднократна такса, за да продължите с тази актуализация.</translation>
<translation id="6523879681771260760">Моля, посочете пътя за съхранение на архивния файл</translation>
<translation id="2036152819788683293">Създаване на архивен файл за този акаунт (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Научете повече<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Архивиране</translation>
<translation id="4267347174163690295">Създаване на архивен файл за този акаунт (beta).</translation>
<translation id="8112950994208888917">Тази операция създава пълен архив на диска за този акаунт, което улеснява възстановяването на JemaOS до състоянието, в което е бил при създаването на архива, включително настройките, инсталираните разширения на браузъра и приложенията на подсистемата. В зависимост от вашите приложения и съдържанието на домашната ви папка архивният файл може да бъде голям; препоръчително е да съхранявате архивния файл на външно запомнящо устройство. Ако имате преносимо USB устройство, моля, свържете го сега. <ph name="BEGIN_LINK_LEARN_MORE" />Научете повече<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Моля, въведете паролата за влизане за този акаунт</translation>
<translation id="8663988871299316062">Моля, запомнете тази парола, тъй като тя ще бъде необходима при възстановяването на този архивен файл</translation>
<translation id="6408904153044317846">Изберете архивния файл за възстановяване</translation>
<translation id="8062988348127771021">Възстановяване на данните на JemaOS от архивен файл</translation>
<translation id="7309192418866543730">Въведете паролата на архива</translation>
<translation id="3642408376366598984">Въведете паролата, използвана за шифроване на този архивен файл</translation>
<translation id="7783974937157985523">Парола на архива</translation>
<translation id="6583780301401541007">Възстановяването е успешно</translation>
<translation id="3514011352559420398">Възстановяването не бе успешно</translation>
<translation id="7535980903266533458">Запазване на архива на вашето устройство или външно хранилище</translation>
<translation id="604001903249547235">Архивиране в облака</translation>
<translation id="8885702701336541611">Качване на архива в облачното хранилище на JemaOS</translation>
<translation id="3939744430096549862">Архивиране в облака</translation>
<translation id="619129431573254316">Възстановяване от локален архивен файл</translation>
<translation id="1859592711955106569">Възстановяване от облака</translation>
<translation id="38222223336741457">Изтегляне и възстановяване от облака на JemaOS</translation>
<translation id="1241089811244416179">Възстановяване от облака</translation>
<translation id="652479689372703360">Архивирането е в ход</translation>
<translation id="3655220146274872918">Архивирането приключи</translation>
<translation id="4243579853635792694">Вашият архив бе създаден успешно</translation>
<translation id="6337433855796857931">Архивирането не бе успешно</translation>
<translation id="4854179463174744546">Възникна грешка по време на процеса на архивиране</translation>
