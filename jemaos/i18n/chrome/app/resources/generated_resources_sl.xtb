<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="sl">
	<translation id="7386402409475121504">Ustvarite svoj lokalni račun JemaOS</translation>
	<translation id="3760308806144055927">Prijavite se v lokalni račun JemaOS</translation>
	<translation id="3325117507482096812">Prosim vnesite geslo</translation>
	<translation id="1838206877831947154">Vaši gesli se ne ujemata</translation>
	<translation id="2158276988029582286">Ustvarite nov lokalni račun</translation>
	<translation id="8592849747346274067">Prijavite se v obstoječi račun</translation>
	<translation id="482190417986201746">Uporabniško ime ali geslo, ki ste ga vnesli, ni pravilno</translation>
	<translation id="6603987686259425085">Lahko se <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>prijavite z lokalnim računom JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-pošta <ph name="EMAIL_ADDRESS">$1</ph> že obstaja. Poskusite znova z drugim e-poštnim naslovom.</translation>
	<translation id="7215016743510876720">Uporabite lokalni račun</translation>
	<translation id="6657635042185516718">Še naprej uporabljajte spletni račun</translation>
	<translation id="6867476688065565618">Preklop na lokalni račun?</translation>
	<translation id="4840454774882557974">Če se odločite za uporabo lokalnega računa, uporabne funkcije vključujejo sinhronizacijo vaših podatkov in nastavitev v več napravah ter samodejno prijavljanje v spletne aplikacije z vašim računom JemaOS ne bodo delovale.</translation>
	<translation id="8951507920859729424">Priporočamo uporabo spletnega računa, da v največji možni meri izkoristite JemaOS.</translation>
	<translation id="479773200536372215">Google računov ne boste mogli dodati, ker manjkajo ključi Google API. Za podrobnosti glejte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Ne boste mogli dodati računov JemaOS, ker manjkajo ključi JemaOS API. Za podrobnosti glejte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Izjava o zasebnosti</translation>
	<translation id="4907736162587268100">Vsebina izjave o zasebnosti</translation>
	<translation id="5988344732274877691">Prijavite se na (zelo redko, obljubljeno) glasilo za JemaOS</translation>
	<translation id="1706203008474708805">Pridružite se načrtu za izboljšanje uporabniške izkušnje JemaOS</translation>
	<translation id="1147139514756087229">Prijavite se z lokalnim računom</translation>
	<translation id="2054784944085654098">Ustvarjanje varnostne kopije. To lahko traja nekaj časa; prosim počakajte...</translation>
	<translation id="3554401467586751874">Datoteka varnostne kopije je bila uspešno ustvarjena</translation>
	<translation id="2349211327705667074">Ogled datoteke varnostne kopije</translation>
	<translation id="3049367131589710124">Oglejte si dnevnik napak</translation>
	<translation id="1079017345574916945">Oddaljeno namizje</translation>
	<translation id="3064478898280877715">Trgovina z aplikacijami</translation>
	<translation id="5890206344045530832">Namestitveni program</translation>
	<translation id="2173278076276376488">Ta pripomoček vam bo pomagal namestiti <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> v notranji pomnilnik te naprave.</translation>
	<translation id="5323182426977498659">Opozorilo! Ta postopek je uničujoč in ga ni mogoče razveljaviti. Upoštevajte, da ne prevzemamo nikakršne odgovornosti za vašo morebitno izgubo podatkov niti ne nudimo nujne tehnične podpore, nadaljujte na lastno odgovornost.</translation>
	<translation id="8517836015601969896">Celotna namestitev diska</translation>
	<translation id="7300045760790370189">Namestite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, da zavzamete celoten trdi disk, vsi podatki na ciljnem trdem disku bodo izbrisani.</translation>
	<translation id="8762511733918256595">Namestitev z več zagoni</translation>
	<translation id="248900698427753678">Namestite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na obstoječo particijo trdega diska, kjer lahko <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> obstaja vzporedno z drugimi operacijskimi sistemi. Vsi podatki na ciljni particiji bodo izbrisani.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bo nameščen na vašem izbranem trdem disku; vsi podatki na ciljnem disku bodo izbrisani.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Disk ni na voljo</translation>
	<translation id="8217653566575018388">Namestitev končana</translation>
	<translation id="8846746259444262774">Namestitev ni uspela</translation>
	<translation id="7263815009235541549">Namestitev se je uspešno končala. Najprej izklopite napravo, nato odstranite vse namestitvene medije in jo znova vklopite, da se zažene <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, nekaj je šlo narobe in namestitev se ni dokončala. Poskusite znova. Če se ista napaka ponovi, se z zgornjim dnevnikom obrnite na podporo za JemaOS.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bo nameščen na izbrano particijo vašega trdega diska. Po trenutni shemi več zagonov se to lahko izvede samo, če vaša naprava podpira UEFI in so vaši trdi diski formatirani z GPT.</translation>
	<translation id="7831363758161884243">Ciljna particija bo izbrisana; določiti morate tudi vašo aktivno particijo EFI (običajno samodejno), saj mora namestitveni program spremeniti konfiguracije zagona sistema.</translation>
	<translation id="5670799238446305550">Izberite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ciljno particijo</translation>
	<translation id="3695537760133394753">Particija</translation>
	<translation id="5610519566593708119">Izberite particijo EFI</translation>
	<translation id="3367650349940010965">Za izbrani disk ni razpoložljivih particij</translation>
	<translation id="7453223384507098390">Za izbrani disk ni na voljo nobena particija EFI</translation>
	<translation id="1854532683465500847">Velikost izbrane particije je manjša od 20 GB, namestitev morda ne bo uspela</translation>
	<translation id="4144613075340468247">Izbrana particija je bila nameščena v <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> večkratni zagon, ponovna namestitev nanjo morda ne bo uspela</translation>
	<translation id="5793361052649920836">Kako želite po namestitvi zagnati <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Namestite in konfigurirajte rEFInd zame (priporočeno)</translation>
	<translation id="1858708492548921044">rEFInd je program za upravljanje zagona, ki ponuja prijeten grafični vmesnik za možnosti zagona operacijskega sistema, ko se vaš računalnik zažene, izbrali boste lahko želeni operacijski sistem za zagon z njim. Za več informacij o rEFInd obiščite njegovo domačo stran.</translation>
	<translation id="3861924051442564602">Dodajte mi možnost zagonskega menija UEFI</translation>
	<translation id="8622370666798589804">Ko se vaš računalnik zažene, boste morda lahko vstopili v meni z možnostmi zagona UEFI (najverjetneje s pritiskom na bližnjično tipko), ta možnost doda <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kot vnos v ta meni. (Podpira samo nekatere modele vdelane programske opreme BIOS in UEFI).</translation>
	<translation id="1569398690544416170">Tukaj ne storite ničesar, konfiguriral bom sam</translation>
	<translation id="3554866444001249532">Ta namestitveni skript bo v vašo particijo EFI postavil samo potrebne datoteke .efi za zagon <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>; sami boste morali konfigurirati, kako ga zagnati.</translation>
	<translation id="7492832751164189534">Prisilno odnehaj</translation>
	<translation id="5159534860632584026">Postopek namestitve je prekinjen</translation>
	<translation id="8686749782014838344">Podatkov o disku ni bilo mogoče pridobiti</translation>
	<translation id="5688543378771259173">Namestitev se prekinja...</translation>
	<translation id="5350452134936384991">Namestite v USB</translation>
	<translation id="8008470485414925603">Namestite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na disk USB; vsi podatki na ciljnem disku USB bodo izbrisani.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bo nameščen na vaš izbrani disk USB; vsi podatki na ciljnem disku bodo izbrisani.</translation>
	<translation id="5725593226060700263">USB disk ni na voljo</translation>
	<translation id="4357040841587078287">Zaznali smo, da uporabljate to kopijo JemaOS iz prenesene slikovne datoteke. Za uporabo najobsežnejših podpornih funkcij (vključno z brezžičnimi posodobitvami), ki jih lahko ponudi JemaOS, močno priporočamo, da zaženete funkcijo "Namestitveni program", da izvedete namestitev JemaOS-a na polni disk v ločeno napravo za shranjevanje.</translation>
	<translation id="1246398339704431302">Vseeno lahko <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>še naprej uporabljate to kopijo JemaOS<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, postopek namestitve lahko izvedete pozneje v sistemu, vendar bodo vsi vaši podatki po namestitvi izbrisani in znova boste začeli s te strani.</translation>
	<translation id="3654532222088291133">Namesto vnosa gesla za račun JemaOS za prijavo lahko ustvarite geslo za <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> za to napravo</translation>
	<translation id="8377684629839541977">Uporabite geslo računa JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
