<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="pa">
	<translation id="7386402409475121504">ਆਪਣਾ ਸਥਾਨਕ JemaOS ਖਾਤਾ ਬਣਾਓ</translation>
	<translation id="3760308806144055927">ਆਪਣੇ ਸਥਾਨਕ JemaOS ਖਾਤੇ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ</translation>
	<translation id="3325117507482096812">ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਪਾਸਵਰਡ ਇਨਪੁਟ ਕਰੋ</translation>
	<translation id="1838206877831947154">ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਮੇਲ ਨਹੀਂ ਖਾਂਦੇ</translation>
	<translation id="2158276988029582286">ਇੱਕ ਨਵਾਂ ਸਥਾਨਕ ਖਾਤਾ ਬਣਾਓ</translation>
	<translation id="8592849747346274067">ਇੱਕ ਮੌਜੂਦਾ ਖਾਤੇ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ</translation>
	<translation id="482190417986201746">ਤੁਹਾਡੇ ਦੁਆਰਾ ਦਰਜ ਕੀਤਾ ਉਪਭੋਗਤਾ ਨਾਮ ਜਾਂ ਪਾਸਵਰਡ ਗਲਤ ਹੈ</translation>
	<translation id="6603987686259425085">ਤੁਸੀਂ <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS ਸਥਾਨਕ ਖਾਤੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰ ਸਕਦੇ ਹੋ<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>।</translation>
	<translation id="3598802966230712759">ਈਮੇਲ <ph name="EMAIL_ADDRESS">$1</ph> ਪਹਿਲਾਂ ਹੀ ਮੌਜੂਦ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਕਿਸੇ ਹੋਰ ਈਮੇਲ ਨਾਲ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
	<translation id="7215016743510876720">ਸਥਾਨਕ ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
	<translation id="6657635042185516718">ਔਨਲਾਈਨ ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰਨਾ ਜਾਰੀ ਰੱਖੋ</translation>
	<translation id="6867476688065565618">ਕੀ ਸਥਾਨਕ ਖਾਤੇ 'ਤੇ ਜਾਣਾ ਹੈ?</translation>
	<translation id="4840454774882557974">ਜੇਕਰ ਤੁਸੀਂ ਇੱਕ ਸਥਾਨਕ ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰਨ ਦੀ ਚੋਣ ਕਰਦੇ ਹੋ, ਤਾਂ ਉਪਯੋਗੀ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਵਿੱਚ ਤੁਹਾਡੇ ਡੇਟਾ ਅਤੇ ਤਰਜੀਹਾਂ ਨੂੰ ਕਈ ਡਿਵਾਈਸਾਂ ਵਿੱਚ ਸਮਕਾਲੀ ਕਰਨਾ ਅਤੇ ਤੁਹਾਡੇ JemaOS ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹੋਏ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਵੈਬ ਐਪਸ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰਨਾ ਸ਼ਾਮਲ ਹੈ।</translation>
	<translation id="8951507920859729424">ਅਸੀਂ JemaOS ਦੀ ਪੂਰੀ ਵਰਤੋਂ ਕਰਨ ਲਈ ਇੱਕ ਔਨਲਾਈਨ ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰਨ ਦੀ ਸਿਫ਼ਾਰਿਸ਼ ਕਰਦੇ ਹਾਂ।</translation>
	<translation id="479773200536372215">ਤੁਸੀਂ Google ਖਾਤੇ ਜੋੜਨ ਦੇ ਯੋਗ ਨਹੀਂ ਹੋਵੋਗੇ ਕਿਉਂਕਿ Google API ਕੁੰਜੀਆਂ ਗੁੰਮ ਹਨ। ਵੇਰਵਿਆਂ ਲਈ <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ਦੇਖੋ।</translation>
	<translation id="1198491307547164157">ਤੁਸੀਂ JemaOS ਖਾਤੇ ਜੋੜਨ ਦੇ ਯੋਗ ਨਹੀਂ ਹੋਵੋਗੇ ਕਿਉਂਕਿ JemaOS API ਕੁੰਜੀਆਂ ਗੁੰਮ ਹਨ। ਵੇਰਵਿਆਂ ਲਈ <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ਦੇਖੋ।</translation>
	<translation id="5042404702659901995">ਗੋਪਨੀਯਤਾ ਬਿਆਨ</translation>
	<translation id="4907736162587268100">ਗੋਪਨੀਯਤਾ ਬਿਆਨ ਸਮੱਗਰੀ</translation>
	<translation id="5988344732274877691">JemaOS ਲਈ (ਬਹੁਤ ਹੀ ਘੱਟ, ਵਾਅਦਾ ਕੀਤੇ) ਨਿਊਜ਼ਲੈਟਰ ਲਈ ਸਾਈਨ ਅੱਪ ਕਰੋ</translation>
	<translation id="1706203008474708805">JemaOS ਉਪਭੋਗਤਾ ਅਨੁਭਵ ਸੁਧਾਰ ਯੋਜਨਾ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋਵੋ</translation>
	<translation id="1147139514756087229">ਇੱਕ ਸਥਾਨਕ ਖਾਤੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋ</translation>
	<translation id="2054784944085654098">ਹੁਣ ਬੈਕਅੱਪ ਫਾਈਲ ਬਣਾਈ ਜਾ ਰਹੀ ਹੈ। ਇਸ ਵਿੱਚ ਕੁਝ ਸਮਾਂ ਲੱਗ ਸਕਦਾ ਹੈ; ਕਿਰਪਾ ਕਰਕੇ ਉਡੀਕ ਕਰੋ…</translation>
	<translation id="3554401467586751874">ਬੈਕਅੱਪ ਫਾਈਲ ਸਫਲਤਾਪੂਰਵਕ ਬਣਾਈ ਗਈ ਸੀ</translation>
	<translation id="2349211327705667074">ਬੈਕਅੱਪ ਫਾਈਲ ਵੇਖੋ</translation>
	<translation id="6337433855796857931">ਬੈਕਅੱਪ ਅਸਫਲ ਰਿਹਾ</translation>
	<translation id="3049367131589710124">ਗਲਤੀ ਲੌਗ ਵੇਖੋ</translation>
	<translation id="1079017345574916945">ਰਿਮੋਟ ਡੈਸਕਟਾਪ</translation>
	<translation id="3064478898280877715">ਐਪ ਸਟੋਰ</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">ਇੰਸਟਾਲਰ</translation>
	<translation id="2173278076276376488">ਇਹ ਸਹੂਲਤ ਇਸ ਡਿਵਾਈਸ ਦੀ ਅੰਦਰੂਨੀ ਸਟੋਰੇਜ 'ਤੇ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਸਥਾਪਤ ਕਰਨ ਵਿੱਚ ਤੁਹਾਡੀ ਮਦਦ ਕਰੇਗੀ।</translation>
	<translation id="5323182426977498659">ਚੇਤਾਵਨੀ! ਇਹ ਪ੍ਰਕਿਰਿਆ ਵਿਨਾਸ਼ਕਾਰੀ ਹੈ ਅਤੇ ਇਸਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਨੋਟ ਕਰੋ ਕਿ ਅਸੀਂ ਤੁਹਾਡੇ ਸੰਭਾਵੀ ਡੇਟਾ ਦੇ ਨੁਕਸਾਨ ਲਈ ਕੋਈ ਜ਼ਿੰਮੇਵਾਰੀ ਨਹੀਂ ਲਵਾਂਗੇ ਅਤੇ ਨਾ ਹੀ ਕੋਈ ਜ਼ਰੂਰੀ ਤਕਨੀਕੀ ਸਹਾਇਤਾ ਪ੍ਰਦਾਨ ਕਰਾਂਗੇ, ਆਪਣੇ ਖੁਦ ਦੇ ਜੋਖਮ 'ਤੇ ਅੱਗੇ ਵਧੋ।</translation>
	<translation id="8517836015601969896">ਪੂਰੀ ਡਿਸਕ ਇੰਸਟਾਲੇਸ਼ਨ</translation>
	<translation id="7300045760790370189">ਪੂਰੀ ਹਾਰਡ ਡਿਸਕ 'ਤੇ ਕਬਜ਼ਾ ਕਰਨ ਲਈ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਸਥਾਪਿਤ ਕਰੋ, ਟਾਰਗੇਟ ਹਾਰਡ ਡਿਸਕ ਦਾ ਸਾਰਾ ਡਾਟਾ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
	<translation id="8762511733918256595">ਮਲਟੀ-ਬੂਟ ਇੰਸਟਾਲੇਸ਼ਨ</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਇੱਕ ਹਾਰਡ ਡਿਸਕ ਦੇ ਮੌਜੂਦਾ ਭਾਗ ਵਿੱਚ ਸਥਾਪਿਤ ਕਰੋ, ਜਿੱਥੇ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਹੋਰ OS ਦੇ ਸਮਾਨਾਂਤਰ ਮੌਜੂਦ ਹੋ ਸਕਦਾ ਹੈ। ਟਾਰਗਿਟ ਭਾਗ 'ਤੇ ਸਾਰਾ ਡਾਟਾ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਤੁਹਾਡੀ ਚੁਣੀ ਗਈ ਹਾਰਡ ਡਰਾਈਵ 'ਤੇ ਸਥਾਪਿਤ ਕੀਤਾ ਜਾਵੇਗਾ; ਟਾਰਗਿਟ ਡਿਸਕ 'ਤੇ ਸਾਰਾ ਡਾਟਾ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
	<translation id="4039091757234555415">ਡਿਸਕ</translation>
	<translation id="7783580523889684697">ਕੋਈ ਡਿਸਕ ਉਪਲਬਧ ਨਹੀਂ ਹੈ</translation>
	<translation id="8217653566575018388">ਸਥਾਪਨਾ ਪੂਰੀ ਹੋਈ</translation>
	<translation id="8846746259444262774">ਸਥਾਪਨਾ ਅਸਫਲ ਰਹੀ</translation>
	<translation id="7263815009235541549">ਇੰਸਟਾਲੇਸ਼ਨ ਸਫਲਤਾਪੂਰਵਕ ਸਮਾਪਤ ਹੋ ਗਈ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਪਹਿਲਾਂ ਆਪਣੀ ਡਿਵਾਈਸ ਬੰਦ ਕਰੋ, ਫਿਰ ਕੋਈ ਵੀ ਇੰਸਟਾਲੇਸ਼ਨ ਮੀਡੀਆ ਹਟਾਓ, ਅਤੇ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਬੂਟ ਕਰਨ ਲਈ ਇਸਨੂੰ ਦੁਬਾਰਾ ਚਾਲੂ ਕਰੋ।</translation>
	<translation id="3380151284134965398">ਓਹੋ, ਕੁਝ ਗਲਤ ਹੋ ਗਿਆ ਹੈ ਅਤੇ ਸਥਾਪਨਾ ਪੂਰੀ ਨਹੀਂ ਹੋਈ। ਕਿਰਪਾ ਕਰਕੇ ਪ੍ਰਕਿਰਿਆ ਦੀ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ। ਜੇਕਰ ਉਹੀ ਤਰੁੱਟੀ ਬਣੀ ਰਹਿੰਦੀ ਹੈ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਉਪਰੋਕਤ ਲੌਗ ਦੇ ਨਾਲ JemaOS ਸਹਾਇਤਾ ਲਈ ਸੰਪਰਕ ਕਰੋ।</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਤੁਹਾਡੀ ਹਾਰਡ ਡਰਾਈਵ ਦੇ ਚੁਣੇ ਭਾਗ 'ਤੇ ਸਥਾਪਤ ਕੀਤਾ ਜਾਵੇਗਾ। ਮੌਜੂਦਾ ਮਲਟੀ-ਬੂਟ ਸਕੀਮ ਦੇ ਤਹਿਤ, ਇਹ ਤਾਂ ਹੀ ਅੱਗੇ ਵਧ ਸਕਦਾ ਹੈ ਜੇਕਰ ਤੁਹਾਡੀ ਡਿਵਾਈਸ UEFI ਦਾ ਸਮਰਥਨ ਕਰਦੀ ਹੈ ਅਤੇ ਤੁਹਾਡੀਆਂ ਹਾਰਡ ਡਿਸਕਾਂ ਨੂੰ GPT ਨਾਲ ਫਾਰਮੈਟ ਕੀਤਾ ਗਿਆ ਹੈ।</translation>
	<translation id="7831363758161884243">ਟਾਰਗਿਟ ਭਾਗ ਪੂੰਝਿਆ ਜਾਵੇਗਾ; ਤੁਹਾਨੂੰ ਆਪਣਾ ਕਿਰਿਆਸ਼ੀਲ EFI ਭਾਗ (ਆਮ ਤੌਰ 'ਤੇ ਆਪਣੇ ਆਪ ਹੀ ਕੀਤਾ ਜਾਂਦਾ ਹੈ) ਦੇਣ ਦੀ ਲੋੜ ਹੁੰਦੀ ਹੈ ਕਿਉਂਕਿ ਇੰਸਟਾਲਰ ਨੂੰ ਸਿਸਟਮ ਬੂਟ ਸੰਰਚਨਾ ਨੂੰ ਸੋਧਣ ਦੀ ਲੋੜ ਹੁੰਦੀ ਹੈ।</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਟਾਰਗੇਟ ਭਾਗ ਚੁਣੋ</translation>
	<translation id="3695537760133394753">ਭਾਗ</translation>
	<translation id="5610519566593708119">EFI ਭਾਗ ਚੁਣੋ</translation>
	<translation id="3367650349940010965">ਚੁਣੀ ਗਈ ਡਿਸਕ ਲਈ ਕੋਈ ਭਾਗ ਉਪਲਬਧ ਨਹੀਂ ਹਨ</translation>
	<translation id="7453223384507098390">ਚੁਣੀ ਗਈ ਡਿਸਕ ਲਈ ਕੋਈ EFI ਭਾਗ ਉਪਲਬਧ ਨਹੀਂ ਹਨ</translation>
	<translation id="1854532683465500847">ਚੁਣੇ ਹੋਏ ਭਾਗ ਦਾ ਆਕਾਰ 20GB ਤੋਂ ਘੱਟ ਹੈ, ਇੰਸਟਾਲੇਸ਼ਨ ਅਸਫਲ ਹੋ ਸਕਦੀ ਹੈ</translation>
	<translation id="4144613075340468247">ਚੁਣੇ ਹੋਏ ਭਾਗ ਨੂੰ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਮਲਟੀ-ਬੂਟ 'ਤੇ ਮਾਊਂਟ ਕੀਤਾ ਗਿਆ ਹੈ, ਇਸ ਨੂੰ ਦੁਬਾਰਾ ਇੰਸਟਾਲ ਕਰਨਾ ਅਸਫਲ ਹੋ ਸਕਦਾ ਹੈ</translation>
	<translation id="5793361052649920836">ਇੰਸਟਾਲੇਸ਼ਨ ਤੋਂ ਬਾਅਦ, ਤੁਸੀਂ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਕਿਵੇਂ ਬੂਟ ਕਰਨਾ ਚਾਹੋਗੇ?</translation>
	<translation id="4273235330352963866">ਮੇਰੇ ਲਈ rEFInd ਨੂੰ ਸਥਾਪਿਤ ਅਤੇ ਕੌਂਫਿਗਰ ਕਰੋ (ਸਿਫਾਰਸ਼ੀ)</translation>
	<translation id="1858708492548921044">rEFInd ਇੱਕ ਬੂਟ ਮੈਨੇਜਰ ਪ੍ਰੋਗਰਾਮ ਹੈ ਜੋ OS ਬੂਟ ਵਿਕਲਪਾਂ ਲਈ ਇੱਕ ਵਧੀਆ ਗ੍ਰਾਫਿਕਲ ਇੰਟਰਫੇਸ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰਦਾ ਹੈ ਜਦੋਂ ਤੁਹਾਡਾ PC ਚਾਲੂ ਹੁੰਦਾ ਹੈ, ਤੁਸੀਂ ਇਸਦੇ ਨਾਲ ਬੂਟ ਕਰਨ ਲਈ ਆਪਣੇ ਲੋੜੀਂਦੇ OS ਦੀ ਚੋਣ ਕਰਨ ਦੇ ਯੋਗ ਹੋਵੋਗੇ। rEFInd ਬਾਰੇ ਵਧੇਰੇ ਜਾਣਕਾਰੀ ਲਈ, ਕਿਰਪਾ ਕਰਕੇ ਇਸਦੇ ਹੋਮਪੇਜ ਨੂੰ ਵੇਖੋ।</translation>
	<translation id="3861924051442564602">ਮੇਰੇ ਲਈ ਇੱਕ UEFI ਬੂਟ ਮੀਨੂ ਵਿਕਲਪ ਸ਼ਾਮਲ ਕਰੋ</translation>
	<translation id="8622370666798589804">ਜਦੋਂ ਤੁਹਾਡਾ PC ਚਾਲੂ ਹੁੰਦਾ ਹੈ ਤਾਂ ਤੁਸੀਂ UEFI ਬੂਟ ਵਿਕਲਪ ਮੀਨੂ ਵਿੱਚ ਦਾਖਲ ਹੋ ਸਕਦੇ ਹੋ (ਸਭ ਤੋਂ ਵੱਧ ਸੰਭਾਵਨਾ ਇੱਕ ਹੌਟਕੀ ਦਬਾ ਕੇ), ਇਹ ਵਿਕਲਪ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਉਸ ਮੀਨੂ ਵਿੱਚ ਇੱਕ ਐਂਟਰੀ ਵਜੋਂ ਜੋੜਦਾ ਹੈ। (ਸਿਰਫ਼ BIOS ਅਤੇ UEFI ਫਰਮਵੇਅਰ ਦੇ ਕੁਝ ਮਾਡਲਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)।</translation>
	<translation id="1569398690544416170">ਇੱਥੇ ਕੁਝ ਨਾ ਕਰੋ, ਮੈਂ ਇਸਨੂੰ ਆਪਣੇ ਆਪ ਸੰਰਚਿਤ ਕਰਾਂਗਾ</translation>
	<translation id="3554866444001249532">ਇਹ ਇੰਸਟਾਲੇਸ਼ਨ ਸਕ੍ਰਿਪਟ ਤੁਹਾਡੇ EFI ਭਾਗ ਵਿੱਚ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਬੂਟ ਕਰਨ ਲਈ ਸਿਰਫ਼ ਲੋੜੀਂਦੀਆਂ .efi ਫਾਈਲਾਂ ਪਾਵੇਗੀ, ਤੁਹਾਨੂੰ ਇਹ ਸੰਰਚਿਤ ਕਰਨ ਦੀ ਲੋੜ ਹੋਵੇਗੀ ਕਿ ਇਸਨੂੰ ਆਪਣੇ ਆਪ ਕਿਵੇਂ ਬੂਟ ਕਰਨਾ ਹੈ।</translation>
	<translation id="7492832751164189534">ਛੱਡਣ ਲਈ ਮਜਬੂਰ ਕਰੋ</translation>
	<translation id="5159534860632584026">ਇੰਸਟਾਲੇਸ਼ਨ ਪ੍ਰਕਿਰਿਆ ਨੂੰ ਖਤਮ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ</translation>
	<translation id="8686749782014838344">ਡਿਸਕ ਜਾਣਕਾਰੀ ਪ੍ਰਾਪਤ ਕਰਨ ਵਿੱਚ ਅਸਫਲ</translation>
	<translation id="5688543378771259173">ਸਥਾਪਨਾ ਨੂੰ ਸਮਾਪਤ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ...</translation>
	<translation id="5350452134936384991">USB ਵਿੱਚ ਸਥਾਪਿਤ ਕਰੋ</translation>
	<translation id="8008470485414925603">ਇੱਕ USB ਡਿਸਕ ਉੱਤੇ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਨੂੰ ਸਥਾਪਿਤ ਕਰੋ; ਟੀਚਾ USB ਡਿਸਕ 'ਤੇ ਸਾਰਾ ਡਾਟਾ ਪੂੰਝ ਜਾਵੇਗਾ.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ਤੁਹਾਡੀ ਚੁਣੀ ਗਈ USB ਡਿਸਕ 'ਤੇ ਸਥਾਪਿਤ ਕੀਤਾ ਜਾਵੇਗਾ; ਟਾਰਗਿਟ ਡਿਸਕ 'ਤੇ ਸਾਰਾ ਡਾਟਾ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
	<translation id="5725593226060700263">ਕੋਈ USB ਡਿਸਕ ਉਪਲਬਧ ਨਹੀਂ ਹੈ</translation>
	<translation id="4357040841587078287">ਸਾਨੂੰ ਪਤਾ ਲੱਗਾ ਹੈ ਕਿ ਤੁਸੀਂ JemaOS ਦੀ ਇਸ ਕਾਪੀ ਨੂੰ ਡਾਊਨਲੋਡ ਕੀਤੀ ਚਿੱਤਰ ਫ਼ਾਈਲ ਤੋਂ ਚਲਾ ਰਹੇ ਹੋ। JemaOS ਦੁਆਰਾ ਪੇਸ਼ ਕੀਤੀਆਂ ਜਾ ਸਕਣ ਵਾਲੀਆਂ ਸਭ ਤੋਂ ਵਿਆਪਕ ਸਹਾਇਤਾ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ (ਓਵਰ-ਦ-ਏਅਰ ਅੱਪਡੇਟ ਸਮੇਤ) ਦੀ ਵਰਤੋਂ ਕਰਨ ਲਈ, ਅਸੀਂ ਜ਼ੋਰਦਾਰ ਸਿਫ਼ਾਰਿਸ਼ ਕਰਦੇ ਹਾਂ ਕਿ ਤੁਸੀਂ ਇੱਕ ਵੱਖਰੇ ਸਟੋਰੇਜ਼ ਡਿਵਾਈਸ 'ਤੇ JemaOS ਦੀ ਫੁੱਲ-ਡਿਸਕ ਸਥਾਪਨਾ ਕਰਨ ਲਈ "ਇੰਸਟਾਲਰ" ਫੰਕਸ਼ਨ ਲਾਂਚ ਕਰੋ।</translation>
	<translation id="1246398339704431302">ਤੁਸੀਂ <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>ਕਿਸੇ ਵੀ ਤਰ੍ਹਾਂ JemaOS ਦੀ ਇਸ ਕਾਪੀ ਦੀ ਵਰਤੋਂ ਕਰਨਾ ਜਾਰੀ ਰੱਖ ਸਕਦੇ ਹੋ<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, ਇੰਸਟਾਲੇਸ਼ਨ ਪ੍ਰਕਿਰਿਆ ਨੂੰ ਸਿਸਟਮ ਵਿੱਚ ਬਾਅਦ ਦੇ ਪੜਾਅ 'ਤੇ ਚਲਾਇਆ ਜਾ ਸਕਦਾ ਹੈ, ਹਾਲਾਂਕਿ, ਇਸ ਪੰਨੇ ਤੋਂ ਬਾਅਦ ਤੁਹਾਡਾ ਸਾਰਾ ਡਾਟਾ ਮਿਟਾਇਆ ਜਾਵੇਗਾ ਅਤੇ ਤੁਸੀਂ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰੋਗੇ।</translation>
	<translation id="3654532222088291133">ਸਾਈਨ ਇਨ ਕਰਨ ਲਈ ਆਪਣਾ JemaOS ਖਾਤਾ ਪਾਸਵਰਡ ਦਰਜ ਕਰਨ ਦੀ ਬਜਾਏ, ਤੁਸੀਂ ਇਸ ਡਿਵਾਈਸ ਲਈ ਇੱਕ <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> ਪਾਸਵਰਡ ਬਣਾ ਸਕਦੇ ਹੋ</translation>
	<translation id="8377684629839541977">JemaOS ਖਾਤੇ ਦਾ ਪਾਸਵਰਡ ਵਰਤੋ</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
