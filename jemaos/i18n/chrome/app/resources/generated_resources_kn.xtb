<translation id="6183637837838262693">Intel Slim</translation>
<translation id="1270291881045478104">JemaOS AI ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="2013780539677437932">ಎಲ್ಲಾ JemaOS AI-ಸಂಬಂಧಿತ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ ಅಥವಾ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="3398637633218757480">JemaOS AI ಕ್ವಿಕ್ ಕಾಲ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="8986197796475507452">Ctrl + C + C ಒತ್ತುವ ಮೂಲಕ ಹೈಲೈಟ್ ಮಾಡಿದ ವಿಷಯಕ್ಕೆ JemaOS AI ಆಯ್ಕೆಗಳನ್ನು ತ್ವರಿತವಾಗಿ ತನ್ನಿ</translation>
<translation id="6407628130593274137">JemaOS AI ಗಾಗಿ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮತ್ತು ಆಯ್ಕೆಗಳು</translation>
<translation id="4005574560653331142">ಈ ಸ್ಥಳೀಯ ಖಾತೆಯ PIN ಅಥವಾ ಸೈನ್-ಇನ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬದಲಾಯಿಸಲು, <ph name="BEGIN_LINK" />ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ<ph name="END_LINK" /> ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ.</translation>
<!-- login_strings (JemaOS) -->
<translation id="6419913024856619425">ನೀವು <ph name="LINK_START" />JemaOS ಸ್ಥಳೀಯ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು<ph name="LINK_END" />.</translation>
<translation id="5291842596976929391">ಇಮెయిల್ <ph name="EMAIL_ADDRESS" /> ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ. ದಯವಿಟ್ಟು ಬೇರೆ ಇಮೆಯిల್‌ನೊಂದಿಗೆ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="4519800823932975782">JemaOS ಸಹಾಯ ಕೇಂದ್ರ</translation>
<translation id="4737474693231655139">ಸಾಮಾನ್ಯ JemaOS ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಗಳು ಮತ್ತು ಸಹಾಯ ಲೇಖನಗಳನ್ನು ಹುಡುಕಿ</translation>
</translationbundle>
