<translation id="1210024513248363065">Masofaviy xizmatlar</translation>
<translation id="2878862288885588535">Masofaviy diagnostika xizmati</translation>
<translation id="7409197984340676806">Masofaviy diagnostika xizmati JemaOS rasmiy qo'llab-quvvatlash vakillariga tizim muammolarini aniqlash imkonini beradi. Hozircha masofaviy diagnostika xizmatini faqat JemaOS rasmiy qo'llab-quvvatlash vakillari ishga tushirishi mumkin.</translation>
<translation id="1791028023086176332">Ushbu raqamni JemaOS rasmiy qo'llab-quvvatlash vakillari bilan ulashing</translation>
<translation id="6279304275399437025">Masofaviy diagnostika xizmati ishga tushirilmoqda...</translation>
<translation id="1501882165699826662">Masofaviy diagnostika xizmatini to'xtatib, qaytadan urinib ko'ring</translation>
<translation id="3100283258447375201">Qo'shimcha ma'lumot</translation>
<translation id="4070039109671307724">Boshqalar</translation>
<translation id="7326893024940073254">"Qayta ishga tushirish" tugmasi</translation>
<translation id="3002423764319968103">Tizim menyusida "Qayta ishga tushirish" tugmasini ko'rsatish</translation>
<translation id="6243454903512423518">"Ekranni aylantirish" tugmasi</translation>
<translation id="6491049336868978729">Hozir planshet rejimida emassiz, "Ekranni aylantirish" tugmasi yashiringan</translation>
<translation id="5496012402277579695">Tizim menyusida "Ekranni aylantirish" tugmasini ko'rsatish</translation>
