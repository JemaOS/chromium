<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="lv">
	<translation id="7386402409475121504">Izveidojiet savu vietējo JemaOS kontu</translation>
	<translation id="3760308806144055927">Pierakstieties savā vietējā JemaOS kontā</translation>
	<translation id="3325117507482096812">Lūdzu, ievadiet paroli</translation>
	<translation id="1838206877831947154">Jūsu paroles nesakrīt</translation>
	<translation id="2158276988029582286">Izveidojiet jaunu vietējo kontu</translation>
	<translation id="8592849747346274067">Pierakstieties esošajā kontā</translation>
	<translation id="482190417986201746">Ievadītais lietotājvārds vai parole ir nepareiza</translation>
	<translation id="6603987686259425085">Varat <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>pierakstīties, izmantojot JemaOS vietējo kontu<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-pasts <ph name="EMAIL_ADDRESS">$1</ph> jau pastāv. Lūdzu, mēģiniet vēlreiz, izmantojot citu e-pasta adresi.</translation>
	<translation id="7215016743510876720">Izmantojiet vietējo kontu</translation>
	<translation id="6657635042185516718">Turpiniet izmantot tiešsaistes kontu</translation>
	<translation id="6867476688065565618">Pārslēgties uz vietējo kontu?</translation>
	<translation id="4840454774882557974">Ja izvēlaties izmantot vietējo kontu, noderīgas funkcijas ietver datu un preferenču sinhronizēšanu vairākās ierīcēs un automātisku pierakstīšanos tīmekļa lietotnēs, izmantojot savu JemaOS kontu, nedarbosies.</translation>
	<translation id="8951507920859729424">Mēs iesakām izmantot tiešsaistes kontu, lai pilnībā izmantotu JemaOS.</translation>
	<translation id="479773200536372215">Jūs nevarēsit pievienot Google kontus, jo trūkst Google API atslēgu. Plašāku informāciju skatiet vietnē <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Jūs nevarēsit pievienot JemaOS kontus, jo trūkst JemaOS API atslēgu. Plašāku informāciju skatiet vietnē <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Privātuma paziņojums</translation>
	<translation id="4907736162587268100">Privātuma paziņojuma saturs</translation>
	<translation id="5988344732274877691">Reģistrējieties (ļoti reti, apsolītajam) JemaOS biļetenam</translation>
	<translation id="1706203008474708805">Pievienojieties JemaOS lietotāja pieredzes uzlabošanas plānam</translation>
	<translation id="1147139514756087229">Pierakstieties, izmantojot vietējo kontu</translation>
	<translation id="2054784944085654098">Tagad tiek izveidots dublējuma fails. Tas var aizņemt kādu laiku; lūdzu uzgaidiet…</translation>
	<translation id="3554401467586751874">Dublējuma fails tika veiksmīgi izveidots</translation>
	<translation id="2349211327705667074">Skatīt dublējuma failu</translation>
	<translation id="6337433855796857931">Dublēšana neizdevās</translation>
	<translation id="3049367131589710124">Skatīt kļūdu žurnālu</translation>
	<translation id="1079017345574916945">Attālā darbvirsma</translation>
	<translation id="3064478898280877715">Lietotņu veikals</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Uzstādītājs</translation>
	<translation id="2173278076276376488">Šī utilīta palīdzēs instalēt <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> šīs ierīces iekšējā atmiņā.</translation>
	<translation id="5323182426977498659">Brīdinājums! Šī procedūra ir destruktīva, un to nevar atsaukt. Lūdzu, ņemiet vērā, ka mēs neuzņemamies nekādu atbildību par jūsu iespējamo datu zudumu un nesniegsim nekādu steidzamu tehnisko atbalstu, rīkojieties uz savu risku.</translation>
	<translation id="8517836015601969896">Pilna diska uzstādīšana</translation>
	<translation id="7300045760790370189">Instalējiet <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, lai aizņemtu visu cieto disku, tiks dzēsti visi mērķa cietā diska dati.</translation>
	<translation id="8762511733918256595">Vairāku sāknēšanas instalēšana</translation>
	<translation id="248900698427753678">Instalējiet <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> esošā cietā diska nodalījumā, kur <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> var pastāvēt paralēli citām operētājsistēmām. Visi dati par mērķa nodalījumu tiks dzēsti.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tiks instalēts jūsu atlasītajā cietajā diskā; visi dati mērķa diskā tiks dzēsti.</translation>
	<translation id="4039091757234555415">Disks</translation>
	<translation id="7783580523889684697">Nav pieejams disks</translation>
	<translation id="8217653566575018388">Uzstādīšana pabeigta</translation>
	<translation id="8846746259444262774">Instalēšana neizdevās</translation>
	<translation id="7263815009235541549">Instalēšana ir veiksmīgi pabeigta. Lūdzu, vispirms izslēdziet ierīci, pēc tam noņemiet visus instalācijas datu nesējus un ieslēdziet to vēlreiz, lai palaistu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Hmm, kaut kas nogāja greizi, un instalēšana netika pabeigta. Lūdzu, mēģiniet vēlreiz. Ja tā pati kļūda joprojām pastāv, lūdzu, sazinieties ar JemaOS atbalstu, izmantojot iepriekš minēto žurnālu.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tiks instalēts jūsu cietā diska atlasītajā nodalījumā. Saskaņā ar pašreizējo vairāku sāknēšanas shēmu tas varētu notikt tikai tad, ja jūsu ierīce atbalsta UEFI un jūsu cietie diski ir formatēti ar GPT.</translation>
	<translation id="7831363758161884243">Mērķa nodalījums tiks notīrīts; jums arī jānorāda aktīvais EFI nodalījums (parasti tas tiek darīts automātiski), jo instalētājam ir jāmaina sistēmas sāknēšanas konfigurācijas.</translation>
	<translation id="5670799238446305550">Atlasiet mērķa nodalījumu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Sadalījums</translation>
	<translation id="5610519566593708119">Atlasiet EFI nodalījumu</translation>
	<translation id="3367650349940010965">Atlasītajam diskam nav pieejami nodalījumi</translation>
	<translation id="7453223384507098390">Atlasītajam diskam nav pieejams neviens EFI nodalījums</translation>
	<translation id="1854532683465500847">Atlasītā nodalījuma izmērs ir mazāks par 20 GB, instalēšana var neizdoties</translation>
	<translation id="4144613075340468247">Atlasītais nodalījums ir pievienots <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vairākām sāknēšanas reizēm. Instalēšana tajā atkārtoti var neizdoties</translation>
	<translation id="5793361052649920836">Pēc instalēšanas kā jūs vēlaties palaist <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instalējiet un konfigurējiet reEFInd man (ieteicams)</translation>
	<translation id="1858708492548921044">REFInd ir sāknēšanas pārvaldnieka programma, kas piedāvā jauku grafisko interfeisu OS sāknēšanas opcijām, kad jūsu dators tiek startēts, un jūs varēsiet izvēlēties vēlamo operētājsistēmu, ko ar to palaist. Lai iegūtu papildinformāciju par REFInd, lūdzu, skatiet tās mājaslapu.</translation>
	<translation id="3861924051442564602">Pievienojiet man UEFI sāknēšanas izvēlnes opciju</translation>
	<translation id="8622370666798589804">Kad dators tiek startēts, iespējams, varēsiet atvērt UEFI sāknēšanas opciju izvēlni (visticamāk, nospiežot karsto taustiņu), šī opcija šai izvēlnei pievieno <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>. (atbalsta tikai dažus BIOS un UEFI programmaparatūras modeļus).</translation>
	<translation id="1569398690544416170">Šeit neko nedariet, es pats to konfigurēšu</translation>
	<translation id="3554866444001249532">Šis instalācijas skripts ievietos tikai nepieciešamos .efi failus <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sāknēšanai jūsu EFI nodalījumā. Jums būs jākonfigurē, kā to bootēt pašam.</translation>
	<translation id="7492832751164189534">Piespiest atmest</translation>
	<translation id="5159534860632584026">Instalēšanas process ir pārtraukts</translation>
	<translation id="8686749782014838344">Neizdevās iegūt informāciju par disku</translation>
	<translation id="5688543378771259173">Instalēšana tiek pārtraukta...</translation>
	<translation id="5350452134936384991">Instalējiet USB</translation>
	<translation id="8008470485414925603">Instalējiet <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> USB diskā; visi dati mērķa USB diskā tiks dzēsti.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tiks instalēts jūsu atlasītajā USB diskā; visi dati mērķa diskā tiks dzēsti.</translation>
	<translation id="5725593226060700263">Nav pieejams USB disks</translation>
	<translation id="4357040841587078287">Esam konstatējuši, ka jūs izmantojat šo JemaOS kopiju no lejupielādēta attēla faila. Lai izmantotu visplašākās atbalsta funkcijas (tostarp Over-The-Air atjauninājumus), ko JemaOS var piedāvāt, mēs ļoti iesakām palaist funkciju "Instalētājs", lai veiktu JemaOS pilna diska instalēšanu atsevišķā atmiņas ierīcē.</translation>
	<translation id="1246398339704431302">Varat <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>tik un tā turpināt izmantot šo JemaOS kopiju<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, instalēšanas procesu var izpildīt vēlākā sistēmas posmā, tomēr pēc instalēšanas visi jūsu dati tiks dzēsti no jauna, un jūs to darīsit.</translation>
	<translation id="3654532222088291133">Lai pierakstītos, tā vietā, lai ievadītu JemaOS konta paroli, šai ierīcei varat izveidot <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> paroli.</translation>
	<translation id="8377684629839541977">Izmantojiet JemaOS konta paroli</translation>

