<translation id="3855250998276979579">Nutstore ایپ کھولیں</translation>
<translation id="6565655783894300125">اور Nutstore اکاؤنٹ کو اپنے ای میل اور ایپلیکیشن پاس ورڈ کے ساتھ JemaOS سے جوڑیں</translation>
<translation id="4208217820626259628">JemaDrop</translation>
<translation id="77997252117517973">جلد آ رہا ہے</translation>
<translation id="4928968570611226525">اس عمل کو جاری رکھنے کے لیے آپ کو اپنے JemaOS ڈیوائس پر <ph name="BEGIN_LINK_ARC_APP" />&gt;Android سب سسٹم کو فعال کرنا<ph name="END_LINK_ARC_APP" /> ہوگا؛ نیز آپ کے JemaOS ڈیوائس کو <ph name="BEGIN_LINK_HELP" />ڈویلپر موڈ میں تبدیل کیا جانا<ph name="END_LINK_HELP" /> ضروری ہے۔</translation>
<translation id="7395250550107972941">.apk فائلوں کو سائیڈ لوڈ کرنے سے قاصر ہے۔ براہ کرم یقینی بنائیں کہ Android سب سسٹم فعال ہو چکا ہے اور آپ JemaOS ڈویلپر موڈ میں ہیں۔</translation>
