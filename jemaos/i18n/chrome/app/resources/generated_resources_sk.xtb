<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="sk">
	<translation id="7386402409475121504">Vytvorte si svoj lokálny účet JemaOS</translation>
	<translation id="3760308806144055927">Prihláste sa do svojho lokálneho účtu JemaOS</translation>
	<translation id="3325117507482096812">Zadajte heslo</translation>
	<translation id="1838206877831947154">Vaše heslá sa nezhodujú</translation>
	<translation id="2158276988029582286">Vytvorte nový lokálny účet</translation>
	<translation id="8592849747346274067">Prihláste sa do existujúceho účtu</translation>
	<translation id="482190417986201746">Zadané používateľské meno alebo heslo je nesprávne</translation>
	<translation id="6603987686259425085">Môžete sa <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>prihlásiť pomocou lokálneho účtu JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-mail <ph name="EMAIL_ADDRESS">$1</ph> už existuje. Skúste to znova s ​​iným e-mailom.</translation>
	<translation id="7215016743510876720">Použite lokálny účet</translation>
	<translation id="6657635042185516718">Pokračujte v používaní online účtu</translation>
	<translation id="6867476688065565618">Prepnúť na lokálny účet?</translation>
	<translation id="4840454774882557974">Ak sa rozhodnete používať lokálny účet, užitočné funkcie zahŕňajú synchronizáciu vašich údajov a preferencií na viacerých zariadeniach a automatické prihlasovanie do webových aplikácií pomocou vášho účtu JemaOS nebude fungovať.</translation>
	<translation id="8951507920859729424">Ak chcete naplno využívať JemaOS, odporúčame vám použiť online účet.</translation>
	<translation id="479773200536372215">Nebudete môcť pridať účty Google, pretože chýbajú kľúče rozhrania Google API. Podrobnosti nájdete na stránke <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Nebudete môcť pridať účty JemaOS, pretože chýbajú kľúče API JemaOS. Podrobnosti nájdete na stránke <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Vyhlásenie o ochrane osobných údajov</translation>
	<translation id="4907736162587268100">Obsah vyhlásenia o ochrane osobných údajov</translation>
	<translation id="5988344732274877691">Prihláste sa na odber (veľmi zriedkavého, sľubovaného) newsletteru pre JemaOS</translation>
	<translation id="1706203008474708805">Pripojte sa k plánu zlepšenia používateľského prostredia JemaOS</translation>
	<translation id="1147139514756087229">Prihláste sa pomocou lokálneho účtu</translation>
	<translation id="2054784944085654098">Teraz sa vytvára záložný súbor. Môže to chvíľu trvať; prosím počkajte…</translation>
	<translation id="3554401467586751874">Záložný súbor bol úspešne vytvorený</translation>
	<translation id="2349211327705667074">Zobraziť záložný súbor</translation>
	<translation id="3049367131589710124">Zobraziť denník chýb</translation>
	<translation id="1079017345574916945">Vzdialená plocha</translation>
	<translation id="3064478898280877715">Obchod s aplikáciami</translation>
	<translation id="5890206344045530832">Inštalátor</translation>
	<translation id="2173278076276376488">Tento nástroj vám pomôže nainštalovať <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> do interného úložiska tohto zariadenia.</translation>
	<translation id="5323182426977498659">POZOR! Tento postup je deštruktívny a nedá sa vrátiť späť. Upozorňujeme, že nenesieme žiadnu zodpovednosť za vašu potenciálnu stratu údajov ani neposkytujeme naliehavú technickú podporu, postupujeme na vlastné riziko.</translation>
	<translation id="8517836015601969896">Kompletná inštalácia disku</translation>
	<translation id="7300045760790370189">Nainštalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, aby ste zabrali celý pevný disk, všetky údaje cieľového pevného disku budú vymazané.</translation>
	<translation id="8762511733918256595">Inštalácia s viacerými systémami</translation>
	<translation id="248900698427753678">Nainštalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na existujúcu partíciu pevného disku, kde <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> môže existovať paralelne s iným OS. Všetky údaje na cieľovom oddiele budú vymazané.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sa nainštaluje na vybratý pevný disk; všetky údaje na cieľovom disku budú vymazané.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Nie je k dispozícii žiadny disk</translation>
	<translation id="8217653566575018388">Inštalácia dokončená</translation>
	<translation id="8846746259444262774">Inštalácia zlyhala</translation>
	<translation id="7263815009235541549">Inštalácia bola úspešne dokončená. Najprv vypnite svoje zariadenie, potom odstráňte všetky inštalačné médiá a znova ho zapnite, aby sa spustil <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ojoj, niečo sa pokazilo a inštalácia sa nedokončila. Skúste proces zopakovať. Ak rovnaká chyba pretrváva, kontaktujte podporu JemaOS pomocou vyššie uvedeného denníka.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sa nainštaluje na vybranú partíciu vášho pevného disku. Podľa aktuálnej schémy spustenia viacerých systémov by to mohlo pokračovať iba vtedy, ak vaše zariadenie podporuje UEFI a vaše pevné disky sú naformátované pomocou GPT.</translation>
	<translation id="7831363758161884243">Cieľový oddiel bude vymazaný; musíte tiež špecifikovať váš aktívny oddiel EFI (zvyčajne sa to robí automaticky), pretože inštalačný program potrebuje upraviť konfigurácie zavádzania systému.</translation>
	<translation id="5670799238446305550">Vyberte cieľový oddiel <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Priečka</translation>
	<translation id="5610519566593708119">Vyberte oblasť EFI</translation>
	<translation id="3367650349940010965">Pre vybraný disk nie sú k dispozícii žiadne oddiely</translation>
	<translation id="7453223384507098390">Pre vybratý disk nie sú k dispozícii žiadne oddiely EFI</translation>
	<translation id="1854532683465500847">Veľkosť vybratého oddielu je menšia ako 20 GB, inštalácia môže zlyhať</translation>
	<translation id="4144613075340468247">Vybraný oddiel bol pripojený k <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, opätovná inštalácia môže zlyhať</translation>
	<translation id="5793361052649920836">Ako chcete po inštalácii spustiť systém <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Nainštalujte a nakonfigurujte rEFInd za mňa (odporúča sa)</translation>
	<translation id="1858708492548921044">rEFInd je program na správu zavádzania, ktorý ponúka pekné grafické rozhranie pre možnosti zavádzania operačného systému, keď sa počítač spustí, budete si môcť vybrať požadovaný operačný systém, z ktorého sa má spustiť. Viac informácií o rEFInd nájdete na jeho domovskej stránke.</translation>
	<translation id="3861924051442564602">Pridajte pre mňa možnosť zavádzacej ponuky UEFI</translation>
	<translation id="8622370666798589804">Po spustení počítača možno budete môcť vstúpiť do ponuky možností zavádzania UEFI (najpravdepodobnejšie stlačením klávesovej skratky), táto možnosť pridá <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ako položku do tejto ponuky. (Podporuje len niektoré modely firmvéru BIOS a UEFI).</translation>
	<translation id="1569398690544416170">Nerobte tu nič, nakonfigurujem si to sám</translation>
	<translation id="3554866444001249532">Tento inštalačný skript vloží iba potrebné .efi súbory na zavedenie <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> do vašej EFI partície, budete si musieť sami nakonfigurovať, ako ho zaviesť.</translation>
	<translation id="7492832751164189534">Vynútiť ukončenie</translation>
	<translation id="5159534860632584026">Proces inštalácie bol ukončený</translation>
	<translation id="8686749782014838344">Nepodarilo sa získať informácie o disku</translation>
	<translation id="5688543378771259173">Inštalácia sa ukončuje...</translation>
	<translation id="5350452134936384991">Nainštalujte do USB</translation>
	<translation id="8008470485414925603">Nainštalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na USB disk; všetky dáta na cieľovom USB disku budú vymazané.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sa nainštaluje na vybratý USB disk; všetky údaje na cieľovom disku budú vymazané.</translation>
	<translation id="5725593226060700263">Nie je k dispozícii žiadny USB disk</translation>
	<translation id="4357040841587078287">Zistili sme, že používate túto kópiu JemaOS zo prevzatého súboru s obrázkom. Ak chcete využiť najkomplexnejšie funkcie podpory (vrátane aktualizácií Over-The-Air), ktoré môže JemaOS ponúknuť, dôrazne odporúčame spustiť funkciu „Inštalátor“, aby ste vykonali inštaláciu JemaOS z celého disku na samostatné úložné zariadenie.</translation>
	<translation id="1246398339704431302"><ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>aj tak môžete pokračovať v používaní tejto kópie JemaOS<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proces inštalácie možno spustiť v neskoršej fáze systému, po inštalácii sa však všetky vaše údaje vymažú a začnete znova z tejto stránky.</translation>
	<translation id="3654532222088291133">Namiesto zadávania hesla účtu JemaOS na prihlásenie si môžete pre toto zariadenie vytvoriť heslo <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph></translation>
	<translation id="8377684629839541977">Použite heslo účtu JemaOS</translation>

