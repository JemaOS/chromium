	<translation id="7386402409475121504">Sortu zure tokiko JemaOS kontua</translation>
	<translation id="3760308806144055927">Hasi saioa zure tokiko JemaOS kontuan</translation>
	<translation id="3325117507482096812">Mesedez, sartu pasahitza</translation>
	<translation id="1838206877831947154">Zure pasahitzak ez datoz bat</translation>
	<translation id="2158276988029582286">Sortu tokiko kontu berri bat</translation>
	<translation id="8592849747346274067">Hasi saioa lehendik dagoen kontu batean</translation>
	<translation id="482190417986201746">Idatzi duzun erabiltzaile-izena edo pasahitza okerra da</translation>
	<translation id="6603987686259425085"><ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>saioa dezakezu JemaOS tokiko kontu batekin<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Dagoeneko bada <ph name="EMAIL_ADDRESS">$1</ph> posta elektronikoa. Mesedez, saiatu berriro beste mezu elektroniko batekin.</translation>
	<translation id="7215016743510876720">Erabili tokiko kontua</translation>
	<translation id="6657635042185516718">Jarraitu lineako kontua erabiltzen</translation>
	<translation id="6867476688065565618">Tokiko kontura aldatu?</translation>
	<translation id="4840454774882557974">Tokiko kontu bat erabiltzea aukeratzen baduzu, eginbide erabilgarriak dira zure datuak eta hobespenak hainbat gailutan sinkronizatzea eta web-aplikazioetan saioa automatikoki zure JemaOS kontua erabiliz ez du funtzionatuko.</translation>
	<translation id="8951507920859729424">Lineako kontu bat erabiltzea gomendatzen dugu JemaOS ahalik eta gehien erabiltzeko.</translation>
	<translation id="479773200536372215">Ezin izango dituzu Google kontuak gehitu Google API gakoak falta direlako. Ikus <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> xehetasunetarako.</translation>
	<translation id="1198491307547164157">Ezin izango dituzu JemaOS kontuak gehitu JemaOS API gakoak falta direlako. Ikus <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> xehetasunetarako.</translation>
	<translation id="5042404702659901995">Pribatutasun-adierazpena</translation>
	<translation id="4907736162587268100">Pribatutasun-adierazpenaren edukia</translation>
	<translation id="5988344732274877691">Eman izena JemaOSen (oso gutxitan, agindutakoa) buletinarako</translation>
	<translation id="1706203008474708805">Sartu JemaOS erabiltzaileen esperientzia hobetzeko planarekin</translation>
	<translation id="1147139514756087229">Hasi saioa tokiko kontu batekin</translation>
	<translation id="2054784944085654098">Babeskopia fitxategia sortzen orain. Horrek denbora pixka bat behar du; mesedez itxaron...</translation>
	<translation id="3554401467586751874">Babeskopia fitxategia behar bezala sortu da</translation>
	<translation id="2349211327705667074">Ikusi babeskopia fitxategia</translation>
	<translation id="6337433855796857931">Babeskopia egiteak huts egin du</translation>
	<translation id="3049367131589710124">Ikusi erroreen erregistroa</translation>
	<translation id="1079017345574916945">Urruneko mahaigaina</translation>
	<translation id="3064478898280877715">Aplikazio denda</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Instalatzailea</translation>
	<translation id="2173278076276376488">Utilitate honek <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> gailu honen barneko biltegian instalatzen lagunduko dizu.</translation>
	<translation id="5323182426977498659">Kontuz! Prozedura hau suntsitzailea da eta ezin da desegin. Kontuan izan ez dugula inolako erantzukizunik izango zure datu-galeren balizko erantzukizunik, ezta premiazko laguntza teknikorik emango, zure ardurapean jarraitu.</translation>
	<translation id="8517836015601969896">Disko osoa instalatzea</translation>
	<translation id="7300045760790370189">Instalatu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> disko gogor osoa okupatzeko, helburuko disko gogorreko datu guztiak ezabatu egingo dira.</translation>
	<translation id="8762511733918256595">Abio anitzeko instalazioa</translation>
	<translation id="248900698427753678">Instalatu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> lehendik dagoen disko gogor baten partizio batean, non <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> beste OS batzuekin paraleloan egon daitekeen. Xede partizioaren datu guztiak ezabatu egingo dira.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> hautatutako disko gogorrean instalatuko da; xede diskoko datu guztiak ezabatu egingo dira.</translation>
	<translation id="4039091757234555415">Diskoa</translation>
	<translation id="7783580523889684697">Ez dago diskorik erabilgarri</translation>
	<translation id="8217653566575018388">Instalazioa amaitu da</translation>
	<translation id="8846746259444262774">Instalazioak huts egin du</translation>
	<translation id="7263815009235541549">Instalazioa behar bezala amaitu da. Mesedez, itzali gailua lehenik, kendu instalazioko euskarri guztiak eta piztu berriro <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> abiarazteko.</translation>
	<translation id="3380151284134965398">Zerbait gaizki joan da eta instalazioa ez da amaitu. Saiatu berriro prozesua. Errore berdinak jarraitzen badu, jarri harremanetan JemaOS laguntza-zerbitzuarekin goiko erregistroarekin.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> zure disko gogorreko hautatutako partizioan instalatuko da. Egungo abiarazte anitzeko eskemaren arabera, zure gailuak UEFI onartzen badu eta zure disko gogorrak GPT-rekin formateatzen baditu bakarrik aurrera egin liteke.</translation>
	<translation id="7831363758161884243">Helburu-partizioa ezabatu egingo da; zure EFI partizio aktiboa ere zehaztu behar duzu (normalean automatikoki egiten da) Instalatzaileak sistemaren abio-konfigurazioak aldatu behar dituelako.</translation>
	<translation id="5670799238446305550">Hautatu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> helburu-partizioa</translation>
	<translation id="3695537760133394753">Zatiketa</translation>
	<translation id="5610519566593708119">Hautatu EFI partizioa</translation>
	<translation id="3367650349940010965">Ez dago partiziorik erabilgarri hautatutako diskorako</translation>
	<translation id="7453223384507098390">Ez dago EFI partiziorik aukeratutako diskorako</translation>
	<translation id="1854532683465500847">Hautatutako partizioaren tamaina 20 GB baino txikiagoa da, instalazioak huts egin dezake</translation>
	<translation id="4144613075340468247">Hautatutako partizioa <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> abiarazte anitzeko batera muntatu da; baliteke bertan instalatzea huts egitea</translation>
	<translation id="5793361052649920836">Instalatu ondoren, nola abiarazi nahi zenuke <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instalatu eta konfiguratu rEFInd niretzat (gomendatua)</translation>
	<translation id="1858708492548921044">rEFInd abio kudeatzaile programa bat da, zure ordenagailua abiaraztean OS abiarazteko aukerak egiteko interfaze grafiko polita eskaintzen duena, nahi duzun sistema eragilea aukeratu ahal izango duzu berarekin abiarazteko. rEFInd-i buruzko informazio gehiago lortzeko, begiratu bere hasierako orrialdera.</translation>
	<translation id="3861924051442564602">Gehitu UEFI abioko menuko aukera bat niretzat</translation>
	<translation id="8622370666798589804">Zure ordenagailua abiarazten denean UEFI abiarazte-aukeren menuan sartu ahal izango zara (seguruenik laster-tekla bat sakatuz), aukera honek <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> gehitzen du menu horren sarrera gisa. (BIOS eta UEFI firmware eredu batzuk bakarrik onartzen ditu).</translation>
	<translation id="1569398690544416170">Ez egin ezer hemen, nik neuk konfiguratuko dut</translation>
	<translation id="3554866444001249532">Instalazio-script honek <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> zure EFI partizioan abiarazteko beharrezko .efi fitxategiak bakarrik jarriko ditu, zuk zeuk konfiguratu beharko duzu nola abiarazteko.</translation>
	<translation id="7492832751164189534">Behartu irten</translation>
	<translation id="5159534860632584026">Instalazio-prozesua amaitu da</translation>
	<translation id="8686749782014838344">Ezin izan da diskoaren informazioa eskuratu</translation>
	<translation id="5688543378771259173">Instalazioa amaitzen ari da...</translation>
	<translation id="5350452134936384991">Instalatu USB batean</translation>
	<translation id="8008470485414925603">Instalatu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> USB disko batean; Helburuko USB diskoko datu guztiak ezabatu egingo dira.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> hautatutako USB diskoan instalatuko da; xede diskoko datu guztiak ezabatu egingo dira.</translation>
	<translation id="5725593226060700263">Ez dago USB diskorik erabilgarri</translation>
	<translation id="4357040841587078287">JemaOS-en kopia hau deskargatutako irudi-fitxategi batetik exekutatzen ari zarela detektatu dugu. JemaOSek eskain ditzakeen laguntza-funtziorik zabalenak (Aire bidezko eguneraketak barne) erabiltzeko, gomendatzen dizugu "Instalatzailea" funtzioa abiarazteko JemaOS disko osoko instalazioa biltegiratze-gailu bereizi batean egiteko.</translation>
	<translation id="1246398339704431302"><ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>JemaOS-en kopia hau erabiltzen jarraitu dezakezu, dena den<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, instalazio-prozesua sisteman geroago exekutatu daiteke, hala ere, zure datu guztiak berriro ezabatu egingo dira instalatu ondoren eta orri honetatik hasiko zara.</translation>
	<translation id="3654532222088291133">Saioa hasteko JemaOS kontuaren pasahitza sartu beharrean, <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> pasahitza sor dezakezu gailu honetarako</translation>
	<translation id="8377684629839541977">Erabili JemaOS kontuaren pasahitza</translation>

