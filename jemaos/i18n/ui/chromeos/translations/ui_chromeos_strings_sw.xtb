<!-- jemaos_menus -->
<translation id="6011650404329072318">JemaOS × Nutstore</translation>
<translation id="7292499970804736756">Jisajili Nutstore ili kusawazisha faili zako kwenye wingu katika JemaOS.</translation>
<translation id="8672291834743661083">Jisajili Nutstore</translation>
<translation id="5103639294476249880">Bofya kitufe cha "Ongeza Programu" katika mipangilio ya Usalama</translation>
<translation id="8371020157576651120">Tengeneza na kunakili nenosiri lako la programu</translation>
<translation id="3855250998276979579">Fungua Programu ya Nutstore</translation>
<translation id="6565655783894300125">na uunganishe akaunti ya Nutstore na JemaOS kwa barua pepe na nenosiri lako la programu</translation>
<translation id="4208217820626259628">JemaDrop</translation>
<translation id="77997252117517973">Inakuja hivi karibuni</translation>
<translation id="4928968570611226525">Ili kuendelea na kitendo hiki utahitaji <ph name="BEGIN_LINK_ARC_APP" />&gt;kuamilisha mfumo mdogo wa Android<ph name="END_LINK_ARC_APP" /> kwenye kifaa chako cha JemaOS; pia kifaa chako cha JemaOS kinahitaji <ph name="BEGIN_LINK_HELP" />kuwashwa hadi Hali ya Mwendelezaji<ph name="END_LINK_HELP" />.</translation>
<translation id="7395250550107972941">Imeshindwa kupakia kando faili za .apk. Tafadhali hakikisha kuwa mfumo mdogo wa Android umeamilishwa na kuwa uko katika Hali ya Mwendelezaji ya JemaOS.</translation>
<translation id="5690820326685091783">Fungua kwa JemaOS AI</translation>
