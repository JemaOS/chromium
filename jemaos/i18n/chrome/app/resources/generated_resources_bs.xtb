<translation id="3850846286480935456">Analiza pohrane sigurnosnih kopija</translation>
<translation id="6244494465581273970">Potreban je ID korisnika</translation>
<translation id="9204006549413740506">Zadnje ažuriranje</translation>
<translation id="476642412165431515">Hardverski uređaji</translation>
<translation id="3386337985825120901">Nema dostupnih podataka sigurnosne kopije</translation>
<translation id="8490990067870590760">Učitavanje datoteka sigurnosnih kopija...</translation>
<translation id="2955409026764742995">Odaberite datoteku sigurnosne kopije za vraćanje:</translation>
<translation id="7414629348005657242">-- Odaberite datoteku sigurnosne kopije --</translation>
<translation id="918246516374174381">Nije pronađena nijedna datoteka sigurnosne kopije. Prvo napravite sigurnosnu kopiju.</translation>
