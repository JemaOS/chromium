<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ky">
	<translation id="7386402409475121504">Жергиликтүү JemaOS каттоо эсебиңизди түзүңүз</translation>
	<translation id="3760308806144055927">Жергиликтүү JemaOS каттоо эсебиңизге кириңиз</translation>
	<translation id="3325117507482096812">Сураныч, сырсөз киргизиңиз</translation>
	<translation id="1838206877831947154">Сырсөздөрүңүз дал келбейт</translation>
	<translation id="2158276988029582286">Жаңы жергиликтүү каттоо эсебин түзүү</translation>
	<translation id="8592849747346274067">Учурдагы каттоо эсебине кириңиз</translation>
	<translation id="482190417986201746">Сиз киргизген колдонуучу аты же сырсөз туура эмес</translation>
	<translation id="6603987686259425085">Сиз <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS жергиликтүү каттоо эсеби менен кире аласыз<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759"><ph name="EMAIL_ADDRESS">$1</ph> электрондук почтасы мурунтан эле бар. Сураныч, башка электрондук почта менен кайталап көрүңүз.</translation>
	<translation id="7215016743510876720">Жергиликтүү каттоо эсебин колдонуңуз</translation>
	<translation id="6657635042185516718">Онлайн каттоо эсебин колдонууну улантыңыз</translation>
	<translation id="6867476688065565618">Жергиликтүү каттоо эсебине которуласызбы?</translation>
	<translation id="4840454774882557974">Эгер сиз жергиликтүү каттоо эсебин колдонууну тандасаңыз, пайдалуу функцияларга дайындарыңызды жана тандоолоруңузду бир нече түзмөктөрдө синхрондоштуруу кирет жана JemaOS каттоо эсебиңиз аркылуу веб колдонмолоруна автоматтык түрдө кирүү иштебейт.</translation>
	<translation id="8951507920859729424">Биз JemaOSту толук пайдалануу үчүн онлайн каттоо эсебин колдонууну сунуштайбыз.</translation>
	<translation id="479773200536372215">Google API ачкычтары жок болгондуктан, Google аккаунттарын кошо албайсыз. Чоо-жайы үчүн <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> караңыз.</translation>
	<translation id="1198491307547164157">JemaOS API ачкычтары жок болгондуктан, сиз JemaOS каттоо эсептерин кошо албайсыз. Чоо-жайы үчүн <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> караңыз.</translation>
	<translation id="5042404702659901995">Купуялык билдирүүсү</translation>
	<translation id="4907736162587268100">Купуялык билдирүүнүн мазмуну</translation>
	<translation id="5988344732274877691">JemaOS үчүн (өтө сейрек, убадаланган) маалымат бюллетенине катталыңыз</translation>
	<translation id="1706203008474708805">JemaOS колдонуучу тажрыйбасын жакшыртуу планына кошулуңуз</translation>
	<translation id="1147139514756087229">Жергиликтүү каттоо эсеби менен кириңиз</translation>
	<translation id="2054784944085654098">Азыр камдык файл түзүлүүдө. Бул бир аз убакыт талап кылынышы мүмкүн; күтө туруңуз…</translation>
	<translation id="3554401467586751874">Камдык файл ийгиликтүү түзүлдү</translation>
	<translation id="2349211327705667074">Камдык файлды көрүү</translation>
	<translation id="6337433855796857931">Камдык көчүрмө сакталган жок</translation>
	<translation id="3049367131589710124">Ката журналын көрүү</translation>
	<translation id="1079017345574916945">Алыскы иш такта</translation>
	<translation id="3064478898280877715">Колдонмо дүкөнү</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Орнотуучу</translation>
	<translation id="2173278076276376488">Бул утилита сизге <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ти ушул түзмөктүн ички сактагычына орнотууга жардам берет.</translation>
	<translation id="5323182426977498659">Эскертүү! Бул процедура кыйратуучу жана аны артка кайтарууга болбойт. Сураныч, биз сиздин потенциалдуу маалыматыңыздын жоголушу үчүн эч кандай жоопкерчилик тартпай турганыбызды жана шашылыш техникалык колдоо көрсөтпөй турганыбызды эске алыңыз, өзүңүздүн тобокелиңизге баш багыңыз.</translation>
	<translation id="8517836015601969896">Толук диск орнотуу</translation>
	<translation id="7300045760790370189">Толук катуу дискти ээлөө үчүн <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> орнотуңуз, максаттуу катуу дисктин бардык маалыматтары өчүрүлөт.</translation>
	<translation id="8762511733918256595">Көп жүктөөлүү орнотуу</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ди катуу дисктин учурдагы бөлүгүнө орнотуңуз, мында <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> башка ОС менен параллелдүү болушу мүмкүн. Максаттуу бөлүмдөгү бардык маалыматтар жок кылынат.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> тандалган катуу дискиңизге орнотулат; максаттуу дисктеги бардык маалыматтар жок кылынат.</translation>
	<translation id="4039091757234555415">Диск</translation>
	<translation id="7783580523889684697">Жеткиликтүү диск жок</translation>
	<translation id="8217653566575018388">Орнотуу аяктады</translation>
	<translation id="8846746259444262774">Орнотуу ишке ашкан жок</translation>
	<translation id="7263815009235541549">Орнотуу ийгиликтүү аяктады. <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> жүктөө үчүн алгач түзмөгүңүздү өчүрүп, андан соң бардык орнотуу медиасын алып салыңыз жана аны кайра күйгүзүңүз.</translation>
	<translation id="3380151284134965398">Ой, бир жерден ката кетип, орнотуу аягына чыккан жок. Сураныч, процессти кайталап көрүңүз. Эгер ошол эле ката кайталана берсе, жогорудагы журнал менен JemaOS колдоо бөлүмүнө кайрылыңыз.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> катуу дискиңиздин тандалган бөлүгүнө орнотулат. Учурдагы көп жүктөө схемасы боюнча, бул сиздин түзмөгүңүз UEFI колдосо жана катуу дисктериңиз GPT менен форматталганда гана улана алат.</translation>
	<translation id="7831363758161884243">Максаттуу бөлүм тазаланат; Сиз ошондой эле активдүү EFI бөлүмүңүздү көрсөтүшүңүз керек (көбүнчө автоматтык түрдө аткарылат), анткени Орнотуучу системанын жүктөө конфигурацияларын өзгөртүүгө муктаж.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> максаттуу бөлүмүн тандаңыз</translation>
	<translation id="3695537760133394753">Бөлүм</translation>
	<translation id="5610519566593708119">EFI бөлүмүн тандаңыз</translation>
	<translation id="3367650349940010965">Тандалган диск үчүн бөлүктөр жок</translation>
	<translation id="7453223384507098390">Тандалган диск үчүн EFI бөлүмдөрү жок</translation>
	<translation id="1854532683465500847">Тандалган бөлүмдүн көлөмү 20 ГБдан аз, орнотуу ишке ашпай калышы мүмкүн</translation>
	<translation id="4144613075340468247">Тандалган бөлүм <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> көп жүктөөчүгө орнотулду, ага кайра орнотулбай калышы мүмкүн</translation>
	<translation id="5793361052649920836">Орнотулгандан кийин, <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> кантип жүктөөнү каалайт элеңиз?</translation>
	<translation id="4273235330352963866">Мен үчүн rEFInd орнотуу жана конфигурациялоо (сунушталат)</translation>
	<translation id="1858708492548921044">rEFInd – бул жүктөө менеджери программасы, ал сиздин компьютериңиз ишке киргенде OS жүктөө параметрлери үчүн жагымдуу графикалык интерфейсти сунуштайт, сиз аны менен жүктөө үчүн каалаган ОСти тандай аласыз. rEFInd жөнүндө көбүрөөк маалымат алуу үчүн, анын башкы бетине кайрылыңыз.</translation>
	<translation id="3861924051442564602">Мен үчүн UEFI жүктөө менюсун кошуңуз</translation>
	<translation id="8622370666798589804">Компьютериңиз ишке киргенде, сиз UEFI жүктөө параметрлери менюсуна кире аласыз (кыязы, тез баскычты басуу менен), бул опция ошол менюга кирүү катары <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> кошот. (BIOS жана UEFI микропрограммасынын кээ бир моделдерин гана колдойт).</translation>
	<translation id="1569398690544416170">Бул жерде эч нерсе кылбаңыз, мен аны өзүм конфигурациялайм</translation>
	<translation id="3554866444001249532">Бул орнотуу скрипти сиздин EFI бөлүмүңүзгө <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> жүктөө үчүн керектүү .efi файлдарын гана коёт, сиз аны өзүңүз кантип жүктөө керектигин конфигурациялашыңыз керек болот.</translation>
	<translation id="7492832751164189534">Мажбурлоо</translation>
	<translation id="5159534860632584026">Орнотуу процесси токтотулду</translation>
	<translation id="8686749782014838344">Диск маалыматы алынбай калды</translation>
	<translation id="5688543378771259173">Орнотуу токтотулууда...</translation>
	<translation id="5350452134936384991">USBге орнотуу</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ди USB дискке орнотуңуз; максаттуу USB дисктеги бардык маалыматтар жок кылынат.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> тандалган USB дискиңизге орнотулат; максаттуу дисктеги бардык маалыматтар жок кылынат.</translation>
	<translation id="5725593226060700263">USB диск жок</translation>
	<translation id="4357040841587078287">Жүктөлүп алынган сүрөт файлынан JemaOSтун бул көчүрмөсүн иштетип жатканыңызды аныктадык. JemaOS сунуш кыла ала турган эң комплекстүү колдоо функцияларын (анын ичинде Over-The-Air жаңыртууларын) колдонуу үчүн, JemaOSту өзүнчө сактагыч түзмөгүнө толук диск орнотууну ишке ашыруу үчүн "Орнотуу" функциясын ишке киргизүүнү катуу сунуштайбыз.</translation>
	<translation id="1246398339704431302">Сиз <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>баары бир JemaOSтун бул көчүрмөсүн колдонууну уланта аласыз<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, орнотуу процесси системанын кийинки баскычында аткарылышы мүмкүн, бирок орнотуудан кийин бардык маалыматтарыңыз өчүрүлөт.</translation>
	<translation id="3654532222088291133">Кирүү үчүн JemaOS каттоо эсебиңиздин сырсөзүн киргизүүнүн ордуна, бул түзмөк үчүн <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> сырсөзүн түзө аласыз</translation>
	<translation id="8377684629839541977">JemaOS каттоо эсебинин сырсөзүн колдонуңуз</translation>

