<translation id="6583780301401541007">Obnovení bylo úspěšné</translation>
<translation id="3514011352559420398">Obnovení se nezdařilo</translation>
<translation id="7535980903266533458">Uložit zálohu do zařízení nebo na externí úložiště</translation>
