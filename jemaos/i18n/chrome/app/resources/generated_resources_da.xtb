<translationbundle lang="da">
	<translation id="7386402409475121504">Opret din lokale JemaOS-konto</translation>
	<translation id="3760308806144055927">Log på din lokale JemaOS-konto</translation>
	<translation id="3325117507482096812">Indtast venligst en adgangskode</translation>
	<translation id="1838206877831947154">Dine adgangskoder stemmer ikke overens</translation>
	<translation id="2158276988029582286">Opret en ny lokal konto</translation>
	<translation id="8592849747346274067">Log ind på en eksisterende konto</translation>
	<translation id="482190417986201746">Brugernavnet eller adgangskoden du indtastede er forkert</translation>
	<translation id="6603987686259425085">Du kan <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>logge ind med en JemaOS lokal konto<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-mailadressen <ph name="EMAIL_ADDRESS">$1</ph> findes allerede. Prøv venligst igen med en anden e-mail.</translation>
	<translation id="7215016743510876720">Brug lokal konto</translation>
	<translation id="6657635042185516718">Fortsæt med at bruge online-konto</translation>
	<translation id="6867476688065565618">Skift til lokal konto?</translation>
	<translation id="4840454774882557974">Hvis du vælger at bruge en lokal konto, omfatter nyttige funktioner synkronisering af dine data og præferencer på tværs af flere enheder og automatisk login på webapps ved hjælp af din JemaOS-konto, vil ikke fungere.</translation>
	<translation id="8951507920859729424">Vi anbefaler at bruge en onlinekonto for at udnytte JemaOS fuldt ud.</translation>
	<translation id="479773200536372215">Du vil ikke kunne tilføje Google-konti, fordi Google API-nøgler mangler. Se <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for detaljer.</translation>
	<translation id="1198491307547164157">Du vil ikke kunne tilføje JemaOS-konti, fordi JemaOS API-nøgler mangler. Se <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for detaljer.</translation>
	<translation id="5042404702659901995">Fortrolighedserklæring</translation>
	<translation id="4907736162587268100">Indhold i fortrolighedserklæringen</translation>
	<translation id="5988344732274877691">Tilmeld dig det (meget sjældne, lovede) nyhedsbrev for JemaOS</translation>
	<translation id="1706203008474708805">Tilmeld dig planen for forbedring af JemaOS brugeroplevelse</translation>
	<translation id="1147139514756087229">Log ind med en lokal konto</translation>
	<translation id="2054784944085654098">Opretter backup-fil nu. Dette kan tage et stykke tid; vent venligst...</translation>
	<translation id="3554401467586751874">Sikkerhedskopieringsfil blev oprettet</translation>
	<translation id="2349211327705667074">Se backup-fil</translation>
	<translation id="3049367131589710124">Se fejllog</translation>
	<translation id="1079017345574916945">Fjernskrivebord</translation>
	<translation id="3064478898280877715">App store</translation>
	<translation id="5890206344045530832">Installatør</translation>
	<translation id="2173278076276376488">Dette værktøj vil hjælpe dig med at installere <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> på det interne lager på denne enhed.</translation>
	<translation id="5323182426977498659">Advarsel! Denne procedure er destruktiv og kan ikke fortrydes. Bemærk venligst, at vi ikke vil holde noget ansvar for dit potentielle tab af data eller yde nogen presserende teknisk support, fortsæt på egen risiko.</translation>
	<translation id="8517836015601969896">Fuld diskinstallation</translation>
	<translation id="7300045760790370189">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> for at optage en hel harddisk, alle data på målharddisken slettes.</translation>
	<translation id="8762511733918256595">Multi-boot installation</translation>
	<translation id="248900698427753678">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> på en eksisterende partition på en harddisk, hvor <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kan eksistere parallelt med andre OS. Alle data på målpartitionen vil blive slettet.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil blive installeret på din valgte harddisk; alle data på måldisken vil blive slettet.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Ingen disk tilgængelig</translation>
	<translation id="8217653566575018388">Installation afsluttet</translation>
	<translation id="8846746259444262774">Installationen mislykkedes</translation>
	<translation id="7263815009235541549">Installationen er afsluttet. Sluk først din enhed, fjern derefter eventuelle installationsmedier, og tænd den igen for at starte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, noget er gået galt, og installationen blev ikke fuldført. Prøv venligst processen igen. Hvis den samme fejl fortsætter, bedes du kontakte JemaOS Support med ovenstående log.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil blive installeret på den valgte partition på din harddisk. Under det nuværende multi-boot-skema kunne dette kun fortsætte, hvis din enhed understøtter UEFI, og dine harddiske er formateret med GPT.</translation>
	<translation id="7831363758161884243">Målpartitionen slettes; du skal også angive din aktive EFI-partition (normalt gøres automatisk), da installationsprogrammet skal ændre systemstartkonfigurationer.</translation>
	<translation id="5670799238446305550">Vælg <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> målpartition</translation>
	<translation id="3695537760133394753">Skillevæg</translation>
	<translation id="5610519566593708119">Vælg EFI-partition</translation>
	<translation id="3367650349940010965">Der er ingen partitioner tilgængelige for den valgte disk</translation>
	<translation id="7453223384507098390">Der er ingen EFI-partitioner tilgængelige for den valgte disk</translation>
	<translation id="1854532683465500847">Størrelsen på den valgte partition er mindre end 20 GB, installationen kan mislykkes</translation>
	<translation id="4144613075340468247">Den valgte partition er blevet monteret til <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, installation på den igen kan mislykkes</translation>
	<translation id="5793361052649920836">Efter installationen, hvordan vil du starte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Installer og konfigurer rEFInd for mig (anbefales)</translation>
	<translation id="1858708492548921044">rEFInd er et boot manager program, der tilbyder en flot grafisk grænseflade til OS boot muligheder, når din pc starter op, vil du være i stand til at vælge dit ønskede OS at starte med det. For mere information om rEFInd, se venligst dens hjemmeside.</translation>
	<translation id="3861924051442564602">Tilføj en UEFI boot menu mulighed for mig</translation>
	<translation id="8622370666798589804">Når din pc starter op, kan du muligvis gå ind i UEFI-startindstillingersmenuen (sandsynligvis ved at trykke på en genvejstast), denne mulighed tilføjer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> som en indgang til denne menu. (Understøtter kun nogle modeller af BIOS og UEFI-firmware).</translation>
	<translation id="1569398690544416170">Gør intet her, jeg konfigurerer det selv</translation>
	<translation id="3554866444001249532">Dette installationsscript vil kun lægge nødvendige .efi-filer til opstart af <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> til din EFI-partition, du skal selv konfigurere, hvordan du starter den op.</translation>
	<translation id="7492832751164189534">Tvinge op</translation>
	<translation id="5159534860632584026">Installationsprocessen er blevet afsluttet</translation>
	<translation id="8686749782014838344">Det lykkedes ikke at hente diskoplysninger</translation>
	<translation id="5688543378771259173">Installationen er ved at blive afsluttet...</translation>
	<translation id="5350452134936384991">Installer i USB</translation>
	<translation id="8008470485414925603">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> på en USB-disk; alle data på mål-USB-disken slettes.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil blive installeret på din valgte USB-disk; alle data på måldisken vil blive slettet.</translation>
	<translation id="5725593226060700263">Ingen USB-disk tilgængelig</translation>
	<translation id="4357040841587078287">Vi har opdaget, at du kører denne kopi af JemaOS fra en downloadet billedfil. For at bruge de mest omfattende supportfunktioner (inklusive Over-The-Air-opdateringer), som JemaOS kan tilbyde, anbefaler vi kraftigt, at du starter funktionen "Installer" for at udføre en fuld-diskinstallation af JemaOS på en separat lagerenhed.</translation>
	<translation id="1246398339704431302">Du kan <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>fortsætte med at bruge denne kopi af JemaOS alligevel<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, installationsprocessen kan udføres på et senere tidspunkt i systemet, dog vil alle dine data blive slettet fra denne side, og du vil begynde igen efter installationen.</translation>
	<translation id="3654532222088291133">I stedet for at indtaste adgangskoden til din JemaOS-konto for at logge ind, kan du oprette en <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph>-adgangskode til denne enhed</translation>
	<translation id="8377684629839541977">Brug adgangskoden til JemaOS-kontoen</translation>

