<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="cy">
	<translation id="7386402409475121504">Creu eich cyfrif JemaOS lleol</translation>
	<translation id="3760308806144055927">Mewngofnodwch yn eich cyfrif JemaOS lleol</translation>
	<translation id="3325117507482096812">Rhowch gyfrinair</translation>
	<translation id="1838206877831947154">Nid yw eich cyfrineiriau yn cyfateb</translation>
	<translation id="2158276988029582286">Creu cyfrif lleol newydd</translation>
	<translation id="8592849747346274067">Mewngofnodwch i gyfrif sy'n bodoli eisoes</translation>
	<translation id="482190417986201746">Mae'r enw defnyddiwr neu gyfrinair a roesoch yn anghywir</translation>
	<translation id="6603987686259425085">Gallwch <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph> fewngofnodi gyda chyfrif lleol JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Mae e-bost <ph name="EMAIL_ADDRESS">$1</ph> eisoes yn bodoli. Rhowch gynnig arall arni gydag e-bost arall.</translation>
	<translation id="7215016743510876720">Defnyddio cyfrif lleol</translation>
	<translation id="6657635042185516718">Parhau i ddefnyddio cyfrif ar-lein</translation>
	<translation id="6867476688065565618">Newid i gyfrif lleol?</translation>
	<translation id="4840454774882557974">Os dewiswch ddefnyddio cyfrif lleol, mae nodweddion defnyddiol yn cynnwys cysoni'ch data a'ch dewisiadau ar draws dyfeisiau lluosog ac ni fydd llofnodi apiau gwe yn awtomatig gan ddefnyddio'ch cyfrif JemaOS yn gweithio.</translation>
	<translation id="8951507920859729424">Rydym yn argymell defnyddio cyfrif ar-lein i ddefnyddio JemaOS i'r eithaf.</translation>
	<translation id="479773200536372215">Ni fyddwch yn gallu ychwanegu cyfrifon Google oherwydd bod allweddi API Google ar goll. Gweler <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> am fanylion.</translation>
	<translation id="1198491307547164157">Ni fyddwch yn gallu ychwanegu cyfrifon JemaOS oherwydd bod allweddi API JemaOS ar goll. Gweler <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> am fanylion.</translation>
	<translation id="5042404702659901995">Datganiad preifatrwydd</translation>
	<translation id="4907736162587268100">Cynnwys datganiad preifatrwydd</translation>
	<translation id="5988344732274877691">Cofrestrwch ar gyfer y cylchlythyr (anaml iawn, wedi'i addo) ar gyfer JemaOS</translation>
	<translation id="1706203008474708805">Ymunwch â chynllun gwella profiad defnyddiwr JemaOS</translation>
	<translation id="1147139514756087229">Mewngofnodwch gyda chyfrif lleol</translation>
	<translation id="2054784944085654098">Creu ffeil wrth gefn nawr. Gall hyn gymryd peth amser; arhoswch os gwelwch yn dda…</translation>
	<translation id="3554401467586751874">Crëwyd ffeil wrth gefn yn llwyddiannus</translation>
	<translation id="2349211327705667074">Gweld ffeil wrth gefn</translation>
	<translation id="6337433855796857931">Wedi methu gwneud copi wrth gefn</translation>
	<translation id="3049367131589710124">Gweld log gwall</translation>
	<translation id="1079017345574916945">Bwrdd gwaith o bell</translation>
	<translation id="3064478898280877715">Siop app</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Gosodwr</translation>
	<translation id="2173278076276376488">Bydd y cyfleuster hwn yn eich helpu i osod <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ar storfa fewnol y ddyfais hon.</translation>
	<translation id="5323182426977498659">Rhybudd! Mae'r weithdrefn hon yn ddinistriol ac ni ellir ei dadwneud. Sylwch na fyddwn yn dal unrhyw gyfrifoldeb am eich colled data posibl nac yn darparu unrhyw gymorth technegol brys, symud ymlaen ar eich menter eich hun.</translation>
	<translation id="8517836015601969896">Gosod disg llawn</translation>
	<translation id="7300045760790370189">Gosod <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> i feddiannu disg galed gyfan, bydd holl ddata'r ddisg galed darged yn cael ei sychu.</translation>
	<translation id="8762511733918256595">Gosodiad aml-gist</translation>
	<translation id="248900698427753678">Gosod <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> i raniad presennol o ddisg galed, lle gall <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> fodoli ochr yn ochr ag OS arall. Bydd yr holl ddata ar y rhaniad targed yn cael ei sychu.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">Bydd $1 <ex>JemaOS</ex></ph> yn cael ei osod ar eich gyriant caled dewisol; bydd yr holl ddata ar y ddisg darged yn cael ei sychu.</translation>
	<translation id="4039091757234555415">Disg</translation>
	<translation id="7783580523889684697">Dim disg ar gael</translation>
	<translation id="8217653566575018388">Gosod wedi'i gwblhau</translation>
	<translation id="8846746259444262774">Methodd y gosodiad</translation>
	<translation id="7263815009235541549">Mae'r gosodiad wedi gorffen yn llwyddiannus. Pwerwch eich dyfais i ffwrdd yn gyntaf, yna tynnwch unrhyw gyfrwng gosod, a phwerwch ef ymlaen eto i gychwyn <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Wps, mae rhywbeth wedi mynd o'i le ac ni chwblhawyd y gosodiad. Rhowch gynnig arall ar y broses. Os yw'r un gwall yn parhau, cysylltwch â Chymorth JemaOS gyda'r log uchod.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS"> Bydd $1 <ex>JemaOS</ex></ph> yn cael ei osod ar y rhaniad dewisiedig o'ch gyriant caled. O dan y cynllun aml-gist presennol, dim ond os yw'ch dyfais yn cefnogi UEFI a bod eich disgiau caled wedi'u fformatio â GPT y gallai hyn fynd ymlaen.</translation>
	<translation id="7831363758161884243">Bydd y rhaniad targed yn cael ei sychu; mae angen i chi hefyd nodi eich rhaniad EFI gweithredol (a wneir yn awtomatig fel arfer) gan fod angen i'r Gosodwr addasu ffurfweddiadau cychwyn y system.</translation>
	<translation id="5670799238446305550">Dewiswch <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> rhaniad targed</translation>
	<translation id="3695537760133394753">Rhaniad</translation>
	<translation id="5610519566593708119">Dewiswch rhaniad EFI</translation>
	<translation id="3367650349940010965">Nid oes unrhyw raniadau ar gael ar gyfer y ddisg a ddewiswyd</translation>
	<translation id="7453223384507098390">Nid oes unrhyw raniadau EFI ar gael ar gyfer y ddisg a ddewiswyd</translation>
	<translation id="1854532683465500847">Mae maint y rhaniad a ddewiswyd yn llai na 20GB, efallai y bydd y gosodiad yn methu</translation>
	<translation id="4144613075340468247">Mae'r rhaniad dewisiedig wedi ei osod i <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, efallai y bydd gosod iddo eto yn methu</translation>
	<translation id="5793361052649920836">Ar ôl gosod, sut hoffech chi gychwyn <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Gosod a ffurfweddu reEFInd i mi (argymhellir)</translation>
	<translation id="1858708492548921044">Mae rEFInd yn rhaglen rheolwr cist sy'n cynnig rhyngwyneb graffigol braf ar gyfer opsiynau cychwyn OS pan fydd eich cyfrifiadur personol yn cychwyn, byddwch yn gallu dewis eich OS dymunol i gychwyn ag ef. I gael rhagor o wybodaeth am REFInd, cyfeiriwch at ei hafan.</translation>
	<translation id="3861924051442564602">Ychwanegu opsiwn dewislen cychwyn UEFI i mi</translation>
	<translation id="8622370666798589804">Pan fydd eich PC yn cychwyn efallai y byddwch yn gallu mynd i mewn i ddewislen opsiynau cychwyn UEFI (trwy wasgu bysell boeth yn ôl pob tebyg), mae'r opsiwn hwn yn ychwanegu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> fel cofnod i'r ddewislen honno. (Dim ond yn cefnogi rhai modelau o firmware BIOS a UEFI).</translation>
	<translation id="1569398690544416170">Gwneud dim byd yma, byddaf yn ei ffurfweddu fy hun</translation>
	<translation id="3554866444001249532">Bydd y sgript gosod hon ond yn rhoi'r ffeiliau .efi angenrheidiol ar gyfer cychwyn <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> i'ch rhaniad EFI, bydd angen i chi ffurfweddu sut i'w gychwyn eich hun.</translation>
	<translation id="7492832751164189534">Gorfod rhoi'r gorau iddi</translation>
	<translation id="5159534860632584026">Mae'r broses osod wedi'i therfynu</translation>
	<translation id="8686749782014838344">Wedi methu cael gwybodaeth disg</translation>
	<translation id="5688543378771259173">Mae'r gosodiad yn cael ei derfynu...</translation>
	<translation id="5350452134936384991">Gosod yn USB</translation>
	<translation id="8008470485414925603">Gosod <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ar ddisg USB; bydd yr holl ddata ar y ddisg USB targed yn cael ei sychu.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS"> Bydd $1 <ex>JemaOS</ex></ph> yn cael ei osod ar y ddisg USB a ddewiswyd gennych; bydd yr holl ddata ar y ddisg darged yn cael ei sychu.</translation>
	<translation id="5725593226060700263">Dim disg USB ar gael</translation>
	<translation id="4357040841587078287">Rydym wedi canfod eich bod yn rhedeg y copi hwn o JemaOS o ffeil delwedd wedi'i lawrlwytho. Er mwyn defnyddio'r nodweddion cymorth mwyaf cynhwysfawr (gan gynnwys diweddariadau Over-The-Air) y gall JemaOS eu cynnig, rydym yn argymell yn gryf eich bod yn lansio'r swyddogaeth "Installer" i berfformio gosodiad disg llawn o JemaOS ar ddyfais storio ar wahân.</translation>
	<translation id="1246398339704431302">Gallwch <ph name="LINK_BEGIN">&amp;lt;span id="parhau-beth bynnag"&amp;gt;</ph> barhau i ddefnyddio'r copi hwn o JemaOS beth bynnag <ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, gall y broses osod gael ei gweithredu yn ddiweddarach yn y system, fodd bynnag, bydd eich holl ddata yn cael ei sychu ar ôl gosod a byddwch yn dechrau eto o'r gosodiad hwn.</translation>
	<translation id="3654532222088291133">Yn lle rhoi cyfrinair eich cyfrif JemaOS i fewngofnodi, gallwch greu cyfrinair <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> ar gyfer y ddyfais hon</translation>
	<translation id="8377684629839541977">Defnyddiwch gyfrinair cyfrif JemaOS</translation>

