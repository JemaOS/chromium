<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot பற்றி</translation>
<translation id="5639860668557220477">Thot உலாவியில் உதவி பெறவும்</translation>
<translation id="1692689520561928457">JemaOS பற்றி</translation>
<translation id="8692765844418174375">JemaOS பதிப்பு</translation>
<translation id="2943260250558374955">JemaOS இல் உதவி பெறவும்</translation>
<translation id="713321354492170993">உலாவி செயலற்ற தாவல்களிலிருந்து நினைவகத்தை விடுவிக்கிறது. இது செயலில் உள்ள தாவல்களுக்கும் பிற பயன்பாடுகளுக்கும் அதிக கணினி வளங்களை அளித்து உலாவியை வேகமாக வைத்திருக்கிறது. நீங்கள் செயலற்ற தாவல்களுக்குத் திரும்பும்போது அவை தானாகவே மீண்டும் செயல்படும்.</translation>
<translation id="1774190491044887444">உலாவி பின்னணி நடவடிக்கை மற்றும் சுமூக்கமான உருட்டல், வீடியோ ஃப்ரேம் விகிதங்கள் போன்ற காட்சி விளைவுகளைக் கட்டுப்படுத்தி பேட்டரியைச் சேமிக்கிறது.</translation>
<translation id="180121268008059459">உலாவி பக்கங்களை முன்கூட்டியே ஏற்றுகிறது, இதனால் உலாவுதலும் தேடுதலும் வேகமாகிறது.</translation>
<translation id="7127093527178692287">காப்புப்பிரதியை மீட்டெடுக்கவும் (பீட்டா)</translation>
<translation id="4439042171549201806">காப்புப்பிரதி கோப்பிலிருந்து JemaOS ஐ மீட்டெடுக்க, காப்புப்பிரதி கோப்பு உள்ள நீக்கக்கூடிய டிரைவை இப்போது உங்கள் JemaOS சாதனத்தில் செருகி, எந்த காப்புப்பிரதி கோப்பை மீட்டெடுக்க விரும்புகிறீர்கள் என்பதைக் குறிப்பிடவும். இந்த விசார்டால் கண்டறியப்பட உங்கள் காப்புப்பிரதி கோப்பு நீக்கக்கூடிய டிரைவின் ரூட் கோப்பகத்தில் இருக்க வேண்டும் என்பதை நினைவில் கொள்ளவும்.</translation>
<translation id="2955409026764742995">மீட்டெடுக்க காப்புப்பிரதி கோப்பைத் தேர்ந்தெடுக்கவும்:</translation>
<translation id="7040434808685140085">மன்னிக்கவும், தேர்ந்தெடுக்கப்பட்ட காப்புப்பிரதி கோப்பை அடையாளம் காண முடியவில்லை; புதிய ஒன்றைத் தேர்ந்தெடுக்கவும்.</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />தேர்ந்தெடுக்கப்பட்ட காப்புப்பிரதி கோப்பிலிருந்து JemaOS ஐ மீட்டெடுக்க, காப்புப்பிரதி உருவாக்கப்பட்டபோது அது பற்றிய துல்லியமான தகவல் இருப்பது அவசியம். இல்லையெனில், மீட்டெடுப்பு செயல்முறை தோல்வியடையும்.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"கணக்கு பெயர்" என்பது உங்கள் காப்புப்பிரதி கோப்பு உருவாக்கப்பட்ட கணக்கின் முதன்மை உள்நுழைவு சான்றாகும். இது பொதுவாக உங்கள் JemaOS/Google கணக்கில் பதிவு செய்யப் பயன்படுத்திய மின்னஞ்சல் முகவரியாகும். அது உள்ளூர் கணக்காக இருந்தால், "@jemaos.local" உடன் இணைக்கப்பட்ட பயனர் பெயராக இருக்கும்.<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />கடவுச்சொல் என்பது காப்புப்பிரதி உருவாக்கப்பட்டபோது நீங்கள் உள்ளிடக் கேட்கப்பட்ட கடவுச்சொற்றொடராகும். இது பொதுவாக இந்தக் கணக்கிற்கு JemaOS டெஸ்க்டாப்பில் உள்நுழையப் பயன்படுத்திய அதே கடவுச்சொல்லாகும்.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">கணக்கு பெயர்</translation>
<translation id="5490570429039308155">மன்னிக்கவும், சரியான கணக்கு பெயரை உள்ளிடவும்</translation>
<translation id="6657585470893396449">கடவுச்சொல்</translation>
<translation id="8200189938001188563">மன்னிக்கவும், கடவுச்சொல் காலியாக இருக்க முடியாது</translation>
<translation id="3157931365184549694">மீட்டெடுக்கவும்</translation>
<translation id="8556278756526311953">காப்புப்பிரதி மீட்டெடுக்கப்படுகிறது</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />உங்கள் காப்புப்பிரதி கோப்பை மீட்டெடுக்கும் பணியை இப்போது மேற்கொண்டு வருகிறோம்; இதற்கு சிறிது நேரம் ஆகலாம், எனவே பொறுமையாக இருங்கள்.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />மீட்டெடுப்பு செயல்முறை வெற்றிகரமாக முடிந்ததும் UI தானாகவே மறுதொடங்கும் என்பதை நினைவில் கொள்ளவும்.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">காப்புப்பிரதி மீட்டெடுப்பு தோல்வியடைந்தது</translation>
<translation id="5003531399442003695">மேலும் விவரங்களுக்கு, பதிவுகளைக் காண கீழே உள்ள இணைப்பைக் கிளிக் செய்யவும். இந்தப் பிழை தொடர்ந்தால், JemaOS தொழில்நுட்ப ஆதரவு சேனல்களைத் தொடர்பு கொண்டு பிழைப் பதிவுகளை வழங்கவும்.</translation>
<translation id="6363786367719063276">பதிவுகளைக் காண்க</translation>
<translation id="8730621377337864115">முடிந்தது</translation>
<translation id="975238173507911396">தரவு மீட்டெடுப்பு வெற்றி</translation>
<translation id="6276879052695618521">காப்புப்பிரதி மீட்டெடுப்பு பதிவுகள்</translation>
<translation id="4901207598072637766">JemaOS, <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> மூலம் வழங்கப்படுகிறது</translation>
<translation id="7894910504474624324">JemaOS மற்றும் அதன் சேவைகள் GDPR மற்றும் ஐரோப்பிய தரவுப் பாதுகாப்புச் சட்டத்தின் விதிமுறைகளுக்கு இணங்குகின்றன. மேலும் தகவலுக்கு, எங்கள் <ph name="BEGIN_LINK_PRIVACY" />தனியுரிமைக் கொள்கை<ph name="END_LINK_PRIVACY" /> மற்றும் எங்கள் <ph name="BEGIN_LINK_TOS" />சேவை விதிமுறைகள்<ph name="END_LINK_TOS" /> ஐப் பார்க்கவும்.</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.</translation>
<translation id="370679569376308836">JemaOS என்பது Jema சாதனம் மற்றும் அதன் SaaS ஐ அடிப்படையாகக் கொண்ட வணிக வழங்கலாகும்.</translation>
<translation id="2773644194450163486">JemaOS <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> திறந்த மூல திட்டத்தால் சாத்தியமானது.</translation>
<translation id="2330680727776977160">Chromium மற்ற <ph name="BEGIN_LINK_1" />திறந்த மூல மென்பொருள்<ph name="END_LINK_1" /> மற்றும் <ph name="BEGIN_LINK_2" />கூடுதல் திறந்த மூல மென்பொருள்<ph name="END_LINK_2" /> ஆகியவற்றாலும் சாத்தியமானது.</translation>
<translation id="1419954813084261088">Jema Technology ஆல் வடிவமைக்கப்பட்டு உருவாக்கப்பட்டது.</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.</translation>
<translation id="6168072053306020326">Jema Technology என்பது Jema Technology LTD மற்றும் Jema Technology (Beijing) Limited ஆகியவற்றின் வர்த்தக பெயராகும்.
        <ph name="LINE_BREAK" />
        Jema Technology LTD என்பது நிறுவன எண் 12273803 உடன் இங்கிலாந்து மற்றும் வேல்சில் பதிவு செய்யப்பட்ட நிறுவனமாகும்.</translation>
<translation id="1251589813188467292">முக்கியமான சாதன உத்தரவாதம் மற்றும் சேவை தகவல்</translation>
<translation id="4851115775198886021">சாதன SN:</translation>
</translationbundle>
