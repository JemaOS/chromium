import("//build/config/features.gni")
import("//jemaos/extensions/common/api/jemaos_schema.gni")
import("//extensions/buildflags/buildflags.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")
import("//tools/json_schema_compiler/json_features.gni")
import("//jemaos/build/config/buildflags.gni")


assert(enable_extensions)

generated_json_strings("jemaos_api") {
  sources = extensions_api_schema_files
  bundle_name = "JemaOS"
  root_namespace = extensions_api_root_namespace
  schema_include_rules = extensions_api_schema_include_rules
  deps = [
      "//chromeos",
  ]
  visibility = [ ":api" ]
}

generated_types("jemaos_api_types") {
  sources = extensions_api_schema_files
  root_namespace = extensions_api_root_namespace
  deps = [
    "//base",
    "//extensions/buildflags",
    "//chromeos",
  ]
  visibility = [ ":api" ]
}

group("api"){
  deps = [
    ":jemaos_api",
    ":jemaos_api_types",
  ]
}

group("jemaos_features") {
  public_deps = [
    ":api_features",
    ":permission_features",
  ]
}

json_features("api_features") {
  feature_type = "APIFeature"
  method_name = "AddJemaOSAPIFeatures"
  sources = [
    "_api_features.json",
  ]
  if (use_jemaos_license) {
    sources += [
      "_license_api_features.json",
    ]
  }
  visibility = [ ":jemaos_features" ]
}

json_features("permission_features") {
  feature_type = "PermissionFeature"
  method_name = "AddJemaOSPermissionFeatures"
  sources = [
    "_permission_features.json",
  ]
  visibility = [ ":jemaos_features" ]
}
