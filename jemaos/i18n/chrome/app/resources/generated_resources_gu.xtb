<translation id="6183637837838262693">Intel Slim</translation>
<translation id="1270291881045478104">JemaOS AI સક્ષમ કરો</translation>
<translation id="2013780539677437932">તમામ JemaOS AI-સંબંધિત સુવિધાઓ સક્ષમ અથવા અક્ષમ કરો</translation>
<translation id="3398637633218757480">JemaOS AI ક્વિક કૉલ સક્ષમ કરો</translation>
<translation id="8986197796475507452">Ctrl + C + C દબાવીને હાઇલાઇટ કરેલી સામગ્રી માટે JemaOS AI વિકલ્પો ઝડપથી લાવો</translation>
<translation id="6407628130593274137">JemaOS AI માટે અન્ય સેટિંગ્સ અને વિકલ્પો</translation>
<translation id="4005574560653331142">આ સ્થાનિક એકાઉન્ટનો PIN અથવા સાઇન-ઇન પાસવર્ડ બદલવા માટે, <ph name="BEGIN_LINK" />ગોપનીયતા અને સુરક્ષા<ph name="END_LINK" /> સેટિંગ્સમાં જાઓ.</translation>
<!-- login_strings (JemaOS) -->
<translation id="6419913024856619425">તમે <ph name="LINK_START" />JemaOS સ્થાનિક એકાઉન્ટથી સાઇન ઇન કરી શકો છો<ph name="LINK_END" />.</translation>
<translation id="5291842596976929391">ઈમેલ <ph name="EMAIL_ADDRESS" /> પહેલેથી જ અસ્તિત્વમાં છે. કૃપા કરીને બીજા ઈમેલથી ફરી પ્રયાસ કરો.</translation>
<translation id="4519800823932975782">JemaOS સહાય કેન્દ્ર</translation>
<translation id="4737474693231655139">સામાન્ય JemaOS પ્રશ્નોના જવાબો અને સહાય લેખો શોધો</translation>
</translationbundle>
