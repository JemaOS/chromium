<!-- jemaos_menus -->
<translation id="5027700305690795897">JemaOS nuk ka përfunduar konfigurimin e tij fillestar.</translation>
<translation id="4257170804800372451">JemaOS dhe Thot bëhen të mundur nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> dhe <ph name="BEGIN_LINK_OSS" />softuer tjetër me burim të hapur<ph name="END_LINK_OSS" />.</translation>
