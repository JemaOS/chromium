	<translation id="6603987686259425085">آپ <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>کسی JemaOS مقامی اکاؤنٹ سے سائن ان کر سکتے ہیں<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>۔</translation>
	<translation id="3598802966230712759">ای میل <ph name="EMAIL_ADDRESS">$1</ph> پہلے سے موجود ہے۔ براہ کرم ایک اور ای میل کے ساتھ دوبارہ کوشش کریں۔</translation>
	<translation id="7215016743510876720">مقامی اکاؤنٹ استعمال کریں۔</translation>
	<translation id="6657635042185516718">آن لائن اکاؤنٹ استعمال کرنا جاری رکھیں</translation>
	<translation id="6867476688065565618">مقامی اکاؤنٹ پر سوئچ کریں؟</translation>
	<translation id="4840454774882557974">اگر آپ مقامی اکاؤنٹ استعمال کرنے کا انتخاب کرتے ہیں تو مفید خصوصیات میں آپ کے ڈیٹا اور ترجیحات کو متعدد آلات پر مطابقت پذیر بنانا اور آپ کے JemaOS اکاؤنٹ کا استعمال کرتے ہوئے خودکار طور پر ویب ایپس میں سائن ان کرنا کام نہیں کرے گا۔</translation>
	<translation id="8951507920859729424">ہم JemaOS کو مکمل طور پر استعمال کرنے کے لیے ایک آن لائن اکاؤنٹ استعمال کرنے کی تجویز کرتے ہیں۔</translation>
	<translation id="479773200536372215">آپ گوگل اکاؤنٹس شامل نہیں کر سکیں گے کیونکہ گوگل API کیز غائب ہیں۔ تفصیلات کے لیے <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> دیکھیں۔</translation>
	<translation id="1198491307547164157">آپ JemaOS اکاؤنٹس شامل نہیں کر سکیں گے کیونکہ JemaOS API کیز غائب ہیں۔ تفصیلات کے لیے <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> دیکھیں۔</translation>
	<translation id="5042404702659901995">رازداری کا بیان</translation>
	<translation id="4907736162587268100">رازداری کے بیان کے مواد</translation>
	<translation id="5988344732274877691">JemaOS کے لیے (بہت کم، وعدہ شدہ) نیوز لیٹر کے لیے سائن اپ کریں۔</translation>
	<translation id="1706203008474708805">JemaOS صارف کے تجربے میں بہتری کے منصوبے میں شامل ہوں۔</translation>
	<translation id="1147139514756087229">مقامی اکاؤنٹ کے ساتھ سائن ان کریں۔</translation>
	<translation id="2054784944085654098">ابھی بیک اپ فائل بنائی جا رہی ہے۔ اس میں کچھ وقت لگ سکتا ہے۔ براہ مہربانی انتظار کریں…</translation>
