<translation id="8362858344151826493">JemaOS ਖਾਤਾ, ਬੈਕਅੱਪ, ਵਿਵਿਧ</translation>
<translation id="9150429437595727962">Wi-Fi ਸੈਟਿੰਗਾਂ</translation>
<translation id="4938972461544498524">ਟੱਚਪੈਡ ਸੈਟਿੰਗਾਂ</translation>
<translation id="1210024513248363065">ਰਿਮੋਟ ਸੇਵਾਵਾਂ</translation>
<translation id="2878862288885588535">ਰਿਮੋਟ ਡਾਇਗਨੋਸਟਿਕ ਸੇਵਾ</translation>
<translation id="7409197984340676806">ਰਿਮੋਟ ਡਾਇਗਨੋਸਟਿਕ ਸੇਵਾ ਅਧਿਕਾਰਤ JemaOS ਸਹਾਇਤਾ ਪ੍ਰਤੀਨਿਧਾਂ ਨੂੰ ਸਿਸਟਮ ਸਮੱਸਿਆਵਾਂ ਦੀ ਪਛਾਣ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦੀ ਹੈ। ਇਸ ਸਮੇਂ, ਰਿਮੋਟ ਡਾਇਗਨੋਸਟਿਕ ਸੇਵਾ ਸਿਰਫ਼ ਅਧਿਕਾਰਤ JemaOS ਸਹਾਇਤਾ ਪ੍ਰਤੀਨਿਧਾਂ ਦੁਆਰਾ ਹੀ ਸ਼ੁਰੂ ਕੀਤੀ ਜਾ ਸਕਦੀ ਹੈ।</translation>
<translation id="1791028023086176332">ਕਿਰਪਾ ਕਰਕੇ ਇਹ ਨੰਬਰ ਅਧਿਕਾਰਤ JemaOS ਸਹਾਇਤਾ ਪ੍ਰਤੀਨਿਧਾਂ ਨਾਲ ਸਾਂਝਾ ਕਰੋ</translation>
<translation id="6279304275399437025">ਰਿਮੋਟ ਡਾਇਗਨੋਸਟਿਕ ਸੇਵਾ ਸ਼ੁਰੂ ਹੋ ਰਹੀ ਹੈ...</translation>
<translation id="1501882165699826662">ਕਿਰਪਾ ਕਰਕੇ ਰਿਮੋਟ ਡਾਇਗਨੋਸਟਿਕ ਸੇਵਾ ਬੰਦ ਕਰੋ ਅਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ</translation>
<translation id="3100283258447375201">ਹੋਰ ਜਾਣਕਾਰੀ</translation>
<translation id="4070039109671307724">ਵਿਵਿਧ</translation>
<translation id="7326893024940073254">"ਮੁੜ ਚਾਲੂ ਕਰੋ" ਬਟਨ</translation>
<translation id="3002423764319968103">ਸਿਸਟਮ ਮੇਨੂ ਵਿੱਚ "ਮੁੜ ਚਾਲੂ ਕਰੋ" ਬਟਨ ਦਿਖਾਓ</translation>
<translation id="6243454903512423518">"ਸਕਰੀਨ ਘੁਮਾਓ" ਬਟਨ</translation>
<translation id="6491049336868978729">ਤੁਸੀਂ ਇਸ ਸਮੇਂ ਟੈਬਲੈਟ ਮੋਡ ਵਿੱਚ ਨਹੀਂ ਹੋ, "ਸਕਰੀਨ ਘੁਮਾਓ" ਬਟਨ ਲੁਕਿਆ ਹੋਇਆ ਹੈ</translation>
<translation id="5496012402277579695">ਸਿਸਟਮ ਮੇਨੂ ਵਿੱਚ "ਸਕਰੀਨ ਘੁਮਾਓ" ਬਟਨ ਦਿਖਾਓ</translation>
<translation id="5882838977344999606">ਟੈਬਲੈਟ/ਲੈਪਟਾਪ ਮੋਡ ਸਵਿੱਚ</translation>
<translation id="472164133625585606">ਸਿਸਟਮ ਮੇਨੂ ਵਿੱਚ ਟੈਬਲੈਟ/ਲੈਪਟਾਪ ਮੋਡ ਸਵਿੱਚ ਦਿਖਾਓ</translation>
<translation id="1851103550468466960">Widevine ਸਮਰੱਥ ਕਰੋ</translation>
<translation id="4058176713282795846">ਸੁਰੱਖਿਅਤ ਪ੍ਰੀਮੀਅਮ ਸਮੱਗਰੀ ਸਟ੍ਰੀਮ ਕਰਨ ਲਈ Widevine ਸਮਰੱਥ ਕਰੋ। <ph name="BEGIN_LINK_LEARN_MORE" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" ਚੁਣੋ</translation>
<translation id="4838463656205005584">Widevine ਸਮਰੱਥ ਕਰਨਾ ਅਸਫ਼ਲ...</translation>
<translation id="2164041826798266548">Widevine CDM ਮੋਡੀਊਲ ਇੰਸਟਾਲੇਸ਼ਨ ਅਸਫ਼ਲ ਰਹੀ। ਕਿਰਪਾ ਕਰਕੇ ਆਪਣਾ ਕਨੈਕਸ਼ਨ ਜਾਂਚੋ ਅਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="4106982328079440606">JemaOS ਖਾਤਾ ਸੈਟਿੰਗਾਂ</translation>
<translation id="6468776556018764845">ਪ੍ਰਯੋਗਾਤਮਕ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ</translation>
<translation id="3487615413425326553">Trusted Platform Module (TPM) ਜਾਂਚਾਂ ਨੂੰ ਬਾਈਪਾਸ ਕਰੋ</translation>
<translation id="4817176087932811573">ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਵਿੱਚ ਅਸੰਗਤ TPM ਚਿਪ ਕਾਰਨ ਕੁਝ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਅਸਫ਼ਲ ਹੋ ਸਕਦੀਆਂ ਹਨ; ਤੁਸੀਂ ਹੱਲ ਵਜੋਂ TPM ਜਾਂਚਾਂ ਨੂੰ ਬਾਈਪਾਸ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="3356003366173774486">ਸਵੈਚਲਿਤ ਸਾਈਨ-ਇਨ</translation>
<translation id="6218459410891191693">ਡਿਵਾਈਸ ਮੁੜ ਚਾਲੂ ਹੋਣ 'ਤੇ ਮੌਜੂਦਾ ਖਾਤੇ ਨੂੰ ਡੈਸਕਟਾਪ ਵਿੱਚ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਸਾਈਨ ਇਨ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ</translation>
<translation id="6620839363422062843">ਇਸ ਖਾਤੇ ਲਈ ਸਮਰੱਥ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ; ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਹੋਰ ਖਾਤਿਆਂ ਲਈ ਸਵੈਚਲਿਤ ਸਾਈਨ-ਇਨ ਪਹਿਲਾਂ ਹੀ ਸਕ੍ਰਿਆ ਹੈ</translation>
<translation id="6734500226490446035">ਇਸ ਖਾਤੇ ਲਈ ਸਮਰੱਥ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ; ਇਸ ਖਾਤੇ ਲਈ ਫ਼ਾਈਲ ਸਿਸਟਮ ਸ਼ੁਰੂ ਕਰਦੇ ਸਮੇਂ ਇੱਕ ਅਗਿਆਤ ਗਲਤੀ ਆਈ। ਕਿਰਪਾ ਕਰਕੇ ਮੁੜ ਚਾਲੂ ਕਰਕੇ ਜਾਂ ਨਵਾਂ ਖਾਤਾ ਬਣਾ ਕੇ ਕੋਸ਼ਿਸ਼ ਕਰੋ</translation>
<translation id="5464880042146818691">ਇਸ ਖਾਤੇ ਲਈ ਸਮਰੱਥ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ; ਸਵੈਚਲਿਤ ਸਾਈਨ-ਇਨ ਵਿਕਲਪ ਸਿਰਫ਼ "ਸਥਾਨਕ ਖਾਤਾ" ਕਿਸਮ ਲਈ ਉਪਲਬਧ ਹੈ।</translation>
<translation id="3335654854106476749">ਸਵੈਚਲਿਤ ਸਾਈਨ-ਇਨ ਸਮਰੱਥ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕਿਰਪਾ ਕਰਕੇ <ph name="BEGIN_LINK" />ਪਰਦੇਦਾਰੀ ਅਤੇ ਸੁਰੱਖਿਆ<ph name="END_LINK" /> ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸਾਈਨ-ਇਨ ਪਾਸਵਰਡ ਸ਼ਾਮਲ ਕਰੋ।</translation>
<translation id="5586831602198585601">JemaOS ਦਾ ਇੱਕ ਨਵਾਂ ਸੰਸਕਰਣ ਹੁਣ ਅੱਪਡੇਟ ਲਈ ਉਪਲਬਧ ਹੈ। ਹਾਲਾਂਕਿ, ਤੁਹਾਡਾ JemaOS for You ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਸਮਾਪਤ ਹੋ ਗਿਆ ਹੈ; ਆਪਣਾ JemaOS ਅੱਪਡੇਟ ਕਰਨ ਲਈ ਤੁਹਾਨੂੰ ਇੱਕ ਸਕ੍ਰਿਆ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਦੀ ਲੋੜ ਹੈ।</translation>
<translation id="3869860597719956574">JemaOS ਦਾ ਇੱਕ ਨਵਾਂ ਮੁੱਖ ਸੰਸਕਰਣ ਹੁਣ ਅੱਪਡੇਟ ਲਈ ਉਪਲਬਧ ਹੈ। ਇਸ ਅੱਪਡੇਟ ਨਾਲ ਜਾਰੀ ਰੱਖਣ ਲਈ ਤੁਹਾਨੂੰ ਇਕ-ਵਾਰੀ ਫ਼ੀਸ ਦੇਣੀ ਹੋਵੇਗੀ।</translation>
<translation id="6523879681771260760">ਕਿਰਪਾ ਕਰਕੇ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਸਟੋਰ ਕਰਨ ਦਾ ਰਾਹ ਨਿਰਦਿਸ਼ਟ ਕਰੋ</translation>
<translation id="2036152819788683293">ਇਸ ਖਾਤੇ ਲਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਬਣਾਓ (ਬੀਟਾ)। <ph name="BEGIN_LINK_LEARN_MORE" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">ਬੈਕਅੱਪ ਕਰੋ</translation>
<translation id="4267347174163690295">ਇਸ ਖਾਤੇ ਲਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਬਣਾਓ (ਬੀਟਾ)।</translation>
<translation id="8112950994208888917">ਇਹ ਕਾਰਵਾਈ ਇਸ ਖਾਤੇ ਲਈ ਇੱਕ ਪੂਰਾ ਡਿਸਕ ਬੈਕਅੱਪ ਬਣਾਉਂਦੀ ਹੈ, ਜਿਸ ਨਾਲ ਤੁਹਾਡੇ JemaOS ਨੂੰ ਉਸ ਸਥਿਤੀ ਵਿੱਚ ਰੀਸਟੋਰ ਕਰਨਾ ਆਸਾਨ ਹੋ ਜਾਂਦਾ ਹੈ ਜਿਸ ਵਿੱਚ ਇਹ ਬੈਕਅੱਪ ਬਣਾਇਆ ਗਿਆ ਸੀ, ਜਿਸ ਵਿੱਚ ਸੈਟਿੰਗਾਂ, ਇੰਸਟਾਲ ਕੀਤੇ ਬ੍ਰਾਊਜ਼ਰ ਐਕਸਟੈਂਸ਼ਨ ਅਤੇ ਸਬਸਿਸਟਮ ਐਪਸ ਸ਼ਾਮਲ ਹਨ। ਤੁਹਾਡੀਆਂ ਐਪਸ ਅਤੇ ਹੋਮ ਫੋਲਡਰ ਦੀ ਸਮੱਗਰੀ 'ਤੇ ਨਿਰਭਰ ਕਰਦੇ ਹੋਏ, ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਵੱਡੀ ਹੋ ਸਕਦੀ ਹੈ; ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਨੂੰ ਬਾਹਰੀ ਸਟੋਰੇਜ ਡਿਵਾਈਸ 'ਤੇ ਸਟੋਰ ਕਰਨ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਕੀਤੀ ਜਾਂਦੀ ਹੈ। ਜੇ ਤੁਹਾਡੇ ਕੋਲ ਪੋਰਟੇਬਲ USB ਡ੍ਰਾਈਵ ਹੈ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਇਸਨੂੰ ਹੁਣੇ ਕਨੈਕਟ ਕਰੋ। <ph name="BEGIN_LINK_LEARN_MORE" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">ਕਿਰਪਾ ਕਰਕੇ ਇਸ ਖਾਤੇ ਦਾ ਸਾਈਨ-ਇਨ ਪਾਸਵਰਡ ਦਰਜ ਕਰੋ</translation>
<translation id="8663988871299316062">ਕਿਰਪਾ ਕਰਕੇ ਇਹ ਪਾਸਵਰਡ ਯਾਦ ਰੱਖੋ, ਕਿਉਂਕਿ ਇਸ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਨੂੰ ਰੀਸਟੋਰ ਕਰਦੇ ਸਮੇਂ ਇਸਦੀ ਲੋੜ ਹੋਵੇਗੀ</translation>
<translation id="6408904153044317846">ਰੀਸਟੋਰ ਕਰਨ ਲਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਚੁਣੋ</translation>
<translation id="8062988348127771021">ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਤੋਂ ਆਪਣਾ JemaOS ਡੇਟਾ ਰੀਸਟੋਰ ਕਰੋ</translation>
<translation id="7309192418866543730">ਬੈਕਅੱਪ ਪਾਸਵਰਡ ਦਰਜ ਕਰੋ</translation>
<translation id="3642408376366598984">ਇਸ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਨੂੰ ਇੰਕ੍ਰਿਪਟ ਕਰਨ ਲਈ ਵਰਤਿਆ ਗਿਆ ਪਾਸਵਰਡ ਦਰਜ ਕਰੋ</translation>
<translation id="7783974937157985523">ਬੈਕਅੱਪ ਪਾਸਵਰਡ</translation>
<translation id="6583780301401541007">ਰੀਸਟੋਰ ਸਫ਼ਲ</translation>
<translation id="3514011352559420398">ਰੀਸਟੋਰ ਅਸਫ਼ਲ</translation>
<translation id="7535980903266533458">ਬੈਕਅੱਪ ਨੂੰ ਆਪਣੇ ਡਿਵਾਈਸ ਜਾਂ ਬਾਹਰੀ ਸਟੋਰੇਜ 'ਤੇ ਸੁਰੱਖਿਅਤ ਕਰੋ</translation>
<translation id="604001903249547235">ਕਲਾਉਡ ਬੈਕਅੱਪ</translation>
<translation id="8885702701336541611">ਬੈਕਅੱਪ ਨੂੰ JemaOS ਕਲਾਉਡ ਸਟੋਰੇਜ 'ਤੇ ਅੱਪਲੋਡ ਕਰੋ</translation>
<translation id="3939744430096549862">ਕਲਾਉਡ 'ਤੇ ਬੈਕਅੱਪ ਕਰੋ</translation>
<translation id="619129431573254316">ਸਥਾਨਕ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਤੋਂ ਰੀਸਟੋਰ ਕਰੋ</translation>
<translation id="1859592711955106569">ਕਲਾਉਡ ਰੀਸਟੋਰ</translation>
<translation id="38222223336741457">JemaOS ਕਲਾਉਡ ਤੋਂ ਡਾਊਨਲੋਡ ਅਤੇ ਰੀਸਟੋਰ ਕਰੋ</translation>
<translation id="1241089811244416179">ਕਲਾਉਡ ਤੋਂ ਰੀਸਟੋਰ ਕਰੋ</translation>
<translation id="652479689372703360">ਬੈਕਅੱਪ ਜਾਰੀ ਹੈ</translation>
<translation id="3655220146274872918">ਬੈਕਅੱਪ ਪੂਰਾ ਹੋ ਗਿਆ</translation>
<translation id="4243579853635792694">ਤੁਹਾਡਾ ਬੈਕਅੱਪ ਸਫ਼ਲਤਾਪੂਰਵਕ ਬਣਾਇਆ ਗਿਆ</translation>
<translation id="4854179463174744546">ਬੈਕਅੱਪ ਪ੍ਰਕਿਰਿਆ ਦੌਰਾਨ ਇੱਕ ਗਲਤੀ ਆਈ</translation>
<translation id="2410668771600309999">Connect API ਉਪਭੋਗਤਾ ਜਾਣਕਾਰੀ</translation>
<translation id="2223892939866251845">ਉਪਭੋਗਤਾ ID</translation>
<translation id="3850846286480935456">ਬੈਕਅੱਪ ਸਟੋਰੇਜ ਵਿਸ਼ਲੇਸ਼ਣ</translation>
<translation id="6244494465581273970">ਉਪਭੋਗਤਾ ID ਦੀ ਲੋੜ ਹੈ</translation>
<translation id="9204006549413740506">ਆਖਰੀ ਵਾਰ ਅੱਪਡੇਟ ਕੀਤਾ ਗਿਆ</translation>
<translation id="476642412165431515">ਹਾਰਡਵੇਅਰ ਡਿਵਾਈਸ</translation>
<translation id="3386337985825120901">ਕੋਈ ਬੈਕਅੱਪ ਡੇਟਾ ਉਪਲਬਧ ਨਹੀਂ</translation>
<translation id="8490990067870590760">ਬੈਕਅੱਪ ਫ਼ਾਈਲਾਂ ਲੋਡ ਹੋ ਰਹੀਆਂ ਹਨ...</translation>
<translation id="2955409026764742995">ਰੀਸਟੋਰ ਕਰਨ ਲਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਚੁਣੋ:</translation>
<translation id="7414629348005657242">-- ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਚੁਣੋ --</translation>
<translation id="918246516374174381">ਕੋਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲਾਂ ਨਹੀਂ ਮਿਲੀਆਂ। ਕਿਰਪਾ ਕਰਕੇ ਪਹਿਲਾਂ ਇੱਕ ਬੈਕਅੱਪ ਬਣਾਓ।</translation>
<translation id="77997252117517973">ਜਲਦੀ ਆ ਰਿਹਾ ਹੈ</translation>
<translation id="1930692852800776096">ਸ਼ਬਦਕੋਸ਼ ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="8793060353848771694">ਖੱਬੇ ਈਅਰਬਡ ਦੀ ਤਸਵੀਰ</translation>
<translation id="6257440204887306255">ਚਾਰਜਿੰਗ ਕੇਸ ਦੀ ਤਸਵੀਰ</translation>
<translation id="2754700616124958693">ਸੱਜੇ ਈਅਰਬਡ ਦੀ ਤਸਵੀਰ</translation>
<translation id="1068676292264983586">ਡਿਫੌਲਟ ਡਿਵਾਈਸ ਤਸਵੀਰ</translation>
<translation id="6364075396486660405">ਬੈਟਰੀ ਲਾਈਫ਼ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਉਣ ਲਈ ਸਾਰੇ ਪਾਰਟੀਸ਼ਨਾਂ ਲਈ ਮੀਡੀਆ ਫ਼ਾਈਲਾਂ ਦੀ ਸਵੈਚਲਿਤ ਸਕੈਨਿੰਗ ਅਸਮਰੱਥ ਕਰੋ। <ph name="BEGIN_LINK_LEARN_MORE" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">ਸੁਰੱਖਿਆ ਵਿਕਲਪ</translation>
<translation id="5618366106086725045">ਹੋਰ ਡਿਵੈਲਪਰ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਦੇ ਨਾਲ ਇਸ <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> ਇੰਸਟਾਲੇਸ਼ਨ ਲਈ "ਡਿਵੈਲਪਰ ਮੋਡ" ਸਮਰੱਥ ਕਰੋ। <ph name="BEGIN_LINK_LEARN_MORE" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">ਤੁਸੀਂ ਪਹਿਲਾਂ ਹੀ "ਡਿਵੈਲਪਰ ਮੋਡ" ਵਿੱਚ ਹੋ</translation>
<translation id="6074549317340202195">"ਡਿਵੈਲਪਰ ਮੋਡ" ਸਮਰੱਥ ਕਰੋ</translation>
<translation id="418781258674176053">ਚੇਤਾਵਨੀ! "ਡਿਵੈਲਪਰ ਮੋਡ" ਸਮਰੱਥ ਕਰਨਾ ਇੱਕ ਅਟੱਲ ਕਾਰਵਾਈ ਹੈ। ਜੇ ਤੁਸੀਂ "ਡਿਵੈਲਪਰ ਮੋਡ" ਅਸਮਰੱਥ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ ਤੁਹਾਨੂੰ JemaOS ਨੂੰ ਮੁੜ ਇੰਸਟਾਲ ਕਰਨਾ ਹੋਵੇਗਾ, ਜਿਸ ਨਾਲ ਸਾਰਾ ਡੇਟਾ ਮਿਟ ਜਾਵੇਗਾ। ਕਿਰਪਾ ਕਰਕੇ ਆਪਣੇ ਡੇਟਾ ਦਾ ਬੈਕਅੱਪ ਲਓ ਅਤੇ ਆਪਣੀ ਜ਼ਿੰਮੇਵਾਰੀ 'ਤੇ ਅੱਗੇ ਵਧੋ।</translation>
