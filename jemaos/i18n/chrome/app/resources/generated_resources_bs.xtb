<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Platforma <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Udaljena radna površina</translation>
<translation id="6898090158927982244">Vaš Linux je ažuran</translation>
<translation id="4886703929102211360">Dostupno je kritično ažuriranje za komponentu Linux (beta). Preporučuje se da instalirate ovo ažuriranje što je prije moguće, u suprotnom vaš Linux (beta) može prestati raditi.</translation>
<translation id="6694016202036959050">Postavke <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">JemaOS račun, sigurnosna kopija, razno</translation>
<translation id="9150429437595727962">Wi-Fi postavke</translation>
<translation id="4938972461544498524">Postavke dodirne pločice</translation>
<translation id="1210024513248363065">Udaljene usluge</translation>
<translation id="2878862288885588535">Usluga udaljene dijagnostike</translation>
<translation id="7409197984340676806">Usluga udaljene dijagnostike omogućava službenim predstavnicima JemaOS podrške identificiranje problema sistema. Trenutno uslugu udaljene dijagnostike mogu pokrenuti samo službeni predstavnici JemaOS podrške.</translation>
<translation id="1791028023086176332">Podijelite ovaj broj sa službenim predstavnicima JemaOS podrške</translation>
<translation id="6279304275399437025">Pokretanje usluge udaljene dijagnostike...</translation>
<translation id="1501882165699826662">Zaustavite uslugu udaljene dijagnostike i pokušajte ponovo</translation>
<translation id="3100283258447375201">Više informacija</translation>
<translation id="4070039109671307724">Razno</translation>
<translation id="7326893024940073254">Dugme „Ponovo pokreni“</translation>
<translation id="3002423764319968103">Prikaži dugme „Ponovo pokreni“ u sistemskom meniju</translation>
<translation id="6243454903512423518">Dugme „Rotiraj ekran“</translation>
<translation id="6491049336868978729">Trenutno niste u režimu tableta, dugme „Rotiraj ekran“ je skriveno</translation>
<translation id="5496012402277579695">Prikaži dugme „Rotiraj ekran“ u sistemskom meniju</translation>
<translation id="5882838977344999606">Prekidač režima tablet/laptop</translation>
<translation id="472164133625585606">Prikaži prekidač režima tablet/laptop u sistemskom meniju</translation>
<translation id="1851103550468466960">Omogući Widevine</translation>
<translation id="4058176713282795846">Omogućite Widevine za strujanje zaštićenog premium sadržaja. <ph name="BEGIN_LINK_LEARN_MORE" />Saznajte više<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Odaberite „libwidevine.so“</translation>
<translation id="4838463656205005584">Omogućavanje Widevinea nije uspjelo...</translation>
<translation id="2164041826798266548">Instalacija modula Widevine CDM nije uspjela. Provjerite vezu i pokušajte ponovo.</translation>
<translation id="4106982328079440606">Postavke JemaOS računa</translation>
<translation id="6468776556018764845">Eksperimentalne značajke</translation>
<translation id="3487615413425326553">Zaobiđi provjere modula pouzdane platforme (TPM)</translation>
<translation id="4817176087932811573">Neke značajke možda neće raditi zbog nekompatibilnog TPM čipa u vašem uređaju; kao zaobilazno rješenje možete zaobići provjere TPM-a.</translation>
<translation id="3356003366173774486">Automatska prijava</translation>
<translation id="6218459410891191693">Dozvoli trenutnom računu automatsku prijavu na radnu površinu prilikom ponovnog pokretanja uređaja</translation>
<translation id="6620839363422062843">Nije moguće omogućiti za ovaj račun; automatska prijava je već aktivna za druge račune na ovom uređaju</translation>
<translation id="6734500226490446035">Nije moguće omogućiti za ovaj račun; došlo je do nepoznate greške prilikom inicijalizacije datotečnih sistema za ovaj račun. Pokušajte ponovo pokrenuti uređaj ili napraviti novi račun</translation>
<translation id="5464880042146818691">Nije moguće omogućiti za ovaj račun; opcija automatske prijave dostupna je samo za račune tipa „Lokalni račun“.</translation>
<translation id="3335654854106476749">Prije omogućavanja automatske prijave dodajte lozinku za prijavu u postavkama <ph name="BEGIN_LINK" />Privatnost i sigurnost<ph name="END_LINK" />.</translation>
<translation id="5586831602198585601">Novija verzija JemaOS-a je sada dostupna za ažuriranje. Međutim, vaša pretplata JemaOS for You je istekla; potrebna vam je aktivna pretplata za ažuriranje JemaOS-a.</translation>
<translation id="3869860597719956574">Nova glavna verzija JemaOS-a je sada dostupna za ažuriranje. Morate platiti jednokratnu naknadu da biste nastavili sa ovim ažuriranjem.</translation>
<translation id="6523879681771260760">Navedite putanju za čuvanje datoteke sigurnosne kopije</translation>
<translation id="2036152819788683293">Napravite datoteku sigurnosne kopije za ovaj račun (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Saznajte više<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Napravi sigurnosnu kopiju</translation>
<translation id="4267347174163690295">Napravite datoteku sigurnosne kopije za ovaj račun (beta).</translation>
<translation id="8112950994208888917">Ova operacija pravi potpunu sigurnosnu kopiju diska za ovaj račun, što olakšava vraćanje JemaOS-a u stanje u kojem je bio prilikom pravljenja sigurnosne kopije, uključujući postavke, instalirana proširenja preglednika i aplikacije podsistema. Ovisno o vašim aplikacijama i sadržaju početne mape, datoteka sigurnosne kopije može biti velika; preporučuje se da datoteku sigurnosne kopije čuvate na vanjskom uređaju za pohranu. Ako imate prenosni USB pogon, povežite ga sada. <ph name="BEGIN_LINK_LEARN_MORE" />Saznajte više<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Unesite lozinku za prijavu za ovaj račun</translation>
<translation id="8663988871299316062">Zapamtite ovu lozinku jer će biti potrebna prilikom vraćanja ove datoteke sigurnosne kopije</translation>
<translation id="6408904153044317846">Odaberite datoteku sigurnosne kopije za vraćanje</translation>
<translation id="8062988348127771021">Vratite podatke JemaOS-a iz datoteke sigurnosne kopije</translation>
<translation id="7309192418866543730">Unesite lozinku sigurnosne kopije</translation>
<translation id="3642408376366598984">Unesite lozinku korištenu za šifriranje ove datoteke sigurnosne kopije</translation>
<translation id="7783974937157985523">Lozinka sigurnosne kopije</translation>
<translation id="6583780301401541007">Vraćanje uspješno</translation>
<translation id="3514011352559420398">Vraćanje nije uspjelo</translation>
<translation id="7535980903266533458">Sačuvajte sigurnosnu kopiju na uređaj ili vanjsku pohranu</translation>
<translation id="604001903249547235">Sigurnosna kopija u oblaku</translation>
<translation id="8885702701336541611">Otpremite sigurnosnu kopiju u JemaOS pohranu u oblaku</translation>
<translation id="3939744430096549862">Napravi sigurnosnu kopiju u oblaku</translation>
<translation id="619129431573254316">Vrati iz lokalne datoteke sigurnosne kopije</translation>
