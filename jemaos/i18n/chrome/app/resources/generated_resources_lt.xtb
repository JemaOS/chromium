<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="lt">
	<translation id="7386402409475121504">Sukurkite vietinę JemaOS paskyrą</translation>
	<translation id="3760308806144055927">Prisijunkite prie vietinės JemaOS paskyros</translation>
	<translation id="3325117507482096812">Įveskite slaptažodį</translation>
	<translation id="1838206877831947154">Jūsų slaptažodžiai nesutampa</translation>
	<translation id="2158276988029582286">Sukurkite naują vietinę paskyrą</translation>
	<translation id="8592849747346274067">Prisijunkite prie esamos paskyros</translation>
	<translation id="482190417986201746">Įvestas neteisingas vartotojo vardas arba slaptažodis</translation>
	<translation id="6603987686259425085">Galite <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>prisijungti naudodami vietinę JemaOS paskyrą<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">El. pašto adresas <ph name="EMAIL_ADDRESS">$1</ph> jau yra. Bandykite dar kartą naudodami kitą el. laišką.</translation>
	<translation id="7215016743510876720">Naudokite vietinę paskyrą</translation>
	<translation id="6657635042185516718">Toliau naudokite internetinę paskyrą</translation>
	<translation id="6867476688065565618">Perjungti į vietinę paskyrą?</translation>
	<translation id="4840454774882557974">Jei pasirinksite naudoti vietinę paskyrą, naudingos funkcijos apima duomenų ir nuostatų sinchronizavimą keliuose įrenginiuose ir automatinį prisijungimą prie žiniatinklio programų naudojant JemaOS paskyrą.</translation>
	<translation id="8951507920859729424">Rekomenduojame naudoti internetinę paskyrą, kad galėtumėte maksimaliai išnaudoti JemaOS.</translation>
	<translation id="479773200536372215">Negalėsite pridėti „Google“ paskyrų, nes trūksta „Google“ API raktų. Norėdami gauti daugiau informacijos, žr. <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Negalėsite pridėti JemaOS paskyrų, nes trūksta JemaOS API raktų. Norėdami gauti daugiau informacijos, žr. <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Privatumo pareiškimas</translation>
	<translation id="4907736162587268100">Privatumo pareiškimo turinys</translation>
	<translation id="5988344732274877691">Prisiregistruokite gauti (labai nedažną, žadėtą) JemaOS naujienlaiškį</translation>
	<translation id="1706203008474708805">Prisijunkite prie JemaOS naudotojo patirties gerinimo plano</translation>
	<translation id="1147139514756087229">Prisijunkite naudodami vietinę paskyrą</translation>
	<translation id="2054784944085654098">Dabar kuriamas atsarginės kopijos failas. Tai gali šiek tiek užtrukti; prašau palaukti…</translation>
	<translation id="3554401467586751874">Atsarginės kopijos failas sėkmingai sukurtas</translation>
	<translation id="2349211327705667074">Peržiūrėkite atsarginės kopijos failą</translation>
	<translation id="6337433855796857931">Nepavyko sukurti atsarginės kopijos</translation>
	<translation id="3049367131589710124">Peržiūrėkite klaidų žurnalą</translation>
	<translation id="1079017345574916945">Nuotolinis darbalaukis</translation>
	<translation id="3064478898280877715">Programėlių parduotuvė</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Montuotojas</translation>
	<translation id="2173278076276376488">Ši programa padės įdiegti <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> šio įrenginio vidinėje atmintyje.</translation>
	<translation id="5323182426977498659">Įspėjimas! Ši procedūra yra žalinga ir negali būti atšaukta. Atkreipkite dėmesį, kad mes neprisiimame jokios atsakomybės už galimą jūsų duomenų praradimą ir neteiksime jokios skubios techninės pagalbos, tęskite savo rizika.</translation>
	<translation id="8517836015601969896">Pilnas disko diegimas</translation>
	<translation id="7300045760790370189">Įdiekite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, kad užimtumėte visą standųjį diską, visi tikslinio standžiojo disko duomenys bus ištrinti.</translation>
	<translation id="8762511733918256595">Kelių įkrovų diegimas</translation>
	<translation id="248900698427753678">Įdiekite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> į esamą standžiojo disko skaidinį, kuriame <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> gali egzistuoti lygiagrečiai su kita OS. Visi duomenys tiksliniame skaidinyje bus ištrinti.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bus įdiegta pasirinktame standžiajame diske; visi duomenys tiksliniame diske bus ištrinti.</translation>
	<translation id="4039091757234555415">Diskas</translation>
	<translation id="7783580523889684697">Nėra disko</translation>
	<translation id="8217653566575018388">Diegimas baigtas</translation>
	<translation id="8846746259444262774">Diegimas nepavyko</translation>
	<translation id="7263815009235541549">Diegimas sėkmingai baigtas. Pirmiausia išjunkite įrenginį, tada pašalinkite visas diegimo laikmenas ir vėl įjunkite, kad paleistumėte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Oi, kažkas nutiko ir diegimas nebuvo baigtas. Bandykite procesą dar kartą. Jei ta pati klaida kartojasi, susisiekite su JemaOS palaikymo tarnyba aukščiau pateiktu žurnalu.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bus įdiegta pasirinktame standžiojo disko skaidinyje. Pagal dabartinę kelių įkrovos schemą tai galima padaryti tik tuo atveju, jei jūsų įrenginys palaiko UEFI, o standieji diskai suformatuoti naudojant GPT.</translation>
	<translation id="7831363758161884243">Tikslinė skaidinys bus nuvalytas; taip pat turite nurodyti aktyvų EFI skaidinį (paprastai tai daroma automatiškai), nes diegimo programai reikia keisti sistemos įkrovos konfigūracijas.</translation>
	<translation id="5670799238446305550">Pasirinkite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tikslinį skaidinį</translation>
	<translation id="3695537760133394753">Pertvara</translation>
	<translation id="5610519566593708119">Pasirinkite EFI skaidinį</translation>
	<translation id="3367650349940010965">Pasirinktame diske nėra galimų skaidinių</translation>
	<translation id="7453223384507098390">Pasirinktame diske nėra EFI skaidinių</translation>
	<translation id="1854532683465500847">Pasirinkto skaidinio dydis yra mažesnis nei 20 GB, gali nepavykti įdiegti</translation>
	<translation id="4144613075340468247">Pasirinktas skaidinys buvo prijungtas prie <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kelių įkrovų, gali nepavykti įdiegti dar kartą</translation>
	<translation id="5793361052649920836">Kaip norėtumėte paleisti <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> po įdiegimo?</translation>
	<translation id="4273235330352963866">Įdiekite ir sukonfigūruokite reEFInd už mane (rekomenduojama)</translation>
	<translation id="1858708492548921044">REFInd yra įkrovos tvarkyklės programa, kuri siūlo gražią grafinę sąsają OS įkrovos parinktims, kai jūsų kompiuteris paleidžiamas, galėsite pasirinkti norimą OS, kurią norite įkelti. Daugiau informacijos apie REFInd rasite jos pagrindiniame puslapyje.</translation>
	<translation id="3861924051442564602">Pridėkite man UEFI įkrovos meniu parinktį</translation>
	<translation id="8622370666798589804">Kai kompiuteris paleidžiamas, galite patekti į UEFI įkrovos parinkčių meniu (greičiausiai paspausdami spartųjį klavišą), ši parinktis prideda <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kaip to meniu įrašą. (Palaiko tik kai kuriuos BIOS ir UEFI programinės įrangos modelius).</translation>
	<translation id="1569398690544416170">Nieko čia nedarykite, aš pats sukonfigūruosiu</translation>
	<translation id="3554866444001249532">Šis diegimo scenarijus įdės tik būtinus .efi failus <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> į EFI skaidinį. Jums reikės sukonfigūruoti, kaip jį paleisti patiems.</translation>
	<translation id="7492832751164189534">Priversti mesti</translation>
	<translation id="5159534860632584026">Diegimo procesas buvo nutrauktas</translation>
	<translation id="8686749782014838344">Nepavyko gauti disko informacijos</translation>
	<translation id="5688543378771259173">Diegimas nutraukiamas...</translation>
	<translation id="5350452134936384991">Įdiegti į USB</translation>
	<translation id="8008470485414925603">Įdiekite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> į USB diską; visi duomenys tiksliniame USB diske bus ištrinti.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bus įdiegta pasirinktame USB diske; visi duomenys tiksliniame diske bus ištrinti.</translation>
	<translation id="5725593226060700263">Nėra USB disko</translation>
	<translation id="4357040841587078287">Aptikome, kad naudojate šią JemaOS kopiją iš atsisiųsto vaizdo failo. Norėdami pasinaudoti visapusiškiausiomis palaikymo funkcijomis (įskaitant naujinimus belaidžiu būdu), kurias gali pasiūlyti JemaOS, primygtinai rekomenduojame paleisti funkciją „Įdiegėjas“, kad atliktumėte viso disko JemaOS diegimą į atskirą saugojimo įrenginį.</translation>
	<translation id="1246398339704431302">Galite <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>vis tiek toliau naudoti šią JemaOS kopiją<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, diegimo procesas gali būti vykdomas vėlesniame sistemos etape, tačiau visi jūsų duomenys bus ištrinti iš šio puslapio įdiegus ir jūs.</translation>
	<translation id="3654532222088291133">Užuot įvedę JemaOS paskyros slaptažodį, kad prisijungtumėte, galite sukurti <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> slaptažodį šiam įrenginiui</translation>
	<translation id="8377684629839541977">Naudokite JemaOS paskyros slaptažodį</translation>

