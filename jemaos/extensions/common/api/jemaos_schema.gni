import("//jemaos/build/config/buildflags.gni")

extensions_api_schema_files_ = []

if (is_chromeos) {
  extensions_api_schema_files_ += [
    "jemaos_private.json",
    "native_windows.json",
    "app_management.json",
    "command_line.json",
    "shell_client.json",
    "jemaos_arc_status.json",
  ]
  if (use_jemaos_license) {
    extensions_api_schema_files_ += [
      "license_management.json",
    ]
  }
}

extensions_api_schema_files =
    get_path_info(extensions_api_schema_files_, "abspath")

