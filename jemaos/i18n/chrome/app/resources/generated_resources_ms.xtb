<translationbundle lang="ms">
	<translation id="7386402409475121504">Buat akaun JemaOS tempatan anda</translation>
	<translation id="3760308806144055927">Log masuk akaun JemaOS tempatan anda</translation>
	<translation id="3325117507482096812">Sila masukkan kata laluan</translation>
	<translation id="1838206877831947154">Kata laluan anda tidak sepadan</translation>
	<translation id="2158276988029582286">Buat akaun tempatan baharu</translation>
	<translation id="8592849747346274067">Log masuk ke akaun sedia ada</translation>
	<translation id="482190417986201746">Nama pengguna atau kata laluan yang anda masukkan adalah salah</translation>
	<translation id="6603987686259425085">Anda boleh <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>log masuk dengan akaun setempat JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-mel <ph name="EMAIL_ADDRESS">$1</ph> sudah wujud. Sila cuba semula dengan e-mel lain.</translation>
	<translation id="7215016743510876720">Gunakan akaun tempatan</translation>
	<translation id="6657635042185516718">Teruskan menggunakan akaun dalam talian</translation>
	<translation id="6867476688065565618">Tukar ke akaun tempatan?</translation>
	<translation id="4840454774882557974">Jika anda memilih untuk menggunakan akaun setempat, ciri berguna termasuk menyegerakkan data dan pilihan anda merentas berbilang peranti dan log masuk secara automatik apl web menggunakan akaun JemaOS anda tidak akan berfungsi.</translation>
	<translation id="8951507920859729424">Kami mengesyorkan menggunakan akaun dalam talian untuk menggunakan JemaOS sepenuhnya.</translation>
	<translation id="479773200536372215">Anda tidak akan dapat menambah akaun Google kerana kunci API Google tiada. Lihat <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> untuk mendapatkan butiran.</translation>
	<translation id="1198491307547164157">Anda tidak akan dapat menambah akaun JemaOS kerana kunci API JemaOS tiada. Lihat <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> untuk mendapatkan butiran.</translation>
	<translation id="5042404702659901995">Kenyataan privasi</translation>
	<translation id="4907736162587268100">Kandungan pernyataan privasi</translation>
	<translation id="5988344732274877691">Daftar untuk surat berita (sangat jarang, dijanjikan) untuk JemaOS</translation>
	<translation id="1706203008474708805">Sertai pelan peningkatan pengalaman pengguna JemaOS</translation>
	<translation id="1147139514756087229">Log masuk dengan akaun tempatan</translation>
	<translation id="2054784944085654098">Mencipta fail sandaran sekarang. Ini mungkin mengambil sedikit masa; sila tunggu…</translation>
	<translation id="3554401467586751874">Fail sandaran telah berjaya dibuat</translation>
	<translation id="2349211327705667074">Lihat fail sandaran</translation>
	<translation id="3049367131589710124">Lihat log ralat</translation>
	<translation id="1079017345574916945">Desktop jauh</translation>
	<translation id="3064478898280877715">Kedai aplikasi</translation>
	<translation id="5890206344045530832">Pemasang</translation>
	<translation id="2173278076276376488">Utiliti ini akan membantu anda memasang <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pada storan dalaman peranti ini.</translation>
	<translation id="5323182426977498659">Amaran! Prosedur ini merosakkan dan tidak boleh dibuat asal. Sila ambil perhatian bahawa kami tidak akan bertanggungjawab untuk potensi kehilangan data anda atau memberikan sebarang sokongan teknikal segera, teruskan atas risiko anda sendiri.</translation>
	<translation id="8517836015601969896">Pemasangan cakera penuh</translation>
	<translation id="7300045760790370189">Pasang <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> untuk menduduki keseluruhan cakera keras, semua data cakera keras sasaran akan dipadamkan.</translation>
	<translation id="8762511733918256595">Pemasangan berbilang but</translation>
	<translation id="248900698427753678">Pasang <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pada partition cakera keras sedia ada, di mana <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> boleh wujud selari dengan OS lain. Semua data pada partition sasaran akan dipadamkan.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan dipasang pada pemacu keras pilihan anda; semua data pada cakera sasaran akan dipadamkan.</translation>
	<translation id="4039091757234555415">Cakera</translation>
	<translation id="7783580523889684697">Tiada cakera tersedia</translation>
	<translation id="8217653566575018388">Pemasangan selesai</translation>
	<translation id="8846746259444262774">Pemasangan gagal</translation>
	<translation id="7263815009235541549">Pemasangan telah berjaya diselesaikan. Sila matikan peranti anda dahulu, kemudian alih keluar sebarang media pemasangan dan hidupkan semula untuk but <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Oops, sesuatu telah berlaku dan pemasangan tidak selesai. Sila cuba semula proses tersebut. Jika ralat yang sama berterusan, sila hubungi Sokongan JemaOS dengan log di atas.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan dipasang pada partition yang dipilih pada pemacu keras anda. Di bawah skema berbilang but semasa, ini hanya boleh diteruskan jika peranti anda menyokong UEFI dan cakera keras anda diformatkan dengan GPT.</translation>
	<translation id="7831363758161884243">Partition sasaran akan dipadamkan; anda juga perlu menentukan partition EFI aktif anda (biasanya dilakukan secara automatik) kerana Pemasang perlu mengubah suai konfigurasi but sistem.</translation>
	<translation id="5670799238446305550">Pilih <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> partition sasaran</translation>
	<translation id="3695537760133394753">Pembahagian</translation>
	<translation id="5610519566593708119">Pilih partition EFI</translation>
	<translation id="3367650349940010965">Tiada sekatan tersedia untuk cakera yang dipilih</translation>
	<translation id="7453223384507098390">Tiada partition EFI tersedia untuk cakera yang dipilih</translation>
	<translation id="1854532683465500847">Saiz partition yang dipilih adalah kurang daripada 20GB, pemasangan mungkin gagal</translation>
	<translation id="4144613075340468247">Partition yang dipilih telah dipasang pada <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> berbilang but, pemasangan padanya sekali lagi mungkin gagal</translation>
	<translation id="5793361052649920836">Selepas pemasangan, bagaimana anda ingin but <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Pasang dan konfigurasikan REFInd untuk saya (disyorkan)</translation>
	<translation id="1858708492548921044">rEFInd ialah program pengurus but yang menawarkan antara muka grafik yang bagus untuk pilihan but OS apabila PC anda dimulakan, anda akan dapat memilih OS yang anda inginkan untuk but dengannya. Untuk mendapatkan maklumat lanjut mengenai rEFInd, sila rujuk halaman utamanya.</translation>
	<translation id="3861924051442564602">Tambah pilihan menu but UEFI untuk saya</translation>
	<translation id="8622370666798589804">Apabila PC anda dimulakan, anda mungkin boleh memasuki menu pilihan but UEFI (kemungkinan besar dengan menekan kekunci pintas), pilihan ini menambahkan <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sebagai entri pada menu tersebut. (Hanya menyokong beberapa model perisian tegar BIOS dan UEFI).</translation>
	<translation id="1569398690544416170">Jangan lakukan apa-apa di sini, saya akan mengkonfigurasinya sendiri</translation>
	<translation id="3554866444001249532">Skrip pemasangan ini hanya akan meletakkan fail .efi yang diperlukan untuk but <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ke partition EFI anda, anda perlu mengkonfigurasi cara untuk but sendiri.</translation>
	<translation id="7492832751164189534">Berhenti paksa</translation>
	<translation id="5159534860632584026">Proses pemasangan telah ditamatkan</translation>
	<translation id="8686749782014838344">Gagal mendapatkan maklumat cakera</translation>
	<translation id="5688543378771259173">Pemasangan sedang ditamatkan...</translation>
	<translation id="5350452134936384991">Pasang dalam USB</translation>
	<translation id="8008470485414925603">Pasang <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pada cakera USB; semua data pada cakera USB sasaran akan dipadamkan.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan dipasang pada cakera USB pilihan anda; semua data pada cakera sasaran akan dipadamkan.</translation>
	<translation id="5725593226060700263">Tiada cakera USB tersedia</translation>
	<translation id="4357040841587078287">Kami telah mengesan bahawa anda menjalankan salinan JemaOS ini daripada fail imej yang dimuat turun. Untuk menggunakan ciri sokongan yang paling komprehensif (termasuk kemas kini Over-The-Air) yang boleh ditawarkan oleh JemaOS, kami amat mengesyorkan anda melancarkan fungsi "Pemasang" untuk melaksanakan pemasangan cakera penuh JemaOS ke peranti storan yang berasingan.</translation>
	<translation id="1246398339704431302">Anda boleh <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>terus menggunakan salinan JemaOS ini juga<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proses pemasangan boleh dilaksanakan pada peringkat seterusnya dalam sistem, walau bagaimanapun, semua data anda akan dipadamkan semula selepas pemasangan ini dan anda akan mula dipadam semula.</translation>
	<translation id="3654532222088291133">Daripada memasukkan kata laluan akaun JemaOS anda untuk log masuk, anda boleh membuat kata laluan <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> untuk peranti ini</translation>
	<translation id="8377684629839541977">Gunakan kata laluan akaun JemaOS</translation>

