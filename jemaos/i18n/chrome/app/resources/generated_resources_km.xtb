	<translation id="8762511733918256595">ការដំឡើង Multi-boot</translation>
	<translation id="248900698427753678">ដំឡើង <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ទៅភាគថាសដែលមានស្រាប់នៃថាសរឹង ដែល <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> អាចមានស្របជាមួយប្រព័ន្ធប្រតិបត្តិការផ្សេងទៀត។ ទិន្នន័យទាំងអស់នៅលើភាគថាសគោលដៅនឹងត្រូវបានលុបចោល។</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> នឹងត្រូវបានដំឡើងនៅលើថាសរឹងដែលអ្នកបានជ្រើសរើស។ ទិន្នន័យទាំងអស់នៅលើថាសគោលដៅនឹងត្រូវបានលុបចោល។</translation>
