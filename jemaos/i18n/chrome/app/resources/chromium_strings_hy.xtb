<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot-ի մասին</translation>
<translation id="5639860668557220477">Օգնություն ստացեք Thot դիտարկիչի վերաբերյալ</translation>
<translation id="1692689520561928457">JemaOS-ի մասին</translation>
<translation id="8692765844418174375">JemaOS տարբերակ</translation>
<translation id="2943260250558374955">Օգնություն ստացեք JemaOS-ի վերաբերյալ</translation>
<translation id="713321354492170993">Դիտարկիչը ազատում է հիշողություն ոչ ակտիվ ներդիրներից։ Սա ակտիվ ներդիրներին և այլ հավելվածներին տալիս է ավելի շատ հաշվողական ռեսուրսներ և պահպանում է դիտարկիչը արագ։ Ձեր ոչ ակտիվ ներդիրները ավտոմատ կերպով նորից ակտիվանում են, երբ վերադառնում եք դրանց։</translation>
<translation id="1774190491044887444">Դիտարկիչը խնայում է մարտկոցը՝ սահմանափակելով ֆոնային գործունեությունը և տեսողական էֆեկտները, ինչպիսիք են սահուն ոլորումը և տեսանյութի կադրերի արագությունը։</translation>
<translation id="180121268008059459">Դիտարկիչը նախապես բեռնում է էջերը՝ դարձնելով դիտարկումը և որոնումը ավելի արագ։</translation>
<translation id="7127093527178692287">Վերականգնել կրկնօրինակը (բետա)</translation>
<translation id="4439042171549201806">JemaOS-ը կրկնօրինակի ֆայլից վերականգնելու համար խնդրում ենք այժմ տեղադրել շարժական սկավառակը, որը պարունակում է կրկնօրինակի ֆայլը, ձեր JemaOS սարքի մեջ և նշեք, թե որ կրկնօրինակի ֆայլն եք ցանկանում վերականգնել։ Խնդրում ենք նկատի ունենալ, որ ձեր կրկնօրինակի ֆայլը պետք է լինի շարժական սկավառակի արմատային գրացուցակում, որպեսզի այս օգնականը հայտնաբերի այն։</translation>
<translation id="2955409026764742995">Ընտրեք վերականգնվելիք կրկնօրինակի ֆայլը՝</translation>
<translation id="7040434808685140085">Ցավոք, ընտրված կրկնօրինակի ֆայլը հնարավոր չէ ճանաչել. խնդրում ենք ընտրել նորը։</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />JemaOS-ը ընտրված կրկնօրինակի ֆայլից վերականգնելու համար անհրաժեշտ է ունենալ ճշգրիտ տեղեկատվություն կրկնօրինակի ստեղծման պահի մասին։ Հակառակ դեպքում վերականգնման գործընթացը ձախողվելու է։<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />«Հաշվի անունը» այն հաշվի հիմնական մուտքի տվյալն է, որի ներքո ստեղծվել է ձեր կրկնօրինակի ֆայլը։ Սա սովորաբար այն էլ. փոստի հասցեն է, որը դուք օգտագործել եք ձեր JemaOS/Google հաշիվ գրանցվելու համար։ Եթե դա տեղական հաշիվ լիներ, ապա դա կլիներ օգտանունը՝ կցված «@jemaos.local»-ով։<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />Գաղտնաբառը այն գաղտնաբառի արտահայտությունն է, որը ձեզ խնդրել էին մուտքագրել կրկնօրինակի ստեղծման ժամանակ։ Սա սովորաբար նույն գաղտնաբառն է, որը դուք օգտագործել եք այս հաշվի համար JemaOS աշխատասեղան մուտք գործելու համար։<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">Հաշվի անուն</translation>
<translation id="5490570429039308155">Ցավոք, խնդրում ենք մուտքագրել ճիշտ հաշվի անունը</translation>
<translation id="6657585470893396449">Գաղտնաբառ</translation>
<translation id="8200189938001188563">Ցավոք, գաղտնաբառը չի կարող դատարկ լինել</translation>
<translation id="3157931365184549694">Վերականգնել</translation>
<translation id="8556278756526311953">Կրկնօրինակի վերականգնում</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />Մենք այժմ աշխատում ենք ձեր կրկնօրինակի ֆայլի վերականգնման վրա. սա կարող է որոշ ժամանակ տևել, ուստի խնդրում ենք լինել համբերատար։<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />Խնդրում ենք նկատի ունենալ, որ օգտատիրոջ ինտերֆեյսը ավտոմատ կերպով վերամեկնարկվելու է, երբ վերականգնման գործընթացը հաջողությամբ ավարտվի։<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">Կրկնօրինակի վերականգնումը ձախողվեց</translation>
<translation id="5003531399442003695">Լրացուցիչ մանրամասների համար խնդրում ենք սեղմել ստորև բերված հղումը՝ գրանցամատյանները դիտելու համար։ Եթե այս սխալը շարունակվում է, խնդրում ենք կապ հաստատել JemaOS տեխնիկական աջակցության ալիքների հետ և տրամադրել սխալների գրանցամատյանները։</translation>
<translation id="6363786367719063276">Դիտել գրանցամատյանները</translation>
<translation id="8730621377337864115">Պատրաստ է</translation>
<translation id="975238173507911396">Տվյալների վերականգնումը հաջող է</translation>
<translation id="6276879052695618521">Կրկնօրինակի վերականգնման գրանցամատյաններ</translation>
<translation id="4901207598072637766">JemaOS, տրամադրված <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" />-ի կողմից</translation>
<translation id="7894910504474624324">JemaOS-ը և իր ծառայությունները համապատասխանում են GDPR-ին և եվրոպական տվյալների պաշտպանության օրենքի դրույթներին։ Լրացուցիչ տեղեկատվության համար խնդրում ենք տեսնել մեր <ph name="BEGIN_LINK_PRIVACY" />Գաղտնիության քաղաքականությունը<ph name="END_LINK_PRIVACY" /> և մեր <ph name="BEGIN_LINK_TOS" />Ծառայության պայմանները։<ph name="END_LINK_TOS" /></translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, բոլոր իրավունքները պաշտպանված են։</translation>
<translation id="370679569376308836">JemaOS-ը կոմերցիոն առաջարկ է, որը հիմնված է Jema սարքի և իր SaaS-ի վրա։</translation>
<translation id="2773644194450163486">JemaOS-ը հնարավոր է դարձել <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> բաց կոդով նախագծի շնորհիվ։</translation>
<translation id="2330680727776977160">Chromium-ը նույնպես հնարավոր է դարձել այլ <ph name="BEGIN_LINK_1" />բաց կոդով ծրագրային ապահովման<ph name="END_LINK_1" /> և <ph name="BEGIN_LINK_2" />լրացուցիչ բաց կոդով ծրագրային ապահովման<ph name="END_LINK_2" /> շնորհիվ։</translation>
<translation id="1419954813084261088">Նախագծված և արտադրված է Jema Technology-ի կողմից։</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, բոլոր իրավունքները պաշտպանված են։</translation>
<translation id="6168072053306020326">Jema Technology-ն Jema Technology LTD-ի և Jema Technology (Beijing) Limited-ի առևտրային անունն է։
        <ph name="LINE_BREAK" />
        Jema Technology LTD-ն ընկերություն է, որը գրանցված է Անգլիայում և Ուելսում 12273803 ընկերության համարով։</translation>
<translation id="1251589813188467292">Սարքի երաշխիքի և սպասարկման կարևոր տեղեկատվություն</translation>
<translation id="4851115775198886021">Սարքի SN.</translation>
</translationbundle>
