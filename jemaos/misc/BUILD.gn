import("//build/config/chromeos/rules.gni")
import("//jemaos/build/config/buildflags.gni")

assert(is_chromeos, "Non-Chrome-OS builds must not depend on //chromeos")

static_library("misc") {
  deps = [
    "//base",
    "//net",
    "//content/public/browser",
    "//jemaos/build/config:buildflags",
  ]

  sources = [
    "jemaos_email_subscription.cc",
    "jemaos_email_subscription.h",
    "jemaos_misc_scheduler.cc",
    "jemaos_misc_scheduler.h",
    "jemaos_device_uid.cc",
    "jemaos_device_uid.h",
    "jemaos_statistics_collector.cc",
    "jemaos_statistics_collector.h",
    "jemaos_release_note_url.cc",
    "jemaos_release_note_url.h",
    "jemaos_toggle_ota.cc",
    "jemaos_toggle_ota.h",
    "jemaos_dev_mode.cc",
    "jemaos_dev_mode.h",
  ]

  if (use_jemaos_com) {
    sources += [
      "jemaos_crostini_notifier.cc",
      "jemaos_crostini_notifier.h",
    ]
  }

  defines = [ "CHROMEOS_IMPLEMENTATION" ]
}
