<translation id="2896503748067813182">ಪ್ರಾಯೋಗಿಕ ಚಂದಾದಾರಿಕೆ</translation>
<translation id="4362781408813685579">ಸಕ್ರಿಯ ಚಂದಾದಾರಿಕೆ</translation>
<translation id="1141274201089997510">ಮುಗಿದ ಚಂದಾದಾರಿಕೆ</translation>
<translation id="2553683254139782404">ವಾಣಿಜ್ಯೇತರ ಆವೃತ್ತಿ</translation>
<translation id="8466048683756385518">ಎಂಟರ್‌ಪ್ರೈಸ್ ಪರವಾನಗಿ ಆವೃತ್ತಿ (ಪ್ರಾಯೋಗಿಕ)</translation>
<translation id="2853871047705932424">ಎಂಟರ್‌ಪ್ರೈಸ್ ಪರವಾನಗಿ ಆವೃತ್ತಿ</translation>
<translation id="5239675900317881945">ಎಂಟರ್‌ಪ್ರೈಸ್ ಪರವಾನಗಿ ಆವೃತ್ತಿ (ಮುಗಿದಿದೆ)</translation>
