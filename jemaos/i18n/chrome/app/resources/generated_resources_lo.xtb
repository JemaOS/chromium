<translation id="8986197796475507452">ເອີ້ນທາງເລືອກ JemaOS AI ຢ່າງໄວສຳລັບເນື້ອຫາທີ່ເນັ້ນ ໂດຍກົດ Ctrl + C + C</translation>
<translation id="6407628130593274137">ການຕັ້ງຄ່າ ແລະ ທາງເລືອກອື່ນໆສຳລັບ JemaOS AI</translation>
<translation id="4005574560653331142">ເພື່ອປ່ຽນ PIN ຫຼື ລະຫັດຜ່ານເຂົ້າສູ່ລະບົບຂອງບັນຊີທ້ອງຖິ່ນນີ້, ໄປທີ່ການຕັ້ງຄ່າ <ph name="BEGIN_LINK" />ຄວາມເປັນສ່ວນຕົວ ແລະ ຄວາມປອດໄພ<ph name="END_LINK" />.</translation>
<!-- login_strings (JemaOS) -->
<translation id="6419913024856619425">ທ່ານສາມາດ<ph name="LINK_START" />ເຂົ້າສູ່ລະບົບດ້ວຍບັນຊີ JemaOS ທ້ອງຖິ່ນ<ph name="LINK_END" />ໄດ້.</translation>
<translation id="5291842596976929391">ອີເມວ <ph name="EMAIL_ADDRESS" /> ມີຢູ່ແລ້ວ. ກະລຸນາລອງໃໝ່ດ້ວຍອີເມວອື່ນ.</translation>
<translation id="4519800823932975782">ສູນຊ່ວຍເຫຼືອ JemaOS</translation>
<translation id="4737474693231655139">ຊອກຫາບົດຄວາມຊ່ວຍເຫຼືອ ແລະ ຄຳຕອບສຳລັບຄຳຖາມ JemaOS ທົ່ວໄປ</translation>
</translationbundle>
