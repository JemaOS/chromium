<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="am">
	<translation id="7386402409475121504">የአካባቢዎን የJemaOS መለያ ይፍጠሩ</translation>
	<translation id="3760308806144055927">በአካባቢዎ የ JemaOS መለያ ይግቡ</translation>
	<translation id="3325117507482096812">እባክዎ የይለፍ ቃል ያስገቡ</translation>
	<translation id="1838206877831947154">የይለፍ ቃላትህ አይዛመዱም።</translation>
	<translation id="2158276988029582286">አዲስ የአካባቢ መለያ ይፍጠሩ</translation>
	<translation id="8592849747346274067">ወደ ነባር መለያ ይግቡ</translation>
	<translation id="482190417986201746">ያስገቡት የተጠቃሚ ስም ወይም የይለፍ ቃል የተሳሳተ ነው።</translation>
	<translation id="6603987686259425085">በJemaOS አካባቢያዊ መለያ <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>መግባት ትችላለህ<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>።</translation>
	<translation id="3598802966230712759">ኢሜይል <ph name="EMAIL_ADDRESS">$1</ph> አስቀድሞ አለ። እባክህ በሌላ ኢሜይል እንደገና ሞክር።</translation>
	<translation id="7215016743510876720">የአካባቢ መለያ ይጠቀሙ</translation>
	<translation id="6657635042185516718">የመስመር ላይ መለያ መጠቀሙን ይቀጥሉ</translation>
	<translation id="6867476688065565618">ወደ አካባቢያዊ መለያ ይቀይሩ?</translation>
	<translation id="4840454774882557974">አካባቢያዊ መለያ ለመጠቀም ከመረጡ ጠቃሚ ባህሪያት የእርስዎን ውሂብ እና ምርጫዎች በበርካታ መሳሪያዎች ላይ ማመሳሰልን ያካትታሉ እና የ JemaOS መለያዎን ተጠቅመው ወደ ድር መተግበሪያዎች በራስ-ሰር መግባት አይሰራም።</translation>
	<translation id="8951507920859729424">JemaOSን ሙሉ በሙሉ ለመጠቀም የመስመር ላይ መለያ እንድትጠቀም እንመክራለን።</translation>
	<translation id="479773200536372215">የጎግል ኤፒአይ ቁልፎች ስለሌሉ የጉግል መለያዎችን ማከል አይችሉም። ለዝርዝር መረጃ <ph name= "DETAILS_URL">$1<ex>http://www.example.com</ex></ph>ን ይመልከቱ።</translation>
	<translation id="1198491307547164157">የJemaOS ኤፒአይ ቁልፎች ስለሌሉ የJemaOS መለያዎችን ማከል አይችሉም። ለዝርዝር መረጃ <ph name= "DETAILS_URL">$1<ex>http://www.example.com</ex></ph>ን ይመልከቱ።</translation>
	<translation id="5042404702659901995">የግላዊነት መግለጫ</translation>
	<translation id="4907736162587268100">የግላዊነት መግለጫ ይዘቶች</translation>
	<translation id="5988344732274877691">ለጀማኦኤስ (በጣም አልፎ አልፎ፣ ቃል የተገባለት) ጋዜጣ ይመዝገቡ</translation>
	<translation id="1706203008474708805">የJemaOS የተጠቃሚ ተሞክሮ ማሻሻያ ዕቅድን ይቀላቀሉ</translation>
	<translation id="1147139514756087229">በአካባቢያዊ መለያ ይግቡ</translation>
	<translation id="2054784944085654098">አሁን የምትኬ ፋይል በመፍጠር ላይ። ይህ ትንሽ ጊዜ ሊወስድ ይችላል; እባክዎ ይጠብቁ…</translation>
	<translation id="3554401467586751874">የመጠባበቂያ ፋይል በተሳካ ሁኔታ ተፈጥሯል።</translation>
	<translation id="2349211327705667074">የምትኬ ፋይልን ተመልከት</translation>
	<translation id="6337433855796857931">ምትኬ አልተሳካም።</translation>
	<translation id="3049367131589710124">የስህተት ምዝግብ ማስታወሻን ይመልከቱ</translation>
	<translation id="1079017345574916945">የርቀት ዴስክቶፕ</translation>
	<translation id="3064478898280877715">የመተግበሪያ መደብር</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">ጫኝ</translation>
	<translation id="2173278076276376488">ይህ መገልገያ <ph name= "DEVICE_OS">$1<ex>JemaOS</ex></ph>ን በዚህ መሳሪያ ውስጣዊ ማከማቻ ላይ እንድትጭን ይረዳሃል።</translation>
	<translation id="5323182426977498659">ማስጠንቀቂያ! ይህ አሰራር አጥፊ ስለሆነ ሊቀለበስ አይችልም። እባክዎ ለዳታ መጥፋትዎ ምንም አይነት ሀላፊነት እንደማንወስድ ወይም ምንም አይነት አስቸኳይ የቴክኒክ ድጋፍ እንደማንሰጥ እባክዎን በእራስዎ ሃላፊነት ይቀጥሉ።</translation>
	<translation id="8517836015601969896">ሙሉ ዲስክ መጫን</translation>
	<translation id="7300045760790370189">ሙሉ ሃርድ ዲስክን ለመያዝ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን ይጫኑ፣ ሁሉም የታለመው ሃርድ ዲስክ ውሂብ ይጠፋል።</translation>
	<translation id="8762511733918256595">ባለብዙ-ቡት መጫኛ</translation>
	<translation id="248900698427753678">Install <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> to an existing partition of a hard disk, where <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> can exist in parallel with other OS. All data on the target partition will be wiped.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> በመረጡት ሃርድ ድራይቭ ላይ ይጫናል፤ በታለመው ዲስክ ላይ ያሉ ሁሉም መረጃዎች ይደመሰሳሉ.</translation>
	<translation id="4039091757234555415">ዲስክ</translation>
	<translation id="7783580523889684697">ምንም ዲስክ አይገኝም</translation>
	<translation id="8217653566575018388">መጫኑ ተጠናቅቋል</translation>
	<translation id="8846746259444262774">መጫኑ አልተሳካም።</translation>
	<translation id="7263815009235541549">መጫኑ በተሳካ ሁኔታ ተጠናቅቋል። እባክዎ መጀመሪያ መሳሪያዎን ያጥፉት፣ ከዚያ ማንኛውንም የመጫኛ ሚዲያ ያስወግዱ እና <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን ለማስነሳት እንደገና ያብሩት።</translation>
	<translation id="3380151284134965398">ውይ፣ የሆነ ችግር ተፈጥሯል እና መጫኑ አልተጠናቀቀም። እባክዎ ሂደቱን እንደገና ይሞክሩ። ተመሳሳይ ስህተት ከቀጠለ፣ እባክዎ ከላይ ባለው ምዝግብ ማስታወሻ የJemaOS ድጋፍን ያግኙ።</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> በተመረጠው የሃርድ ድራይቭ ክፋይ ላይ ይጫናል። አሁን ባለው ባለብዙ ቡት አሰራር፣ ይሄ ሊቀጥል የሚችለው መሳሪያዎ UEFIን የሚደግፍ ከሆነ እና ሃርድ ዲስኮችዎ በጂፒቲ ከተቀረጹ ብቻ ነው።</translation>
	<translation id="7831363758161884243">የታለመው ክፍልፋይ ይጸዳል; ጫኚው የስርዓት ማስነሻ አወቃቀሮችን ማሻሻል ስለሚያስፈልገው የነቃ የEFI ክፍልፍልዎን (ብዙውን ጊዜ በራስ-ሰር ይከናወናል) መግለጽ ያስፈልግዎታል።</translation>
	<translation id="5670799238446305550">የ<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ኢላማ ክፍልፍልን ይምረጡ</translation>
	<translation id="3695537760133394753">ክፍልፍል</translation>
	<translation id="5610519566593708119">EFI ክፍልፍልን ይምረጡ</translation>
	<translation id="3367650349940010965">ለተመረጠው ዲስክ ምንም ክፍልፋዮች የሉም</translation>
	<translation id="7453223384507098390">ለተመረጠው ዲስክ ምንም የ EFI ክፍልፋዮች የሉም</translation>
	<translation id="1854532683465500847">የተመረጠው ክፍልፋይ መጠን ከ 20 ጂቢ ያነሰ ነው, መጫኑ ላይሳካ ይችላል</translation>
	<translation id="4144613075340468247">የተመረጠው ክፍልፋይ ወደ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ባለብዙ ቡት ላይ ተጭኗል፣ እሱን መጫን እንደገና ሊሳካ ይችላል።</translation>
	<translation id="5793361052649920836">ከተጫነ በኋላ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን እንዴት ማስነሳት ይፈልጋሉ?</translation>
	<translation id="4273235330352963866">ለእኔ reEFind ን ጫን እና አዋቅር (የሚመከር)</translation>
	<translation id="1858708492548921044">rEFind የቡት ማናጀር ፕሮግራም ነው ፒሲዎ ሲጀመር ለስርዓተ ክወና ማስነሻ አማራጮች ጥሩ ስዕላዊ በይነገጽ የሚያቀርብ፣ በሱ ለማስነሳት የሚፈልጉትን ስርዓተ ክወና መምረጥ ይችላሉ። ስለ reFind ለበለጠ መረጃ፣እባክዎ መነሻ ገጹን ይመልከቱ።</translation>
	<translation id="3861924051442564602">ለእኔ የ UEFI ማስነሻ ምናሌ አማራጭ ያክሉ</translation>
	<translation id="8622370666798589804">የእርስዎ ፒሲ ሲጀምር የUEFI ማስነሻ አማራጮችን ምናሌ ውስጥ ማስገባት ይችሉ ይሆናል (በአብዛኛው hotkey በመጫን) ይህ አማራጭ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን ወደ ምናሌው እንደ መግቢያ ይጨምራል። (አንዳንድ የ BIOS እና UEFI firmware ሞዴሎችን ብቻ ይደግፋል)።</translation>
	<translation id="1569398690544416170">እዚህ ምንም ነገር አታድርጉ, እኔ ራሴ አዋቅረዋለሁ</translation>
	<translation id="3554866444001249532">ይህ የመጫኛ ስክሪፕት <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን ወደ የእርስዎ EFI ክፍልፍል ለማስነሳት አስፈላጊ የሆኑ .efi ፋይሎችን ብቻ ያስቀምጣል።እንዴት እንደሚነሳ በራስዎ ማዋቀር ያስፈልግዎታል።</translation>
	<translation id="7492832751164189534">ለመልቀቅ አስገድድ</translation>
	<translation id="5159534860632584026">የመጫን ሂደቱ ተቋርጧል</translation>
	<translation id="8686749782014838344">የዲስክ መረጃ ማግኘት አልተሳካም።</translation>
	<translation id="5688543378771259173">መጫኑ እየተቋረጠ ነው...</translation>
	<translation id="5350452134936384991">በዩኤስቢ ውስጥ ጫን</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ን በዩኤስቢ ዲስክ ላይ ይጫኑ። በታለመው የዩኤስቢ ዲስክ ላይ ያለ ሁሉም ውሂብ ይጠፋል።</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> በተመረጠው ዩኤስቢ ዲስክ ላይ ይጫናል፤ በታለመው ዲስክ ላይ ያሉ ሁሉም መረጃዎች ይደመሰሳሉ.</translation>
	<translation id="5725593226060700263">ምንም የዩኤስቢ ዲስክ አይገኝም</translation>
	<translation id="4357040841587078287">ይህን የJemaOS ቅጂ ከወረደ የምስል ፋይል እያስኬዱ እንደሆነ ደርሰንበታል። JemaOS ሊያቀርባቸው የሚችሉትን ሁሉን አቀፍ የድጋፍ ባህሪያትን (ከአየር ላይ ዝማኔዎችን ጨምሮ) ለመጠቀም የጄማኦስን ሙሉ ዲስክ ወደተለየ የማከማቻ መሳሪያ ለመጫን የ"Installer" ተግባርን እንድትጀምሩ አበክረን እንመክርዎታለን።</translation>
	<translation id="1246398339704431302">ይህንን የJemaOS ቅጂ ለመጠቀም <ph name="LINK_BEGIN">&amp;lt;span id="continue- anyway"&amp;gt;</ph>ለመቀጠል ይችላሉ።</translation>
	<translation id="3654532222088291133">ለመግባት የJemaOS መለያ ይለፍ ቃልዎን ከማስገባት ይልቅ ለዚህ መሳሪያ <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> ይለፍ ቃል መፍጠር ይችላሉ።</translation>
	<translation id="8377684629839541977">የJemaOS መለያ ይለፍ ቃል ይጠቀሙ</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" /> በራስ-ሰር እንዲዘምን ያድርጉ</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> ዝማኔ ነቅቷል</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> ዝማኔ ተሰናክሏል</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) መድረክ <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">የርቀት ዴስክቶፕ</translation>
<translation id="6898090158927982244">Linuxዎ ወቅታዊ ነው</translation>
<translation id="4886703929102211360">ለLinux (ቤታ) ክፍል አስፈላጊ ዝማኔ ይገኛል። ይህን ዝማኔ በተቻለ ፍጥነት መጫን በጽኑ ይመከራል፤ አለዚያ Linux (ቤታ)ዎ መስራት ሊያቆም ይችላል።</translation>
<translation id="6694016202036959050">የ<ph name="DEVICE_OS" /> ቅንብሮች</translation>
<translation id="8362858344151826493">የJemaOS መለያ፣ ምትኬ፣ የተለያዩ</translation>
<translation id="9150429437595727962">የWi-Fi ቅንብሮች</translation>
<translation id="4938972461544498524">የነካች ፓድ ቅንብሮች</translation>
<translation id="1210024513248363065">የርቀት አገልግሎቶች</translation>
<translation id="2878862288885588535">የርቀት ምርመራ አገልግሎት</translation>
<translation id="7409197984340676806">የርቀት ምርመራ አገልግሎት ኦፊሴላዊ የJemaOS ድጋፍ ተወካዮች የስርዓት ችግሮችን እንዲለዩ ያስችላል። በአሁኑ ጊዜ የርቀት ምርመራ አገልግሎት ሊጀምር የሚችለው በኦፊሴላዊ የJemaOS ድጋፍ ተወካዮች ብቻ ነው።</translation>
<translation id="1791028023086176332">እባክዎ ይህን ቁጥር ከኦፊሴላዊ የJemaOS ድጋፍ ተወካዮች ጋር ያጋሩ</translation>
<translation id="6279304275399437025">የርቀት ምርመራ አገልግሎትን በማስጀመር ላይ...</translation>
<translation id="1501882165699826662">እባክዎ የርቀት ምርመራ አገልግሎቱን ያቁሙ እና እንደገና ይሞክሩ</translation>
<translation id="3100283258447375201">ተጨማሪ መረጃ</translation>
<translation id="4070039109671307724">የተለያዩ</translation>
<translation id="7326893024940073254">"እንደገና ጀምር" አዝራር</translation>
<translation id="3002423764319968103">በስርዓት ምናሌ ውስጥ "እንደገና ጀምር" አዝራር አሳይ</translation>
<translation id="6243454903512423518">"ማያ ገጽ አሽከርክር" አዝራር</translation>
<translation id="6491049336868978729">አሁን በታብሌት ሁነታ ላይ አይደለዎትም፣ "ማያ ገጽ አሽከርክር" አዝራሩ ተደብቋል</translation>
<translation id="5496012402277579695">በስርዓት ምናሌ ውስጥ "ማያ ገጽ አሽከርክር" አዝራር አሳይ</translation>
<translation id="5882838977344999606">የታብሌት/ላፕቶፕ ሁነታ ቀዳዳ</translation>
<translation id="472164133625585606">በስርዓት ምናሌ ውስጥ የታብሌት/ላፕቶፕ ሁነታ ቀዳዳ አሳይ</translation>
<translation id="1851103550468466960">Widevineን አንቃ</translation>
<translation id="4058176713282795846">የተጠበቀ ፕሪሚየም ይዘትን ለመስራጨት Widevineን ያንቁ። <ph name="BEGIN_LINK_LEARN_MORE" />የበለጠ ይወቁ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so"ን ይምረጡ</translation>
<translation id="4838463656205005584">Widevineን ማንቃት አልተሳካም...</translation>
<translation id="2164041826798266548">የWidevine CDM ሞዱል መጫኛ አልተሳካም። እባክዎ ግንኙነትዎን ያረጋግጡ እና እንደገና ይሞክሩ።</translation>
<translation id="4106982328079440606">የJemaOS መለያ ቅንብሮች</translation>
<translation id="6468776556018764845">የሙከራ ባህሪያት</translation>
<translation id="3487615413425326553">የTrusted Platform Module (TPM) ምርመራዎችን ዝለል</translation>
<translation id="4817176087932811573">አንዳንድ ባህሪያት በመሣሪያዎ ውስጥ ባለው የማይጣጣም TPM ቺፕ ሊከሽፉ ይችላሉ፤ እንደ አማራጭ መፍትሔ የTPM ምርመራዎችን መዝለል ይችላሉ።</translation>
<translation id="3356003366173774486">ራስ-ሰር መግባት</translation>
<translation id="6218459410891191693">መሣሪያው ሲጀምር ወደ ዴስክቶፕ በራስ-ሰር እንዲገባ ለአሁኑ መለያ ይፍቀዱ</translation>
<translation id="6620839363422062843">ለዚህ መለያ ማንቃት አይቻልም፤ ራስ-ሰር መግባት በዚህ መሣሪያ ላይ ለሌሎች መለያዎች አስቀድሞ ንቁ ነው</translation>
<translation id="6734500226490446035">ለዚህ መለያ ማንቃት አይቻልም፤ ለዚህ መለያ የፋይል ስርዓቶችን ሲዘጋጅ ያልታወቀ ስህተት ተከስቷል። እባክዎ እንደገና ማስጀመርን ወይም አዲስ መለያ መፍጠርን ይሞክሩ</translation>
<translation id="5464880042146818691">ለዚህ መለያ ማንቃት አይቻልም፤ የራስ-ሰር መግባት አማራጭ ለ"አካባቢያዊ መለያ" አይነት ብቻ ነው የሚገኘው።</translation>
<translation id="3335654854106476749">ራስ-ሰር መግባትን ከማንቃትዎ በፊት እባክዎ በ<ph name="BEGIN_LINK" />ግላዊነት እና ደህንነት<ph name="END_LINK" /> ቅንብሮች ውስጥ የመግቢያ ይለፍ ቃል ይጨምሩ።</translation>
<translation id="5586831602198585601">አዲስ የJemaOS ስሪት አሁን ለዝማኔ ይገኛል። ሆኖም የJemaOS for You ደንበኝነትዎ አብቅቷል፤ JemaOSዎን ለማዘመን ንቁ ደንበኝነት ያስፈልግዎታል።</translation>
<translation id="3869860597719956574">አዲስ ዋና የJemaOS ስሪት አሁን ለዝማኔ ይገኛል። በዚህ ዝማኔ ለመቀጠል የአንድ ጊዜ ክፍያ መክፈል አለብዎት።</translation>
<translation id="6523879681771260760">እባክዎ የምትኬ ፋይሉን ለማከማቸት መንገዱን ይግለጹ</translation>
<translation id="2036152819788683293">ለዚህ መለያ የምትኬ ፋይል ይፍጠሩ (ቤታ)። <ph name="BEGIN_LINK_LEARN_MORE" />የበለጠ ይወቁ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">ምትኬ ፍጠር</translation>
<translation id="4267347174163690295">ለዚህ መለያ የምትኬ ፋይል ይፍጠሩ (ቤታ)።</translation>
<translation id="8112950994208888917">ይህ ክዋኔ ለዚህ መለያ ሙሉ የዲስክ ምትኬ ይፈጥራል፤ ይህም JemaOSዎን ምትኬው ሲፈጠር ወደነበረበት ሁኔታ ለመመለስ ያመቻቻል፤ ቅንብሮችን፣ የተጫኑ የማሰሻ ቅጥያዎችን እና የንዑስ ስርዓት መተግበሪያዎችን ጨምሮ። እንደ መተግበሪያዎችዎ እና የመነሻ አቃፊዎ ይዘት መጠን የምትኬ ፋይሉ ትልቅ ሊሆን ይችላል፤ የምትኬ ፋይሉን በውጪ ማከማቻ መሣሪያ ላይ ማከማቸት ይመከራል። ተንቀሳቃሽ USB ድራይቭ ካለዎት፣ እባክዎ አሁን ያግኙ። <ph name="BEGIN_LINK_LEARN_MORE" />የበለጠ ይወቁ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">እባክዎ የዚህን መለያ የመግቢያ ይለፍ ቃል ያስገቡ</translation>
<translation id="8663988871299316062">እባክዎ ይህን ይለፍ ቃል ያስታውሱ፣ ምክንያቱም ይህን ምትኬ ፋይል ሲመልሱ ያስፈልጋል</translation>
<translation id="6408904153044317846">የሚመለሱትን የምትኬ ፋይል ይምረጡ</translation>
<translation id="8062988348127771021">የJemaOS ውሂብዎን ከምትኬ ፋይል ይመልሱ</translation>
<translation id="7309192418866543730">የምትኬ ይለፍ ቃል ያስገቡ</translation>
<translation id="3642408376366598984">ይህን ምትኬ ፋይል ለመስጠር የተጠቀምከውን ይለፍ ቃል ያስገቡ</translation>
<translation id="7783974937157985523">የምትኬ ይለፍ ቃል</translation>
<translation id="6583780301401541007">መመለስ ተሳክቷል</translation>
<translation id="3514011352559420398">መመለስ አልተሳካም</translation>
<translation id="7535980903266533458">ምትኬውን በመሣሪያዎ ላይ ወይም በውጪ ማከማቻ ያስቀምጡ</translation>
<translation id="604001903249547235">የደመና ምትኬ</translation>
<translation id="8885702701336541611">ምትኬውን ወደ JemaOS የደመና ማከማቻ ይላኩ</translation>
<translation id="3939744430096549862">ወደ ደመና ምትኬ ፍጠር</translation>
<translation id="619129431573254316">ከአካባቢ የምትኬ ፋይል መልስ</translation>
<translation id="1859592711955106569">የደመና መመለሻ</translation>
<translation id="38222223336741457">ከJemaOS ደመና ያውርዱ እና ይመልሱ</translation>
<translation id="1241089811244416179">ከደመና መልስ</translation>
<translation id="652479689372703360">ምትኬ በሂደት ላይ</translation>
<translation id="3655220146274872918">ምትኬ ተጠናቋል</translation>
<translation id="4243579853635792694">ምትኬዎ በተሳካ ሁኔታ ተፈጥሯል</translation>
<translation id="4854179463174744546">በምትኬ ሂደት ወቅት ስህተት ተከስቷል</translation>
<translation id="2410668771600309999">የConnect API ተጠቃሚ መረጃ</translation>
<translation id="2223892939866251845">የተጠቃሚ መታወቂያ</translation>
<translation id="3850846286480935456">የምትኬ ማከማቻ ትንታኔ</translation>
<translation id="6244494465581273970">የተጠቃሚ መታወቂያ ያስፈልጋል</translation>
<translation id="9204006549413740506">መጨረሻ የተዘመነው</translation>
<translation id="476642412165431515">የሃርድዌር መሣሪያዎች</translation>
<translation id="3386337985825120901">ምንም የምትኬ ውሂብ የለም</translation>
<translation id="8490990067870590760">የምትኬ ፋይሎችን በመጫን ላይ...</translation>
<translation id="2955409026764742995">የሚመለሱትን የምትኬ ፋይል ይምረጡ:</translation>
<translation id="7414629348005657242">-- የምትኬ ፋይል ይምረጡ --</translation>
<translation id="918246516374174381">ምንም የምትኬ ፋይሎች አልተገኙም። እባክዎ መጀመሪያ ምትኬ ይፍጠሩ።</translation>
<translation id="77997252117517973">በቅርቡ ይመጣል</translation>
<translation id="1930692852800776096">መዝገበ ቃላት ጨምር</translation>
<translation id="8793060353848771694">የግራ ጆሮ ማዳመጫ ምስል</translation>
<translation id="6257440204887306255">የኃይል መሙያ ሳጥን ምስል</translation>
<translation id="2754700616124958693">የቀኝ ጆሮ ማዳመጫ ምስል</translation>
<translation id="1068676292264983586">ነባሪ የመሣሪያ ምስል</translation>
<translation id="6364075396486660405">የባትሪ ሕይወትን ለማሻሻል ለሁሉም ክፍላዎች የሚዲያ ፋይሎችን ራስ-ሰር ስካን ያሰናክሉ። <ph name="BEGIN_LINK_LEARN_MORE" />የበለጠ ይወቁ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">የደህንነት አማራጮች</translation>
<translation id="5618366106086725045">ለዚህ <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> ገጽታ "የገንቢ ሁነታ"ን ከተጨማሪ የገንቢ ባህሪያት ጋር ያንቁ። <ph name="BEGIN_LINK_LEARN_MORE" />የበለጠ ይወቁ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">አስቀድመው በ"የገንቢ ሁነታ" ውስጥ ነዎት</translation>
<translation id="6074549317340202195">"የገንቢ ሁነታ"ን አንቃ</translation>
<translation id="418781258674176053">ማስጠንቀቂያ! "የገንቢ ሁነታ"ን ማንቃት ሊቀለበስ የማይችል ክዋኔ ነው። "የገንቢ ሁነታ"ን ለማሰናከል ከፈለጉ JemaOSን እንደገና መጫን አለብዎት፣ ይህም ሁሉንም ውሂብ ይሰርዛል። እባክዎ ውሂብዎን ምትኬ ያድርጉ እና በራስዎ ሃላፊነት ይቀጥሉ።</translation>
