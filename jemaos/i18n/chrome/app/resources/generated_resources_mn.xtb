<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="mn">
	<translation id="7386402409475121504">Орон нутгийн JemaOS бүртгэлээ үүсгэ</translation>
	<translation id="3760308806144055927">Орон нутгийн JemaOS бүртгэлдээ нэвтэрнэ үү</translation>
	<translation id="3325117507482096812">Нууц үг оруулна уу</translation>
	<translation id="1838206877831947154">Таны нууц үг таарахгүй байна</translation>
	<translation id="2158276988029582286">Шинэ орон нутгийн бүртгэл үүсгэ</translation>
	<translation id="8592849747346274067">Одоо байгаа данс руугаа нэвтэрнэ үү</translation>
	<translation id="482190417986201746">Таны оруулсан хэрэглэгчийн нэр эсвэл нууц үг буруу байна</translation>
	<translation id="6603987686259425085">Та <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS локал бүртгэлээр<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph> нэвтэрч болно.</translation>
	<translation id="3598802966230712759"><ph name="EMAIL_ADDRESS">$1</ph> имэйл аль хэдийн байна. Өөр имэйлээр дахин оролдоно уу.</translation>
	<translation id="7215016743510876720">Дотоод данс ашиглах</translation>
	<translation id="6657635042185516718">Цахим дансаа үргэлжлүүлэн ашиглах</translation>
	<translation id="6867476688065565618">Дотоод бүртгэл рүү шилжих үү?</translation>
	<translation id="4840454774882557974">Хэрэв та локал акаунт ашиглахаар шийдсэн бол олон төхөөрөмж дээр өгөгдөл, тохиргоогоо синхрончлох, JemaOS бүртгэлээ ашиглан вэб програмд автоматаар нэвтрэх зэрэг ашигтай функцууд багтана.</translation>
	<translation id="8951507920859729424">Бид JemaOS-ийг бүрэн дүүрэн ашиглахын тулд онлайн данс ашиглахыг зөвлөж байна.</translation>
	<translation id="479773200536372215">Google API түлхүүр байхгүй тул та Google бүртгэл нэмэх боломжгүй болно. Дэлгэрэнгүйг <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>-с үзнэ үү.</translation>
	<translation id="1198491307547164157">JemaOS API түлхүүр байхгүй тул та JemaOS бүртгэл нэмэх боломжгүй болно. Дэлгэрэнгүйг <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>-с үзнэ үү.</translation>
	<translation id="5042404702659901995">Нууцлалын мэдэгдэл</translation>
	<translation id="4907736162587268100">Нууцлалын мэдэгдлийн агуулга</translation>
	<translation id="5988344732274877691">JemaOS-д зориулсан (маш ховор, амласан) мэдээллийн товхимолд бүртгүүлнэ үү</translation>
	<translation id="1706203008474708805">JemaOS хэрэглэгчийн туршлагыг сайжруулах төлөвлөгөөнд нэгдээрэй</translation>
	<translation id="1147139514756087229">Орон нутгийн бүртгэлээр нэвтэрнэ үү</translation>
	<translation id="2054784944085654098">Одоо нөөц файл үүсгэж байна. Үүнд хэсэг хугацаа зарцуулагдаж магадгүй; түр хүлээнэ үү...</translation>
	<translation id="3554401467586751874">Нөөц файлыг амжилттай үүсгэсэн</translation>
	<translation id="2349211327705667074">Нөөц файлыг үзэх</translation>
	<translation id="6337433855796857931">Нөөцлөлт амжилтгүй боллоо</translation>
	<translation id="3049367131589710124">Алдааны бүртгэлийг харах</translation>
	<translation id="1079017345574916945">Алсын ширээний компьютер</translation>
	<translation id="3064478898280877715">Апп дэлгүүр</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Суулгагч</translation>
	<translation id="2173278076276376488">Энэ хэрэгсэл нь танд <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г энэ төхөөрөмжийн дотоод санах ойд суулгахад тусална.</translation>
	<translation id="5323182426977498659">Анхааруулга! Энэ процедур нь хор хөнөөлтэй тул буцаах боломжгүй. Бид таны болзошгүй өгөгдлийн алдагдлыг хариуцахгүй бөгөөд яаралтай техникийн дэмжлэг үзүүлэхгүй тул эрсдэлээ өөрөө хариуцна.</translation>
	<translation id="8517836015601969896">Бүрэн диск суурилуулалт</translation>
	<translation id="7300045760790370189">Хатуу дискийг бүхэлд нь эзлэхийн тулд <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г суулгавал зорилтот хатуу дискний бүх өгөгдөл устах болно.</translation>
	<translation id="8762511733918256595">Олон ачаалах суулгац</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г одоо байгаа хатуу дискний хуваалтад суулгаж, <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> нь бусад үйлдлийн системтэй зэрэгцэн байж болно. Зорилтот хуваалт дээрх бүх өгөгдөл устах болно.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г таны сонгосон хатуу диск дээр суулгах болно; зорилтот диск дээрх бүх өгөгдөл устах болно.</translation>
	<translation id="4039091757234555415">Диск</translation>
	<translation id="7783580523889684697">Диск байхгүй байна</translation>
	<translation id="8217653566575018388">Суурилуулалт дууссан</translation>
	<translation id="8846746259444262774">Суулгалт амжилтгүй боллоо</translation>
	<translation id="7263815009235541549">Суулгалт амжилттай дууслаа. <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г ачаалахын тулд эхлээд төхөөрөмжөө унтрааж, суулгах бүх медиаг устгаад дахин асаана уу.</translation>
	<translation id="3380151284134965398">Уучлаарай, ямар нэг зүйл буруу болж, суулгалт дуусаагүй байна. Процессыг дахин оролдоно уу. Хэрэв ижил алдаа гарсаар байвал дээрх бүртгэлийг ашиглан JemaOS-ийн тусламжтай холбогдоно уу.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г таны хатуу дискний сонгосон хэсэг дээр суулгах болно. Одоогийн олон ачаалах схемийн дагуу энэ нь зөвхөн таны төхөөрөмж UEFI-г дэмждэг бөгөөд таны хатуу дискүүд GPT-ээр форматлагдсан тохиолдолд л үргэлжлэх боломжтой.</translation>
	<translation id="7831363758161884243">Зорилтот хуваалтыг арилгах болно; Суулгагч нь системийн ачаалах тохиргоог өөрчлөх шаардлагатай тул та идэвхтэй EFI хуваалтаа (ихэвчлэн автоматаар хийдэг) зааж өгөх хэрэгтэй.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> зорилтот хуваалтыг сонгоно уу</translation>
	<translation id="3695537760133394753">Хуваалт</translation>
	<translation id="5610519566593708119">EFI хуваалтыг сонгоно уу</translation>
	<translation id="3367650349940010965">Сонгосон дискэнд хуваалт байхгүй байна</translation>
	<translation id="7453223384507098390">Сонгосон дискэнд EFI хуваалт байхгүй байна</translation>
	<translation id="1854532683465500847">Сонгосон хуваалтын хэмжээ 20 ГБ-аас бага тул суулгалт амжилтгүй болж магадгүй</translation>
	<translation id="4144613075340468247">Сонгосон хуваалтыг <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> олон ачаалах төхөөрөмжид суулгасан тул дахин суулгаж болохгүй.</translation>
	<translation id="5793361052649920836">Суулгасны дараа та <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г хэрхэн ачаалахыг хүсэж байна вэ?</translation>
	<translation id="4273235330352963866">Миний хувьд rEFInd-г суулгаж тохируулна уу (санал болгож байна)</translation>
	<translation id="1858708492548921044">rEFInd нь ачаалах менежер програм бөгөөд таны компьютер асаалттай үед үйлдлийн системээ ачаалах сонголтуудад зориулсан сайхан график интерфэйсийг санал болгодог бөгөөд та өөрийн хүссэн үйлдлийн системээ сонгох боломжтой. rEFInd-ийн талаарх дэлгэрэнгүй мэдээллийг түүний нүүр хуудаснаас авна уу.</translation>
	<translation id="3861924051442564602">Надад UEFI ачаалах цэсийн сонголтыг нэмнэ үү</translation>
	<translation id="8622370666798589804">Таны компьютер асаалттай үед та UEFI ачаалах сонголтын цэс рүү орох боломжтой (хоолны товчийг дарснаар) энэ сонголт нь <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г тухайн цэсэнд оруулдаг. (Зөвхөн BIOS болон UEFI програм хангамжийн зарим загварыг дэмждэг).</translation>
	<translation id="1569398690544416170">Энд юу ч хийхгүй, би өөрөө тохируулах болно</translation>
	<translation id="3554866444001249532">Энэхүү суулгацын скрипт нь зөвхөн <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г ачаалахад шаардлагатай .efi файлуудыг өөрийн EFI хуваалтад оруулах бөгөөд та үүнийг хэрхэн ачаалахаа өөрөө тохируулах хэрэгтэй болно.</translation>
	<translation id="7492832751164189534">Албадан гарах</translation>
	<translation id="5159534860632584026">Суулгах процессыг зогсоосон</translation>
	<translation id="8686749782014838344">Дискний мэдээллийг авч чадсангүй</translation>
	<translation id="5688543378771259173">Суулгацыг зогсоож байна...</translation>
	<translation id="5350452134936384991">USB дээр суулгана уу</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г USB диск рүү суулгана уу; зорилтот USB диск дээрх бүх өгөгдөл устах болно.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-г таны сонгосон USB дискэнд суулгах болно; зорилтот диск дээрх бүх өгөгдөл устах болно.</translation>
	<translation id="5725593226060700263">USB диск байхгүй байна</translation>
	<translation id="4357040841587078287">Та татаж авсан зургийн файлаас JemaOS-ийн энэ хуулбарыг ажиллуулж байгааг бид илрүүллээ. JemaOS-ийн санал болгож чадах хамгийн иж бүрэн дэмжлэгийн функцуудыг (Агаарт шинэчлэлтүүдийг оруулаад) ашиглахын тулд JemaOS-ийг тусдаа хадгалах төхөөрөмжид бүрэн дискээр суулгахын тулд "Суулгагч" функцийг ажиллуулахыг зөвлөж байна.</translation>
	<translation id="1246398339704431302">Та <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>ямар ч байсан JemaOS-ийн энэ хуулбарыг үргэлжлүүлэн ашиглах боломжтой<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, суулгах процессыг системийн дараагийн шатанд гүйцэтгэх боломжтой хэдий ч энэ хуудаснаас таны бүх өгөгдөл устах болно.</translation>
	<translation id="3654532222088291133">Нэвтрэхийн тулд JemaOS бүртгэлийн нууц үгээ оруулахын оронд та энэ төхөөрөмжид <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> нууц үг үүсгэж болно.</translation>
	<translation id="8377684629839541977">JemaOS дансны нууц үгийг ашиглана уу</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" /> системийг автоматаар шинэчлэх</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> шинэчлэлт идэвхжсэн</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> шинэчлэлт идэвхгүй</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Платформ <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Алсын ажлын ширээ</translation>
<translation id="6898090158927982244">Таны Linux шинэчлэгдсэн байна</translation>
<translation id="4886703929102211360">Linux (бета) бүрэлдэхүүн хэсэгт чухал шинэчлэлт боломжтой байна. Энэ шинэчлэлтийг аль болох хурдан суулгахыг зөвлөж байна, эс бөгөөс таны Linux (бета) ажиллахаа болих магадлалтай.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> тохиргоо</translation>
<translation id="8362858344151826493">JemaOS бүртгэл, нөөцлөлт, бусад</translation>
<translation id="9150429437595727962">Wi-Fi тохиргоо</translation>
<translation id="4938972461544498524">Тачпад тохиргоо</translation>
<translation id="1210024513248363065">Алсын үйлчилгээ</translation>
<translation id="2878862288885588535">Алсын оношлогооны үйлчилгээ</translation>
<translation id="7409197984340676806">Алсын оношлогооны үйлчилгээ нь JemaOS албан ёсны дэмжлэгийн төлөөлөгчдөд системийн асуудлыг тодорхойлох боломж олгодог. Одоогоор алсын оношлогооны үйлчилгээг зөвхөн JemaOS албан ёсны дэмжлэгийн төлөөлөгчид эхлүүлэх боломжтой.</translation>
<translation id="1791028023086176332">Энэ дугаарыг JemaOS албан ёсны дэмжлэгийн төлөөлөгчдөд хуваалцана уу</translation>
<translation id="6279304275399437025">Алсын оношлогооны үйлчилгээ эхэлж байна...</translation>
<translation id="1501882165699826662">Алсын оношлогооны үйлчилгээг зогсоож, дахин оролдоно уу</translation>
<translation id="3100283258447375201">Нэмэлт мэдээлэл</translation>
<translation id="4070039109671307724">Бусад</translation>
<translation id="7326893024940073254">"Дахин ачаалах" товч</translation>
<translation id="3002423764319968103">Систем цэсэнд "Дахин ачаалах" товч харуулах</translation>
<translation id="6243454903512423518">"Дэлгэц эргүүлэх" товч</translation>
<translation id="6491049336868978729">Та одоо таблет горимд байгаагүй тул "Дэлгэц эргүүлэх" товч нуугдсан</translation>
<translation id="5496012402277579695">Систем цэсэнд "Дэлгэц эргүүлэх" товч харуулах</translation>
<translation id="5882838977344999606">Таблет/Зөөврийн компьютер горим солих</translation>
<translation id="472164133625585606">Систем цэсэнд таблет/зөөврийн компьютер горим солих товч харуулах</translation>
<translation id="1851103550468466960">Widevine идэвхжүүлэх</translation>
<translation id="4058176713282795846">Хамгаалагдсан премиум агуулга дамжуулахын тулд Widevine идэвхжүүлнэ үү. <ph name="BEGIN_LINK_LEARN_MORE" />Дэлгэрэнгүй<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" сонгоно уу</translation>
<translation id="4838463656205005584">Widevine идэвхжүүлж чадсангүй...</translation>
<translation id="2164041826798266548">Widevine CDM модуль суулгахад алдаа гарлаа. Холболтоо шалгаад дахин оролдоно уу.</translation>
<translation id="4106982328079440606">JemaOS бүртгэлийн тохиргоо</translation>
<translation id="6468776556018764845">Туршилтын функцууд</translation>
<translation id="3487615413425326553">Trusted Platform Module (TPM) шалгалтыг алгасах</translation>
<translation id="4817176087932811573">Зарим функцууд таны төхөөрөмжийн тохирохгүй TPM чипээс шалтгаалан ажиллахгүй байж болзошгүй; шийдэл болгон TPM шалгалтыг алгасаж болно.</translation>
<translation id="3356003366173774486">Автомат нэвтрэлт</translation>
<translation id="6218459410891191693">Төхөөрөмж дахин ачаалагдахад одоогийн бүртгэл ажлын ширээнд автоматаар нэвтрэхийг зөвшөөрөх</translation>
<translation id="6620839363422062843">Энэ бүртгэлд идэвхжүүлэх боломжгүй; автомат нэвтрэлт энэ төхөөрөмжийн бусад бүртгэлд аль хэдийн идэвхтэй байна</translation>
<translation id="6734500226490446035">Энэ бүртгэлд идэвхжүүлэх боломжгүй; энэ бүртгэлийн файлын системийг эхлүүлэх үед тодорхойгүй алдаа гарлаа. Дахин ачаалах эсвэл шинэ бүртгэл үүсгэж үзнэ үү</translation>
<translation id="5464880042146818691">Энэ бүртгэлд идэвхжүүлэх боломжгүй; автомат нэвтрэлтийн сонголт зөвхөн "Дотоод бүртгэл" төрөлд боломжтой.</translation>
<translation id="3335654854106476749">Автомат нэвтрэлтийг идэвхжүүлэхээс өмнө <ph name="BEGIN_LINK" />Нууцлал ба аюулгүй байдал<ph name="END_LINK" /> тохиргоонд нэвтрэх нууц үг нэмнэ үү.</translation>
<translation id="5586831602198585601">JemaOS системийн шинэ хувилбар одоо шинэчлэхэд боломжтой. Гэвч таны JemaOS for You захиалгын хугацаа дууссан; JemaOS-оо шинэчлэхийн тулд идэвхтэй захиалга хэрэгтэй.</translation>
<translation id="3869860597719956574">JemaOS системийн шинэ гол хувилбар одоо шинэчлэхэд боломжтой. Энэ шинэчлэлтийг үргэлжлүүлэхийн тулд нэг удаагийн төлбөр төлөх ёстой.</translation>
<translation id="6523879681771260760">Нөөцлөх файл хадгалах замыг заана уу</translation>
<translation id="2036152819788683293">Энэ бүртгэлд нөөцлөх файл үүсгэх (бета). <ph name="BEGIN_LINK_LEARN_MORE" />Дэлгэрэнгүй<ph name="END_LINK_LEARN_MORE" /></translation>
