<!DOCTYPE translationbundle>
<translationbundle lang="pa">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot ਬਾਰੇ</translation>
<translation id="5639860668557220477">Thot ਬ੍ਰਾਊਜ਼ਰ ਨਾਲ ਮਦਦ ਲਵੋ</translation>
<translation id="1692689520561928457">JemaOS ਬਾਰੇ</translation>
<translation id="8692765844418174375">JemaOS ਸੰਸਕਰਣ</translation>
<translation id="2943260250558374955">JemaOS ਨਾਲ ਮਦਦ ਲਵੋ</translation>
<translation id="713321354492170993">ਬ੍ਰਾਊਜ਼ਰ ਗ਼ੈਰ-ਸਰਗਰਮ ਟੈਬਾਂ ਤੋਂ ਮੈਮੋਰੀ ਖ਼ਾਲੀ ਕਰਦਾ ਹੈ। ਇਸ ਨਾਲ ਸਰਗਰਮ ਟੈਬਾਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਨੂੰ ਵੱਧ ਕੰਪਿਊਟਿੰਗ ਸਰੋਤ ਮਿਲਦੇ ਹਨ ਅਤੇ ਬ੍ਰਾਊਜ਼ਰ ਤੇਜ਼ ਰਹਿੰਦਾ ਹੈ। ਜਦੋਂ ਤੁਸੀਂ ਗ਼ੈਰ-ਸਰਗਰਮ ਟੈਬਾਂ 'ਤੇ ਵਾਪਸ ਆਉਂਦੇ ਹੋ ਤਾਂ ਉਹ ਆਪਣੇ ਆਪ ਮੁੜ ਸਰਗਰਮ ਹੋ ਜਾਂਦੀਆਂ ਹਨ।</translation>
<translation id="1774190491044887444">ਬ੍ਰਾਊਜ਼ਰ ਬੈਕਗ੍ਰਾਊਂਡ ਗਤੀਵਿਧੀ ਅਤੇ ਸਮੂਥ ਸਕ੍ਰੋਲਿੰਗ ਤੇ ਵੀਡੀਓ ਫ੍ਰੇਮ ਰੇਟ ਵਰਗੇ ਵਿਜ਼ੂਅਲ ਇਫੈਕਟਾਂ ਨੂੰ ਸੀਮਿਤ ਕਰਕੇ ਬੈਟਰੀ ਬਚਾਉਂਦਾ ਹੈ।</translation>
<translation id="180121268008059459">ਬ੍ਰਾਊਜ਼ਰ ਪੰਨਿਆਂ ਨੂੰ ਪਹਿਲਾਂ ਤੋਂ ਲੋਡ ਕਰਦਾ ਹੈ, ਜਿਸ ਨਾਲ ਬ੍ਰਾਊਜ਼ਿੰਗ ਅਤੇ ਖੋਜ ਤੇਜ਼ ਹੁੰਦੀ ਹੈ।</translation>
<translation id="7127093527178692287">ਬੈਕਅੱਪ ਰੀਸਟੋਰ ਕਰੋ (ਬੀਟਾ)</translation>
<translation id="4439042171549201806">ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਤੋਂ JemaOS ਨੂੰ ਰੀਸਟੋਰ ਕਰਨ ਲਈ, ਕਿਰਪਾ ਕਰਕੇ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਵਾਲੀ ਰਿਮੂਵਬਲ ਡ੍ਰਾਈਵ ਨੂੰ ਹੁਣ ਆਪਣੇ JemaOS ਡਿਵਾਈਸ ਵਿੱਚ ਪਾਓ ਅਤੇ ਦੱਸੋ ਕਿ ਤੁਸੀਂ ਕਿਹੜੀ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਰੀਸਟੋਰ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ। ਕਿਰਪਾ ਕਰਕੇ ਧਿਆਨ ਦਿਓ ਕਿ ਇਸ ਵਿਜ਼ਾਰਡ ਵੱਲੋਂ ਖੋਜੀ ਜਾਣ ਲਈ ਤੁਹਾਡੀ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਤੁਹਾਡੀ ਰਿਮੂਵਬਲ ਡ੍ਰਾਈਵ ਦੀ ਰੂਟ ਡਾਇਰੈਕਟਰੀ ਵਿੱਚ ਹੋਣੀ ਲਾਜ਼ਮੀ ਹੈ।</translation>
<translation id="2955409026764742995">ਰੀਸਟੋਰ ਕਰਨ ਲਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਚੁਣੋ:</translation>
<translation id="7040434808685140085">ਮਾਫ਼ ਕਰਨਾ, ਚੁਣੀ ਗਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਪਛਾਣੀ ਨਹੀਂ ਜਾ ਸਕੀ; ਕਿਰਪਾ ਕਰਕੇ ਨਵੀਂ ਫ਼ਾਈਲ ਚੁਣੋ।</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />ਚੁਣੀ ਗਈ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਤੋਂ JemaOS ਨੂੰ ਰੀਸਟੋਰ ਕਰਨ ਲਈ, ਬੈਕਅੱਪ ਬਣਨ ਸਮੇਂ ਦੀ ਸਹੀ ਜਾਣਕਾਰੀ ਹੋਣੀ ਬਹੁਤ ਜ਼ਰੂਰੀ ਹੈ। ਨਹੀਂ ਤਾਂ, ਰੀਸਟੋਰ ਪ੍ਰਕਿਰਿਆ ਅਸਫਲ ਹੋ ਜਾਵੇਗੀ।<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"ਖਾਤਾ ਨਾਮ" ਉਸ ਖਾਤੇ ਦਾ ਮੁੱਖ ਲੌਗਇਨ ਕ੍ਰੈਡੈਨਸ਼ਿਅਲ ਹੈ ਜਿਸ ਅਧੀਨ ਤੁਹਾਡੀ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਬਣਾਈ ਗਈ ਸੀ। ਇਹ ਆਮ ਤੌਰ 'ਤੇ ਤੁਹਾਡੇ JemaOS/Google ਖਾਤੇ ਲਈ ਸਾਈਨ ਅੱਪ ਕਰਨ ਲਈ ਵਰਤਿਆ ਗਿਆ ਈਮੇਲ ਪਤਾ ਹੁੰਦਾ ਹੈ। ਜੇ ਇਹ ਸਥਾਨਕ ਖਾਤਾ ਹੁੰਦਾ, ਤਾਂ ਇਹ "@jemaos.local" ਨਾਲ ਜੋੜਿਆ ਗਿਆ ਉਪਭੋਗਤਾ ਨਾਮ ਹੁੰਦਾ।<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />ਪਾਸਵਰਡ ਉਹ ਪਾਸਫ਼ਰੇਜ਼ ਹੈ ਜੋ ਬੈਕਅੱਪ ਬਣਾਉਣ ਵੇਲੇ ਤੁਹਾਨੂੰ ਦਰਜ ਕਰਨ ਲਈ ਕਿਹਾ ਗਿਆ ਸੀ। ਇਹ ਆਮ ਤੌਰ 'ਤੇ ਇਸ ਖਾਤੇ ਲਈ JemaOS ਡੈਸਕਟੌਪ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰਨ ਲਈ ਵਰਤਿਆ ਗਿਆ ਉਹੀ ਪਾਸਵਰਡ ਹੁੰਦਾ ਹੈ।<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">ਖਾਤਾ ਨਾਮ</translation>
<translation id="5490570429039308155">ਮਾਫ਼ ਕਰਨਾ, ਕਿਰਪਾ ਕਰਕੇ ਸਹੀ ਖਾਤਾ ਨਾਮ ਦਰਜ ਕਰੋ</translation>
<translation id="6657585470893396449">ਪਾਸਵਰਡ</translation>
<translation id="8200189938001188563">ਮਾਫ਼ ਕਰਨਾ, ਪਾਸਵਰਡ ਖਾਲੀ ਨਹੀਂ ਹੋ ਸਕਦਾ</translation>
<translation id="3157931365184549694">ਰੀਸਟੋਰ ਕਰੋ</translation>
<translation id="8556278756526311953">ਬੈਕਅੱਪ ਰੀਸਟੋਰ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />ਅਸੀਂ ਹੁਣ ਤੁਹਾਡੀ ਬੈਕਅੱਪ ਫ਼ਾਈਲ ਰੀਸਟੋਰ ਕਰਨ ਦਾ ਕੰਮ ਕਰ ਰਹੇ ਹਾਂ; ਇਸ ਵਿੱਚ ਕੁਝ ਸਮਾਂ ਲੱਗ ਸਕਦਾ ਹੈ, ਇਸ ਲਈ ਕਿਰਪਾ ਕਰਕੇ ਧੀਰਜ ਰੱਖੋ।<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />ਕਿਰਪਾ ਕਰਕੇ ਧਿਆਨ ਦਿਓ ਕਿ ਰੀਸਟੋਰ ਪ੍ਰਕਿਰਿਆ ਸਫਲਤਾਪੂਰਵਕ ਪੂਰੀ ਹੋਣ 'ਤੇ UI ਆਪਣੇ ਆਪ ਮੁੜ-ਚਾਲੂ ਹੋ ਜਾਵੇਗਾ।<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ਬੈਕਅੱਪ ਰੀਸਟੋਰ ਅਸਫਲ ਰਿਹਾ</translation>
<translation id="5003531399442003695">ਹੋਰ ਵੇਰਵਿਆਂ ਲਈ, ਕਿਰਪਾ ਕਰਕੇ ਲਾਗ ਵੇਖਣ ਲਈ ਹੇਠਾਂ ਦਿੱਤੇ ਲਿੰਕ 'ਤੇ ਕਲਿੱਕ ਕਰੋ। ਜੇ ਇਹ ਗਲਤੀ ਬਣੀ ਰਹਿੰਦੀ ਹੈ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ JemaOS ਤਕਨੀਕੀ ਸਹਾਇਤਾ ਚੈਨਲਾਂ ਨਾਲ ਸੰਪਰਕ ਕਰੋ ਅਤੇ ਗਲਤੀ ਲਾਗ ਮੁਹੱਈਆ ਕਰੋ।</translation>
<translation id="6363786367719063276">ਲਾਗ ਵੇਖੋ</translation>
<translation id="8730621377337864115">ਹੋ ਗਿਆ</translation>
<translation id="975238173507911396">ਡੇਟਾ ਰੀਸਟੋਰ ਸਫਲ</translation>
<translation id="6276879052695618521">ਬੈਕਅੱਪ ਰੀਸਟੋਰ ਲਾਗ</translation>
<translation id="4901207598072637766">JemaOS, <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> ਵੱਲੋਂ ਪ੍ਰਦਾਨ ਕੀਤਾ ਗਿਆ</translation>
<translation id="7894910504474624324">JemaOS ਅਤੇ ਇਸ ਦੀਆਂ ਸੇਵਾਵਾਂ GDPR ਅਤੇ ਯੂਰਪੀਅਨ ਡੇਟਾ ਸੁਰੱਖਿਆ ਕਾਨੂੰਨ ਦੇ ਪ੍ਰਾਵਧਾਨਾਂ ਦੀ ਪਾਲਣਾ ਕਰਦੀਆਂ ਹਨ। ਹੋਰ ਜਾਣਕਾਰੀ ਲਈ, ਕਿਰਪਾ ਕਰਕੇ ਸਾਡੀ <ph name="BEGIN_LINK_PRIVACY" />ਗੋਪਨੀਯਤਾ ਨੀਤੀ<ph name="END_LINK_PRIVACY" /> ਅਤੇ ਸਾਡੀਆਂ <ph name="BEGIN_LINK_TOS" />ਸੇਵਾ ਸ਼ਰਤਾਂ<ph name="END_LINK_TOS" /> ਵੇਖੋ।</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, ਸਾਰੇ ਹੱਕ ਰਾਖਵੇਂ ਹਨ।</translation>
<translation id="370679569376308836">JemaOS ਇੱਕ Jema ਡਿਵਾਈਸ ਅਤੇ ਇਸਦੇ SaaS 'ਤੇ ਆਧਾਰਿਤ ਵਪਾਰਕ ਪੇਸ਼ਕਸ਼ ਹੈ।</translation>
<translation id="2773644194450163486">JemaOS <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> ਓਪਨ ਸੋਰਸ ਪ੍ਰੋਜੈਕਟ ਕਾਰਨ ਸੰਭਵ ਹੋਇਆ ਹੈ।</translation>
<translation id="2330680727776977160">Chromium ਵੀ ਹੋਰ <ph name="BEGIN_LINK_1" />ਓਪਨ ਸੋਰਸ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_1" /> ਅਤੇ <ph name="BEGIN_LINK_2" />ਵਧੀਕ ਓਪਨ ਸੋਰਸ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_2" /> ਕਾਰਨ ਸੰਭਵ ਹੋਇਆ ਹੈ।</translation>
<translation id="1419954813084261088">Jema Technology ਵੱਲੋਂ ਡਿਜ਼ਾਈਨ ਅਤੇ ਨਿਰਮਿਤ।</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, ਸਾਰੇ ਹੱਕ ਰਾਖਵੇਂ ਹਨ।</translation>
<translation id="6168072053306020326">Jema Technology, Jema Technology LTD ਅਤੇ Jema Technology (Beijing) Limited ਦਾ ਵਪਾਰਕ ਨਾਮ ਹੈ।
        <ph name="LINE_BREAK" />
        Jema Technology LTD ਕੰਪਨੀ ਨੰਬਰ 12273803 ਨਾਲ ਇੰਗਲੈਂਡ ਅਤੇ ਵੇਲਜ਼ ਵਿੱਚ ਰਜਿਸਟਰਡ ਇੱਕ ਕੰਪਨੀ ਹੈ।</translation>
<translation id="1251589813188467292">ਮਹੱਤਵਪੂਰਨ ਡਿਵਾਈਸ ਵਾਰੰਟੀ ਅਤੇ ਸੇਵਾ ਜਾਣਕਾਰੀ</translation>
<translation id="4851115775198886021">ਡਿਵਾਈਸ SN:</translation>
</translationbundle>
