<!-- jemaos_menus -->
<translation id="5027700305690795897">JemaOS የመጀመሪያ ዝግጅቱን አልጨረሰም።</translation>
<translation id="4257170804800372451">JemaOS እና Thot የሚችሉት በ<ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ክፍት ምንጭ ፕሮጀክት እና በሌሎች <ph name="BEGIN_LINK_OSS" />ክፍት ምንጭ ሶፍትዌሮች<ph name="END_LINK_OSS" /> ነው።</translation>
</translationbundle>
