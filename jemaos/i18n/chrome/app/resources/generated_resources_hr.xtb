<translation id="3655220146274872918">Sigurnosna kopija dovršena</translation>
<translation id="4243579853635792694">Vaša sigurnosna kopija uspješno je izrađena</translation>
<translation id="6337433855796857931">Izrada sigurnosne kopije nije uspjela</translation>
<translation id="4854179463174744546">Došlo je do pogreške tijekom izrade sigurnosne kopije</translation>
