<translation id="6011650404329072318">JemaOS × Nutstore</translation>
<translation id="7292499970804736756">Daftar Nutstore untuk menyinkronkan file Anda ke cloud di JemaOS.</translation>
<translation id="8672291834743661083">Daftar Nutstore</translation>
