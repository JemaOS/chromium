declare_args() {
  use_jemaos_com = false
  is_openjema = false
  jemaos_device = false
}

declare_args() {
  use_jemaos_license = !is_openjema && !jemaos_device
}

if (is_openjema) {
  assert(!use_jemaos_license)
}

if (jemaos_device) {
  assert(!use_jemaos_license)
}

if (use_jemaos_license) {
  assert(!is_openjema)
  assert(!jemaos_device)
}
