<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="is">
	<translation id="7386402409475121504">Búðu til þinn staðbundna JemaOS reikning</translation>
	<translation id="3760308806144055927">Skráðu þig inn á þinn staðbundna JemaOS reikning</translation>
	<translation id="3325117507482096812">Vinsamlega sláðu inn lykilorð</translation>
	<translation id="1838206877831947154">Lykilorðin þín passa ekki saman</translation>
	<translation id="2158276988029582286">Búðu til nýjan staðbundinn reikning</translation>
	<translation id="8592849747346274067">Skráðu þig inn á núverandi reikning</translation>
	<translation id="482190417986201746">Notandanafnið eða lykilorðið sem þú slóst inn er rangt</translation>
	<translation id="6603987686259425085">Þú getur <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>skráð þig inn með JemaOS staðbundnum reikningi<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Netfangið <ph name="EMAIL_ADDRESS">$1</ph> er þegar til. Vinsamlegast reyndu aftur með öðrum tölvupósti.</translation>
	<translation id="7215016743510876720">Notaðu staðbundinn reikning</translation>
	<translation id="6657635042185516718">Haltu áfram að nota netreikning</translation>
	<translation id="6867476688065565618">Skipta yfir í staðbundinn reikning?</translation>
	<translation id="4840454774882557974">Ef þú velur að nota staðbundinn reikning, eru gagnlegir eiginleikar meðal annars að samstilla gögnin þín og kjörstillingar á mörgum tækjum og sjálfvirk innskráning á vefforrit með JemaOS reikningnum þínum mun ekki virka.</translation>
	<translation id="8951507920859729424">Við mælum með því að nota netreikning til að nýta JemaOS til hins ýtrasta.</translation>
	<translation id="479773200536372215">Þú munt ekki geta bætt við Google reikningum vegna þess að Google API lykla vantar. Sjá <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> fyrir frekari upplýsingar.</translation>
	<translation id="1198491307547164157">Þú munt ekki geta bætt við JemaOS reikningum vegna þess að JemaOS API lykla vantar. Sjá <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> fyrir frekari upplýsingar.</translation>
	<translation id="5042404702659901995">Persónuverndaryfirlýsing</translation>
	<translation id="4907736162587268100">Innihald persónuverndaryfirlýsingar</translation>
	<translation id="5988344732274877691">Skráðu þig á (mjög sjaldgæft, lofað) fréttabréfið fyrir JemaOS</translation>
	<translation id="1706203008474708805">Vertu með í áætlun um umbætur á notendaupplifun JemaOS</translation>
	<translation id="1147139514756087229">Skráðu þig inn með staðbundnum reikningi</translation>
	<translation id="2054784944085654098">Býr til öryggisafrit núna. Þetta getur tekið smá stund; vinsamlegast bíddu…</translation>
	<translation id="3554401467586751874">Öryggisskrá var búin til</translation>
	<translation id="2349211327705667074">Skoða öryggisafrit</translation>
	<translation id="3049367131589710124">Skoða villuskrá</translation>
	<translation id="1079017345574916945">Fjarstýrt skrifborð</translation>
	<translation id="3064478898280877715">App verslun</translation>
	<translation id="5890206344045530832">Uppsetningarforrit</translation>
	<translation id="2173278076276376488">Þetta tól mun hjálpa þér að setja upp <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> á innri geymslu þessa tækis.</translation>
	<translation id="5323182426977498659">Viðvörun! Þessi aðferð er eyðileggjandi og ekki hægt að afturkalla hana. Vinsamlegast athugaðu að við munum ekki bera neina ábyrgð á hugsanlegu gagnatapi þínu né veita neina brýna tæknilega aðstoð, haldið áfram á eigin ábyrgð.</translation>
	<translation id="8517836015601969896">Full uppsetning á disknum</translation>
	<translation id="7300045760790370189">Settu upp <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> til að taka upp heilan harða disk, öll gögn á harða disknum sem markið er þurrkuð út.</translation>
	<translation id="8762511733918256595">Multi-boot uppsetning</translation>
	<translation id="248900698427753678">Settu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> upp á núverandi sneið á harða diskinum, þar sem <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> getur verið til samhliða öðru stýrikerfi. Öll gögn á miða skiptingunni verða þurrkuð út.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> verður sett upp á harða disknum sem þú valdir; öll gögn á markdiskinum verða þurrkuð út.</translation>
	<translation id="4039091757234555415">Diskur</translation>
	<translation id="7783580523889684697">Enginn diskur tiltækur</translation>
	<translation id="8217653566575018388">Uppsetningu lokið</translation>
	<translation id="8846746259444262774">Uppsetning mistókst</translation>
	<translation id="7263815009235541549">Uppsetningunni er lokið. Vinsamlegast slökktu á tækinu þínu fyrst, fjarlægðu síðan hvaða uppsetningarmiðla sem er og kveiktu á því aftur til að ræsa <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Úbbs, eitthvað hefur farið úrskeiðis og uppsetningunni lauk ekki. Vinsamlegast reyndu ferlið aftur. Ef sama villa er viðvarandi, vinsamlegast hafðu samband við JemaOS stuðning með ofangreindum notandaskrá.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> verður sett upp á völdu skiptingunni á harða disknum þínum. Samkvæmt núverandi fjölræsingarkerfi gæti þetta aðeins haldið áfram ef tækið þitt styður UEFI og harðir diskarnir þínir eru forsniðnir með GPT.</translation>
	<translation id="7831363758161884243">Markskiptingin verður þurrkuð út; þú þarft líka að tilgreina virku EFI skiptinguna þína (venjulega gert sjálfkrafa) þar sem uppsetningarforritið þarf að breyta ræsistillingum kerfisins.</translation>
	<translation id="5670799238446305550">Veldu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> miðsvæði</translation>
	<translation id="3695537760133394753">Skipting</translation>
	<translation id="5610519566593708119">Veldu EFI skipting</translation>
	<translation id="3367650349940010965">Engin skipting er tiltæk fyrir valinn disk</translation>
	<translation id="7453223384507098390">Engin EFI skipting eru tiltæk fyrir valinn disk</translation>
	<translation id="1854532683465500847">Stærð valda skiptingarinnar er minni en 20GB, uppsetning gæti mistekist</translation>
	<translation id="4144613075340468247">Valin skipting hefur verið sett á <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, uppsetning á henni aftur gæti mistekist</translation>
	<translation id="5793361052649920836">Eftir uppsetningu, hvernig viltu ræsa <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Settu upp og stilltu rEFInd fyrir mig (mælt með)</translation>
	<translation id="1858708492548921044">rEFInd er ræsistjórnunarforrit sem býður upp á fallegt grafískt viðmót fyrir ræsivalkosti stýrikerfisins þegar tölvan þín ræsir, þú munt geta valið það stýrikerfi sem þú vilt ræsa með því. Fyrir frekari upplýsingar um rEFInd, vinsamlegast skoðaðu heimasíðu þess.</translation>
	<translation id="3861924051442564602">Bættu við UEFI ræsivalmynd fyrir mig</translation>
	<translation id="8622370666798589804">Þegar tölvan þín ræsist gætirðu farið inn í valmynd UEFI ræsivalkosta (líklegast með því að ýta á flýtilykla), þessi valkostur bætir <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> við sem færslu í þá valmynd. (Styður aðeins sumar gerðir BIOS og UEFI fastbúnaðar).</translation>
	<translation id="1569398690544416170">Gerðu ekkert hér, ég mun stilla það sjálfur</translation>
	<translation id="3554866444001249532">Þetta uppsetningarforskrift mun aðeins setja nauðsynlegar .efi skrár til að ræsa <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> á EFI skiptinguna þína, þú þarft að stilla hvernig á að ræsa hana sjálfur.</translation>
	<translation id="7492832751164189534">Þvingaðu að hætta</translation>
	<translation id="5159534860632584026">Uppsetningarferlinu hefur verið hætt</translation>
	<translation id="8686749782014838344">Mistókst að fá upplýsingar um diskinn</translation>
	<translation id="5688543378771259173">Verið er að stöðva uppsetningu...</translation>
	<translation id="5350452134936384991">Settu upp í USB</translation>
	<translation id="8008470485414925603">Settu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> upp á USB disk; öll gögn á USB-markdisknum verða þurrkuð út.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> verður sett upp á valinn USB disk; öll gögn á markdiskinum verða þurrkuð út.</translation>
	<translation id="5725593226060700263">Enginn USB diskur tiltækur</translation>
	<translation id="4357040841587078287">Við höfum uppgötvað að þú ert að keyra þetta eintak af JemaOS úr niðurhalðri myndskrá. Til að nýta umfangsmestu stuðningseiginleikana (þar á meðal Over-The-Air uppfærslur) sem JemaOS getur boðið upp á, mælum við eindregið með því að þú ræsir "Installer" aðgerðina til að framkvæma uppsetningu á fullum diski af JemaOS í sérstakt geymslutæki.</translation>
	<translation id="1246398339704431302">Þú getur <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>haldið áfram að nota þetta eintak af JemaOS samt<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, uppsetningarferlið er hægt að framkvæma síðar í kerfinu, en öll gögn þín verða þurrkuð aftur af þessari síðu og þú munt byrja aftur af þessari síðu.</translation>
	<translation id="3654532222088291133">Í stað þess að slá inn JemaOS reikningslykilorðið þitt til að skrá þig inn geturðu búið til <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> lykilorð fyrir þetta tæki</translation>
	<translation id="8377684629839541977">Notaðu lykilorð fyrir JemaOS reikning</translation>

