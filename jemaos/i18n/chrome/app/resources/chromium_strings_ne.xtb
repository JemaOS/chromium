<!DOCTYPE translationbundle>
<translationbundle lang="ne">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot बारे</translation>
<translation id="5639860668557220477">Thot ब्राउजरको लागि सहायता प्राप्त गर्नुहोस्</translation>
<translation id="1692689520561928457">JemaOS बारे</translation>
<translation id="8692765844418174375">JemaOS संस्करण</translation>
<translation id="2943260250558374955">JemaOS को लागि सहायता प्राप्त गर्नुहोस्</translation>
<translation id="713321354492170993">ब्राउजरले निष्क्रिय ट्याबहरूबाट मेमोरी खाली गर्छ। यसले सक्रिय ट्याबहरू र अन्य एपहरूलाई थप कम्प्युटिङ स्रोतहरू दिन्छ र ब्राउजरलाई छिटो राख्छ। तपाईं निष्क्रिय ट्याबहरूमा फर्कँदा ती स्वतः फेरि सक्रिय हुन्छन्।</translation>
<translation id="1774190491044887444">ब्राउजरले पृष्ठभूमि गतिविधि र स्मूद स्क्रोलिङ तथा भिडियो फ्रेम दरहरू जस्ता दृश्य प्रभावहरू सीमित गरेर ब्याट्री बचत गर्छ।</translation>
<translation id="180121268008059459">ब्राउजरले पृष्ठहरू पूर्व-लोड गर्छ, जसले ब्राउजिङ र खोजीलाई छिटो बनाउँछ।</translation>
<translation id="7127093527178692287">ब्याकअप पुनर्स्थापना गर्नुहोस् (बीटा)</translation>
<translation id="4439042171549201806">ब्याकअप फाइलबाट JemaOS पुनर्स्थापना गर्न, कृपया ब्याकअप फाइल भएको हटाउन मिल्ने ड्राइभ अहिले आफ्नो JemaOS उपकरणमा घुसाउनुहोस् र कुन ब्याकअप फाइल पुनर्स्थापना गर्न चाहनुहुन्छ निर्दिष्ट गर्नुहोस्। कृपया ध्यान दिनुहोस् कि यो विजार्डले पत्ता लगाउनको लागि तपाईंको ब्याकअप फाइल हटाउन मिल्ने ड्राइभको रूट डाइरेक्टरीमा हुनुपर्छ।</translation>
<translation id="2955409026764742995">पुनर्स्थापना गर्न ब्याकअप फाइल चयन गर्नुहोस्:</translation>
<translation id="7040434808685140085">माफ गर्नुहोस्, चयन गरिएको ब्याकअप फाइल चिन्न सकिएन; कृपया नयाँ फाइल चयन गर्नुहोस्।</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />चयन गरिएको ब्याकअप फाइलबाट JemaOS पुनर्स्थापना गर्न, ब्याकअप सिर्जना भएको बेलाको सही जानकारी हुनु अत्यावश्यक छ। अन्यथा, पुनर्स्थापना प्रक्रिया असफल हुनेछ।<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"खाता नाम" भनेको तपाईंको ब्याकअप फाइल सिर्जना भएको खाताको प्राथमिक लगइन प्रमाण हो। यो सामान्यतया तपाईंको JemaOS/Google खाताका लागि साइन अप गर्न प्रयोग गर्नुभएको इमेल ठेगाना हो। यदि त्यो स्थानीय खाता भएको खण्डमा, त्यो "@jemaos.local" जोडिएको प्रयोगकर्ता नाम हुनेछ।<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />पासवर्ड भनेको ब्याकअप सिर्जना हुँदा तपाईंलाई प्रविष्ट गर्न भनिएको पासफ्रेज हो। यो सामान्यतया यस खाताका लागि JemaOS डेस्कटपमा साइन इन गर्न प्रयोग गरिएको उही पासवर्ड हो।<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">खाता नाम</translation>
<translation id="5490570429039308155">माफ गर्नुहोस्, कृपया सही खाता नाम प्रविष्ट गर्नुहोस्</translation>
<translation id="6657585470893396449">पासवर्ड</translation>
<translation id="8200189938001188563">माफ गर्नुहोस्, पासवर्ड खाली हुन सक्दैन</translation>
<translation id="3157931365184549694">पुनर्स्थापना गर्नुहोस्</translation>
<translation id="8556278756526311953">ब्याकअप पुनर्स्थापना गर्दै</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />हामी अहिले तपाईंको ब्याकअप फाइल पुनर्स्थापना गर्ने काम गरिरहेका छौं; यसमा केही समय लाग्न सक्छ, त्यसैले कृपया धैर्य राख्नुहोस्।<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />कृपया ध्यान दिनुहोस् कि पुनर्स्थापना प्रक्रिया सफलतापूर्वक सम्पन्न भएपछि UI स्वतः पुनः सुरु हुनेछ।<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ब्याकअप पुनर्स्थापना असफल भयो</translation>
<translation id="5003531399442003695">थप विवरणका लागि, कृपया लगहरू हेर्न तलको लिङ्कमा क्लिक गर्नुहोस्। यदि यो त्रुटि निरन्तर रहन्छ भने, कृपया JemaOS प्राविधिक सहायता च्यानलहरूसँग सम्पर्क गर्नुहोस् र त्रुटि लगहरू उपलब्ध गराउनुहोस्।</translation>
<translation id="6363786367719063276">लगहरू हेर्नुहोस्</translation>
<translation id="8730621377337864115">सम्पन्न</translation>
<translation id="975238173507911396">डाटा पुनर्स्थापना सफल</translation>
<translation id="6276879052695618521">ब्याकअप पुनर्स्थापना लगहरू</translation>
<translation id="4901207598072637766">JemaOS, <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> द्वारा प्रदान गरिएको</translation>
<translation id="7894910504474624324">JemaOS र यसका सेवाहरूले GDPR र युरोपेली डाटा संरक्षण कानूनका प्रावधानहरूको पालना गर्छन्। थप जानकारीका लागि, कृपया हाम्रो <ph name="BEGIN_LINK_PRIVACY" />गोपनीयता नीति<ph name="END_LINK_PRIVACY" /> र हाम्रा <ph name="BEGIN_LINK_TOS" />सेवा सर्तहरू<ph name="END_LINK_TOS" /> हेर्नुहोस्।</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, सर्वाधिकार सुरक्षित।</translation>
<translation id="370679569376308836">JemaOS भनेको Jema उपकरण र यसको SaaS मा आधारित व्यावसायिक प्रस्ताव हो।</translation>
<translation id="2773644194450163486">JemaOS <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> खुला स्रोत परियोजनाद्वारा सम्भव भएको हो।</translation>
<translation id="2330680727776977160">Chromium पनि अन्य <ph name="BEGIN_LINK_1" />खुला स्रोत सफ्टवेयर<ph name="END_LINK_1" /> र <ph name="BEGIN_LINK_2" />थप खुला स्रोत सफ्टवेयर<ph name="END_LINK_2" /> द्वारा सम्भव भएको हो।</translation>
<translation id="1419954813084261088">Jema Technology द्वारा डिजाइन र निर्माण गरिएको।</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, सर्वाधिकार सुरक्षित।</translation>
<translation id="6168072053306020326">Jema Technology भनेको Jema Technology LTD र Jema Technology (Beijing) Limited को व्यापारिक नाम हो।
        <ph name="LINE_BREAK" />
        Jema Technology LTD कम्पनी नम्बर 12273803 साथ इङ्गल्यान्ड र वेल्समा दर्ता भएको कम्पनी हो।</translation>
<translation id="1251589813188467292">महत्वपूर्ण उपकरण वारेन्टी र सेवा जानकारी</translation>
<translation id="4851115775198886021">उपकरण SN:</translation>
</translationbundle>
