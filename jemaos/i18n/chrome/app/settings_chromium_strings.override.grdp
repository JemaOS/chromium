<?xml version="1.0" encoding="utf-8"?>
<!-- override chrome/app/settings_chromium_strings.grdp, included from chromium_strings.grd -->
<grit-part>
  <message name="IDS_SETTINGS_ABOUT_PROGRAM" desc="Menu title for the About Chromium page.">
    À propos de Thot
  </message>
  <message name="IDS_SETTINGS_GET_HELP_USING_CHROME" desc="Text of the button which takes the user to the Chrome help page.">
    Obtenir de l’aide pour le navigateur Thot
  </message>
  <if expr="chromeos_ash">
    <if expr="openjema">
      <message name="IDS_SETTINGS_ABOUT_OS" desc="Menu title for the About Chromium OS page.">
        À propos de Jema
      </message>
      <message name="IDS_OS_SETTINGS_TAG_OS_VERSION" desc="Text for search result item which, when clicked, navigates the user to about Chrome OS settings, which gives information about the current Chrome OS version.">
        openJema version
      </message>
      <message name="IDS_SETTINGS_GET_HELP_USING_CHROME_OS" desc="Text of the button which takes the user to the Chrome help page.">
        Get help with openJema
      </message>
    </if>
    <if expr="not openjema">
      <message name="IDS_SETTINGS_ABOUT_OS" desc="Menu title for the About Chromium OS page.">
        À propos de JemaOS
      </message>
      <message name="IDS_OS_SETTINGS_TAG_OS_VERSION" desc="Text for search result item which, when clicked, navigates the user to about Chrome OS settings, which gives information about the current Chrome OS version.">
        Version de JemaOS
      </message>
      <message name="IDS_SETTINGS_GET_HELP_USING_CHROME_OS" desc="Text of the button which takes the user to the Chrome help page.">
        Obtenir de l’aide pour JemaOS
      </message>
    </if>
  </if>
  <message name="IDS_SETTINGS_PERFORMANCE_MEMORY_SAVER_MODE_SETTING_DESCRIPTION" desc="Description for the memory saver mode setting">
    Le navigateur libère de la mémoire des onglets inactifs. Cela donne aux onglets actifs et aux autres applications plus de ressources informatiques et maintient la rapidité du navigateur. Vos onglets inactifs redeviennent automatiquement actifs lorsque vous y revenez.
  </message>
  <message name="IDS_SETTINGS_PERFORMANCE_BATTERY_SAVER_MODE_SETTING_DESCRIPTION" desc="Description for the energy saver mode setting">
    Le navigateur économise la batterie en limitant l’activité en arrière-plan et les effets visuels, tels que le défilement fluide et les fréquences d’images vidéo.
  </message>
  <message name="IDS_SETTINGS_PERFORMANCE_PRELOAD_TOGGLE_SUMMARY" desc="Summary for the preload pages setting">
    Le navigateur précharge les pages, ce qui rend la navigation et la recherche plus rapides.
  </message>
</grit-part>
