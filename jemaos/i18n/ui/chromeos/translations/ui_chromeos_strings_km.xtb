<!DOCTYPE translationbundle>
<translationbundle lang="km">

<!-- jemaos_menus -->
<translation id="6011650404329072318">JemaOS × Nutstore</translation>
<translation id="7292499970804736756">ចុះឈ្មោះ Nutstore ដើម្បីធ្វើសមកាលកម្មឯកសាររបស់អ្នកតាមពពកក្នុង JemaOS។</translation>
<translation id="8672291834743661083">ចុះឈ្មោះ Nutstore</translation>
<translation id="5103639294476249880">ចុចប៊ូតុង "Add Application" ក្នុងការកំណត់សុវត្ថិភាព</translation>
<translation id="8371020157576651120">បង្កើត និងចម្លងពាក្យសម្ងាត់កម្មវិធីរបស់អ្នក</translation>
<translation id="3855250998276979579">បើកកម្មវិធី Nutstore</translation>
<translation id="6565655783894300125">ហើយភ្ជាប់គណនី Nutstore ទៅ JemaOS ជាមួយអ៊ីមែល និងពាក្យសម្ងាត់កម្មវិធីរបស់អ្នក</translation>
<translation id="4208217820626259628">JemaDrop</translation>
<translation id="77997252117517973">នឹងមកដល់ឆាប់ៗនេះ</translation>
<translation id="4928968570611226525">ដើម្បីបន្តសកម្មភាពនេះ អ្នកនឹងត្រូវ<ph name="BEGIN_LINK_ARC_APP" />&gt;ធ្វើឱ្យប្រព័ន្ធរង Android សកម្ម<ph name="END_LINK_ARC_APP" />នៅលើឧបករណ៍ JemaOS របស់អ្នក; ហើយឧបករណ៍ JemaOS របស់អ្នកក៏ត្រូវតែ<ph name="BEGIN_LINK_HELP" />ប្តូរទៅរបៀបអ្នកអភិវឌ្ឍន៍<ph name="END_LINK_HELP" />ដែរ។</translation>
<translation id="7395250550107972941">មិនអាចផ្ទុកឯកសារ .apk ពីខាងក្រៅបានទេ។ សូមបញ្ជាក់ថាប្រព័ន្ធរង Android ត្រូវបានធ្វើឱ្យសកម្ម ហើយអ្នកស្ថិតក្នុងរបៀបអ្នកអភិវឌ្ឍន៍ JemaOS។</translation>
<translation id="5690820326685091783">បើកជាមួយ JemaOS AI</translation>
</translationbundle>
