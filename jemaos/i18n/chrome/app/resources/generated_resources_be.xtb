<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="be">
	<translation id="7386402409475121504">Стварыце лакальны ўліковы запіс JemaOS</translation>
	<translation id="3760308806144055927">Увайдзіце ў свой лакальны ўліковы запіс JemaOS</translation>
	<translation id="3325117507482096812">Калі ласка, увядзіце пароль</translation>
	<translation id="1838206877831947154">Вашы паролі не супадаюць</translation>
	<translation id="2158276988029582286">Стварыце новы лакальны ўліковы запіс</translation>
	<translation id="8592849747346274067">Увайдзіце ў існуючы ўліковы запіс</translation>
	<translation id="482190417986201746">Імя карыстальніка або пароль, якія вы ўвялі, няправільныя</translation>
	<translation id="6603987686259425085">Вы можаце <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>увайсці з дапамогай лакальнага ўліковага запісу JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Адрас электроннай пошты <ph name="EMAIL_ADDRESS">$1</ph> ужо існуе. Паўтарыце спробу з іншым адрасам электроннай пошты.</translation>
	<translation id="7215016743510876720">Выкарыстоўвайце лакальны ўліковы запіс</translation>
	<translation id="6657635042185516718">Працягвайце карыстацца інтэрнэт-рахункам</translation>
	<translation id="6867476688065565618">Пераключыцца на лакальны ўліковы запіс?</translation>
	<translation id="4840454774882557974">Калі вы вырашыце выкарыстоўваць лакальны ўліковы запіс, карысныя функцыі, у тым ліку сінхранізацыя вашых даных і налад на некалькіх прыладах і аўтаматычны ўваход у вэб-праграмы з дапамогай вашага ўліковага запісу JemaOS, не будуць працаваць.</translation>
	<translation id="8951507920859729424">Мы рэкамендуем выкарыстоўваць онлайн-рахунак, каб выкарыстоўваць JemaOS у поўнай меры.</translation>
	<translation id="479773200536372215">Вы не зможаце дадаць уліковыя запісы Google, бо адсутнічаюць ключы Google API. Глядзіце <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> для атрымання падрабязнай інфармацыі.</translation>
	<translation id="1198491307547164157">Вы не зможаце дадаць уліковыя запісы JemaOS, таму што адсутнічаюць ключы JemaOS API. Глядзіце <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> для атрымання падрабязнай інфармацыі.</translation>
	<translation id="5042404702659901995">Заява аб прыватнасці</translation>
	<translation id="4907736162587268100">Змест заявы аб прыватнасці</translation>
	<translation id="5988344732274877691">Падпішыцеся на (вельмі рэдкую, абяцаную) рассылку для JemaOS</translation>
	<translation id="1706203008474708805">Далучайцеся да плана паляпшэння карыстацкага досведу JemaOS</translation>
	<translation id="1147139514756087229">Увайдзіце з дапамогай лакальнага ўліковага запісу</translation>
	<translation id="2054784944085654098">Ствараецца файл рэзервовай копіі. Гэта можа заняць некаторы час; калі ласка, пачакайце...</translation>
	<translation id="3554401467586751874">Файл рэзервовай копіі створаны паспяхова</translation>
	<translation id="2349211327705667074">Прагляд файла рэзервовай копіі</translation>
	<translation id="6337433855796857931">Збой рэзервовага капіравання</translation>
	<translation id="3049367131589710124">Праглядзець журнал памылак</translation>
	<translation id="1079017345574916945">Аддалены працоўны стол</translation>
	<translation id="3064478898280877715">Крама прыкладанняў</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Усталёўшчык</translation>
	<translation id="2173278076276376488">Гэтая ўтыліта дапаможа вам усталяваць <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ва ўнутранае сховішча гэтай прылады.</translation>
	<translation id="5323182426977498659">Папярэджанне! Гэтая працэдура разбуральная і не можа быць адменена. Калі ласка, звярніце ўвагу, што мы не нясем ніякай адказнасці за патэнцыйную страту даных і не будзем аказваць тэрміновую тэхнічную падтрымку, працягвайце на свой страх і рызыку.</translation>
	<translation id="8517836015601969896">Поўная ўстаноўка на дыск</translation>
	<translation id="7300045760790370189">Усталюйце <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, каб заняць увесь жорсткі дыск, усе дадзеныя мэтавага жорсткага дыска будуць сцёрты.</translation>
	<translation id="8762511733918256595">Мультызагрузная ўстаноўка</translation>
	<translation id="248900698427753678">Усталюйце <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на існуючы раздзел жорсткага дыска, дзе <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> можа існаваць паралельна з іншымі АС. Усе дадзеныя ў мэтавым раздзеле будуць выдалены.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будзе ўсталявана на абраны жорсткі дыск; усе дадзеныя на мэтавым дыску будуць выдалены.</translation>
	<translation id="4039091757234555415">Дыск</translation>
	<translation id="7783580523889684697">Няма даступнага дыска</translation>
	<translation id="8217653566575018388">Устаноўка завершана</translation>
	<translation id="8846746259444262774">Збой усталявання</translation>
	<translation id="7263815009235541549">Ўстаноўка паспяхова завершана. Спачатку выключыце прыладу, потым выдаліце ​​ўсе ўсталявальныя носьбіты і ўключыце яе зноў, каб загрузіць <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">На жаль, нешта пайшло не так, і ўстаноўка не завяршылася. Калі ласка, паўтарыце працэс. Калі гэтая ж памылка не знікне, звярніцеся ў службу падтрымкі JemaOS з прыведзеным вышэй журналам.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будзе ўсталявана на выбраны раздзел вашага жорсткага дыска. Згодна з цяперашняй схемай шматразовай загрузкі, гэта можа адбыцца толькі ў тым выпадку, калі ваша прылада падтрымлівае UEFI і вашы жорсткія дыскі адфарматаваны ў GPT.</translation>
	<translation id="7831363758161884243">Мэтавы раздзел будзе сцёрты; вам таксама трэба пазначыць ваш актыўны раздзел EFI (звычайна гэта робіцца аўтаматычна), бо ўсталёўшчык павінен змяніць канфігурацыі загрузкі сістэмы.</translation>
	<translation id="5670799238446305550">Выберыце мэтавы падзел <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Перагародка</translation>
	<translation id="5610519566593708119">Выберыце раздзел EFI</translation>
	<translation id="3367650349940010965">Для абранага дыска няма даступных раздзелаў</translation>
	<translation id="7453223384507098390">Для абранага дыска няма даступных раздзелаў EFI</translation>
	<translation id="1854532683465500847">Памер абранага падзелу менш за 20 ГБ, усталяванне можа быць няўдалым</translation>
	<translation id="4144613075340468247">Выбраны падзел быў падключаны да <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> з мультызагрузкай, паўторная ўстаноўка можа не атрымацца</translation>
	<translation id="5793361052649920836">Як бы вы хацелі загрузіць <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> пасля ўстаноўкі?</translation>
	<translation id="4273235330352963866">Усталяваць і наладзіць rEFInd для мяне (рэкамендуецца)</translation>
	<translation id="1858708492548921044">rEFInd - гэта праграма дыспетчара загрузкі, якая прапануе добры графічны інтэрфейс для параметраў загрузкі АС пры запуску ПК, вы зможаце выбраць патрэбную АС для загрузкі з яе. Для атрымання дадатковай інфармацыі аб rEFInd, калі ласка, звярніцеся на яго галоўную старонку.</translation>
	<translation id="3861924051442564602">Дадайце для мяне параметр меню загрузкі UEFI</translation>
	<translation id="8622370666798589804">Калі ваш ПК запускаецца, вы можаце ўвайсці ў меню параметраў загрузкі UEFI (хутчэй за ўсё, націснуўшы гарачую клавішу), гэты параметр дадае <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> у якасці запісу ў гэтае меню. (Падтрымлівае толькі некаторыя мадэлі прашыўкі BIOS і UEFI).</translation>
	<translation id="1569398690544416170">Тут нічога не рабіць, я сам наладжу</translation>
	<translation id="3554866444001249532">Гэты ўсталявальны скрыпт будзе змясціць толькі неабходныя файлы .efi для загрузкі <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> у ваш раздзел EFI, вам трэба будзе самастойна наладзіць яго загрузку.</translation>
	<translation id="7492832751164189534">Прымусова кінуць</translation>
	<translation id="5159534860632584026">Працэс усталёўкі спынены</translation>
	<translation id="8686749782014838344">Не ўдалося атрымаць інфармацыю аб дыску</translation>
	<translation id="5688543378771259173">Усталяванне спыняецца...</translation>
	<translation id="5350452134936384991">Усталяваць у USB</translation>
	<translation id="8008470485414925603">Усталюйце <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на USB-дыск; усе дадзеныя на мэтавым USB-дыску будуць выдалены.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будзе ўсталявана на выбраны вамі USB-дыск; усе дадзеныя на мэтавым дыску будуць выдалены.</translation>
	<translation id="5725593226060700263">USB-дыск адсутнічае</translation>
	<translation id="4357040841587078287">Мы выявілі, што вы выкарыстоўваеце гэтую копію JemaOS са спампаванага файла выявы. Каб выкарыстоўваць самыя поўныя функцыі падтрымкі (уключаючы бесправадныя абнаўленні), якія можа прапанаваць JemaOS, мы настойліва рэкамендуем вам запусціць функцыю «Усталёўшчык», каб выканаць усталёўку JemaOS на поўны дыск на асобную прыладу захоўвання дадзеных.</translation>
	<translation id="1246398339704431302">Вы можаце <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>у любым выпадку працягваць выкарыстоўваць гэту копію JemaOS<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, працэс усталявання можа быць выкананы на больш познім этапе ў сістэме, аднак усе вашы даныя будуць сцёртыя пасля ўсталявання, і вы пачнеце зноў з гэтай старонкі.</translation>
	<translation id="3654532222088291133">Замест таго каб уводзіць пароль уліковага запісу JemaOS для ўваходу, вы можаце стварыць пароль <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> для гэтай прылады</translation>
	<translation id="8377684629839541977">Выкарыстоўвайце пароль уліковага запісу JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Аўтаматычна падтрымліваць <ph name="DEVICE_OS" /> ў актуальным стане</translation>
<translation id="2347352406101856238">Абнаўленне <ph name="DEVICE_OS" /> уключана</translation>
<translation id="185834232609012804">Абнаўленне <ph name="DEVICE_OS" /> выключана</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Платформа <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Аддалены працоўны стол</translation>
<translation id="6898090158927982244">Ваш Linux абноўлены</translation>
<translation id="4886703929102211360">Для кампанента Linux (beta) даступна крытычнае абнаўленне. Настойліва рэкамендуецца ўсталяваць гэтае абнаўленне як мага хутчэй, інакш ваш Linux (beta) можа перастаць працаваць.</translation>
<translation id="6694016202036959050">Налады <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">Уліковы запіс JemaOS, рэзервовае капіяванне, рознае</translation>
<translation id="9150429437595727962">Налады Wi-Fi</translation>
<translation id="4938972461544498524">Налады тачпада</translation>
<translation id="1210024513248363065">Аддаленыя службы</translation>
<translation id="2878862288885588535">Служба аддаленай дыягностыкі</translation>
<translation id="7409197984340676806">Служба аддаленай дыягностыкі дазваляе афіцыйным прадстаўнікам падтрымкі JemaOS выяўляць праблемы сістэмы. У цяперашні час служба аддаленай дыягностыкі можа быць ініцыявана толькі афіцыйнымі прадстаўнікамі падтрымкі JemaOS.</translation>
<translation id="1791028023086176332">Падзяліцеся гэтым нумарам з афіцыйнымі прадстаўнікамі падтрымкі JemaOS</translation>
<translation id="6279304275399437025">Запуск службы аддаленай дыягностыкі...</translation>
<translation id="1501882165699826662">Спыніце службу аддаленай дыягностыкі і паспрабуйце зноў</translation>
<translation id="3100283258447375201">Дадатковая інфармацыя</translation>
<translation id="4070039109671307724">Рознае</translation>
<translation id="7326893024940073254">Кнопка "Перазапусціць"</translation>
<translation id="3002423764319968103">Паказваць кнопку "Перазапусціць" у сістэмным меню</translation>
<translation id="6243454903512423518">Кнопка "Павярнуць экран"</translation>
<translation id="6491049336868978729">Вы зараз не ў рэжыме планшэта; кнопка "Павярнуць экран" схавана</translation>
<translation id="5496012402277579695">Паказваць кнопку "Павярнуць экран" у сістэмным меню</translation>
<translation id="5882838977344999606">Перамыкач рэжыму планшэта/ноўтбука</translation>
<translation id="472164133625585606">Паказваць перамыкач рэжыму планшэта/ноўтбука ў сістэмным меню</translation>
<translation id="1851103550468466960">Уключыць Widevine</translation>
<translation id="4058176713282795846">Уключыце Widevine, каб прайграваць абаронены прэміум-кантэнт. <ph name="BEGIN_LINK_LEARN_MORE" />Даведацца больш<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Выберыце "libwidevine.so"</translation>
<translation id="4838463656205005584">Не ўдалося ўключыць Widevine...</translation>
<translation id="2164041826798266548">Не ўдалося ўсталяваць модуль Widevine CDM. Праверце злучэнне і паспрабуйце зноў.</translation>
<translation id="4106982328079440606">Налады ўліковага запісу JemaOS</translation>
<translation id="6468776556018764845">Эксперыментальныя функцыі</translation>
<translation id="3487615413425326553">Абысці праверкі Trusted Platform Module (TPM)</translation>
<translation id="4817176087932811573">Некаторыя функцыі могуць не працаваць з-за несумяшчальнага чыпа TPM у вашай прыладзе; як часовае рашэнне вы можаце абысці праверкі TPM.</translation>
<translation id="3356003366173774486">Аўтаматычны ўваход</translation>
<translation id="6218459410891191693">Дазволіць бягучаму ўліковаму запісу аўтаматычна ўваходзіць на працоўны стол пры перазапуску прылады</translation>
<translation id="6620839363422062843">Немагчыма ўключыць для гэтага ўліковага запісу; аўтаматычны ўваход ужо актыўны для іншых уліковых запісаў на гэтай прыладзе</translation>
<translation id="6734500226490446035">Немагчыма ўключыць для гэтага ўліковага запісу; пры ініцыялізацыі файлавых сістэм для гэтага ўліковага запісу адбылася невядомая памылка. Паспрабуйце перазапусціць прыладу або стварыце новы ўліковы запіс</translation>
<translation id="5464880042146818691">Немагчыма ўключыць для гэтага ўліковага запісу; параметр аўтаматычнага ўваходу даступны толькі для тыпу "Лакальны ўліковы запіс".</translation>
<translation id="3335654854106476749">Дадайце пароль для ўваходу ў наладах <ph name="BEGIN_LINK" />Прыватнасць і бяспека<ph name="END_LINK" /> перад уключэннем аўтаматычнага ўваходу.</translation>
<translation id="5586831602198585601">Зараз даступна навейшая версія JemaOS для абнаўлення. Аднак тэрмін вашай падпіскі JemaOS for You скончыўся; для абнаўлення JemaOS вам патрэбна актыўная падпіска.</translation>
<translation id="3869860597719956574">Зараз даступна новая асноўная версія JemaOS для абнаўлення. Каб працягнуць гэтае абнаўленне, неабходна сплаціць аднаразовы ўзнос.</translation>
<translation id="6523879681771260760">Укажыце шлях для захоўвання файла рэзервовай копіі</translation>
<translation id="2036152819788683293">Стварыць файл рэзервовай копіі для гэтага ўліковага запісу (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Даведацца больш<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Стварыць рэзервовую копію</translation>
<translation id="4267347174163690295">Стварыць файл рэзервовай копіі для гэтага ўліковага запісу (beta).</translation>
<translation id="8112950994208888917">Гэтая аперацыя стварае поўную рэзервовую копію дыска для гэтага ўліковага запісу, што дазваляе лёгка аднавіць ваш JemaOS да стану на момант стварэння рэзервовай копіі, уключаючы налады, усталяваныя пашырэнні браўзера і праграмы падсістэмы. У залежнасці ад вашых праграм і змесціва дамашняй тэчкі файл рэзервовай копіі можа быць вялікім; рэкамендуецца захоўваць файл рэзервовай копіі на знешнім назапашвальніку. Калі ў вас ёсць партатыўны USB-дыск, падключыце яго зараз. <ph name="BEGIN_LINK_LEARN_MORE" />Даведацца больш<ph name="END_LINK_LEARN_MORE" /></translation>
