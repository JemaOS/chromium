<?xml version="1.0" encoding="utf-8"?>
<!-- override chromeos/chromeos_strings.grd -->
<grit-part>
  <if expr="openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_HELP_APP_WHATS_NEW_CONTINUE_TASK_TITLE" desc="Title for a ChromeOS launcher continue section item that can be used to quickly access most recent ChromeOS release notes. Continue section contains set of UI elements that are suggestions for continuing recent user workflows. Release notes element is shown after ChromeOS device updates to a new version. Clicking the relese notes element will redirect user to an app that gives the user more information about the ChromeOS update [CHAR_LIMIT=20]">
        Mise à jour d'openJema
      </message>
      <message name="IDS_ASH_SHELF_OS_INSTALL_BUTTON" desc="Text shown on install cloudready button on login screen.">
        Installer openJema
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_HELP_APP_WHATS_NEW_CONTINUE_TASK_TITLE" desc="Title for a ChromeOS launcher continue section item that can be used to quickly access most recent ChromeOS release notes. Continue section contains set of UI elements that are suggestions for continuing recent user workflows. Release notes element is shown after ChromeOS device updates to a new version. Clicking the relese notes element will redirect user to an app that gives the user more information about the ChromeOS update [CHAR_LIMIT=20]">
        openJema update
      </message>
      <message name="IDS_ASH_SHELF_OS_INSTALL_BUTTON" desc="Text shown on install cloudready button on login screen.">
        Install openJema
      </message>
    </if>
  </if>
  <if expr="not openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_HELP_APP_WHATS_NEW_CONTINUE_TASK_TITLE" desc="Title for a ChromeOS launcher continue section item that can be used to quickly access most recent ChromeOS release notes. Continue section contains set of UI elements that are suggestions for continuing recent user workflows. Release notes element is shown after ChromeOS device updates to a new version. Clicking the relese notes element will redirect user to an app that gives the user more information about the ChromeOS update [CHAR_LIMIT=20]">
        Mise à jour de JemaOS
      </message>
      <message name="IDS_ASH_SHELF_OS_INSTALL_BUTTON" desc="Text shown on install cloudready button on login screen.">
        Installer JemaOS
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_HELP_APP_WHATS_NEW_CONTINUE_TASK_TITLE" desc="Title for a ChromeOS launcher continue section item that can be used to quickly access most recent ChromeOS release notes. Continue section contains set of UI elements that are suggestions for continuing recent user workflows. Release notes element is shown after ChromeOS device updates to a new version. Clicking the relese notes element will redirect user to an app that gives the user more information about the ChromeOS update [CHAR_LIMIT=20]">
        JemaOS update
      </message>
      <message name="IDS_ASH_SHELF_OS_INSTALL_BUTTON" desc="Text shown on install cloudready button on login screen.">
        Install JemaOS
      </message>
    </if>
  </if>
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_FEEDBACK_TOOL_PAGE_TITLE" desc="Label showing the title of the feedback tool before a report has been sent">
      Envoyer des commentaires à l'équipe d'assistance JemaOS
    </message>
    <message name="IDS_FEEDBACK_TOOL_ATTACH_FILE_LABEL_TOOLTIP" desc="Label for the tooltip content on attach files icon.">
      Les fichiers seront envoyés à l'équipe de développement JemaOS pour le débogage ; vous pouvez également choisir un fichier supplémentaire (moins de 5 Mo) à soumettre.
    </message>
    <message name="IDS_FEEDBACK_TOOL_USER_CONSENT_LABEL" desc="Label for checkbox indicating whether the user agrees to be contacted back.">
      Autoriser l'équipe de développement JemaOS à vous contacter par e-mail concernant ce problème
    </message>
    <message name="IDS_FEEDBACK_TOOL_FILE_TOO_BIG_ERROR_MESSAGE" desc="Error message when the upload file is larger than 10MB.">
      Impossible de télécharger un fichier de plus de 5 Mo
    </message>
    <message name="IDS_FEEDBACK_TOOL_SHARE_PAGE_URL_LABEL" desc="Label showing the share page url.">
      Partager l'URL récente :
    </message>
    <message name="IDS_FEEDBACK_TOOL_PRIVACY_NOTE" desc="Text for the privacy note included in the feedback app">
      En cliquant sur le bouton « Envoyer », vous soumettrez les informations et données sélectionnées à l'équipe de développement JemaOS. Nous utiliserons les informations que vous nous fournissez pour résoudre les problèmes techniques et améliorer l'expérience utilisateur de JemaOS. Nous nous engageons à traiter les données conformément à notre <ph name="BEGIN_LINK1">&lt;a id="privacyPolicyUrl"&gt;</ph>Politique de confidentialité<ph name="END_LINK1">&lt;/a&gt;</ph> et nos <ph name="BEGIN_LINK2">&lt;a id="termsOfServiceUrl"&gt;</ph>Conditions d'utilisation<ph name="END_LINK2">&lt;/a&gt;</ph>.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_FEEDBACK_TOOL_PAGE_TITLE" desc="Label showing the title of the feedback tool before a report has been sent">
      Send feedback to the JemaOS support team
    </message>
    <message name="IDS_FEEDBACK_TOOL_ATTACH_FILE_LABEL_TOOLTIP" desc="Label for the tooltip content on attach files icon.">
      Files will be sent to JemaOS development team for debugging; you can also choose an additional file (less than 5MB) to submit.
    </message>
    <message name="IDS_FEEDBACK_TOOL_USER_CONSENT_LABEL" desc="Label for checkbox indicating whether the user agrees to be contacted back.">
      Allow the JemaOS development team to email you about this issue
    </message>
    <message name="IDS_FEEDBACK_TOOL_FILE_TOO_BIG_ERROR_MESSAGE" desc="Error message when the upload file is larger than 10MB.">
      Can't upload file larger than 5 MB
    </message>
    <message name="IDS_FEEDBACK_TOOL_SHARE_PAGE_URL_LABEL" desc="Label showing the share page url.">
      Share recent URL:
    </message>
    <message name="IDS_FEEDBACK_TOOL_PRIVACY_NOTE" desc="Text for the privacy note included in the feedback app">
      Clicking the "Send" button will submit your selected information and data to the JemaOS development team. We will use the information you give us to help address technical issues and improve the user experience of JemaOS. We promise to handle the data in strict accordance with our <ph name="BEGIN_LINK1">&lt;a id="privacyPolicyUrl"&gt;</ph>Privacy Policy<ph name="END_LINK1">&lt;/a&gt;</ph> and <ph name="BEGIN_LINK2">&lt;a id="termsOfServiceUrl"&gt;</ph>Terms of Use<ph name="END_LINK2">&lt;/a&gt;</ph>.
    </message>
  </if>
  <if expr="openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_OFFLINE" desc="Thank you note when feedback tool is offline">
        Vos commentaires nous aident à améliorer l'expérience d'utilisation d'openJema et seront examinés prochainement par notre équipe. Si vous souhaitez mentionner vos commentaires à un membre de l'équipe d'assistance JemaOS dans les communautés publiques, veuillez inclure la référence unique suivante :
      </message>
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_ONLINE" desc="Thank you note when feedback tool is online">
        Vos commentaires nous aident à améliorer l'expérience d'utilisation d'openJema et seront examinés prochainement par notre équipe. Si vous souhaitez mentionner vos commentaires à un membre de l'équipe d'assistance JemaOS dans les communautés publiques, veuillez inclure la référence unique suivante :
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_OFFLINE" desc="Thank you note when feedback tool is offline">
        Your feedback helps us improve the experience of using openJema and will be reviewed by our team soon. If you wish to mention your feedback to a member of the JemaOS support team in the public communities, please include the following unique reference:
      </message>
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_ONLINE" desc="Thank you note when feedback tool is online">
        Your feedback helps us improve the experience of using openJema and will be reviewed by our team soon. If you wish to mention your feedback to a member of the JemaOS support team in the public communities, please include the following unique reference:
      </message>
    </if>
  </if>
  <if expr="not openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_OFFLINE" desc="Thank you note when feedback tool is offline">
        Vos commentaires nous aident à améliorer l'expérience d'utilisation de JemaOS et seront examinés prochainement par notre équipe. Si vous souhaitez mentionner vos commentaires à un membre de l'équipe d'assistance JemaOS dans les communautés publiques, veuillez inclure la référence unique suivante :
      </message>
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_ONLINE" desc="Thank you note when feedback tool is online">
        Vos commentaires nous aident à améliorer l'expérience d'utilisation de JemaOS et seront examinés prochainement par notre équipe. Si vous souhaitez mentionner vos commentaires à un membre de l'équipe d'assistance JemaOS dans les communautés publiques, veuillez inclure la référence unique suivante :
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_OFFLINE" desc="Thank you note when feedback tool is offline">
        Your feedback helps us improve the experience of using JemaOS and will be reviewed by our team soon. If you wish to mention your feedback to a member of the JemaOS support team in the public communities, please include the following unique reference:
      </message>
      <message name="IDS_FEEDBACK_TOOL_THANK_YOU_NOTE_ONLINE" desc="Thank you note when feedback tool is online">
        Your feedback helps us improve the experience of using JemaOS and will be reviewed by our team soon. If you wish to mention your feedback to a member of the JemaOS support team in the public communities, please include the following unique reference:
      </message>
    </if>
  </if>
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_FEEDBACK_TOOL_RESOURCES_ASK_COMMUNITY_LABEL" desc="Label of the ask community that opens an external link to the Chromebook community.">
      Communauté JemaOS
    </message>
    <message name="IDS_FEEDBACK_TOOL_RESOURCES_ASK_COMMUNITY_DESCRIPTION" desc="Description of the ask community link">
      Demandez à d'autres utilisateurs expérimentés dans le forum communautaire
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_FEEDBACK_TOOL_RESOURCES_ASK_COMMUNITY_LABEL" desc="Label of the ask community that opens an external link to the Chromebook community.">
      JemaOS Community
    </message>
    <message name="IDS_FEEDBACK_TOOL_RESOURCES_ASK_COMMUNITY_DESCRIPTION" desc="Description of the ask community link">
      Ask other experienced users in the community forum
    </message>
  </if>
  <message name="IDS_SANITIZE_WARNING" desc="Warning text in the safety reset">
    Safety reset turns off browser extensions and resets network and other settings to safe defaults.
    Your tabs, files, cookies, and history won’t be changed.
  </message>
  <if expr="openjema">
    <message name="IDS_SANITIZE_DONE_DESCRIPTION" desc="Description of the safety reset done dialog">
      Your openJema was reset to safe defaults. You can adjust these changes anytime in Settings.
    </message>
    <message name="IDS_SANITIZE_DONE_ACCORDION_CHROMEOS_TITLE" desc="Accordion title for ChromeOS resets">
      openJema Settings
    </message>
  </if>
  <if expr="not openjema">
    <message name="IDS_SANITIZE_DONE_DESCRIPTION" desc="Description of the safety reset done dialog">
      Your JemaOS was reset to safe defaults. You can adjust these changes anytime in Settings.
    </message>
    <message name="IDS_SANITIZE_DONE_ACCORDION_CHROMEOS_TITLE" desc="Accordion title for ChromeOS resets">
      JemaOS Settings
    </message>
  </if>
  <message name="IDS_SANITIZE_DONE_ACCORDION_CHROME_TITLE" desc="Accordion title for Chrome resets">
    Thot Settings
  </message>
</grit-part>
