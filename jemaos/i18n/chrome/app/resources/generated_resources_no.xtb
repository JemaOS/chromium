<translationbundle lang="no">
	<translation id="7386402409475121504">Opprett din lokale JemaOS-konto</translation>
	<translation id="3760308806144055927">Logg på din lokale JemaOS-konto</translation>
	<translation id="3325117507482096812">Vennligst skriv inn et passord</translation>
	<translation id="1838206877831947154">Passordene dine stemmer ikke overens</translation>
	<translation id="2158276988029582286">Opprett en ny lokal konto</translation>
	<translation id="8592849747346274067">Logg på en eksisterende konto</translation>
	<translation id="482190417986201746">Brukernavnet eller passordet du skrev inn er feil</translation>
	<translation id="6603987686259425085">Du kan <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>logge på med en JemaOS lokal konto<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-postadressen <ph name="EMAIL_ADDRESS">$1</ph> eksisterer allerede. Prøv på nytt med en annen e-post.</translation>
	<translation id="7215016743510876720">Bruk lokal konto</translation>
	<translation id="6657635042185516718">Fortsett å bruke nettkonto</translation>
	<translation id="6867476688065565618">Bytte til lokal konto?</translation>
	<translation id="4840454774882557974">Hvis du velger å bruke en lokal konto, vil nyttige funksjoner som synkronisering av data og preferanser på tvers av flere enheter og automatisk pålogging av nettapper ved hjelp av JemaOS-kontoen din ikke fungere.</translation>
	<translation id="8951507920859729424">Vi anbefaler å bruke en nettkonto for å utnytte JemaOS til det fulle.</translation>
	<translation id="479773200536372215">Du vil ikke kunne legge til Google-kontoer fordi Google API-nøkler mangler. Se <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for detaljer.</translation>
	<translation id="1198491307547164157">Du vil ikke kunne legge til JemaOS-kontoer fordi JemaOS API-nøkler mangler. Se <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for detaljer.</translation>
	<translation id="5042404702659901995">Personvernerklæring</translation>
	<translation id="4907736162587268100">Personvernerklæringens innhold</translation>
	<translation id="5988344732274877691">Registrer deg for (svært sjelden, lovet) nyhetsbrev for JemaOS</translation>
	<translation id="1706203008474708805">Bli med i JemaOS-plan for forbedring av brukeropplevelsen</translation>
	<translation id="1147139514756087229">Logg på med en lokal konto</translation>
	<translation id="2054784944085654098">Oppretter sikkerhetskopifil nå. Dette kan ta en stund; vennligst vent...</translation>
	<translation id="3554401467586751874">Sikkerhetskopieringsfilen ble opprettet</translation>
	<translation id="2349211327705667074">Se sikkerhetskopifilen</translation>
	<translation id="3049367131589710124">Se feillogg</translation>
	<translation id="1079017345574916945">Eksternt skrivebord</translation>
	<translation id="3064478898280877715">App store</translation>
	<translation id="5890206344045530832">Installatør</translation>
	<translation id="2173278076276376488">Dette verktøyet hjelper deg med å installere <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> på den interne lagringen til denne enheten.</translation>
	<translation id="5323182426977498659">Advarsel! Denne prosedyren er destruktiv og kan ikke angres. Vær oppmerksom på at vi ikke vil holde noe ansvar for potensielt tap av data eller gi noen presserende teknisk støtte, fortsett på egen risiko.</translation>
	<translation id="8517836015601969896">Full diskinstallasjon</translation>
	<translation id="7300045760790370189">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> for å okkupere en hel harddisk, alle data på målharddisken vil bli slettet.</translation>
	<translation id="8762511733918256595">Multi-boot installasjon</translation>
	<translation id="248900698427753678">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> til en eksisterende partisjon på en harddisk, der <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kan eksistere parallelt med andre operativsystemer. Alle data på målpartisjonen vil bli slettet.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil bli installert på den valgte harddisken; alle data på måldisken vil bli slettet.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Ingen disk tilgjengelig</translation>
	<translation id="8217653566575018388">Installasjonen fullført</translation>
	<translation id="8846746259444262774">Installasjonen mislyktes</translation>
	<translation id="7263815009235541549">Installasjonen er fullført. Slå av enheten først, fjern deretter eventuelle installasjonsmedier, og slå den på igjen for å starte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Beklager, noe har gått galt og installasjonen ble ikke fullført. Vennligst prøv prosessen på nytt. Hvis den samme feilen vedvarer, vennligst kontakt JemaOS Support med loggen ovenfor.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil bli installert på den valgte partisjonen på harddisken. Under den nåværende multi-boot-ordningen kan dette bare fortsette hvis enheten din støtter UEFI og harddiskene dine er formatert med GPT.</translation>
	<translation id="7831363758161884243">Målpartisjonen vil bli slettet; du må også spesifisere din aktive EFI-partisjon (vanligvis gjøres automatisk) ettersom installasjonsprogrammet må endre systemoppstartskonfigurasjoner.</translation>
	<translation id="5670799238446305550">Velg <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> målpartisjon</translation>
	<translation id="3695537760133394753">Partisjon</translation>
	<translation id="5610519566593708119">Velg EFI-partisjon</translation>
	<translation id="3367650349940010965">Det er ingen partisjoner tilgjengelig for den valgte disken</translation>
	<translation id="7453223384507098390">Det er ingen EFI-partisjoner tilgjengelig for den valgte disken</translation>
	<translation id="1854532683465500847">Størrelsen på den valgte partisjonen er mindre enn 20 GB, installasjonen kan mislykkes</translation>
	<translation id="4144613075340468247">Den valgte partisjonen har blitt montert til <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, installering på den igjen kan mislykkes</translation>
	<translation id="5793361052649920836">Etter installasjonen, hvordan vil du starte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Installer og konfigurer rEFInd for meg (anbefalt)</translation>
	<translation id="1858708492548921044">rEFInd er et oppstartsbehandlingsprogram som tilbyr et fint grafisk grensesnitt for OS-oppstartsalternativer når PC-en starter opp, vil du kunne velge ønsket OS for å starte opp med det. For mer informasjon om rEFInd, vennligst se hjemmesiden.</translation>
	<translation id="3861924051442564602">Legg til et UEFI-oppstartsmenyalternativ for meg</translation>
	<translation id="8622370666798589804">Når PC-en starter opp, kan du kanskje gå inn i UEFI-oppstartsalternativmenyen (mest sannsynlig ved å trykke på en hurtigtast), dette alternativet legger til <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> som en oppføring til den menyen. (Støtter bare enkelte modeller av BIOS og UEFI-fastvare).</translation>
	<translation id="1569398690544416170">Ikke gjør noe her, jeg konfigurerer det selv</translation>
	<translation id="3554866444001249532">Dette installasjonsskriptet vil bare sette nødvendige .efi-filer for oppstart av <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> til EFI-partisjonen din, du må konfigurere hvordan du starter den opp selv.</translation>
	<translation id="7492832751164189534">Tvinge avslutning</translation>
	<translation id="5159534860632584026">Installasjonsprosessen er avsluttet</translation>
	<translation id="8686749782014838344">Kunne ikke hente diskinformasjon</translation>
	<translation id="5688543378771259173">Installasjonen avsluttes...</translation>
	<translation id="5350452134936384991">Installer i USB</translation>
	<translation id="8008470485414925603">Installer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> på en USB-disk; alle data på mål-USB-disken vil bli slettet.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> vil bli installert på den valgte USB-disken; alle data på måldisken vil bli slettet.</translation>
	<translation id="5725593226060700263">Ingen USB-disk tilgjengelig</translation>
	<translation id="4357040841587078287">Vi har oppdaget at du kjører denne kopien av JemaOS fra en nedlastet bildefil. For å utnytte de mest omfattende støttefunksjonene (inkludert Over-The-Air-oppdateringer) som JemaOS kan tilby, anbefaler vi på det sterkeste at du starter "Installer"-funksjonen for å utføre en fulldiskinstallasjon av JemaOS til en separat lagringsenhet.</translation>
	<translation id="1246398339704431302">Du kan <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>fortsette å bruke denne kopien av JemaOS uansett<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, installasjonsprosessen kan utføres på et senere tidspunkt i systemet, men alle dataene dine vil bli slettet fra denne siden, og du vil begynne på nytt etter installasjonen.</translation>
	<translation id="3654532222088291133">I stedet for å skrive inn JemaOS-kontopassordet for å logge på, kan du opprette et <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph>-passord for denne enheten</translation>
	<translation id="8377684629839541977">Bruk JemaOS-kontopassord</translation>

