<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot-നെ കുറിച്ച്</translation>
<translation id="5639860668557220477">Thot ബ്രൗസറിൽ സഹായം നേടുക</translation>
<translation id="1692689520561928457">JemaOS-നെ കുറിച്ച്</translation>
<translation id="8692765844418174375">JemaOS പതിപ്പ്</translation>
<translation id="2943260250558374955">JemaOS-ൽ സഹായം നേടുക</translation>
<translation id="713321354492170993">നിർജ്ജീവ ടാബുകളിൽ നിന്ന് ബ്രൗസർ മെമ്മറി സ്വതന്ത്രമാക്കുന്നു. ഇത് സജീവ ടാബുകൾക്കും മറ്റ് ആപ്പുകൾക്കും കൂടുതൽ കമ്പ്യൂട്ടിംഗ് ഉറവിടങ്ങൾ നൽകുകയും ബ്രൗസർ വേഗതയുള്ളതായി നിലനിർത്തുകയും ചെയ്യുന്നു. നിങ്ങൾ അവയിലേക്ക് മടങ്ങിയെത്തുമ്പോൾ നിങ്ങളുടെ നിർജ്ജീവ ടാബുകൾ യാന്ത്രികമായി വീണ്ടും സജീവമാകും.</translation>
<translation id="1774190491044887444">സുഗമമായ സ്ക്രോളിംഗ്, വീഡിയോ ഫ്രെയിം നിരക്കുകൾ തുടങ്ങിയ പശ്ചാത്തല പ്രവർത്തനങ്ങളും വിഷ്വൽ ഇഫക്ടുകളും പരിമിതപ്പെടുത്തിയിക്കൊണ്ട് ബ്രൗസർ ബാറ്ററി ലാഭിക്കുന്നു.</translation>
<translation id="180121268008059459">ബ്രൗസർ പേജുകൾ മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇത് ബ്രൗസിംഗും തിരയലും വേഗത്തിലാക്കുന്നു.</translation>
<translation id="7127093527178692287">ബാക്കപ്പ് പുനഃസ്ഥാപിക്കുക (ബീറ്റ)</translation>
<translation id="4439042171549201806">ഒരു ബാക്കപ്പ് ഫയലിൽ നിന്ന് JemaOS പുനഃസ്ഥാപിക്കാൻ, ബാക്കപ്പ് ഫയൽ അടങ്ങിയ നീക്കം ചെയ്യാവുന്ന ഡ്രൈവ് ഇപ്പോൾ നിങ്ങളുടെ JemaOS ഉപകരണത്തിൽ ദയവായി ഘടിപ്പിക്കുക, നിങ്ങൾക്ക് ഏത് ബാക്കപ്പ് ഫയൽ ആണ് പുനഃസ്ഥാപിക്കേണ്ടതെന്ന് വ്യക്തമാക്കുക. ഈ വിസാർഡ് കണ്ടെത്താൻ നിങ്ങളുടെ ബാക്കപ്പ് ഫയൽ നീക്കം ചെയ്യാവുന്ന ഡ്രൈവിന്റെ റൂട്ട് ഡയറക്ടറിയിൽ ആയിരിക്കണമെന്ന് ദയവായി ശ്രദ്ധിക്കുക.</translation>
<translation id="2955409026764742995">പുനഃസ്ഥാപിക്കേണ്ട ബാക്കപ്പ് ഫയൽ തിരഞ്ഞെടുക്കുക:</translation>
<translation id="7040434808685140085">ക്ഷമിക്കണം, തിരഞ്ഞെടുത്ത ബാക്കപ്പ് ഫയൽ തിരിച്ചറിയാൻ കഴിയുന്നില്ല; ദയവായി പുതിയൊന്ന് തിരഞ്ഞെടുക്കുക.</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />തിരഞ്ഞെടുത്ത ബാക്കപ്പ് ഫയലിൽ നിന്ന് JemaOS പുനഃസ്ഥാപിക്കാൻ, ബാക്കപ്പ് സൃഷ്ടിച്ചപ്പോഴത്തെ കൃത്യമായ വിവരങ്ങൾ ഉണ്ടായിരിക്കേണ്ടത് അത്യന്താപേക്ഷിതമാണ്. അല്ലെങ്കിൽ, പുനഃസ്ഥാപിക്കൽ പ്രക്രിയ പരാജയപ്പെടും.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"അക്കൗണ്ട് പേര്" എന്നത് നിങ്ങളുടെ ബാക്കപ്പ് ഫയൽ സൃഷ്ടിച്ച അക്കൗണ്ടിന്റെ പ്രാഥമിക ലോഗിൻ ക്രെഡൻഷ്യലാണ്. ഇത് സാധാരണയായി നിങ്ങളുടെ JemaOS/Google അക്കൗണ്ടിനായി സൈൻ അപ്പ് ചെയ്യാൻ ഉപയോഗിച്ച ഇമെയിൽ വിലാസമായിരിക്കും. അതൊരു പ്രാദേശിക അക്കൗണ്ട് ആണെങ്കിൽ, "@jemaos.local" ചേർത്ത ഉപയോക്തൃനാമമായിരിക്കും.<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />പാസ്‌വേഡ് എന്നത് ബാക്കപ്പ് സൃഷ്ടിച്ചപ്പോൾ നൽകാൻ ആവശ്യപ്പെട്ട പാസ്‌ഫ്രെയ്സാണ്. ഇത് സാധാരണയായി ഈ അക്കൗണ്ടിനായി JemaOS ഡെസ്ക്ക്ടോപ്പിലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഉപയോഗിച്ച അതേ പാസ്‌വേഡ് ആയിരിക്കും.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">അക്കൗണ്ട് പേര്</translation>
<translation id="5490570429039308155">ക്ഷമിക്കണം, ദയവായി ശരിയായ അക്കൗണ്ട് പേര് നൽകുക</translation>
<translation id="6657585470893396449">പാസ്‌വേഡ്</translation>
<translation id="8200189938001188563">ക്ഷമിക്കണം, പാസ്‌വേഡ് ശൂന്യമായിരിക്കാൻ പാടില്ല</translation>
<translation id="3157931365184549694">പുനഃസ്ഥാപിക്കുക</translation>
<translation id="8556278756526311953">ബാക്കപ്പ് പുനഃസ്ഥാപിക്കുന്നു</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />നിങ്ങളുടെ ബാക്കപ്പ് ഫയൽ പുനഃസ്ഥാപിക്കുന്നതിനുള്ള പ്രവർത്തനം ഞങ്ങൾ ഇപ്പോൾ നടത്തിക്കൊണ്ടിരിക്കുന്നു; ഇതിന് കുറച്ച് സമയം എടുത്തേക്കാം, അതിനാൽ ദയവായി ക്ഷമിക്കുക.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />പുനഃസ്ഥാപിക്കൽ പ്രക്രിയ വിജയകരമായി പൂർത്തിയാകുമ്പോൾ UI യാന്ത്രികമായി പുനരാരംഭിക്കുമെന്ന് ദയവായി ശ്രദ്ധിക്കുക.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ബാക്കപ്പ് പുനഃസ്ഥാപിക്കൽ പരാജയപ്പെട്ടു</translation>
<translation id="5003531399442003695">കൂടുതൽ വിവരങ്ങൾക്കായി, ലോഗുകൾ കാണാൻ ദയവായി താഴെയുള്ള ലിങ്കിൽ ക്ലിക്ക് ചെയ്യുക. ഈ പിശക് തുടരുന്നുവെങ്കിൽ, ദയവായി JemaOS സാങ്കേതിക പിന്തുണാ ചാനലുകളെ ബന്ധപ്പെടുകയും പിശക് ലോഗുകൾ നൽകുകയും ചെയ്യുക.</translation>
<translation id="6363786367719063276">ലോഗുകൾ കാണുക</translation>
<translation id="8730621377337864115">പൂർത്തിയായി</translation>
<translation id="975238173507911396">ഡാറ്റ പുനഃസ്ഥാപിക്കൽ വിജയിച്ചു</translation>
<translation id="6276879052695618521">ബാക്കപ്പ് പുനഃസ്ഥാപിക്കൽ ലോഗുകൾ</translation>
<translation id="4901207598072637766">JemaOS, <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> നൽകുന്നത്</translation>
<translation id="7894910504474624324">JemaOS-ഉം അതിന്റെ സേവനങ്ങളും GDPR-ഉം യൂറോപ്യൻ ഡാറ്റാ സംരക്ഷണ നിയമത്തിന്റെ വ്യവസ്ഥകളും പാലിക്കുന്നു. കൂടുതൽ വിവരങ്ങൾക്കായി, ദയവായി ഞങ്ങളുടെ <ph name="BEGIN_LINK_PRIVACY" />സ്വകാര്യതാ നയം<ph name="END_LINK_PRIVACY" />-ഉം ഞങ്ങളുടെ <ph name="BEGIN_LINK_TOS" />സേവന നിബന്ധനകൾ.<ph name="END_LINK_TOS" />-ഉം കാണുക.</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, എല്ലാ അവകാശങ്ങളും നിക്ഷിപ്തം.</translation>
<translation id="370679569376308836">JemaOS എന്നത് Jema ഉപകരണത്തെയും അതിന്റെ SaaS-ഉം അടിസ്ഥാനമാക്കിയുള്ള ഒരു വാണിജ്യ ഓഫറാണ്.</translation>
<translation id="2773644194450163486">JemaOS സാധ്യമാക്കിയിരിക്കുന്നത് <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> ഓപ്പൺ സോഴ്‌സ് പ്രോജക്റ്റ് വഴിയാണ്.</translation>
<translation id="2330680727776977160">Chromium-ഉം സാധ്യമാക്കിയിരിക്കുന്നത് മറ്റ് <ph name="BEGIN_LINK_1" />ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_1" />-ഉം <ph name="BEGIN_LINK_2" />അധിക ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_2" />-ഉം വഴിയാണ്.</translation>
<translation id="1419954813084261088">Jema Technology രൂപകൽപ്പന ചെയ്ത് നിർമ്മിച്ചത്.</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, എല്ലാ അവകാശങ്ങളും നിക്ഷിപ്തം.</translation>
<translation id="6168072053306020326">Jema Technology എന്നത് Jema Technology LTD-യുടെയും Jema Technology (Beijing) Limited-ന്റെയും വ്യാപാരനാമമാണ്.
        <ph name="LINE_BREAK" />
        Jema Technology LTD എന്നത് ഇംഗ്ലണ്ടിലും വെയിൽസിലും 12273803 കമ്പനി നമ്പരോടെ രജിസ്റ്റർ ചെയ്ത കമ്പനിയാണ്.</translation>
<translation id="1251589813188467292">പ്രധാനപ്പെട്ട ഉപകരണ വാറന്റിയും സേവന വിവരങ്ങളും</translation>
<translation id="4851115775198886021">ഉപകരണ SN:</translation>
</translationbundle>
