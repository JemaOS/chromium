<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="mr">
	<translation id="7386402409475121504">तुमचे स्थानिक JemaOS खाते तयार करा</translation>
	<translation id="3760308806144055927">तुमच्या स्थानिक JemaOS खात्यात साइन इन करा</translation>
	<translation id="3325117507482096812">कृपया पासवर्ड इनपुट करा</translation>
	<translation id="1838206877831947154">तुमचे पासवर्ड जुळत नाहीत</translation>
	<translation id="2158276988029582286">नवीन स्थानिक खाते तयार करा</translation>
	<translation id="8592849747346274067">विद्यमान खात्यात साइन इन करा</translation>
	<translation id="482190417986201746">तुम्ही प्रविष्ट केलेले वापरकर्तानाव किंवा पासवर्ड चुकीचा आहे</translation>
	<translation id="6603987686259425085">तुम्ही <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS स्थानिक खात्याने साइन इन करू शकता<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">ईमेल <ph name="EMAIL_ADDRESS">$1</ph> आधीपासून अस्तित्वात आहे. कृपया दुसऱ्या ईमेलने पुन्हा प्रयत्न करा.</translation>
	<translation id="7215016743510876720">स्थानिक खाते वापरा</translation>
	<translation id="6657635042185516718">ऑनलाइन खाते वापरणे सुरू ठेवा</translation>
	<translation id="6867476688065565618">स्थानिक खात्यावर स्विच करायचे?</translation>
	<translation id="4840454774882557974">तुम्ही स्थानिक खाते वापरण्याची निवड केल्यास, उपयुक्त वैशिष्ट्यांमध्ये तुमचा डेटा आणि प्राधान्ये एकाधिक डिव्हाइसेसवर समक्रमित करणे आणि तुमचे JemaOS खाते वापरून वेब ॲप्समध्ये स्वयंचलितपणे साइन इन करणे कार्य करणार नाही.</translation>
	<translation id="8951507920859729424">JemaOS चा पुरेपूर वापर करण्यासाठी आम्ही ऑनलाइन खाते वापरण्याची शिफारस करतो.</translation>
	<translation id="479773200536372215">तुम्ही Google खाती जोडू शकणार नाही कारण Google API की गहाळ आहेत. तपशीलांसाठी <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> पहा.</translation>
	<translation id="1198491307547164157">तुम्ही JemaOS खाती जोडू शकणार नाही कारण JemaOS API की गहाळ आहेत. तपशीलांसाठी <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> पहा.</translation>
	<translation id="5042404702659901995">गोपनीयता विधान</translation>
	<translation id="4907736162587268100">गोपनीयता विधान सामग्री</translation>
	<translation id="5988344732274877691">JemaOS साठी (अत्यंत क्वचित, वचन दिलेले) वृत्तपत्रासाठी साइन अप करा</translation>
	<translation id="1706203008474708805">JemaOS वापरकर्ता अनुभव सुधारणा योजनेत सामील व्हा</translation>
	<translation id="1147139514756087229">स्थानिक खात्यासह साइन इन करा</translation>
	<translation id="2054784944085654098">आता बॅकअप फाइल तयार करत आहे. यास थोडा वेळ लागू शकतो; कृपया प्रतीक्षा करा…</translation>
	<translation id="3554401467586751874">बॅकअप फाइल यशस्वीरित्या तयार केली गेली</translation>
	<translation id="2349211327705667074">बॅकअप फाइल पहा</translation>
	<translation id="6337433855796857931">बॅकअप अयशस्वी</translation>
	<translation id="3049367131589710124">त्रुटी लॉग पहा</translation>
	<translation id="1079017345574916945">रिमोट डेस्कटॉप</translation>
	<translation id="3064478898280877715">ॲप स्टोअर</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">इंस्टॉलर</translation>
	<translation id="2173278076276376488">ही उपयुक्तता तुम्हाला या डिव्हाइसच्या अंतर्गत स्टोरेजवर <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापित करण्यात मदत करेल.</translation>
	<translation id="5323182426977498659">चेतावणी! ही प्रक्रिया विनाशकारी आहे आणि ती पूर्ववत केली जाऊ शकत नाही. कृपया लक्षात घ्या की तुमच्या संभाव्य डेटाच्या नुकसानासाठी आम्ही कोणतीही जबाबदारी घेणार नाही किंवा कोणतेही तातडीचे तांत्रिक समर्थन देणार नाही, तुमच्या स्वत:च्या जोखमीवर पुढे जा.</translation>
	<translation id="8517836015601969896">पूर्ण डिस्क स्थापना</translation>
	<translation id="7300045760790370189">संपूर्ण हार्ड डिस्क व्यापण्यासाठी <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> इंस्टॉल करा, लक्ष्य हार्ड डिस्कचा सर्व डेटा पुसला जाईल.</translation>
	<translation id="8762511733918256595">मल्टी-बूट स्थापना</translation>
	<translation id="248900698427753678">हार्ड डिस्कच्या विद्यमान विभाजनावर <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापित करा, जिथे <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> इतर OS च्या समांतर अस्तित्वात असू शकतात. लक्ष्य विभाजनावरील सर्व डेटा पुसला जाईल.</translation>
	<translation id="8445241586733258838">तुमच्या निवडलेल्या हार्ड ड्राइव्हवर <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापित केले जाईल; लक्ष्य डिस्कवरील सर्व डेटा पुसला जाईल.</translation>
	<translation id="4039091757234555415">डिस्क</translation>
	<translation id="7783580523889684697">कोणतीही डिस्क उपलब्ध नाही</translation>
	<translation id="8217653566575018388">स्थापना पूर्ण झाली</translation>
	<translation id="8846746259444262774">स्थापना अयशस्वी</translation>
	<translation id="7263815009235541549">स्थापना यशस्वीरित्या पूर्ण झाली आहे. कृपया प्रथम तुमचे डिव्हाइस बंद करा, नंतर कोणताही इंस्टॉलेशन मीडिया काढा आणि <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> बूट करण्यासाठी ते पुन्हा चालू करा.</translation>
	<translation id="3380151284134965398">अरेरे, काहीतरी चूक झाली आहे आणि स्थापना पूर्ण झाली नाही. कृपया प्रक्रिया पुन्हा करून पहा. तीच त्रुटी कायम राहिल्यास, कृपया वरील लॉगसह JemaOS सपोर्टसाठी संपर्क साधा.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> तुमच्या हार्ड ड्राइव्हच्या निवडलेल्या विभाजनावर स्थापित केले जाईल. सध्याच्या मल्टी-बूट योजनेअंतर्गत, तुमचे डिव्हाइस UEFI ला सपोर्ट करत असेल आणि तुमची हार्ड डिस्क GPT सह फॉरमॅट केली असेल तरच हे पुढे जाऊ शकते.</translation>
	<translation id="7831363758161884243">लक्ष्य विभाजन पुसले जाईल; तुम्हाला तुमचे सक्रिय EFI विभाजन (सामान्यत: स्वयंचलितपणे केले जाते) निर्देशीत करणे देखील आवश्यक आहे कारण इंस्टॉलरला सिस्टम बूट संरचना सुधारणे आवश्यक आहे.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> लक्ष्य विभाजन निवडा</translation>
	<translation id="3695537760133394753">विभाजन</translation>
	<translation id="5610519566593708119">EFI विभाजन निवडा</translation>
	<translation id="3367650349940010965">निवडलेल्या डिस्कसाठी कोणतेही विभाजन उपलब्ध नाहीत</translation>
	<translation id="7453223384507098390">निवडलेल्या डिस्कसाठी कोणतेही EFI विभाजने उपलब्ध नाहीत</translation>
	<translation id="1854532683465500847">निवडलेल्या विभाजनाचा आकार 20GB पेक्षा कमी आहे, स्थापना अयशस्वी होऊ शकते</translation>
	<translation id="4144613075340468247">निवडलेले विभाजन <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> मल्टी-बूट वर माउंट केले गेले आहे, ते पुन्हा स्थापित करणे अयशस्वी होऊ शकते</translation>
	<translation id="5793361052649920836">इंस्टॉलेशननंतर, तुम्हाला <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> कसे बूट करायचे आहे?</translation>
	<translation id="4273235330352963866">माझ्यासाठी rEFInd स्थापित आणि कॉन्फिगर करा (शिफारस केलेले)</translation>
	<translation id="1858708492548921044">rEFInd हा बूट मॅनेजर प्रोग्राम आहे जो OS बूट पर्यायांसाठी एक छान ग्राफिकल इंटरफेस ऑफर करतो जेव्हा तुमचा पीसी सुरू होतो, तेव्हा तुम्ही त्यासह बूट करण्यासाठी तुमची इच्छित OS निवडण्यास सक्षम असाल. rEFInd संबंधित अधिक माहितीसाठी, कृपया त्याचे मुख्यपृष्ठ पहा.</translation>
	<translation id="3861924051442564602">माझ्यासाठी UEFI बूट मेनू पर्याय जोडा</translation>
	<translation id="8622370666798589804">तुमचा पीसी सुरू झाल्यावर तुम्ही UEFI बूट पर्याय मेनूमध्ये प्रवेश करू शकता (बहुधा हॉटकी दाबून), हा पर्याय <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> त्या मेनूमध्ये प्रवेश म्हणून जोडतो. (केवळ BIOS आणि UEFI फर्मवेअरच्या काही मॉडेल्सना समर्थन देते).</translation>
	<translation id="1569398690544416170">येथे काहीही करू नका, मी ते स्वतः कॉन्फिगर करेन</translation>
	<translation id="3554866444001249532">ही इन्स्टॉलेशन स्क्रिप्ट तुमच्या EFI विभाजनामध्ये <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> बूट करण्यासाठी फक्त आवश्यक .efi फाइल ठेवेल, तुम्हाला ते स्वतः कसे बूट करायचे ते कॉन्फिगर करावे लागेल.</translation>
	<translation id="7492832751164189534">सक्तीने सोडले</translation>
	<translation id="5159534860632584026">स्थापना प्रक्रिया समाप्त केली गेली आहे</translation>
	<translation id="8686749782014838344">डिस्क माहिती मिळवण्यात अयशस्वी</translation>
	<translation id="5688543378771259173">स्थापना समाप्त केली जात आहे...</translation>
	<translation id="5350452134936384991">यूएसबी मध्ये स्थापित करा</translation>
	<translation id="8008470485414925603">USB डिस्कवर <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापित करा; लक्ष्य USB डिस्कवरील सर्व डेटा पुसला जाईल.</translation>
	<translation id="1270668145107456127">तुमच्या निवडलेल्या USB डिस्कवर <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापित केले जाईल; लक्ष्य डिस्कवरील सर्व डेटा पुसला जाईल.</translation>
	<translation id="5725593226060700263">कोणतीही USB डिस्क उपलब्ध नाही</translation>
	<translation id="4357040841587078287">आम्हाला आढळले आहे की तुम्ही डाउनलोड केलेल्या इमेज फाइलमधून JemaOS ची प्रत चालवत आहात. JemaOS देऊ शकणाऱ्या सर्वात व्यापक समर्थन वैशिष्ट्यांचा (ओव्हर-द-एअर अपडेट्ससह) वापर करण्यासाठी, आम्ही जोरदार शिफारस करतो की तुम्ही वेगळ्या स्टोरेज डिव्हाइसवर JemaOS ची पूर्ण-डिस्क स्थापना करण्यासाठी "इंस्टॉलर" फंक्शन लॉन्च करा.</translation>
	<translation id="1246398339704431302">तुम्ही <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>तरीही JemaOS ची ही प्रत वापरणे सुरू ठेवू शकता<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, इन्स्टॉलेशन प्रक्रिया सिस्टममध्ये नंतरच्या टप्प्यावर कार्यान्वित केली जाऊ शकते, तथापि, इंस्टॉलेशननंतर तुमचा सर्व डेटा पुसून टाकला जाईल आणि तुम्ही पुन्हा सुरू कराल.</translation>
	<translation id="3654532222088291133">साइन इन करण्यासाठी तुमचा JemaOS खाते पासवर्ड टाकण्याऐवजी, तुम्ही या डिव्हाइससाठी <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> पासवर्ड तयार करू शकता</translation>
	<translation id="8377684629839541977">JemaOS खात्याचा पासवर्ड वापरा</translation>

