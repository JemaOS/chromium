	<translation id="5890206344045530832">ინსტალერი</translation>
	<translation id="2173278076276376488">ეს პროგრამა დაგეხმარებათ დააინსტალიროთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ამ მოწყობილობის შიდა მეხსიერებაზე.</translation>
	<translation id="5323182426977498659">გაფრთხილება! ეს პროცედურა დესტრუქციულია და მისი გაუქმება შეუძლებელია. გთხოვთ, გაითვალისწინოთ, რომ ჩვენ არ ვიღებთ პასუხისმგებლობას თქვენს პოტენციურ მონაცემთა დაკარგვაზე და არც რაიმე გადაუდებელ ტექნიკურ დახმარებას, გააგრძელეთ თქვენი რისკის ქვეშ.</translation>
	<translation id="8517836015601969896">სრული დისკის ინსტალაცია</translation>
	<translation id="7300045760790370189">დააინსტალირეთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> მთელი მყარი დისკის დასაკავებლად, სამიზნე მყარი დისკის ყველა მონაცემი წაიშლება.</translation>
	<translation id="8762511733918256595">მრავალ ჩატვირთვის ინსტალაცია</translation>
	<translation id="248900698427753678">დააინსტალირეთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> მყარი დისკის არსებულ დანაყოფზე, სადაც <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> შეიძლება არსებობდეს სხვა OS-ის პარალელურად. ყველა მონაცემი სამიზნე დანაყოფზე წაიშლება.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> დაინსტალირდება თქვენს არჩეულ მყარ დისკზე; ყველა მონაცემი სამიზნე დისკზე წაიშლება.</translation>
	<translation id="4039091757234555415">დისკი</translation>
	<translation id="7783580523889684697">დისკი არ არის ხელმისაწვდომი</translation>
	<translation id="8217653566575018388">ინსტალაცია დასრულებულია</translation>
	<translation id="8846746259444262774">ინსტალაცია ვერ მოხერხდა</translation>
	<translation id="7263815009235541549">ინსტალაცია წარმატებით დასრულდა. გთხოვთ, ჯერ გამორთეთ თქვენი მოწყობილობა, შემდეგ წაშალეთ ნებისმიერი საინსტალაციო მედია და ხელახლა ჩართეთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ჩატვირთვისთვის.</translation>
	<translation id="3380151284134965398">უი, რაღაც შეფერხდა და ინსტალაცია არ დასრულებულა. გთხოვთ, ხელახლა სცადოთ პროცესი. თუ იგივე შეცდომა შენარჩუნებულია, გთხოვთ, მიმართოთ JemaOS მხარდაჭერას ზემოთ მოყვანილი ჟურნალით.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> დაინსტალირდება თქვენი მყარი დისკის არჩეულ დანაყოფზე. მრავალჯერადი ჩატვირთვის ამჟამინდელი სქემის მიხედვით, ეს შეიძლება გაგრძელდეს მხოლოდ იმ შემთხვევაში, თუ თქვენი მოწყობილობა მხარს უჭერს UEFI-ს და თქვენი მყარი დისკები დაფორმატებულია GPT-ით.</translation>
	<translation id="7831363758161884243">სამიზნე დანაყოფი წაიშლება; თქვენ ასევე უნდა მიუთითოთ თქვენი აქტიური EFI დანაყოფი (ჩვეულებრივ ხდება ავტომატურად), რადგან ინსტალერს სჭირდება სისტემის ჩატვირთვის კონფიგურაციის შეცვლა.</translation>
	<translation id="5670799238446305550">აირჩიეთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> სამიზნე დანაყოფი</translation>
	<translation id="3695537760133394753">დანაყოფი</translation>
	<translation id="5610519566593708119">აირჩიეთ EFI დანაყოფი</translation>
	<translation id="3367650349940010965">არჩეული დისკისთვის არ არის ხელმისაწვდომი დანაყოფები</translation>
	<translation id="7453223384507098390">არჩეული დისკისთვის ხელმისაწვდომი არ არის EFI დანაყოფები</translation>
	<translation id="1854532683465500847">არჩეული დანაყოფის ზომა 20 გბ-ზე ნაკლებია, ინსტალაცია შეიძლება ვერ მოხერხდეს</translation>
	<translation id="4144613075340468247">არჩეული დანაყოფი დამონტაჟდა <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> მრავალჯერადი ჩატვირთვისთვის, მასზე ხელახლა ინსტალაცია შეიძლება ვერ მოხერხდეს</translation>
	<translation id="5793361052649920836">ინსტალაციის შემდეგ როგორ გსურთ ჩატვირთოთ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">დააინსტალირე და დააკონფიგურირე rEFInd ჩემთვის (რეკომენდირებულია)</translation>
	<translation id="1858708492548921044">rEFInd არის ჩატვირთვის მენეჯერის პროგრამა, რომელიც გთავაზობთ კარგ გრაფიკულ ინტერფეისს OS-ის ჩატვირთვის ვარიანტებისთვის, როდესაც თქვენი კომპიუტერი ჩაირთვება, თქვენ შეძლებთ აირჩიოთ თქვენთვის სასურველი OS, რომ ჩაიტვირთოთ იგი. დამატებითი ინფორმაციისთვის REFInd-თან დაკავშირებით, გთხოვთ, ეწვიოთ მის მთავარ გვერდს.</translation>
	<translation id="3861924051442564602">დაამატეთ UEFI ჩატვირთვის მენიუს ვარიანტი ჩემთვის</translation>
	<translation id="8622370666798589804">როდესაც თქვენი კომპიუტერი ჩაირთვება, შესაძლოა შეხვიდეთ UEFI ჩატვირთვის პარამეტრების მენიუში (სავარაუდოდ ცხელი კლავიშის დაჭერით), ეს პარამეტრი ამ მენიუს ჩანაწერად ამატებს <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>. (მხოლოდ მხარს უჭერს BIOS და UEFI firmware-ის ზოგიერთ მოდელს).</translation>
	<translation id="1569398690544416170">აქ არაფერი გააკეთო, მე თვითონ გავაკეთებ კონფიგურაციას</translation>
	<translation id="3554866444001249532">ინსტალაციის ეს სკრიპტი თქვენს EFI დანაყოფში ჩატვირთავს მხოლოდ აუცილებელ .efi ფაილებს <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ჩატვირთვისთვის, თქვენ მოგიწევთ მისი დამოუკიდებლად ჩატვირთვის კონფიგურაცია.</translation>
