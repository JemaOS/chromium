<translationbundle lang="he">
	<translation id="7386402409475121504">צור את חשבון JemaOS המקומי שלך</translation>
	<translation id="3760308806144055927">היכנס לחשבון JemaOS המקומי שלך</translation>
	<translation id="3325117507482096812">נא להזין סיסמה</translation>
	<translation id="1838206877831947154">הסיסמאות שלך אינן תואמות</translation>
	<translation id="2158276988029582286">צור חשבון מקומי חדש</translation>
	<translation id="8592849747346274067">היכנס לחשבון קיים</translation>
	<translation id="482190417986201746">שם המשתמש או הסיסמה שהזנת שגויים</translation>
	<translation id="6603987686259425085">אתה יכול <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>להיכנס עם חשבון JemaOS מקומי<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">דוא"ל <ph name="EMAIL_ADDRESS">$1</ph> כבר קיים. אנא נסה שוב עם דוא"ל אחר.</translation>
	<translation id="7215016743510876720">השתמש בחשבון מקומי</translation>
	<translation id="6657635042185516718">המשך להשתמש בחשבון מקוון</translation>
	<translation id="6867476688065565618">לעבור לחשבון מקומי?</translation>
	<translation id="4840454774882557974">אם תבחר להשתמש בחשבון מקומי, תכונות שימושיות כוללות סנכרון הנתונים וההעדפות שלך במכשירים מרובים וכניסה אוטומטית לאפליקציות אינטרנט באמצעות חשבון JemaOS שלך לא תעבוד.</translation>
	<translation id="8951507920859729424">אנו ממליצים להשתמש בחשבון מקוון כדי להשתמש ב-JemaOS במלואו.</translation>
	<translation id="479773200536372215">לא תוכל להוסיף חשבונות Google מכיוון שחסרים מפתחות API של Google. ראה <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> לפרטים.</translation>
	<translation id="1198491307547164157">לא תוכל להוסיף חשבונות JemaOS מכיוון שחסרים מפתחות API של JemaOS. ראה <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> לפרטים.</translation>
	<translation id="5042404702659901995">הצהרת פרטיות</translation>
	<translation id="4907736162587268100">תוכן הצהרת הפרטיות</translation>
	<translation id="5988344732274877691">הירשם לניוזלטר (לא תדיר מאוד, מובטח) עבור JemaOS</translation>
	<translation id="1706203008474708805">הצטרף לתוכנית לשיפור חווית המשתמש של JemaOS</translation>
	<translation id="1147139514756087229">היכנס עם חשבון מקומי</translation>
	<translation id="2054784944085654098">יוצר קובץ גיבוי כעת. זה עשוי לקחת זמן מה; אנא המתן…</translation>
	<translation id="3554401467586751874">קובץ הגיבוי נוצר בהצלחה</translation>
	<translation id="2349211327705667074">הצג קובץ גיבוי</translation>
	<translation id="3049367131589710124">הצג יומן שגיאות</translation>
	<translation id="1079017345574916945">שולחן עבודה מרוחק</translation>
	<translation id="3064478898280877715">חנות אפליקציות</translation>
	<translation id="5890206344045530832">מתקין</translation>
	<translation id="2173278076276376488">כלי זה יעזור לך להתקין <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> על האחסון הפנימי של מכשיר זה.</translation>
	<translation id="5323182426977498659">אַזהָרָה! הליך זה הרסני ואינו ניתן לביטול. לידיעתך, לא נישא באחריות כלשהי לאובדן הנתונים הפוטנציאלי שלך ולא נספק תמיכה טכנית דחופה כלשהי, המשך על אחריותך בלבד.</translation>
	<translation id="8517836015601969896">התקנת דיסק מלאה</translation>
	<translation id="7300045760790370189">התקן את <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> כדי לכבוש דיסק קשיח שלם, כל הנתונים של הדיסק הקשיח היעד יימחקו.</translation>
	<translation id="8762511733918256595">התקנה מרובה אתחול</translation>
	<translation id="248900698427753678">התקן <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> למחיצה קיימת של דיסק קשיח, שבו <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> יכול להתקיים במקביל למערכות הפעלה אחרות. כל הנתונים במחיצת היעד יימחקו.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> יותקן בכונן הקשיח שבחרת; כל הנתונים בדיסק היעד יימחקו.</translation>
	<translation id="4039091757234555415">דיסק</translation>
	<translation id="7783580523889684697">אין דיסק זמין</translation>
	<translation id="8217653566575018388">ההתקנה הושלמה</translation>
	<translation id="8846746259444262774">ההתקנה נכשלה</translation>
	<translation id="7263815009235541549">ההתקנה הסתיימה בהצלחה. אנא כבה את המכשיר שלך תחילה, ולאחר מכן הסר כל אמצעי התקנה, והפעל אותו שוב כדי לאתחל את <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">אופס, משהו השתבש וההתקנה לא הושלמה. אנא נסה שוב את התהליך. אם אותה שגיאה נמשכת, פנה לתמיכה של JemaOS באמצעות היומן שלמעלה.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> יותקן במחיצה שנבחרה של הכונן הקשיח שלך. תחת ערכת ריבוי האתחול הנוכחית, זה יכול להמשיך רק אם המכשיר שלך תומך ב-UEFI והדיסקים הקשיחים שלך מפורמטים עם GPT.</translation>
	<translation id="7831363758161884243">מחיצת היעד תימחק; אתה גם צריך לציין את מחיצת ה-EFI הפעילה שלך (בדרך כלל מתבצעת באופן אוטומטי) שכן המתקין צריך לשנות את תצורות האתחול של המערכת.</translation>
	<translation id="5670799238446305550">בחר במחיצת היעד <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">מחיצה</translation>
	<translation id="5610519566593708119">בחר מחיצת EFI</translation>
	<translation id="3367650349940010965">אין מחיצות זמינות עבור הדיסק הנבחר</translation>
	<translation id="7453223384507098390">אין מחיצות EFI זמינות עבור הדיסק הנבחר</translation>
	<translation id="1854532683465500847">גודל המחיצה שנבחרה הוא פחות מ-20GB, ההתקנה עלולה להיכשל</translation>
	<translation id="4144613075340468247">המחיצה שנבחרה הורכבה לריבוי אתחול <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, ההתקנה בה שוב עלולה להיכשל</translation>
	<translation id="5793361052649920836">לאחר ההתקנה, כיצד תרצה לאתחל את <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">התקן והגדר עבורי rEFInd (מומלץ)</translation>
	<translation id="1858708492548921044">rEFInd היא תוכנית מנהל אתחול המציעה ממשק גרפי נחמד לאפשרויות האתחול של מערכת ההפעלה כאשר המחשב שלך מופעל, תוכל לבחור את מערכת ההפעלה הרצויה כדי לאתחל איתה. למידע נוסף על rEFInd, עיין בדף הבית שלו.</translation>
	<translation id="3861924051442564602">הוסף עבורי אפשרות לתפריט האתחול של UEFI</translation>
	<translation id="8622370666798589804">כאשר המחשב שלך מופעל ייתכן שתוכל להיכנס לתפריט אפשרויות האתחול של UEFI (ככל הנראה על ידי לחיצה על מקש קיצור), אפשרות זו מוסיפה <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> כערך לתפריט זה. (תומך רק בדגמים מסוימים של BIOS ו-UEFI קושחה).</translation>
	<translation id="1569398690544416170">אל תעשה כאן כלום, אני אקבע את זה בעצמי</translation>
	<translation id="3554866444001249532">סקריפט התקנה זה יכניס רק קבצי .efi הדרושים לאתחול <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> למחיצת ה-EFI שלך, תצטרך להגדיר כיצד לאתחל אותה בעצמך.</translation>
	<translation id="7492832751164189534">עזוב בכוח</translation>
	<translation id="5159534860632584026">תהליך ההתקנה הופסק</translation>
	<translation id="8686749782014838344">קבלת מידע על הדיסק נכשלה</translation>
	<translation id="5688543378771259173">ההתקנה מסתיימת...</translation>
	<translation id="5350452134936384991">התקן ב-USB</translation>
	<translation id="8008470485414925603">התקן <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> על גבי דיסק USB; כל הנתונים בכונן USB היעד יימחקו.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> יותקן בדיסק ה-USB שבחרת; כל הנתונים בדיסק היעד יימחקו.</translation>
	<translation id="5725593226060700263">אין דיסק USB זמין</translation>
	<translation id="4357040841587078287">זיהינו שאתה מפעיל עותק זה של JemaOS מקובץ תמונה שהורדת. כדי להשתמש בתכונות התמיכה המקיפות ביותר (כולל עדכוני Over-The-Air) ש-JemaOS יכולה להציע, אנו ממליצים בחום להפעיל את הפונקציה "מתקין" כדי לבצע התקנת דיסק מלא של JemaOS בהתקן אחסון נפרד.</translation>
	<translation id="1246398339704431302">אתה יכול <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>להמשיך להשתמש בעותק זה של JemaOS בכל מקרה<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, תהליך ההתקנה יכול להתבצע בשלב מאוחר יותר במערכת, עם זאת, כל הנתונים שלך יימחקו שוב מדף זה ותתחיל להתחיל מחדש.</translation>
	<translation id="3654532222088291133">במקום להזין את סיסמת חשבון JemaOS שלך כדי להיכנס, תוכל ליצור סיסמת <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> עבור מכשיר זה</translation>
	<translation id="8377684629839541977">השתמש בסיסמת חשבון JemaOS</translation>

