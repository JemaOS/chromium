<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ta">
	<translation id="7386402409475121504">உங்கள் உள்ளூர் JemaOS கணக்கை உருவாக்கவும்</translation>
	<translation id="3760308806144055927">உங்கள் உள்ளூர் JemaOS கணக்கில் உள்நுழையவும்</translation>
	<translation id="3325117507482096812">கடவுச்சொல்லை உள்ளிடவும்</translation>
	<translation id="1838206877831947154">உங்கள் கடவுச்சொற்கள் பொருந்தவில்லை</translation>
	<translation id="2158276988029582286">புதிய உள்ளூர் கணக்கை உருவாக்கவும்</translation>
	<translation id="8592849747346274067">ஏற்கனவே உள்ள கணக்கில் உள்நுழையவும்</translation>
	<translation id="482190417986201746">நீங்கள் உள்ளிட்ட பயனர்பெயர் அல்லது கடவுச்சொல் தவறானது</translation>
	<translation id="6603987686259425085">நீங்கள் <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS உள்ளூர் கணக்கின் மூலம் உள்நுழையலாம்<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">மின்னஞ்சல் <ph name="EMAIL_ADDRESS">$1</ph> ஏற்கனவே உள்ளது. மற்றொரு மின்னஞ்சலில் மீண்டும் முயற்சிக்கவும்.</translation>
	<translation id="7215016743510876720">உள்ளூர் கணக்கைப் பயன்படுத்தவும்</translation>
	<translation id="6657635042185516718">ஆன்லைன் கணக்கை தொடர்ந்து பயன்படுத்தவும்</translation>
	<translation id="6867476688065565618">உள்ளூர் கணக்கிற்கு மாறவா?</translation>
	<translation id="4840454774882557974">உள்ளூர் கணக்கைப் பயன்படுத்த நீங்கள் தேர்வுசெய்தால், பல சாதனங்களில் உங்கள் தரவு மற்றும் விருப்பத்தேர்வுகளை ஒத்திசைப்பது மற்றும் உங்கள் JemaOS கணக்கைப் பயன்படுத்தி தானாக இணைய பயன்பாடுகளில் உள்நுழைவது ஆகியவை பயனுள்ள அம்சங்களில் அடங்கும்.</translation>
	<translation id="8951507920859729424">JemaOS ஐ முழுமையாகப் பயன்படுத்த ஆன்லைன் கணக்கைப் பயன்படுத்த பரிந்துரைக்கிறோம்.</translation>
	<translation id="479773200536372215">Google API விசைகள் இல்லாததால், உங்களால் Google கணக்குகளைச் சேர்க்க முடியாது. விவரங்களுக்கு <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ஐப் பார்க்கவும்.</translation>
	<translation id="1198491307547164157">JemaOS API விசைகள் இல்லாததால் நீங்கள் JemaOS கணக்குகளைச் சேர்க்க முடியாது. விவரங்களுக்கு <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ஐப் பார்க்கவும்.</translation>
	<translation id="5042404702659901995">தனியுரிமை அறிக்கை</translation>
	<translation id="4907736162587268100">தனியுரிமை அறிக்கை உள்ளடக்கம்</translation>
	<translation id="5988344732274877691">JemaOS க்கான (மிகவும் அரிதாக, வாக்குறுதியளிக்கப்பட்ட) செய்திமடலுக்கு பதிவு செய்யவும்</translation>
	<translation id="1706203008474708805">JemaOS பயனர் அனுபவ மேம்பாட்டுத் திட்டத்தில் சேரவும்</translation>
	<translation id="1147139514756087229">உள்ளூர் கணக்கு மூலம் உள்நுழையவும்</translation>
	<translation id="2054784944085654098">காப்பு கோப்பை இப்போது உருவாக்குகிறது. இதற்கு சிறிது நேரம் ஆகலாம்; தயவுசெய்து காத்திருங்கள்…</translation>
	<translation id="3554401467586751874">காப்பு கோப்பு வெற்றிகரமாக உருவாக்கப்பட்டது</translation>
	<translation id="2349211327705667074">காப்பு கோப்பைப் பார்க்கவும்</translation>
	<translation id="6337433855796857931">காப்புப்பிரதி தோல்வியடைந்தது</translation>
	<translation id="3049367131589710124">பிழை பதிவைக் காண்க</translation>
	<translation id="1079017345574916945">ரிமோட் டெஸ்க்டாப்</translation>
	<translation id="3064478898280877715">ஆப் ஸ்டோர்</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">நிறுவி</translation>
	<translation id="2173278076276376488">இந்தச் சாதனத்தின் உள் சேமிப்பகத்தில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ஐ நிறுவ இந்தப் பயன்பாடு உதவும்.</translation>
	<translation id="5323182426977498659">எச்சரிக்கை! இந்த செயல்முறை அழிவுகரமானது மற்றும் செயல்தவிர்க்க முடியாது. உங்கள் சாத்தியமான தரவு இழப்புக்கு நாங்கள் எந்தப் பொறுப்பையும் ஏற்க மாட்டோம் அல்லது எந்த அவசர தொழில்நுட்ப ஆதரவையும் வழங்க மாட்டோம் என்பதை நினைவில் கொள்ளவும், உங்கள் சொந்த ஆபத்தில் தொடரவும்.</translation>
	<translation id="8517836015601969896">முழு வட்டு நிறுவல்</translation>
	<translation id="7300045760790370189">முழு ஹார்ட் டிஸ்க்கை ஆக்கிரமிக்க <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ நிறுவவும், இலக்கு ஹார்ட் டிஸ்க்கின் அனைத்து தரவுகளும் அழிக்கப்படும்.</translation>
	<translation id="8762511733918256595">பல துவக்க நிறுவல்</translation>
	<translation id="248900698427753678">வன் வட்டின் தற்போதைய பகிர்வில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ நிறுவவும், மற்ற OS உடன் இணையாக <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> இருக்க முடியும். இலக்கு பகிர்வில் உள்ள அனைத்து தரவுகளும் அழிக்கப்படும்.</translation>
	<translation id="8445241586733258838">நீங்கள் தேர்ந்தெடுத்த வன்வட்டில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> நிறுவப்படும்; இலக்கு வட்டில் உள்ள அனைத்து தரவுகளும் அழிக்கப்படும்.</translation>
	<translation id="4039091757234555415">வட்டு</translation>
	<translation id="7783580523889684697">வட்டு இல்லை</translation>
	<translation id="8217653566575018388">நிறுவல் முடிந்தது</translation>
	<translation id="8846746259444262774">நிறுவல் தோல்வியடைந்தது</translation>
	<translation id="7263815009235541549">நிறுவல் வெற்றிகரமாக முடிந்தது. முதலில் உங்கள் சாதனத்தை அணைத்து, பின்னர் நிறுவல் மீடியாவை அகற்றி, அதை மீண்டும் இயக்கி <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ துவக்கவும்.</translation>
	<translation id="3380151284134965398">அச்சச்சோ, ஏதோ தவறாகிவிட்டது மற்றும் நிறுவல் முடிவடையவில்லை. செயல்முறையை மீண்டும் முயற்சிக்கவும். இதே பிழை தொடர்ந்தால், மேலே உள்ள பதிவுடன் JemaOS ஆதரவைத் தொடர்பு கொள்ளவும்.</translation>
	<translation id="4683944976188707627">உங்கள் வன்வட்டின் தேர்ந்தெடுக்கப்பட்ட பகிர்வில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> நிறுவப்படும். தற்போதைய மல்டி-பூட் திட்டத்தின் கீழ், உங்கள் சாதனம் UEFI ஐ ஆதரித்தால் மற்றும் உங்கள் ஹார்ட் டிஸ்க்குகள் GPT மூலம் வடிவமைக்கப்பட்டிருந்தால் மட்டுமே இது தொடர முடியும்.</translation>
	<translation id="7831363758161884243">இலக்கு பகிர்வு துடைக்கப்படும்; உங்கள் செயலில் உள்ள EFI பகிர்வையும் குறிப்பிட வேண்டும் (பொதுவாக தானாகவே செய்யப்படும்) நிறுவி கணினி துவக்க உள்ளமைவுகளை மாற்ற வேண்டும்.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> இலக்கு பகிர்வைத் தேர்ந்தெடுக்கவும்</translation>
	<translation id="3695537760133394753">பிரிவினை</translation>
	<translation id="5610519566593708119">EFI பகிர்வைத் தேர்ந்தெடுக்கவும்</translation>
	<translation id="3367650349940010965">தேர்ந்தெடுக்கப்பட்ட வட்டுக்கு பகிர்வுகள் எதுவும் இல்லை</translation>
	<translation id="7453223384507098390">தேர்ந்தெடுக்கப்பட்ட வட்டுக்கு EFI பகிர்வுகள் எதுவும் இல்லை</translation>
	<translation id="1854532683465500847">தேர்ந்தெடுக்கப்பட்ட பகிர்வின் அளவு 20GB க்கும் குறைவாக உள்ளது, நிறுவல் தோல்வியடையும்</translation>
	<translation id="4144613075340468247">தேர்ந்தெடுக்கப்பட்ட பகிர்வு <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> க்கு ஏற்றப்பட்டது, மல்டி-பூட், அதை மீண்டும் நிறுவுவது தோல்வியடையும்</translation>
	<translation id="5793361052649920836">நிறுவிய பின், <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ஐ எவ்வாறு துவக்க விரும்புகிறீர்கள்?</translation>
	<translation id="4273235330352963866">எனக்காக rEFInd ஐ நிறுவி உள்ளமைக்கவும் (பரிந்துரைக்கப்பட்டது)</translation>
	<translation id="1858708492548921044">rEFInd என்பது ஒரு பூட் மேனேஜர் புரோகிராம் ஆகும், இது உங்கள் பிசி தொடங்கும் போது OS துவக்க விருப்பங்களுக்கு ஒரு நல்ல வரைகலை இடைமுகத்தை வழங்குகிறது, அதனுடன் துவக்க நீங்கள் விரும்பிய OS ஐ தேர்வு செய்ய முடியும். rEFInd பற்றிய கூடுதல் தகவலுக்கு, அதன் முகப்புப் பக்கத்தைப் பார்க்கவும்.</translation>
	<translation id="3861924051442564602">எனக்கான UEFI துவக்க மெனு விருப்பத்தைச் சேர்க்கவும்</translation>
	<translation id="8622370666798589804">உங்கள் பிசி தொடங்கும் போது, நீங்கள் UEFI துவக்க விருப்பங்கள் மெனுவை உள்ளிடலாம் (பெரும்பாலும் ஹாட்ஸ்கியை அழுத்துவதன் மூலம்), இந்த விருப்பம் அந்த மெனுவில் ஒரு நுழைவாக <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ சேர்க்கிறது. (பயாஸ் மற்றும் யுஇஎஃப்ஐ ஃபார்ம்வேரின் சில மாடல்களை மட்டுமே ஆதரிக்கிறது).</translation>
	<translation id="1569398690544416170">இங்கே எதுவும் செய்ய வேண்டாம், நானே அதை உள்ளமைப்பேன்</translation>
	<translation id="3554866444001249532">இந்த நிறுவல் ஸ்கிரிப்ட் உங்கள் EFI பகிர்வில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ துவக்குவதற்கு தேவையான .efi கோப்புகளை மட்டுமே வைக்கும், அதை நீங்களே எவ்வாறு துவக்குவது என்பதை நீங்கள் கட்டமைக்க வேண்டும்.</translation>
	<translation id="7492832751164189534">கட்டாயம் வெளியேறியது</translation>
	<translation id="5159534860632584026">நிறுவல் செயல்முறை நிறுத்தப்பட்டது</translation>
	<translation id="8686749782014838344">வட்டு தகவலைப் பெறுவதில் தோல்வி</translation>
	<translation id="5688543378771259173">நிறுவல் நிறுத்தப்படுகிறது...</translation>
	<translation id="5350452134936384991">USB இல் நிறுவவும்</translation>
	<translation id="8008470485414925603">USB டிஸ்கில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ஐ நிறுவவும்; இலக்கு USB வட்டில் உள்ள அனைத்து தரவுகளும் அழிக்கப்படும்.</translation>
	<translation id="1270668145107456127">நீங்கள் தேர்ந்தெடுத்த USB டிஸ்கில் <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> நிறுவப்படும்; இலக்கு வட்டில் உள்ள அனைத்து தரவுகளும் அழிக்கப்படும்.</translation>
	<translation id="5725593226060700263">USB டிஸ்க் இல்லை</translation>
	<translation id="4357040841587078287">பதிவிறக்கம் செய்யப்பட்ட படக் கோப்பிலிருந்து JemaOS இன் இந்த நகலை நீங்கள் இயக்குவதை நாங்கள் கண்டறிந்துள்ளோம். JemaOS வழங்கக்கூடிய மிகவும் விரிவான ஆதரவு அம்சங்களை (Over-The-Air updates உட்பட) பயன்படுத்த, JemaOS இன் முழு-வட்டு நிறுவலை ஒரு தனி சேமிப்பக சாதனத்தில் செயல்படுத்த "நிறுவாளர்" செயல்பாட்டைத் தொடங்குமாறு நாங்கள் கடுமையாக பரிந்துரைக்கிறோம்.</translation>
	<translation id="1246398339704431302">நீங்கள் <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>JemaOS இன் இந்த நகலை எப்படியும் தொடர்ந்து பயன்படுத்தலாம்<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, நிறுவல் செயல்முறையை கணினியில் ஒரு பிந்தைய கட்டத்தில் செயல்படுத்தலாம், இருப்பினும், இந்த பக்கத்திலிருந்து உங்கள் தரவு அனைத்தும் அழிக்கப்படும்.</translation>
	<translation id="3654532222088291133">உள்நுழைய, உங்கள் JemaOS கணக்கின் கடவுச்சொல்லை உள்ளிடுவதற்குப் பதிலாக, இந்தச் சாதனத்திற்கான <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> கடவுச்சொல்லை உருவாக்கலாம்.</translation>
	<translation id="8377684629839541977">JemaOS கணக்கு கடவுச்சொல்லைப் பயன்படுத்தவும்</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" /> ஐ தானாகவே புதுப்பித்த நிலையில் வைக்கவும்</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> புதுப்பிப்பு இயக்கப்பட்டது</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> புதுப்பிப்பு முடக்கப்பட்டது</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) தளம் <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">ரிமோட் டெஸ்க்டாப்</translation>
<translation id="6898090158927982244">உங்கள் Linux புதுப்பித்த நிலையில் உள்ளது</translation>
<translation id="4886703929102211360">Linux (பீட்டா) கூறுக்கு ஒரு முக்கியமான புதுப்பிப்பு கிடைக்கிறது. இந்தப் புதுப்பிப்பை விரைவில் நிறுவ பரிந்துரைக்கப்படுகிறது, இல்லையெனில் உங்கள் Linux (பீட்டா) செயல்படுவதை நிறுத்தலாம்.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> அமைப்புகள்</translation>
<translation id="8362858344151826493">JemaOS கணக்கு, காப்புப்பிரதி, பல்வேறு</translation>
<translation id="9150429437595727962">Wi-Fi அமைப்புகள்</translation>
<translation id="4938972461544498524">டச்பேட் அமைப்புகள்</translation>
<translation id="1210024513248363065">ரிமோட் சேவைகள்</translation>
<translation id="2878862288885588535">ரிமோட் கண்டறிதல் சேவை</translation>
<translation id="7409197984340676806">ரிமோட் கண்டறிதல் சேவை அதிகாரப்பூர்வ JemaOS ஆதரவு பிரதிநிதிகள் கணினி சிக்கல்களை அடையாளம் காண அனுமதிக்கிறது. தற்போது, ரிமோட் கண்டறிதல் சேவையை அதிகாரப்பூர்வ JemaOS ஆதரவு பிரதிநிதிகள் மட்டுமே தொடங்க முடியும்.</translation>
<translation id="1791028023086176332">இந்த எண்ணை அதிகாரப்பூர்வ JemaOS ஆதரவு பிரதிநிதிகளுடன் பகிரவும்</translation>
<translation id="6279304275399437025">ரிமோட் கண்டறிதல் சேவை தொடங்குகிறது...</translation>
<translation id="1501882165699826662">ரிமோட் கண்டறிதல் சேவையை நிறுத்தி மீண்டும் முயற்சிக்கவும்</translation>
<translation id="3100283258447375201">மேலும் தகவல்</translation>
<translation id="4070039109671307724">பல்வேறு</translation>
<translation id="7326893024940073254">"மறுதொடக்கம்" பொத்தான்</translation>
<translation id="3002423764319968103">கணினி மெனுவில் "மறுதொடக்கம்" பொத்தானைக் காட்டவும்</translation>
<translation id="6243454903512423518">"திரையைச் சுழற்று" பொத்தான்</translation>
<translation id="6491049336868978729">நீங்கள் இப்போது டேப்லெட் பயன்முறையில் இல்லை, "திரையைச் சுழற்று" பொத்தான் மறைக்கப்பட்டுள்ளது</translation>
<translation id="5496012402277579695">கணினி மெனுவில் "திரையைச் சுழற்று" பொத்தானைக் காட்டவும்</translation>
<translation id="5882838977344999606">டேப்லெட்/லேப்டாப் பயன்முறை மாற்று</translation>
<translation id="472164133625585606">கணினி மெனுவில் டேப்லெட்/லேப்டாப் பயன்முறை மாற்றைக் காட்டவும்</translation>
<translation id="1851103550468466960">Widevine ஐ இயக்கவும்</translation>
<translation id="4058176713282795846">பாதுகாக்கப்பட்ட பிரீமியம் உள்ளடக்கத்தை ஸ்ட்ரீம் செய்ய Widevine ஐ இயக்கவும். <ph name="BEGIN_LINK_LEARN_MORE" />மேலும் அறிக<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" ஐத் தேர்ந்தெடுக்கவும்</translation>
<translation id="4838463656205005584">Widevine ஐ இயக்குவது தோல்வியடைந்தது...</translation>
<translation id="2164041826798266548">Widevine CDM தொகுதி நிறுவல் தோல்வியடைந்தது. உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</translation>
<translation id="4106982328079440606">JemaOS கணக்கு அமைப்புகள்</translation>
<translation id="6468776556018764845">சோதனை அம்சங்கள்</translation>
<translation id="3487615413425326553">Trusted Platform Module (TPM) சோதனைகளைத் தவிர்க்கவும்</translation>
<translation id="4817176087932811573">உங்கள் சாதனத்தில் பொருந்தாத TPM சிப் காரணமாக சில அம்சங்கள் தோல்வியடையலாம்; தீர்வாக TPM சோதனைகளைத் தவிர்க்கலாம்.</translation>
<translation id="3356003366173774486">தானியங்கு உள்நுழைவு</translation>
<translation id="6218459410891191693">சாதனம் மறுதொடக்கம் செய்யும்போது தற்போதைய கணக்கு டெஸ்க்டாப்பில் தானாக உள்நுழைய அனுமதிக்கவும்</translation>
<translation id="6620839363422062843">இந்தக் கணக்கில் இயக்க முடியாது; இந்தச் சாதனத்தில் உள்ள பிற கணக்குகளுக்கு தானியங்கு உள்நுழைவு ஏற்கனவே செயலில் உள்ளது</translation>
<translation id="6734500226490446035">இந்தக் கணக்கில் இயக்க முடியாது; இந்தக் கணக்கின் கோப்பு முறைமைகளைத் தொடங்கும்போது அறியாத பிழை ஏற்பட்டது. மறுதொடக்கம் செய்யவோ அல்லது புதிய கணக்கை உருவாக்கவோ முயற்சிக்கவும்</translation>
<translation id="5464880042146818691">இந்தக் கணக்கில் இயக்க முடியாது; தானியங்கு உள்நுழைவு விருப்பம் "உள்ளூர் கணக்கு" வகைக்கு மட்டுமே கிடைக்கும்.</translation>
<translation id="3335654854106476749">தானியங்கு உள்நுழைவை இயக்குவதற்கு முன் <ph name="BEGIN_LINK" />தனியுரிமை மற்றும் பாதுகாப்பு<ph name="END_LINK" /> அமைப்புகளில் உள்நுழைவு கடவுச்சொல்லைச் சேர்க்கவும்.</translation>
<translation id="5586831602198585601">JemaOS இன் புதிய பதிப்பு இப்போது புதுப்பிக்கக் கிடைக்கிறது. இருப்பினும், உங்கள் JemaOS for You சந்தா காலாவதியாகிவிட்டது; உங்கள் JemaOS ஐப் புதுப்பிக்க செயலில் உள்ள சந்தா தேவை.</translation>
<translation id="3869860597719956574">JemaOS இன் புதிய முக்கிய பதிப்பு இப்போது புதுப்பிக்கக் கிடைக்கிறது. இந்தப் புதுப்பிப்பைத் தொடர ஒருமுறை கட்டணம் செலுத்த வேண்டும்.</translation>
<translation id="6523879681771260760">காப்புப்பிரதி கோப்பைச் சேமிக்கும் பாதையைக் குறிப்பிடவும்</translation>
<translation id="2036152819788683293">இந்தக் கணக்கிற்கு காப்புப்பிரதி கோப்பை உருவாக்கவும் (பீட்டா). <ph name="BEGIN_LINK_LEARN_MORE" />மேலும் அறிக<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">காப்புப்பிரதி எடுக்கவும்</translation>
<translation id="4267347174163690295">இந்தக் கணக்கிற்கு காப்புப்பிரதி கோப்பை உருவாக்கவும் (பீட்டா).</translation>
<translation id="8112950994208888917">இந்தச் செயல் இந்தக் கணக்கிற்கு முழு வட்டு காப்புப்பிரதியை உருவாக்குகிறது, இது அமைப்புகள், நிறுவப்பட்ட உலாவி நீட்சிகள் மற்றும் துணை அமைப்பு பயன்பாடுகள் உட்பட, உங்கள் JemaOS ஐ காப்புப்பிரதி உருவாக்கப்பட்ட நிலைக்கு மீட்டெடுப்பதை எளிதாக்குகிறது. உங்கள் பயன்பாடுகள் மற்றும் முகப்பு கோப்புறையின் உள்ளடக்கத்தைப் பொறுத்து, காப்புப்பிரதி கோப்பு பெரியதாக இருக்கலாம்; காப்புப்பிரதி கோப்பை வெளிப்புற சேமிப்புச் சாதனத்தில் சேமிக்கப் பரிந்துரைக்கப்படுகிறது. உங்களிடம் போர்ட்டபிள் USB டிரைவ் இருந்தால், இப்போது இணைக்கவும். <ph name="BEGIN_LINK_LEARN_MORE" />மேலும் அறிக<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">இந்தக் கணக்கின் உள்நுழைவு கடவுச்சொல்லை உள்ளிடவும்</translation>
<translation id="8663988871299316062">இந்தக் காப்புப்பிரதி கோப்பை மீட்டெடுக்கும்போது இந்தக் கடவுச்சொல் தேவைப்படும் என்பதால் நினைவில் வைத்திருக்கவும்</translation>
<translation id="6408904153044317846">மீட்டெடுக்க காப்புப்பிரதி கோப்பைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="8062988348127771021">காப்புப்பிரதி கோப்பிலிருந்து உங்கள் JemaOS தரவை மீட்டெடுக்கவும்</translation>
<translation id="7309192418866543730">காப்புப்பிரதி கடவுச்சொல்லை உள்ளிடவும்</translation>
<translation id="3642408376366598984">இந்தக் காப்புப்பிரதி கோப்பை மறையாக்கம் செய்யப் பயன்படுத்திய கடவுச்சொல்லை உள்ளிடவும்</translation>
<translation id="7783974937157985523">காப்புப்பிரதி கடவுச்சொல்</translation>
<translation id="6583780301401541007">மீட்டெடுப்பு வெற்றி</translation>
<translation id="3514011352559420398">மீட்டெடுப்பு தோல்வி</translation>
<translation id="7535980903266533458">காப்புப்பிரதியை உங்கள் சாதனத்தில் அல்லது வெளிப்புற சேமிப்பில் சேமிக்கவும்</translation>
<translation id="604001903249547235">கிளவுட் காப்புப்பிரதி</translation>
<translation id="8885702701336541611">காப்புப்பிரதியை JemaOS கிளவுட் சேமிப்பகத்தில் பதிவேற்றவும்</translation>
<translation id="3939744430096549862">கிளவுட்டில் காப்புப்பிரதி எடுக்கவும்</translation>
<translation id="619129431573254316">உள்ளூர் காப்புப்பிரதி கோப்பிலிருந்து மீட்டெடுக்கவும்</translation>
<translation id="1859592711955106569">கிளவுட் மீட்டெடுப்பு</translation>
<translation id="38222223336741457">JemaOS கிளவுட்டிலிருந்து பதிவிறக்கி மீட்டெடுக்கவும்</translation>
<translation id="1241089811244416179">கிளவுட்டிலிருந்து மீட்டெடுக்கவும்</translation>
<translation id="652479689372703360">காப்புப்பிரதி நடைபெறுகிறது</translation>
<translation id="3655220146274872918">காப்புப்பிரதி முடிந்தது</translation>
<translation id="4243579853635792694">உங்கள் காப்புப்பிரதி வெற்றிகரமாக உருவாக்கப்பட்டது</translation>
<translation id="4854179463174744546">காப்புப்பிரதி செயல்பாட்டின் போது பிழை ஏற்பட்டது</translation>
<translation id="2410668771600309999">Connect API பயனர் தகவல்</translation>
<translation id="2223892939866251845">பயனர் ID</translation>
<translation id="3850846286480935456">காப்புப்பிரதி சேமிப்பு பகுப்பாய்வு</translation>
<translation id="6244494465581273970">பயனர் ID தேவை</translation>
<translation id="9204006549413740506">கடைசியாகப் புதுப்பிக்கப்பட்டது</translation>
<translation id="476642412165431515">வன்பொருள் சாதனங்கள்</translation>
<translation id="3386337985825120901">காப்புப்பிரதி தரவு எதுவும் இல்லை</translation>
<translation id="8490990067870590760">காப்புப்பிரதி கோப்புகள் ஏற்றப்படுகின்றன...</translation>
<translation id="2955409026764742995">மீட்டெடுக்க காப்புப்பிரதி கோப்பைத் தேர்ந்தெடுக்கவும்:</translation>
<translation id="7414629348005657242">-- காப்புப்பிரதி கோப்பைத் தேர்ந்தெடுக்கவும் --</translation>
<translation id="918246516374174381">காப்புப்பிரதி கோப்புகள் எதுவும் கிடைக்கவில்லை. முதலில் ஒரு காப்புப்பிரதியை உருவாக்கவும்.</translation>
<translation id="77997252117517973">விரைவில் வருகிறது</translation>
<translation id="1930692852800776096">அகராதியைச் சேர்க்கவும்</translation>
<translation id="8793060353848771694">இடது இயர்பட் படம்</translation>
<translation id="6257440204887306255">சார்ஜிங் கேஸ் படம்</translation>
<translation id="2754700616124958693">வலது இயர்பட் படம்</translation>
<translation id="1068676292264983586">இயல்புநிலை சாதனப் படம்</translation>
<translation id="6364075396486660405">பேட்டரி ஆயுளை மேம்படுத்த அனைத்து பகிர்வுகளுக்கும் மீடியா கோப்புகளின் தானியங்கு ஸ்கேனிங்கை முடக்கவும். <ph name="BEGIN_LINK_LEARN_MORE" />மேலும் அறிக<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">பாதுகாப்பு விருப்பங்கள்</translation>
<translation id="5618366106086725045">மேலும் டெவலப்பர் அம்சங்களுடன் இந்த <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> நிறுவலுக்கு "டெவலப்பர் பயன்முறை"யை இயக்கவும். <ph name="BEGIN_LINK_LEARN_MORE" />மேலும் அறிக<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">நீங்கள் ஏற்கனவே "டெவலப்பர் பயன்முறை"யில் உள்ளீர்கள்</translation>
<translation id="6074549317340202195">"டெவலப்பர் பயன்முறை"யை இயக்கவும்</translation>
<translation id="418781258674176053">எச்சரிக்கை! "டெவலப்பர் பயன்முறை"யை இயக்குவது மாற்ற முடியாத செயல். "டெவலப்பர் பயன்முறை"யை முடக்க விரும்பினால், JemaOS ஐ மீண்டும் நிறுவ வேண்டும், அது அனைத்துத் தரவையும் அழித்துவிடும். உங்கள் தரவைக் காப்புப்பிரதி எடுத்து உங்கள் சொந்த ஆபத்தில் தொடரவும்.</translation>
