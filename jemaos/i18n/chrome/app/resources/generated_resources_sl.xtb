<translation id="476642412165431515">Strojne naprave</translation>
<translation id="3386337985825120901">Ni razpoložljivih podatkov varnostne kopije</translation>
<translation id="8490990067870590760">Nalaganje datotek varnostnih kopij ...</translation>
<translation id="2955409026764742995">Izberite datoteko varnostne kopije za obnovitev:</translation>
<translation id="7414629348005657242">-- Izberite datoteko varnostne kopije --</translation>
<translation id="918246516374174381">Ni najdenih datotek varnostnih kopij. Najprej ustvarite varnostno kopijo.</translation>
<translation id="77997252117517973">Kmalu na voljo</translation>
<translation id="1930692852800776096">Dodaj slovar</translation>
<translation id="8793060353848771694">Slika leve ušesne slušalke</translation>
<translation id="6257440204887306255">Slika polnilnega etuija</translation>
<translation id="2754700616124958693">Slika desne ušesne slušalke</translation>
<translation id="1068676292264983586">Privzeta slika naprave</translation>
<translation id="6364075396486660405">Onemogočite samodejno pregledovanje medijskih datotek za vse particije za optimizacijo trajanja baterije. <ph name="BEGIN_LINK_LEARN_MORE" />Več informacij<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">Varnostne možnosti</translation>
<translation id="5618366106086725045">Omogočite »Način za razvijalce« za to namestitev <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> z več funkcijami za razvijalce. <ph name="BEGIN_LINK_LEARN_MORE" />Več informacij<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">Že ste v »Načinu za razvijalce«</translation>
<translation id="6074549317340202195">Omogoči »Način za razvijalce«</translation>
<translation id="418781258674176053">Opozorilo! Omogočanje »Načina za razvijalce« je nepovraten postopek. Če želite onemogočiti »Način za razvijalce«, morate znova namestiti JemaOS, kar bo izbrisalo vse podatke. Ustvarite varnostno kopijo podatkov in nadaljujte na lastno odgovornost.</translation>
