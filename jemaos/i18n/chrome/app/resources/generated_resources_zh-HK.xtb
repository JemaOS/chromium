<translationbundle lang="zh-HK">
	<translation id="7386402409475121504">建立您的本地 JemaOS 帳戶</translation>
	<translation id="3760308806144055927">登入您本地的 JemaOS 帳戶</translation>
	<translation id="3325117507482096812">請輸入密碼</translation>
	<translation id="1838206877831947154">您的密碼不匹配</translation>
	<translation id="2158276988029582286">建立一個新的本機帳戶</translation>
	<translation id="8592849747346274067">登入現有帳戶</translation>
	<translation id="482190417986201746">您輸入的使用者名稱或密碼不正確</translation>
	<translation id="6603987686259425085">您可以<ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>使用 JemaOS 本機帳號<ph name="LINK_END">$2<ex>&amp;gt;/a</ex></ph>登入。</translation>
	<translation id="3598802966230712759">電子郵件 <ph name="EMAIL_ADDRESS">$1</ph> 已存在。請使用另一封電子郵件重試。</translation>
	<translation id="7215016743510876720">使用本機帳戶</translation>
	<translation id="6657635042185516718">繼續使用線上帳戶</translation>
	<translation id="6867476688065565618">切換到本機帳戶？</translation>
	<translation id="4840454774882557974">如果您選擇使用本機帳戶，則有用的功能（包括跨多個裝置同步資料和首選項以及使用 JemaOS 帳戶自動登入 Web 應用程式）將無法運作。</translation>
	<translation id="8951507920859729424">我們建議使用線上帳戶來充分利用 JemaOS。</translation>
	<translation id="479773200536372215">您將無法新增 Google 帳戶，因為缺少 Google API 金鑰。有關詳細信息，請參閱 <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>。</translation>
	<translation id="1198491307547164157">您將無法新增 JemaOS 帳戶，因為缺少 JemaOS API 金鑰。有關詳細信息，請參閱 <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>。</translation>
	<translation id="5042404702659901995">隱私權聲明</translation>
	<translation id="4907736162587268100">隱私權聲明內容</translation>
	<translation id="5988344732274877691">訂閱（非常罕見，承諾的）JemaOS 時事通訊</translation>
	<translation id="1706203008474708805">加入JemaOS用戶體驗改善計劃</translation>
	<translation id="1147139514756087229">使用本機帳號登入</translation>
	<translation id="2054784944085654098">現在建立備份檔案。這可能需要一段時間；請稍等...</translation>
	<translation id="3554401467586751874">備份檔案建立成功</translation>
	<translation id="2349211327705667074">查看備份文件</translation>
	<translation id="3049367131589710124">查看錯誤日誌</translation>
	<translation id="1079017345574916945">遠端桌面</translation>
	<translation id="3064478898280877715">應用程式商店</translation>
	<translation id="5890206344045530832">安裝人員</translation>
	<translation id="2173278076276376488">此實用程式將協助您將 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 安裝到該裝置的內部儲存空間。</translation>
	<translation id="5323182426977498659">警告！此過程具有破壞性且無法撤銷。請注意，我們不會對您潛在的資料遺失承擔任何責任，也不提供任何緊急技術支持，您需自行承擔風險。</translation>
	<translation id="8517836015601969896">全盤安裝</translation>
	<translation id="7300045760790370189">安裝 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 佔用整個硬碟，目標硬碟的所有資料將會被清除。</translation>
	<translation id="8762511733918256595">多重啟動安裝</translation>
	<translation id="248900698427753678">將 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 安裝到硬碟的現有分割區，其中 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 可以與其他作業系統並行存在。目標分區上的所有資料都將被擦除。</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 將安裝在您選擇的硬碟上；目標磁碟上的所有資料將會被清除。</translation>
	<translation id="4039091757234555415">磁碟</translation>
	<translation id="7783580523889684697">沒有可用磁碟</translation>
	<translation id="8217653566575018388">安裝完成</translation>
	<translation id="8846746259444262774">安裝失敗</translation>
	<translation id="7263815009235541549">安裝已成功完成。請先關閉您的裝置電源，然後取出所有安裝介質，然後再次開啟裝置以啟動 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>。</translation>
	<translation id="3380151284134965398">糟糕，出了點問題，安裝沒有完成。請重試該過程。如果相同的錯誤仍然存在，請使用上述日誌聯絡 JemaOS 支援。</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 將安裝在您硬碟的選取分割區上。在目前的多重啟動方案下，只有當您的裝置支援 UEFI 且硬碟採用 GPT 格式化時，才能進行此操作。</translation>
	<translation id="7831363758161884243">目標分割區將會被擦除；您還需要指定活動 EFI 分割區（通常會自動完成），因為安裝程式需要修改系統開機設定。</translation>
	<translation id="5670799238446305550">選擇 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 目標分區</translation>
	<translation id="3695537760133394753">分割區</translation>
	<translation id="5610519566593708119">選擇EFI分割區</translation>
	<translation id="3367650349940010965">所選磁碟沒有可用分割區</translation>
	<translation id="7453223384507098390">所選磁碟沒有可用的 EFI 分割區</translation>
	<translation id="1854532683465500847">所選分割區大小小於20GB，安裝可能會失敗</translation>
	<translation id="4144613075340468247">所選分區已安裝至 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 多重啟動，再次安裝可能會失敗</translation>
	<translation id="5793361052649920836">安裝後，您希望如何啟動 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>？</translation>
	<translation id="4273235330352963866">為我安裝和設定 rEFInd（推薦）</translation>
	<translation id="1858708492548921044">rEFInd 是一個啟動管理器程序，它為作業系統啟動選項提供了一個漂亮的圖形介面，當您的電腦啟動時，您將能夠選擇您想要的作業系統來啟動它。有關 rEFInd 的更多信息，請參閱其主頁。</translation>
	<translation id="3861924051442564602">為我新增 UEFI 啟動選單選項</translation>
	<translation id="8622370666798589804">當您的電腦啟動時，您也許能夠進入 UEFI 啟動選項選單（最有可能透過按熱鍵），此選項將 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 新增為該選單的一個條目。 （僅支援部分型號的BIOS和UEFI韌體）。</translation>
	<translation id="1569398690544416170">這裡什麼都不做，我自己配置</translation>
	<translation id="3554866444001249532">此安裝腳本只會將啟動 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 所需的 .efi 檔案放入您的 EFI 分割區，您需要自行設定如何啟動它。</translation>
	<translation id="7492832751164189534">強制退出</translation>
	<translation id="5159534860632584026">安裝程序已終止</translation>
	<translation id="8686749782014838344">取得磁碟資訊失敗</translation>
	<translation id="5688543378771259173">安裝正在終止...</translation>
	<translation id="5350452134936384991">安裝在 USB 中</translation>
	<translation id="8008470485414925603">將 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 安裝到 USB 磁碟上；目標 USB 磁碟上的所有資料將會被清除。</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 將安裝在您選擇的 USB 磁碟上；目標磁碟上的所有資料將會被清除。</translation>
	<translation id="5725593226060700263">沒有可用的 USB 磁碟</translation>
	<translation id="4357040841587078287">我們偵測到您正在從下載的映像檔執行此 JemaOS 副本。為了利用 JemaOS 提供的最全面的支援功能（包括無線更新），我們強烈建議您啟動「安裝程式」功能，將 JemaOS 全磁碟安裝到單獨的儲存裝置上。</translation>
	<translation id="1246398339704431302">您可以<ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>繼續使用此 JemaOS 副本<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>，安裝程序可以稍後在系統中執行，但是安裝後將擦除您的所有資料都將從該頁面重新開始。</translation>
	<translation id="3654532222088291133">您可以為此裝置建立一個 <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> 密碼，而無需輸入 JemaOS 帳戶密碼進行登入</translation>
	<translation id="8377684629839541977">使用JemaOS帳號密碼</translation>

