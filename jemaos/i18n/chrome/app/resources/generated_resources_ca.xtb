<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ca">
	<translation id="7386402409475121504">Creeu el vostre compte local de JemaOS</translation>
	<translation id="3760308806144055927">Inicieu la sessió al vostre compte local de JemaOS</translation>
	<translation id="3325117507482096812">Introduïu una contrasenya</translation>
	<translation id="1838206877831947154">Les vostres contrasenyes no coincideixen</translation>
	<translation id="2158276988029582286">Creeu un compte local nou</translation>
	<translation id="8592849747346274067">Inicieu la sessió en un compte existent</translation>
	<translation id="482190417986201746">El nom d'usuari o la contrasenya que heu introduït són incorrectes</translation>
	<translation id="6603987686259425085">Podeu <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>iniciar la sessió amb un compte local de JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">El correu electrònic <ph name="EMAIL_ADDRESS">$1</ph> ja existeix. Torneu-ho a provar amb un altre correu electrònic.</translation>
	<translation id="7215016743510876720">Utilitza el compte local</translation>
	<translation id="6657635042185516718">Continueu utilitzant el compte en línia</translation>
	<translation id="6867476688065565618">Vols canviar al compte local?</translation>
	<translation id="4840454774882557974">Si opteu per utilitzar un compte local, les funcions útils inclouen la sincronització de les vostres dades i preferències en diversos dispositius i la sessió automàtica d'aplicacions web amb el vostre compte de JemaOS no funcionarà.</translation>
	<translation id="8951507920859729424">Us recomanem que utilitzeu un compte en línia per utilitzar JemaOS al màxim.</translation>
	<translation id="479773200536372215">No podreu afegir comptes de Google perquè falten les claus de l'API de Google. Consulteu <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> per obtenir més informació.</translation>
	<translation id="1198491307547164157">No podreu afegir comptes de JemaOS perquè falten les claus de l'API de JemaOS. Consulteu <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> per obtenir més informació.</translation>
	<translation id="5042404702659901995">Declaració de privadesa</translation>
	<translation id="4907736162587268100">Continguts de la declaració de privadesa</translation>
	<translation id="5988344732274877691">Subscriu-te al butlletí (molt poc freqüent, promès) de JemaOS</translation>
	<translation id="1706203008474708805">Uneix-te al pla de millora de l'experiència d'usuari de JemaOS</translation>
	<translation id="1147139514756087229">Inicieu la sessió amb un compte local</translation>
	<translation id="2054784944085654098">S'està creant un fitxer de còpia de seguretat ara. Això pot trigar una estona; si us plau, espereu...</translation>
	<translation id="3554401467586751874">El fitxer de còpia de seguretat s'ha creat correctament</translation>
	<translation id="2349211327705667074">Veure fitxer de còpia de seguretat</translation>
	<translation id="3049367131589710124">Visualitza el registre d'errors</translation>
	<translation id="1079017345574916945">Escriptori remot</translation>
	<translation id="3064478898280877715">Botiga d'aplicacions</translation>
	<translation id="5890206344045530832">Instal·lador</translation>
	<translation id="2173278076276376488">Aquesta utilitat us ajudarà a instal·lar <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> a l'emmagatzematge intern d'aquest dispositiu.</translation>
	<translation id="5323182426977498659">Avís! Aquest procediment és destructiu i no es pot desfer. Si us plau, tingueu en compte que no assumirem cap responsabilitat per la vostra possible pèrdua de dades ni oferirem cap assistència tècnica urgent, procedim sota el vostre propi risc.</translation>
	<translation id="8517836015601969896">Instal·lació de disc complet</translation>
	<translation id="7300045760790370189">Instal·leu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> per ocupar un disc dur sencer, totes les dades del disc dur de destinació s'esborraran.</translation>
	<translation id="8762511733918256595">Instal·lació multi-arrencada</translation>
	<translation id="248900698427753678">Instal·leu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> a una partició existent d'un disc dur, on <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pot existir en paral·lel amb un altre sistema operatiu. S'esborraran totes les dades de la partició de destinació.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> s'instal·larà al disc dur seleccionat; s'esborraran totes les dades del disc de destinació.</translation>
	<translation id="4039091757234555415">Disc</translation>
	<translation id="7783580523889684697">No hi ha disc disponible</translation>
	<translation id="8217653566575018388">Instal·lació completada</translation>
	<translation id="8846746259444262774">La instal·lació ha fallat</translation>
	<translation id="7263815009235541549">La instal·lació ha finalitzat correctament. Apagueu primer el dispositiu, després traieu qualsevol suport d'instal·lació i torneu-lo a engegar per arrencar <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Vaja, alguna cosa ha fallat i la instal·lació no s'ha completat. Si us plau, torna a provar el procés. Si el mateix error continua, poseu-vos en contacte amb l'assistència de JemaOS amb el registre anterior.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> s'instal·larà a la partició seleccionada del vostre disc dur. Sota l'esquema d'arrencada múltiple actual, això només podria continuar si el vostre dispositiu és compatible amb UEFI i els vostres discs durs estan formatats amb GPT.</translation>
	<translation id="7831363758161884243">La partició de destinació s'esborrarà; també heu d'especificar la vostra partició EFI activa (normalment es fa automàticament), ja que l'instal·lador necessita modificar les configuracions d'arrencada del sistema.</translation>
	<translation id="5670799238446305550">Seleccioneu la partició de destinació <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Partició</translation>
	<translation id="5610519566593708119">Seleccioneu la partició EFI</translation>
	<translation id="3367650349940010965">No hi ha particions disponibles per al disc seleccionat</translation>
	<translation id="7453223384507098390">No hi ha particions EFI disponibles per al disc seleccionat</translation>
	<translation id="1854532683465500847">La mida de la partició seleccionada és inferior a 20 GB, la instal·lació pot fallar</translation>
	<translation id="4144613075340468247">La partició seleccionada s'ha muntat a <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> d'arrencada múltiple, la instal·lació de nou pot fallar</translation>
	<translation id="5793361052649920836">Després de la instal·lació, com us agradaria arrencar <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instal·leu i configureu rEFInd per a mi (recomanat)</translation>
	<translation id="1858708492548921044">rEFInd és un programa gestor d'arrencada que ofereix una bona interfície gràfica per a les opcions d'arrencada del sistema operatiu quan s'engega el vostre PC, podreu triar el vostre sistema operatiu desitjat per arrencar-lo. Per obtenir més informació sobre rEFInd, consulteu la seva pàgina d'inici.</translation>
	<translation id="3861924051442564602">Afegeix una opció de menú d'arrencada UEFI per a mi</translation>
	<translation id="8622370666798589804">Quan el vostre ordinador s'engega, és possible que pugueu entrar al menú d'opcions d'arrencada UEFI (molt probablement prement una tecla d'accés ràpid), aquesta opció afegeix <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> com a entrada a aquest menú. (Només admet alguns models de firmware BIOS i UEFI).</translation>
	<translation id="1569398690544416170">No feu res aquí, ho configuraré jo mateix</translation>
	<translation id="3554866444001249532">Aquest script d'instal·lació només posarà els fitxers .efi necessaris per arrencar <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> a la vostra partició EFI, haureu de configurar com arrencar-lo vosaltres mateixos.</translation>
	<translation id="7492832751164189534">Força la sortida</translation>
	<translation id="5159534860632584026">El procés d'instal·lació s'ha finalitzat</translation>
	<translation id="8686749782014838344">No s'ha pogut obtenir la informació del disc</translation>
	<translation id="5688543378771259173">La instal·lació s'està acabant...</translation>
	<translation id="5350452134936384991">Instal·lar en USB</translation>
	<translation id="8008470485414925603">Instal·leu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> en un disc USB; s'esborraran totes les dades del disc USB de destinació.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> s'instal·larà al disc USB seleccionat; s'esborraran totes les dades del disc de destinació.</translation>
	<translation id="5725593226060700263">No hi ha disc USB disponible</translation>
	<translation id="4357040841587078287">Hem detectat que esteu executant aquesta còpia de JemaOS des d'un fitxer d'imatge baixat. Per utilitzar les funcions d'assistència més completes (incloses les actualitzacions a l'aire) que JemaOS pot oferir, us recomanem que inicieu la funció "Instal·lador" per realitzar una instal·lació de disc complet de JemaOS en un dispositiu d'emmagatzematge independent.</translation>
	<translation id="1246398339704431302">Podeu <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>continuar utilitzant aquesta còpia de JemaOS de totes maneres<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, el procés d'instal·lació es pot executar en una fase posterior al sistema, però, totes les vostres dades s'esborraran de nou després de la instal·lació i començareu de nou.</translation>
	<translation id="3654532222088291133">En lloc d'introduir la contrasenya del vostre compte de JemaOS per iniciar la sessió, podeu crear una contrasenya de <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> per a aquest dispositiu</translation>
	<translation id="8377684629839541977">Utilitzeu la contrasenya del compte JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
