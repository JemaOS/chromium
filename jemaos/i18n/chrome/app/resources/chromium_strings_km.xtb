<translation id="1692689520561928457">អំពី JemaOS</translation>
<translation id="8692765844418174375">កំណែ JemaOS</translation>
<translation id="2943260250558374955">ទទួលជំនួយជាមួយ JemaOS</translation>
<translation id="713321354492170993">កម្មវិធីរុករកដោះលែងអង្គចងចាំពីផ្ទាំងដែលមិនសកម្ម។ នេះផ្តល់ឱ្យផ្ទាំងសកម្ម និងកម្មវិធីផ្សេងទៀតនូវធនធានកុំព្យូទ័របន្ថែម និងរក្សាកម្មវិធីរុករកឱ្យលឿន។ ផ្ទាំងដែលមិនសកម្មរបស់អ្នកនឹងក្លាយជាសកម្មម្តងទៀតដោយស្វ័យប្រវត្តិនៅពេលអ្នកត្រឡប់ទៅរកវា។</translation>
<translation id="1774190491044887444">កម្មវិធីរុករកសន្សំសំចៃថ្មដោយកម្រិតសកម្មភាពផ្ទៃខាងក្រោយ និងបែបផ្ទុយដែលមើលឃើញ ដូចជា ការរមូររលូន និងអត្រាហ្វ្រេមវីដេអូ។</translation>
<translation id="180121268008059459">កម្មវិធីរុករកផ្ទុកទំព័រជាមុន ធ្វើឱ្យការរុករក និងការស្វែងរកលឿនជាង។</translation>
<translation id="7127093527178692287">ស្តារការបម្រុងទុក (បេតា)</translation>
<translation id="4439042171549201806">ដើម្បីស្តារ JemaOS ពីឯកសារបម្រុងទុក សូមបញ្ចូលដ្រាយដែលអាចដោះចេញបានដែលមានឯកសារបម្រុងទុកទៅក្នុងឧបករណ៍ JemaOS របស់អ្នកឥឡូវនេះ ហើយបញ្ជាក់ពីឯកសារបម្រុងទុកដែលអ្នកចង់ស្តារ។ សូមកត់សម្គាល់ថា ឯកសារបម្រុងទុករបស់អ្នកត្រូវស្ថិតនៅក្នុងថត root នៃដ្រាយដែលអាចដោះចេញបានរបស់អ្នក ដើម្បីឱ្យវិជ្ជាការនេះរកឃើញ។</translation>
<translation id="2955409026764742995">ជ្រើសរើសឯកសារបម្រុងទុកដែលត្រូវស្តារ៖</translation>
<translation id="7040434808685140085">សូមទោស មិនអាចស្គាល់ឯកសារបម្រុងទុកដែលបានជ្រើសរើសបានទេ; សូមជ្រើសរើសឯកសារថ្មី។</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />ដើម្បីស្តារ JemaOS ពីឯកសារបម្រុងទុកដែលបានជ្រើសរើស វាចាំបាច់ត្រូវមានព័ត៌មានត្រឹមត្រូវអំពីការបម្រុងទុកនៅពេលវាត្រូវបានបង្កើត។ បើមិនដូច្នោះទេ ដំណើរការស្តារនឹងបរាជ័យ។<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"ឈ្មោះគណនី" គឺជាព័ត៌មានសម្គាល់ចូលដំបូងបង្អស់នៃគណនីដែលឯកសារបម្រុងទុករបស់អ្នកត្រូវបានបង្កើតឡើង។ ជាធម្មតាវាគឺជាអាសយដ្ឋានអ៊ីមែលដែលអ្នកបានប្រើដើម្បីចុះឈ្មោះសម្រាប់គណនី JemaOS/Google របស់អ្នក។ ប្រសិនបើវាជាគណនីក្នុងស្រុក វានឹងជាឈ្មោះអ្នកប្រើប្រាស់ដែលបានបន្ថែមជាមួយ "@jemaos.local"។<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />ពាក្យសម្ងាត់គឺជាឃ្លាសម្ងាត់ដែលអ្នកត្រូវបានស្នើឱ្យបញ្ចូលនៅពេលការបម្រុងទុកត្រូវបានបង្កើត។ ជាធម្មតាវាគឺជាពាក្យសម្ងាត់ដូចគ្នាដែលអ្នកបានប្រើដើម្បីចូលទៅកាន់ផ្ទៃតុ JemaOS សម្រាប់គណនីនេះ។<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">ឈ្មោះគណនី</translation>
<translation id="5490570429039308155">សូមទោស សូមបញ្ចូលឈ្មោះគណនីឱ្យបានត្រឹមត្រូវ</translation>
