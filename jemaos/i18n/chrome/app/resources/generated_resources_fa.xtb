<translation id="3642408376366598984">رمز عبوری را وارد کنید که برای رمزنگاری این فایل پشتیبان استفاده شده است</translation>
<translation id="7783974937157985523">رمز عبور پشتیبان</translation>
<translation id="6583780301401541007">بازیابی موفقیت‌آمیز بود</translation>
