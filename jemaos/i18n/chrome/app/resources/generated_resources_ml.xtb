<translation id="1270291881045478104">JemaOS AI പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="2013780539677437932">എല്ലാ JemaOS AI-ബന്ധപ്പെട്ട സവിശേഷതകളും പ്രവർത്തനക്ഷമമാക്കുകയോ പ്രവർത്തനരഹിതമാക്കുകയോ ചെയ്യുക</translation>
<translation id="3398637633218757480">JemaOS AI ക്വിക്ക് കോൾ പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="8986197796475507452">Ctrl + C + C അമർത്തി ഹൈലൈറ്റ് ചെയ്ത ഉള്ളടക്കത്തിനായി JemaOS AI ഓപ്ഷനുകൾ വേഗത്തിൽ കൊണ്ടുവരിക</translation>
<translation id="6407628130593274137">JemaOS AI-യ്ക്കുള്ള മറ്റ് ക്രമീകരണങ്ങളും ഓപ്ഷനുകളും</translation>
<translation id="4005574560653331142">ഈ പ്രാദേശിക അക്കൗണ്ടിന്റെ PIN അല്ലെങ്കിൽ സൈൻ-ഇൻ പാസ്‌വേഡ് മാറ്റാൻ, <ph name="BEGIN_LINK" />സ്വകാര്യതയും സുരക്ഷയും<ph name="END_LINK" /> ക്രമീകരണങ്ങളിലേക്ക് പോകുക.</translation>
<!-- login_strings (JemaOS) -->
<translation id="6419913024856619425">നിങ്ങൾക്ക് <ph name="LINK_START" />ഒരു JemaOS പ്രാദേശിക അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യാം<ph name="LINK_END" />.</translation>
<translation id="5291842596976929391">ഇമെയിൽ <ph name="EMAIL_ADDRESS" /> ഇതിനകം നിലവിലുണ്ട്. ദയവായി മറ്റൊരു ഇമെയിൽ ഉപയോഗിച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4519800823932975782">JemaOS സഹായ കേന്ദ്രം</translation>
<translation id="4737474693231655139">സാധാരണയായ JemaOS ചോദ്യങ്ങൾക്കുള്ള ഉത്തരങ്ങളും സഹായ ലേഖനങ്ങളും കണ്ടെത്തുക</translation>
</translationbundle>
