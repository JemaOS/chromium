<!DOCTYPE translationbundle>
<translationbundle lang="ka">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot-ის შესახებ</translation>
<translation id="5639860668557220477">მიიღეთ დახმარება Thot ბრაუზერთან დაკავშირებით</translation>
<translation id="1692689520561928457">JemaOS-ის შესახებ</translation>
<translation id="8692765844418174375">JemaOS ვერსია</translation>
<translation id="2943260250558374955">მიიღეთ დახმარება JemaOS-თან დაკავშირებით</translation>
<translation id="713321354492170993">ბრაუზერი ათავისუფლებს მეხსიერებას არააქტიური ჩანართებიდან. ეს აძლევს აქტიურ ჩანართებსა და სხვა აპლიკაციებს მეტ გამოთვლით რესურსებს და ინარჩუნებს ბრაუზერის სისწრაფეს. თქვენი არააქტიური ჩანართები ავტომატურად ისევ აქტიურდება, როდესაც მათ დაუბრუნდებით.</translation>
<translation id="1774190491044887444">ბრაუზერი ზოგავს ბატარეას ფონური აქტივობისა და ვიზუალური ეფექტების შეზღუდვით, როგორიცაა გლუვი გადახვევა და ვიდეოს კადრების სიხშირე.</translation>
<translation id="180121268008059459">ბრაუზერი წინასწარ ტვირთავს გვერდებს, რაც ხდის დათვალიერებასა და ძებნას უფრო სწრაფს.</translation>
<translation id="7127093527178692287">სარეზერვო ასლის აღდგენა (ბეტა)</translation>
<translation id="4439042171549201806">JemaOS-ის სარეზერვო ფაილიდან აღსადგენად, გთხოვთ, ახლავე ჩადეთ მოსახსნელი დისკი, რომელიც შეიცავს სარეზერვო ფაილს, თქვენს JemaOS მოწყობილობაში და მიუთითეთ, რომელი სარეზერვო ფაილის აღდგენა გსურთ. გთხოვთ, გაითვალისწინოთ, რომ თქვენი სარეზერვო ფაილი უნდა იყოს მოსახსნელი დისკის ძირითად დირექტორიაში, რომ ეს ოსტატი აღმოაჩინოს იგი.</translation>
<translation id="2955409026764742995">აირჩიეთ აღსადგენი სარეზერვო ფაილი:</translation>
<translation id="7040434808685140085">სამწუხაროდ, არჩეული სარეზერვო ფაილი ვერ იცნობა; გთხოვთ, აირჩიოთ ახალი.</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />JemaOS-ის არჩეული სარეზერვო ფაილიდან აღსადგენად, აუცილებელია ზუსტი ინფორმაცია სარეზერვო ასლის შექმნის მომენტის შესახებ. წინააღმდეგ შემთხვევაში, აღდგენის პროცესი ჩაიშლება.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />„ანგარიშის სახელი“ არის იმ ანგარიშის პირველადი შესვლის მონაცემი, რომლის ქვეშაც შეიქმნა თქვენი სარეზერვო ფაილი. ეს ჩვეულებრივ არის ელფოსტის მისამართი, რომელიც გამოიყენეთ თქვენი JemaOS/Google ანგარიშის რეგისტრაციისთვის. თუ ეს ადგილობრივი ანგარიში იყო, ეს იქნებოდა მომხმარებლის სახელი დამატებული „@jemaos.local"-ით.<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />პაროლი არის პაროლის ფრაზა, რომლის შეყვანაც გთხოვეს სარეზერვო ასლის შექმნისას. ეს ჩვეულებრივ იგივე პაროლია, რომელიც გამოიყენეთ ამ ანგარიშისთვის JemaOS სამუშაო მაგიდაში შესასვლელად.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">ანგარიშის სახელი</translation>
<translation id="5490570429039308155">სამწუხაროდ, გთხოვთ, შეიყვანოთ სწორი ანგარიშის სახელი</translation>
<translation id="6657585470893396449">პაროლი</translation>
<translation id="8200189938001188563">სამწუხაროდ, პაროლი არ შეიძლება იყოს ცარიელი</translation>
<translation id="3157931365184549694">აღდგენა</translation>
<translation id="8556278756526311953">სარეზერვო ასლის აღდგენა</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />ჩვენ ახლა ვმუშაობთ თქვენი სარეზერვო ფაილის აღდგენაზე; ეს შეიძლება გარკვეული დრო დასჭირდეს, ამიტომ გთხოვთ, იყოთ მოთმინებით.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />გთხოვთ, გაითვალისწინოთ, რომ მომხმარებლის ინტერფეისი ავტომატურად გადაიტვირთება, როდესაც აღდგენის პროცესი წარმატებით დასრულდება.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">სარეზერვო ასლის აღდგენა ჩაიშალა</translation>
<translation id="5003531399442003695">დამატებითი დეტალებისთვის, გთხოვთ, დააწკაპუნოთ ქვემოთ მოცემულ ბმულზე ჟურნალების სანახავად. თუ ეს შეცდომა გრძელდება, გთხოვთ, დაუკავშირდეთ JemaOS-ის ტექნიკური მხარდაჭერის არხებს და მიაწოდოთ შეცდომების ჟურნალები.</translation>
<translation id="6363786367719063276">ჟურნალების ნახვა</translation>
<translation id="8730621377337864115">მზადაა</translation>
<translation id="975238173507911396">მონაცემების აღდგენა წარმატებულია</translation>
<translation id="6276879052695618521">სარეზერვო ასლის აღდგენის ჟურნალები</translation>
<translation id="4901207598072637766">JemaOS, უზრუნველყოფილი <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" />-ის მიერ</translation>
<translation id="7894910504474624324">JemaOS და მისი სერვისები შეესაბამება GDPR-სა და ევროპული მონაცემთა დაცვის კანონის დებულებებს. დამატებითი ინფორმაციისთვის იხილეთ ჩვენი <ph name="BEGIN_LINK_PRIVACY" />კონფიდენციალურობის პოლიტიკა<ph name="END_LINK_PRIVACY" /> და ჩვენი <ph name="BEGIN_LINK_TOS" />მომსახურების პირობები.<ph name="END_LINK_TOS" /></translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, ყველა უფლება დაცულია.</translation>
<translation id="370679569376308836">JemaOS არის კომერციული შეთავაზება, რომელიც ეფუძნება Jema მოწყობილობასა და მის SaaS-ს.</translation>
<translation id="2773644194450163486">JemaOS შესაძლებელი გახდა <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> ღია კოდის პროექტის წყალობით.</translation>
<translation id="2330680727776977160">Chromium ასევე შესაძლებელი გახდა სხვა <ph name="BEGIN_LINK_1" />ღია კოდის პროგრამული უზრუნველყოფის<ph name="END_LINK_1" /> და <ph name="BEGIN_LINK_2" />დამატებითი ღია კოდის პროგრამული უზრუნველყოფის<ph name="END_LINK_2" /> წყალობით.</translation>
<translation id="1419954813084261088">შექმნილი და წარმოებული Jema Technology-ის მიერ.</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, ყველა უფლება დაცულია.</translation>
<translation id="6168072053306020326">Jema Technology არის Jema Technology LTD-სა და Jema Technology (Beijing) Limited-ის სავაჭრო სახელი.
        <ph name="LINE_BREAK" />
        Jema Technology LTD არის კომპანია, რომელიც რეგისტრირებულია ინგლისსა და უელსში კომპანიის ნომრით 12273803.</translation>
<translation id="1251589813188467292">მოწყობილობის გარანტიისა და მომსახურების მნიშვნელოვანი ინფორმაცია</translation>
