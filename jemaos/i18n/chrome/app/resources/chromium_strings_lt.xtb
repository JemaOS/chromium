<!-- jemaos_menus -->
<translation id="6953055153591205035">Apie Thot</translation>
<translation id="5639860668557220477">Gaukite pagalbos naudojant Thot naršyklę</translation>
<translation id="1692689520561928457">Apie JemaOS</translation>
<translation id="8692765844418174375">JemaOS versija</translation>
<translation id="2943260250558374955">Gaukite pagalbos naudojant JemaOS</translation>
<translation id="713321354492170993">Naršyklė atlaisvina atmintį iš neaktyvių skirtukų. Tai suteikia aktyviems skirtukams ir kitoms programoms daugiau skaičiavimo išteklių ir išlaiko naršyklę greitą. Jūsų neaktyvūs skirtukai automatiškai vėl tampa aktyvūs, kai prie jų grįžtate.</translation>
<translation id="1774190491044887444">Naršyklė taupo akumuliatorių ribodama foninę veiklą ir vizualinius efektus, tokius kaip sklandus slinkimas ir vaizdo kadrų dažnis.</translation>
<translation id="180121268008059459">Naršyklė iš anksto įkelia puslapius, todėl naršymas ir paieška vyksta greičiau.</translation>
<translation id="7127093527178692287">Atkurti atsarginę kopiją (beta)</translation>
<translation id="4439042171549201806">Norėdami atkurti JemaOS iš atsarginio failo, dabar įdėkite keičiamąjį diską, kuriame yra atsarginis failas, į savo JemaOS įrenginį ir nurodykite, kurį atsarginį failą norite atkurti. Atkreipkite dėmesį, kad atsarginis failas turi būti keičiamojo disko šakniniame kataloge, kad šis vedlys jį aptiktų.</translation>
<translation id="2955409026764742995">Pasirinkite atkuriamą atsarginį failą:</translation>
<translation id="7040434808685140085">Deja, pasirinkto atsarginio failo nepavyksta atpažinti; pasirinkite naują.</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />Norint atkurti JemaOS iš pasirinkto atsarginio failo, būtina turėti tikslią informaciją apie atsarginės kopijos sukūrimo momentą. Priešingu atveju atkūrimo procesas nepavyks.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"Paskyros pavadinimas" yra pagrindinis prisijungimo duomuo paskyrai, kurioje buvo sukurtas jūsų atsarginis failas. Paprastai tai el. pašto adresas, kurį naudojote registruodamiesi JemaOS/Google paskyroje. Jei tai būtų vietinė paskyra, tai būtų vartotojo vardas su pridėtu "@jemaos.local".<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />Slaptažodis yra slaptažodžio frazė, kurios buvote paprašyti įvesti kuriant atsarginę kopiją. Paprastai tai tas pats slaptažodis, kurį naudojote prisijungdami prie JemaOS darbalaukio šiai paskyrai.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">Paskyros pavadinimas</translation>
<translation id="5490570429039308155">Deja, įveskite teisingą paskyros pavadinimą</translation>
<translation id="6657585470893396449">Slaptažodis</translation>
<translation id="8200189938001188563">Deja, slaptažodis negali būti tuščias</translation>
<translation id="3157931365184549694">Atkurti</translation>
<translation id="8556278756526311953">Atkuriamos atsarginės kopijos</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />Šiuo metu dirbame prie jūsų atsarginio failo atkūrimo; tai gali užtrukti, todėl būkite kantrūs.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />Atkreipkite dėmesį, kad vartotojo sąsaja automatiškai paleis iš naujo, kai atkūrimo procesas bus sėkmingai baigtas.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">Atsarginės kopijos atkūrimas nepavyko</translation>
<translation id="5003531399442003695">Norėdami gauti daugiau informacijos, spustelėkite toliau esančią nuorodą, kad peržiūrėtumėte žurnalus. Jei ši klaida išlieka, susisiekite su JemaOS techninio palaikymo kanalais ir pateikite klaidų žurnalus.</translation>
<translation id="6363786367719063276">Peržiūrėti žurnalus</translation>
<translation id="8730621377337864115">Atlikta</translation>
<translation id="975238173507911396">Duomenų atkūrimas sėkmingas</translation>
<translation id="6276879052695618521">Atsarginės kopijos atkūrimo žurnalai</translation>
<translation id="4901207598072637766">JemaOS, teikiama <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /></translation>
<translation id="7894910504474624324">JemaOS ir jos paslaugos atitinka GDPR ir Europos duomenų apsaugos įstatymo nuostatas. Norėdami gauti daugiau informacijos, žr. mūsų <ph name="BEGIN_LINK_PRIVACY" />Privatumo politiką<ph name="END_LINK_PRIVACY" /> ir mūsų <ph name="BEGIN_LINK_TOS" />Paslaugų teikimo sąlygas.<ph name="END_LINK_TOS" /></translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, visos teisės saugomos.</translation>
<translation id="370679569376308836">JemaOS yra komercinis pasiūlymas, pagrįstas Jema įrenginiu ir jo SaaS.</translation>
<translation id="2773644194450163486">JemaOS tapo įmanoma dėka <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> atvirojo kodo projekto.</translation>
<translation id="2330680727776977160">Chromium taip pat tapo įmanoma dėka kitos <ph name="BEGIN_LINK_1" />atvirojo kodo programinės įrangos<ph name="END_LINK_1" /> ir <ph name="BEGIN_LINK_2" />papildomos atvirojo kodo programinės įrangos<ph name="END_LINK_2" />.</translation>
<translation id="1419954813084261088">Suprojektavo ir pagamino Jema Technology.</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, visos teisės saugomos.</translation>
<translation id="6168072053306020326">Jema Technology yra Jema Technology LTD ir Jema Technology (Beijing) Limited prekybos pavadinimas.
        <ph name="LINE_BREAK" />
        Jema Technology LTD yra įmonė, registruota Anglijoje ir Velse, įmonės numeris 12273803.</translation>
