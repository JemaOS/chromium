<translationbundle lang="pl">
	<translation id="7386402409475121504">Utwórz swoje lokalne konto JemaOS</translation>
	<translation id="3760308806144055927">Zaloguj się na swoje lokalne konto JemaOS</translation>
	<translation id="3325117507482096812">Proszę wprowadzić hasło</translation>
	<translation id="1838206877831947154">Twoje hasła nie pasują do siebie</translation>
	<translation id="2158276988029582286">Utwórz nowe konto lokalne</translation>
	<translation id="8592849747346274067">Zaloguj się do istniejącego konta</translation>
	<translation id="482190417986201746">Wprowadzona nazwa użytkownika lub hasło jest nieprawidłowe</translation>
	<translation id="6603987686259425085">Możesz <ph name="LINK_START">1 $<ex>&amp;gt;a&amp;lt;</ex></ph>zalogować się na lokalne konto JemaOS<ph name="LINK_END">2 $<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Adres e-mail <ph name="EMAIL_ADDRESS">$1</ph> już istnieje. Spróbuj ponownie, używając innego adresu e-mail.</translation>
	<translation id="7215016743510876720">Użyj konta lokalnego</translation>
	<translation id="6657635042185516718">Kontynuuj korzystanie z konta online</translation>
	<translation id="6867476688065565618">Przełączyć się na konto lokalne?</translation>
	<translation id="4840454774882557974">Jeśli zdecydujesz się na korzystanie z konta lokalnego, przydatne funkcje obejmują synchronizację danych i preferencji na wielu urządzeniach oraz automatyczne logowanie się do aplikacji internetowych przy użyciu konta JemaOS.</translation>
	<translation id="8951507920859729424">Aby w pełni wykorzystać JemaOS, zalecamy korzystanie z konta online.</translation>
	<translation id="479773200536372215">Nie będziesz mógł dodać kont Google, ponieważ brakuje kluczy Google API. Szczegóły znajdziesz na <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Nie będziesz mógł dodać kont JemaOS, ponieważ brakuje kluczy API JemaOS. Szczegóły znajdziesz na <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Oświadczenie o ochronie prywatności</translation>
	<translation id="4907736162587268100">Treść oświadczenia o ochronie prywatności</translation>
	<translation id="5988344732274877691">Zapisz się na (bardzo rzadki, obiecany) newsletter JemaOS</translation>
	<translation id="1706203008474708805">Dołącz do planu poprawy doświadczenia użytkownika JemaOS</translation>
	<translation id="1147139514756087229">Zaloguj się na konto lokalne</translation>
	<translation id="2054784944085654098">Tworzę teraz plik kopii zapasowej. Może to chwilę potrwać; proszę czekać…</translation>
	<translation id="3554401467586751874">Plik kopii zapasowej został pomyślnie utworzony</translation>
	<translation id="2349211327705667074">Wyświetl plik kopii zapasowej</translation>
	<translation id="3049367131589710124">Wyświetl dziennik błędów</translation>
	<translation id="1079017345574916945">Zdalny pulpit</translation>
	<translation id="3064478898280877715">Sklep z aplikacjami</translation>
	<translation id="5890206344045530832">Instalator</translation>
	<translation id="2173278076276376488">To narzędzie pomoże Ci zainstalować <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> w pamięci wewnętrznej tego urządzenia.</translation>
	<translation id="5323182426977498659">Ostrzeżenie! Ta procedura jest destrukcyjna i nie można jej cofnąć. Należy pamiętać, że nie ponosimy żadnej odpowiedzialności za potencjalną utratę danych ani nie zapewniamy pilnej pomocy technicznej. Postępujesz na własne ryzyko.</translation>
	<translation id="8517836015601969896">Instalacja na pełnym dysku</translation>
	<translation id="7300045760790370189">Zainstaluj <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, aby zająć cały dysk twardy, wszystkie dane na docelowym dysku twardym zostaną usunięte.</translation>
	<translation id="8762511733918256595">Instalacja wielorozruchowa</translation>
	<translation id="248900698427753678">Zainstaluj <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na istniejącej partycji dysku twardego, gdzie <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> może istnieć równolegle z innym systemem operacyjnym. Wszystkie dane na partycji docelowej zostaną usunięte.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> zostanie zainstalowany na wybranym dysku twardym; wszystkie dane na dysku docelowym zostaną usunięte.</translation>
	<translation id="4039091757234555415">Dysk</translation>
	<translation id="7783580523889684697">Brak dostępnego dysku</translation>
	<translation id="8217653566575018388">Instalacja zakończona</translation>
	<translation id="8846746259444262774">Instalacja nie powiodła się</translation>
	<translation id="7263815009235541549">Instalacja zakończyła się pomyślnie. Najpierw wyłącz urządzenie, następnie wyjmij wszystkie nośniki instalacyjne i włącz je ponownie, aby uruchomić system <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, coś poszło nie tak i instalacja nie została ukończona. Spróbuj ponownie. Jeśli ten sam błąd będzie się powtarzał, skontaktuj się z pomocą techniczną JemaOS, przesyłając powyższy dziennik.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> zostanie zainstalowany na wybranej partycji Twojego dysku twardego. W obecnym schemacie wielokrotnego rozruchu może to nastąpić tylko wtedy, gdy Twoje urządzenie obsługuje UEFI, a dyski twarde są sformatowane przy użyciu GPT.</translation>
	<translation id="7831363758161884243">Partycja docelowa zostanie wyczyszczona; musisz także określić aktywną partycję EFI (zwykle dzieje się to automatycznie), ponieważ instalator musi zmodyfikować konfiguracje rozruchu systemu.</translation>
	<translation id="5670799238446305550">Wybierz partycję docelową <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Partycja</translation>
	<translation id="5610519566593708119">Wybierz partycję EFI</translation>
	<translation id="3367650349940010965">Brak dostępnych partycji dla wybranego dysku</translation>
	<translation id="7453223384507098390">Brak dostępnych partycji EFI dla wybranego dysku</translation>
	<translation id="1854532683465500847">Rozmiar wybranej partycji jest mniejszy niż 20 GB, instalacja może się nie powieść</translation>
	<translation id="4144613075340468247">Wybrana partycja została zamontowana w systemie wielorozruchowym <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>. Ponowna instalacja na niej może się nie powieść</translation>
	<translation id="5793361052649920836">Jak po instalacji chcesz uruchomić <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Zainstaluj i skonfiguruj rEFInd dla mnie (zalecane)</translation>
	<translation id="1858708492548921044">rEFInd to program do zarządzania rozruchem, który oferuje ładny interfejs graficzny dla opcji uruchamiania systemu operacyjnego. Po uruchomieniu komputera będziesz mógł wybrać żądany system operacyjny, który chcesz z nim uruchomić. Więcej informacji na temat rEFInd można znaleźć na jego stronie głównej.</translation>
	<translation id="3861924051442564602">Dodaj dla mnie opcję menu rozruchu UEFI</translation>
	<translation id="8622370666798589804">Po uruchomieniu komputera może być możliwe wejście do menu opcji rozruchu UEFI (najprawdopodobniej poprzez naciśnięcie klawisza skrótu). Ta opcja dodaje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> jako pozycję do tego menu. (Obsługuje tylko niektóre modele oprogramowania układowego BIOS i UEFI).</translation>
	<translation id="1569398690544416170">Nic tu nie rób, sam to skonfiguruję</translation>
	<translation id="3554866444001249532">Ten skrypt instalacyjny umieści tylko pliki .efi niezbędne do rozruchu <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na partycję EFI. Musisz samodzielnie skonfigurować sposób uruchamiania.</translation>
	<translation id="7492832751164189534">Wymuś rezygnację</translation>
	<translation id="5159534860632584026">Proces instalacji został zakończony</translation>
	<translation id="8686749782014838344">Nie udało się pobrać informacji o dysku</translation>
	<translation id="5688543378771259173">Instalacja dobiega końca...</translation>
	<translation id="5350452134936384991">Zainstaluj na USB</translation>
	<translation id="8008470485414925603">Zainstaluj <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na dysku USB; wszystkie dane na docelowym dysku USB zostaną usunięte.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> zostanie zainstalowany na wybranym dysku USB; wszystkie dane na dysku docelowym zostaną usunięte.</translation>
	<translation id="5725593226060700263">Brak dostępnego dysku USB</translation>
	<translation id="4357040841587078287">Wykryliśmy, że uruchamiasz tę kopię JemaOS z pobranego pliku obrazu. Aby skorzystać z najbardziej wszechstronnych funkcji wsparcia (w tym aktualizacji Over-The-Air), jakie może zaoferować JemaOS, zdecydowanie zalecamy uruchomienie funkcji „Instalator”, aby przeprowadzić instalację JemaOS na pełnym dysku na oddzielnym urządzeniu magazynującym.</translation>
	<translation id="1246398339704431302">Możesz <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>mimo wszystko nadal korzystać z tej kopii JemaOS<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proces instalacji można przeprowadzić na późniejszym etapie w systemie, jednak po instalacji wszystkie Twoje dane zostaną usunięte i zaczniesz od nowa z tej strony.</translation>
	<translation id="3654532222088291133">Zamiast wpisywać hasło do konta JemaOS, aby się zalogować, możesz utworzyć hasło <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> dla tego urządzenia</translation>
	<translation id="8377684629839541977">Użyj hasła do konta JemaOS</translation>

