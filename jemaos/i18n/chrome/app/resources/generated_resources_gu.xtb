<translation id="2590678769628709242">તમારું JemaOS સબ્સ્ક્રિપ્શન ઑનલાઇન તપાસો</translation>
<translation id="4701836089682883918">JemaOS સબ્સ્ક્રિપ્શન માહિતી</translation>
<translation id="5891566673089952188">તમારું ડિવાઇસ ID મેળવવામાં ભૂલ આવી</translation>
<translation id="4685086787606104322">સબ્સ્ક્રિપ્શન સમાપ્તિ</translation>
<translation id="3354919960795782984">ડિવાઇસ ID</translation>
<translation id="5758632069869992306">તમારું સબ્સ્ક્રિપ્શન ઑનલાઇન તપાસો</translation>
<translation id="2664883181340330759"><ph name="DEVICE_OS" /> <ph name="DEVICE_VARIANT" />, <ph name="JEMAOS_MAJOR_VERSION" />, <ph name="JEMAOS_LICENSE_STATE_DESC" />
