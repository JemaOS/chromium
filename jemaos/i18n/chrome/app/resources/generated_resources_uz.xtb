<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="uz">
	<translation id="7386402409475121504">Mahalliy JemaOS hisob qaydnomangizni yarating</translation>
	<translation id="3760308806144055927">Mahalliy JemaOS hisobingizga kiring</translation>
	<translation id="3325117507482096812">Iltimos, parol kiriting</translation>
	<translation id="1838206877831947154">Parollaringiz mos emas</translation>
	<translation id="2158276988029582286">Yangi mahalliy hisob yarating</translation>
	<translation id="8592849747346274067">Mavjud hisobga kiring</translation>
	<translation id="482190417986201746">Siz kiritgan foydalanuvchi nomi yoki parol noto'g'ri</translation>
	<translation id="6603987686259425085">Siz <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS mahalliy hisobiga<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph> bilan kirishingiz mumkin.</translation>
	<translation id="3598802966230712759"><ph name="EMAIL_ADDRESS">$1</ph> elektron pochta allaqachon mavjud. Iltimos, boshqa elektron pochta orqali qayta urinib ko'ring.</translation>
	<translation id="7215016743510876720">Mahalliy hisobdan foydalaning</translation>
	<translation id="6657635042185516718">Onlayn hisobdan foydalanishda davom eting</translation>
	<translation id="6867476688065565618">Mahalliy hisobga oʻtilsinmi?</translation>
	<translation id="4840454774882557974">Agar siz mahalliy hisob qaydnomasidan foydalanishni tanlasangiz, foydali funksiyalarga maʼlumotlaringiz va afzalliklaringizni bir nechta qurilmalarda sinxronlashtirish kiradi va JemaOS hisob qaydnomangiz yordamida veb-ilovalarga avtomatik kirish ishlamaydi.</translation>
	<translation id="8951507920859729424">JemaOS'dan to'liq foydalanish uchun onlayn hisob qaydnomasidan foydalanishni tavsiya etamiz.</translation>
	<translation id="479773200536372215">Siz Google hisoblarini qo'sha olmaysiz, chunki Google API kalitlari yo'q. Tafsilotlar uchun <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ga qarang.</translation>
	<translation id="1198491307547164157">Siz JemaOS hisoblarini qo‘sha olmaysiz, chunki JemaOS API kalitlari yo‘q. Tafsilotlar uchun <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ga qarang.</translation>
	<translation id="5042404702659901995">Maxfiylik bayonoti</translation>
	<translation id="4907736162587268100">Maxfiylik bayonnomasi mazmuni</translation>
	<translation id="5988344732274877691">JemaOS uchun (juda kam uchraydigan, va'da qilingan) axborot byulleteniga ro'yxatdan o'ting</translation>
	<translation id="1706203008474708805">JemaOS foydalanuvchi tajribasini yaxshilash rejasiga qo'shiling</translation>
	<translation id="1147139514756087229">Mahalliy hisob bilan kiring</translation>
	<translation id="2054784944085654098">Zaxira fayl yaratilmoqda. Bu biroz vaqt olishi mumkin; iltimos kuting...</translation>
	<translation id="3554401467586751874">Zaxira fayli muvaffaqiyatli yaratildi</translation>
	<translation id="2349211327705667074">Zaxira faylini ko'rish</translation>
	<translation id="6337433855796857931">Zaxiralash amalga oshmadi</translation>
	<translation id="3049367131589710124">Xatolar jurnalini ko'rish</translation>
	<translation id="1079017345574916945">Masofaviy ish stoli</translation>
	<translation id="3064478898280877715">Ilovalar do'koni</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">O'rnatuvchi</translation>
	<translation id="2173278076276376488">Ushbu yordamchi dastur sizga <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ni ushbu qurilmaning ichki xotirasiga o‘rnatishda yordam beradi.</translation>
	<translation id="5323182426977498659">Ogohlantirish! Ushbu protsedura halokatli va uni qaytarib bo'lmaydi. E'tibor bering, biz sizning potentsial ma'lumotlaringiz yo'qolishi uchun hech qanday javobgarlikni o'z zimmamizga olmaymiz yoki shoshilinch texnik yordam ko'rsatmaymiz, o'zingizning xavf-xataringiz bilan davom eting.</translation>
	<translation id="8517836015601969896">To'liq diskni o'rnatish</translation>
	<translation id="7300045760790370189">Butun qattiq diskni egallash uchun <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ni o'rnating, maqsadli qattiq diskdagi barcha ma'lumotlar o'chib ketadi.</translation>
	<translation id="8762511733918256595">Ko'p yuklashni o'rnatish</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-ni qattiq diskning mavjud bo'limiga o'rnating, u erda <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> boshqa OT bilan parallel ravishda mavjud bo'lishi mumkin. Maqsadli bo'limdagi barcha ma'lumotlar o'chib ketadi.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tanlangan qattiq diskingizga o'rnatiladi; maqsadli diskdagi barcha ma'lumotlar o'chiriladi.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Hech qanday disk mavjud emas</translation>
	<translation id="8217653566575018388">Oʻrnatish tugallandi</translation>
	<translation id="8846746259444262774">O‘rnatish amalga oshmadi</translation>
	<translation id="7263815009235541549">O'rnatish muvaffaqiyatli yakunlandi. Iltimos, avval qurilmangizni oʻchiring, soʻngra barcha oʻrnatish vositalarini olib tashlang va <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>ni ishga tushirish uchun uni qayta yoqing.</translation>
	<translation id="3380151284134965398">Nimadir xato ketdi va o‘rnatish tugallanmadi. Jarayonni qaytadan urining. Agar bir xil xatolik davom etsa, yuqoridagi jurnal bilan JemaOS yordamiga murojaat qiling.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> qattiq diskingizning tanlangan qismiga o'rnatiladi. Joriy ko'p yuklash sxemasiga ko'ra, bu faqat qurilmangiz UEFI-ni qo'llab-quvvatlasa va qattiq disklaringiz GPT bilan formatlangan bo'lsa davom etishi mumkin.</translation>
	<translation id="7831363758161884243">Maqsadli bo'lim o'chiriladi; shuningdek, faol EFI bo'limingizni ko'rsatishingiz kerak (odatda avtomatik ravishda amalga oshiriladi), chunki O'rnatuvchi tizimni yuklash konfiguratsiyasini o'zgartirishi kerak.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> maqsadli qismini tanlang</translation>
	<translation id="3695537760133394753">Bo'lim</translation>
	<translation id="5610519566593708119">EFI bo'limini tanlang</translation>
	<translation id="3367650349940010965">Tanlangan disk uchun bo'limlar mavjud emas</translation>
	<translation id="7453223384507098390">Tanlangan disk uchun EFI bo'limlari mavjud emas</translation>
	<translation id="1854532683465500847">Tanlangan bo'limning hajmi 20 Gb dan kam, o'rnatish muvaffaqiyatsiz bo'lishi mumkin</translation>
	<translation id="4144613075340468247">Tanlangan boʻlim <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> koʻp yuklash tizimiga oʻrnatildi, uni qayta oʻrnatib boʻlmaydi.</translation>
	<translation id="5793361052649920836">Oʻrnatishdan soʻng, <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-ni qanday yuklashni xohlaysiz?</translation>
	<translation id="4273235330352963866">Men uchun rEFInd-ni o'rnating va sozlang (tavsiya etiladi)</translation>
	<translation id="1858708492548921044">rEFInd - bu yuklash menejeri dasturi bo'lib, u kompyuteringiz ishga tushganda OTni yuklash opsiyalari uchun chiroyli grafik interfeysni taklif qiladi, siz u bilan yuklash uchun kerakli OTni tanlashingiz mumkin bo'ladi. rEFInd haqida qo'shimcha ma'lumot olish uchun uning bosh sahifasiga qarang.</translation>
	<translation id="3861924051442564602">Men uchun UEFI yuklash menyusi variantini qo'shing</translation>
	<translation id="8622370666798589804">Kompyuteringiz ishga tushganda, siz UEFI yuklash opsiyalari menyusiga kirishingiz mumkin (ehtimol, tezkor tugmani bosish orqali), ushbu parametr ushbu menyuga kirish sifatida <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> qo'shadi. (Faqat BIOS va UEFI proshivkalarining ba'zi modellarini qo'llab-quvvatlaydi).</translation>
	<translation id="1569398690544416170">Bu erda hech narsa qilmang, men uni o'zim sozlayman</translation>
	<translation id="3554866444001249532">Ushbu o'rnatish skripti faqat <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>-ni yuklash uchun kerakli .efi fayllarini EFI bo'limiga joylashtiradi, uni o'zingiz yuklashni sozlashingiz kerak bo'ladi.</translation>
	<translation id="7492832751164189534">Chiqishga majburlash</translation>
	<translation id="5159534860632584026">O'rnatish jarayoni tugatildi</translation>
	<translation id="8686749782014838344">Disk ma'lumotlarini olib bo'lmadi</translation>
	<translation id="5688543378771259173">O‘rnatish tugatilmoqda...</translation>
	<translation id="5350452134936384991">USB-ga o'rnating</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ni USB diskiga o'rnating; maqsadli USB diskdagi barcha ma'lumotlar o'chib ketadi.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> tanlangan USB diskingizga o'rnatiladi; maqsadli diskdagi barcha ma'lumotlar o'chiriladi.</translation>
	<translation id="5725593226060700263">Hech qanday USB disk mavjud emas</translation>
	<translation id="4357040841587078287">Siz JemaOS’ning ushbu nusxasini yuklab olingan rasm faylidan ishga tushirayotganingizni aniqladik. JemaOS taklif qilishi mumkin bo'lgan eng keng qamrovli qo'llab-quvvatlash xususiyatlaridan (jumladan, havo orqali yangilanishlardan) foydalanish uchun JemaOS-ni alohida saqlash qurilmasiga to'liq diskda o'rnatish uchun "O'rnatish" funksiyasini ishga tushirishingizni qat'iy tavsiya qilamiz.</translation>
	<translation id="1246398339704431302">Siz <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>baribir JemaOS-ning ushbu nusxasidan foydalanishda davom etishingiz mumkin<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, oʻrnatish jarayoni tizimning keyingi bosqichida amalga oshirilishi mumkin, ammo oʻrnatishdan soʻng barcha maʼlumotlaringiz oʻchib ketadi.</translation>
	<translation id="3654532222088291133">Kirish uchun JemaOS hisobi parolini kiritish oʻrniga ushbu qurilma uchun <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> parolini yaratishingiz mumkin.</translation>
	<translation id="8377684629839541977">JemaOS hisob qaydnomasi parolidan foydalaning</translation>

