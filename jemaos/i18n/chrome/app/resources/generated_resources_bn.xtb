<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="bn">
	<translation id="7386402409475121504">আপনার স্থানীয় JemaOS অ্যাকাউন্ট তৈরি করুন</translation>
	<translation id="3760308806144055927">আপনার স্থানীয় JemaOS অ্যাকাউন্টে সাইন ইন করুন</translation>
	<translation id="3325117507482096812">একটি পাসওয়ার্ড ইনপুট করুন</translation>
	<translation id="1838206877831947154">আপনার পাসওয়ার্ড মেলে না</translation>
	<translation id="2158276988029582286">একটি নতুন স্থানীয় অ্যাকাউন্ট তৈরি করুন</translation>
	<translation id="8592849747346274067">একটি বিদ্যমান অ্যাকাউন্টে সাইন ইন করুন</translation>
	<translation id="482190417986201746">আপনি যে ব্যবহারকারীর নাম বা পাসওয়ার্ড দিয়েছেন তা ভুল</translation>
	<translation id="6603987686259425085">আপনি <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>একটি JemaOS স্থানীয় অ্যাকাউন্ট দিয়ে সাইন ইন করতে পারেন<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>৷</translation>
	<translation id="3598802966230712759">ইমেল <ph name="EMAIL_ADDRESS">$1</ph> ইতিমধ্যেই বিদ্যমান৷ অন্য ইমেল দিয়ে আবার চেষ্টা করুন.</translation>
	<translation id="7215016743510876720">স্থানীয় অ্যাকাউন্ট ব্যবহার করুন</translation>
	<translation id="6657635042185516718">অনলাইন অ্যাকাউন্ট ব্যবহার করা চালিয়ে যান</translation>
	<translation id="6867476688065565618">স্থানীয় অ্যাকাউন্টে স্যুইচ করবেন?</translation>
	<translation id="4840454774882557974">আপনি যদি একটি স্থানীয় অ্যাকাউন্ট ব্যবহার করতে বেছে নেন, দরকারী বৈশিষ্ট্যগুলির মধ্যে রয়েছে একাধিক ডিভাইসে আপনার ডেটা এবং পছন্দগুলি সিঙ্ক্রোনাইজ করা এবং আপনার JemaOS অ্যাকাউন্ট ব্যবহার করে স্বয়ংক্রিয়ভাবে ওয়েব অ্যাপগুলিতে সাইন ইন করা কাজ করবে না।</translation>
	<translation id="8951507920859729424">আমরা জেমাওএসকে সম্পূর্ণরূপে ব্যবহার করার জন্য একটি অনলাইন অ্যাকাউন্ট ব্যবহার করার পরামর্শ দিই।</translation>
	<translation id="479773200536372215">আপনি Google অ্যাকাউন্ট যোগ করতে পারবেন না কারণ Google API কী অনুপস্থিত। বিস্তারিত জানার জন্য <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> দেখুন।</translation>
	<translation id="1198491307547164157">আপনি JemaOS অ্যাকাউন্ট যোগ করতে পারবেন না কারণ JemaOS API কী অনুপস্থিত। বিস্তারিত জানার জন্য <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> দেখুন।</translation>
	<translation id="5042404702659901995">গোপনীয়তা বিবৃতি</translation>
	<translation id="4907736162587268100">গোপনীয়তা বিবৃতি বিষয়বস্তু</translation>
	<translation id="5988344732274877691">JemaOS-এর জন্য (খুবই বিরল, প্রতিশ্রুত) নিউজলেটারের জন্য সাইন আপ করুন</translation>
	<translation id="1706203008474708805">JemaOS ব্যবহারকারীর অভিজ্ঞতার উন্নতির পরিকল্পনায় যোগ দিন</translation>
	<translation id="1147139514756087229">একটি স্থানীয় অ্যাকাউন্ট দিয়ে সাইন ইন করুন</translation>
	<translation id="2054784944085654098">এখন ব্যাকআপ ফাইল তৈরি করা হচ্ছে। এটি একটি সময় নিতে পারে; অনুগ্রহ করে অপেক্ষা করুন…</translation>
	<translation id="3554401467586751874">ব্যাকআপ ফাইল সফলভাবে তৈরি করা হয়েছে</translation>
	<translation id="2349211327705667074">ব্যাকআপ ফাইল দেখুন</translation>
	<translation id="6337433855796857931">ব্যাকআপ ব্যর্থ হয়েছে৷</translation>
	<translation id="3049367131589710124">ত্রুটি লগ দেখুন</translation>
	<translation id="1079017345574916945">দূরবর্তী ডেস্কটপ</translation>
	<translation id="3064478898280877715">অ্যাপ স্টোর</translation>
	<translation id="2747689477259164256">জেমাওএস এআই</translation>
	<translation id="5890206344045530832">ইনস্টলার</translation>
	<translation id="2173278076276376488">এই ইউটিলিটি আপনাকে এই ডিভাইসের অভ্যন্তরীণ স্টোরেজে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ইনস্টল করতে সাহায্য করবে।</translation>
	<translation id="5323182426977498659">সতর্কতা ! এই পদ্ধতিটি ধ্বংসাত্মক এবং পূর্বাবস্থায় ফেরানো যাবে না। দয়া করে মনে রাখবেন যে আমরা আপনার সম্ভাব্য ডেটা ক্ষতির জন্য কোনও দায়বদ্ধতা রাখব না বা কোনও জরুরি প্রযুক্তিগত সহায়তা প্রদান করব না, আপনার নিজের ঝুঁকিতে এগিয়ে যান।</translation>
	<translation id="8517836015601969896">সম্পূর্ণ ডিস্ক ইনস্টলেশন</translation>
	<translation id="7300045760790370189">একটি সম্পূর্ণ হার্ড ডিস্ক দখল করতে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ইনস্টল করুন, টার্গেট হার্ড ডিস্কের সমস্ত ডেটা মুছে যাবে৷</translation>
	<translation id="8762511733918256595">মাল্টি-বুট ইনস্টলেশন</translation>
	<translation id="248900698427753678">হার্ডডিস্কের একটি বিদ্যমান পার্টিশনে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ইনস্টল করুন, যেখানে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> অন্যান্য OS-এর সাথে সমান্তরালভাবে বিদ্যমান থাকতে পারে। টার্গেট পার্টিশনের সমস্ত ডেটা মুছে ফেলা হবে।</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপনার নির্বাচিত হার্ড ড্রাইভে ইনস্টল করা হবে; লক্ষ্য ডিস্কের সমস্ত ডেটা মুছে ফেলা হবে।</translation>
	<translation id="4039091757234555415">ডিস্ক</translation>
	<translation id="7783580523889684697">কোন ডিস্ক উপলব্ধ নেই</translation>
	<translation id="8217653566575018388">ইনস্টলেশন সম্পন্ন হয়েছে</translation>
	<translation id="8846746259444262774">ইনস্টলেশন ব্যর্থ হয়েছে</translation>
	<translation id="7263815009235541549">ইনস্টলেশন সফলভাবে সমাপ্ত হয়েছে. অনুগ্রহ করে প্রথমে আপনার ডিভাইস বন্ধ করুন, তারপর যেকোনো ইনস্টলেশন মিডিয়া সরিয়ে দিন এবং <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বুট করতে আবার চালু করুন।</translation>
	<translation id="3380151284134965398">ওহো, কিছু ভুল হয়েছে এবং ইনস্টলেশন সম্পূর্ণ হয়নি৷ প্রক্রিয়া পুনরায় চেষ্টা করুন. যদি একই ত্রুটি অব্যাহত থাকে, অনুগ্রহ করে উপরের লগটি সহ JemaOS সহায়তার জন্য যোগাযোগ করুন৷</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপনার হার্ড ড্রাইভের নির্বাচিত পার্টিশনে ইনস্টল করা হবে। বর্তমান মাল্টি-বুট স্কিমের অধীনে, এটি শুধুমাত্র তখনই এগিয়ে যেতে পারে যখন আপনার ডিভাইস UEFI সমর্থন করে এবং আপনার হার্ড ডিস্কগুলি GPT দিয়ে ফর্ম্যাট করা হয়।</translation>
	<translation id="7831363758161884243">লক্ষ্য বিভাজন মুছে ফেলা হবে; আপনাকে আপনার সক্রিয় EFI পার্টিশন (সাধারণত স্বয়ংক্রিয়ভাবে সম্পন্ন) উল্লেখ করতে হবে কারণ ইনস্টলারকে সিস্টেম বুট কনফিগারেশন পরিবর্তন করতে হবে।</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> টার্গেট পার্টিশন নির্বাচন করুন</translation>
	<translation id="3695537760133394753">বিভাজন</translation>
	<translation id="5610519566593708119">EFI পার্টিশন নির্বাচন করুন</translation>
	<translation id="3367650349940010965">নির্বাচিত ডিস্কের জন্য কোন পার্টিশন উপলব্ধ নেই</translation>
	<translation id="7453223384507098390">নির্বাচিত ডিস্কের জন্য কোনো EFI পার্টিশন উপলব্ধ নেই</translation>
	<translation id="1854532683465500847">নির্বাচিত পার্টিশনের আকার 20GB এর কম, ইনস্টলেশন ব্যর্থ হতে পারে</translation>
	<translation id="4144613075340468247">নির্বাচিত পার্টিশনটি <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> মাল্টি-বুটে মাউন্ট করা হয়েছে, এটিতে আবার ইনস্টল করা ব্যর্থ হতে পারে</translation>
	<translation id="5793361052649920836">ইনস্টলেশনের পর, আপনি কিভাবে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বুট করতে চান?</translation>
	<translation id="4273235330352963866">আমার জন্য REFInd ইনস্টল এবং কনফিগার করুন (প্রস্তাবিত)</translation>
	<translation id="1858708492548921044">rEFInd হল একটি বুট ম্যানেজার প্রোগ্রাম যা OS বুট বিকল্পগুলির জন্য একটি চমৎকার গ্রাফিকাল ইন্টারফেস অফার করে যখন আপনার পিসি শুরু হয়, আপনি এটির সাথে বুট করার জন্য আপনার পছন্দসই OS বেছে নিতে সক্ষম হবেন। REFInd সম্পর্কিত আরও তথ্যের জন্য, অনুগ্রহ করে এর হোমপেজ দেখুন।</translation>
	<translation id="3861924051442564602">আমার জন্য একটি UEFI বুট মেনু বিকল্প যোগ করুন</translation>
	<translation id="8622370666798589804">আপনার পিসি শুরু হলে আপনি UEFI বুট বিকল্প মেনুতে প্রবেশ করতে সক্ষম হতে পারেন (সম্ভবত একটি হটকি টিপে), এই বিকল্পটি সেই মেনুতে একটি এন্ট্রি হিসাবে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> যোগ করে৷ (শুধুমাত্র BIOS এবং UEFI ফার্মওয়্যারের কিছু মডেল সমর্থন করে)।</translation>
	<translation id="1569398690544416170">এখানে কিছু করবেন না, আমি নিজেই এটি কনফিগার করব</translation>
	<translation id="3554866444001249532">এই ইনস্টলেশন স্ক্রিপ্টটি আপনার EFI পার্টিশনে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> বুট করার জন্য শুধুমাত্র প্রয়োজনীয় .efi ফাইল রাখবে, আপনাকে এটিকে কীভাবে বুট করতে হবে তা কনফিগার করতে হবে।</translation>
	<translation id="7492832751164189534">জোর করে প্রস্থান করুন</translation>
	<translation id="5159534860632584026">ইনস্টলেশন প্রক্রিয়া বন্ধ করা হয়েছে</translation>
	<translation id="8686749782014838344">ডিস্ক তথ্য পেতে ব্যর্থ</translation>
	<translation id="5688543378771259173">ইনস্টলেশন বন্ধ করা হচ্ছে...</translation>
	<translation id="5350452134936384991">ইউএসবিতে ইনস্টল করুন</translation>
	<translation id="8008470485414925603">একটি USB ডিস্কে <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ইনস্টল করুন; লক্ষ্য ইউএসবি ডিস্কের সমস্ত ডেটা মুছে ফেলা হবে।</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> আপনার নির্বাচিত USB ডিস্কে ইনস্টল করা হবে; লক্ষ্য ডিস্কের সমস্ত ডেটা মুছে ফেলা হবে।</translation>
	<translation id="5725593226060700263">কোনো USB ডিস্ক উপলব্ধ নেই৷</translation>
	<translation id="4357040841587078287">আমরা শনাক্ত করেছি যে আপনি ডাউনলোড করা ইমেজ ফাইল থেকে JemaOS-এর এই কপিটি চালাচ্ছেন। JemaOS অফার করতে পারে এমন সবচেয়ে ব্যাপক সমর্থন বৈশিষ্ট্যগুলি (ওভার-দ্য-এয়ার আপডেট সহ) ব্যবহার করার জন্য, আমরা দৃঢ়ভাবে সুপারিশ করছি যে আপনি একটি পৃথক স্টোরেজ ডিভাইসে JemaOS-এর সম্পূর্ণ-ডিস্ক ইনস্টলেশন সম্পাদন করতে "ইনস্টলার" ফাংশন চালু করুন।</translation>
	<translation id="1246398339704431302">আপনি <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>যেকোনভাবেই JemaOS-এর এই অনুলিপিটি ব্যবহার করা চালিয়ে যেতে পারেন<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, ইনস্টলেশন প্রক্রিয়াটি সিস্টেমে পরবর্তী পর্যায়ে সম্পাদিত হতে পারে, তবে, ইনস্টলেশনের পরে আপনার সমস্ত ডেটা মুছে ফেলা হবে এবং আপনি আবার শুরু করবেন৷</translation>
	<translation id="3654532222088291133">সাইন ইন করতে আপনার JemaOS অ্যাকাউন্টের পাসওয়ার্ড দেওয়ার পরিবর্তে, আপনি এই ডিভাইসের জন্য একটি <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> পাসওয়ার্ড তৈরি করতে পারেন</translation>
	<translation id="8377684629839541977">JemaOS অ্যাকাউন্টের পাসওয়ার্ড ব্যবহার করুন</translation>

