<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ml">
	<translation id="7386402409475121504">നിങ്ങളുടെ പ്രാദേശിക JemaOS അക്കൗണ്ട് സൃഷ്ടിക്കുക</translation>
	<translation id="3760308806144055927">നിങ്ങളുടെ പ്രാദേശിക JemaOS അക്കൗണ്ടിൽ സൈൻ ഇൻ ചെയ്യുക</translation>
	<translation id="3325117507482096812">ദയവായി ഒരു പാസ്‌വേഡ് നൽകുക</translation>
	<translation id="1838206877831947154">നിങ്ങളുടെ പാസ്‌വേഡുകൾ പൊരുത്തപ്പെടുന്നില്ല</translation>
	<translation id="2158276988029582286">ഒരു പുതിയ പ്രാദേശിക അക്കൗണ്ട് സൃഷ്ടിക്കുക</translation>
	<translation id="8592849747346274067">നിലവിലുള്ള ഒരു അക്കൗണ്ടിലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
	<translation id="482190417986201746">നിങ്ങൾ നൽകിയ ഉപയോക്തൃനാമമോ പാസ്‌വേഡോ തെറ്റാണ്</translation>
	<translation id="6603987686259425085">നിങ്ങൾക്ക് ഒരു JemaOS ലോക്കൽ അക്കൗണ്ട് ഉപയോഗിച്ച് <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>സൈൻ ഇൻ ചെയ്യാം<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">ഇമെയിൽ <ph name="EMAIL_ADDRESS">$1</ph> ഇതിനകം നിലവിലുണ്ട്. ദയവായി മറ്റൊരു ഇമെയിൽ ഉപയോഗിച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
	<translation id="7215016743510876720">പ്രാദേശിക അക്കൗണ്ട് ഉപയോഗിക്കുക</translation>
	<translation id="6657635042185516718">ഓൺലൈൻ അക്കൗണ്ട് ഉപയോഗിക്കുന്നത് തുടരുക</translation>
	<translation id="6867476688065565618">പ്രാദേശിക അക്കൗണ്ടിലേക്ക് മാറണോ?</translation>
	<translation id="4840454774882557974">നിങ്ങൾ ഒരു പ്രാദേശിക അക്കൗണ്ട് ഉപയോഗിക്കാൻ തിരഞ്ഞെടുക്കുകയാണെങ്കിൽ, ഒന്നിലധികം ഉപകരണങ്ങളിലുടനീളം നിങ്ങളുടെ ഡാറ്റയും മുൻഗണനകളും സമന്വയിപ്പിക്കുന്നതും നിങ്ങളുടെ JemaOS അക്കൗണ്ട് ഉപയോഗിച്ച് വെബ് ആപ്പുകളിൽ സ്വയമേവ സൈൻ ഇൻ ചെയ്യുന്നതും പ്രവർത്തിക്കില്ല.</translation>
	<translation id="8951507920859729424">JemaOS പൂർണ്ണമായി ഉപയോഗിക്കുന്നതിന് ഒരു ഓൺലൈൻ അക്കൗണ്ട് ഉപയോഗിക്കാൻ ഞങ്ങൾ ശുപാർശ ചെയ്യുന്നു.</translation>
	<translation id="479773200536372215">Google API കീകൾ നഷ്‌ടമായതിനാൽ നിങ്ങൾക്ക് Google അക്കൗണ്ടുകൾ ചേർക്കാൻ കഴിയില്ല. വിശദാംശങ്ങൾക്ക് <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> കാണുക.</translation>
	<translation id="1198491307547164157">JemaOS API കീകൾ നഷ്ടപ്പെട്ടതിനാൽ നിങ്ങൾക്ക് JemaOS അക്കൗണ്ടുകൾ ചേർക്കാൻ കഴിയില്ല. വിശദാംശങ്ങൾക്ക് <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> കാണുക.</translation>
	<translation id="5042404702659901995">സ്വകാര്യതാ പ്രസ്താവന</translation>
	<translation id="4907736162587268100">സ്വകാര്യതാ പ്രസ്താവന ഉള്ളടക്കം</translation>
	<translation id="5988344732274877691">JemaOS-നുള്ള (വളരെ അപൂർവ്വമായ, വാഗ്ദത്തം ചെയ്യപ്പെട്ട) വാർത്താക്കുറിപ്പിനായി സൈൻ അപ്പ് ചെയ്യുക</translation>
	<translation id="1706203008474708805">JemaOS ഉപയോക്തൃ അനുഭവ മെച്ചപ്പെടുത്തൽ പദ്ധതിയിൽ ചേരുക</translation>
	<translation id="1147139514756087229">ഒരു പ്രാദേശിക അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക</translation>
	<translation id="2054784944085654098">ഇപ്പോൾ ബാക്കപ്പ് ഫയൽ സൃഷ്ടിക്കുന്നു. ഇതിന് കുറച്ച് സമയമെടുത്തേക്കാം; ദയവായി കാത്തിരിക്കൂ…</translation>
	<translation id="3554401467586751874">ബാക്കപ്പ് ഫയൽ വിജയകരമായി സൃഷ്ടിച്ചു</translation>
	<translation id="2349211327705667074">ബാക്കപ്പ് ഫയൽ കാണുക</translation>
	<translation id="6337433855796857931">ബാക്കപ്പ് പരാജയപ്പെട്ടു</translation>
	<translation id="3049367131589710124">പിശക് ലോഗ് കാണുക</translation>
	<translation id="1079017345574916945">റിമോട്ട് ഡെസ്ക്ടോപ്പ്</translation>
	<translation id="3064478898280877715">ആപ്പ് സ്റ്റോർ</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">ഇൻസ്റ്റാളർ</translation>
	<translation id="2173278076276376488">ഈ ഉപകരണത്തിൻ്റെ ആന്തരിക സംഭരണത്തിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യാൻ ഈ യൂട്ടിലിറ്റി നിങ്ങളെ സഹായിക്കും.</translation>
	<translation id="5323182426977498659">മുന്നറിയിപ്പ്! ഈ നടപടിക്രമം വിനാശകരമാണ്, അത് പഴയപടിയാക്കാനാകില്ല. നിങ്ങളുടെ സാധ്യതയുള്ള ഡാറ്റ നഷ്‌ടത്തിന് ഞങ്ങൾ ഒരു ഉത്തരവാദിത്തവും വഹിക്കില്ലെന്നും അടിയന്തിര സാങ്കേതിക പിന്തുണ നൽകില്ലെന്നും ദയവായി ശ്രദ്ധിക്കുക, നിങ്ങളുടെ സ്വന്തം ഉത്തരവാദിത്തത്തിൽ തുടരുക.</translation>
	<translation id="8517836015601969896">പൂർണ്ണ ഡിസ്ക് ഇൻസ്റ്റാളേഷൻ</translation>
	<translation id="7300045760790370189">ഒരു മുഴുവൻ ഹാർഡ് ഡിസ്കും കൈവശപ്പെടുത്താൻ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യുക, ടാർഗെറ്റ് ഹാർഡ് ഡിസ്കിൻ്റെ എല്ലാ ഡാറ്റയും മായ്‌ക്കപ്പെടും.</translation>
	<translation id="8762511733918256595">മൾട്ടി-ബൂട്ട് ഇൻസ്റ്റാളേഷൻ</translation>
	<translation id="248900698427753678">ഒരു ഹാർഡ് ഡിസ്കിൻ്റെ നിലവിലുള്ള ഒരു പാർട്ടീഷനിലേക്ക് <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യുക, അവിടെ മറ്റ് OS-ന് സമാന്തരമായി <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> നിലനിൽക്കാൻ കഴിയും. ടാർഗെറ്റ് പാർട്ടീഷനിലെ എല്ലാ ഡാറ്റയും മായ്‌ക്കപ്പെടും.</translation>
	<translation id="8445241586733258838">നിങ്ങൾ തിരഞ്ഞെടുത്ത ഹാർഡ് ഡ്രൈവിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യും; ടാർഗെറ്റ് ഡിസ്കിലെ എല്ലാ ഡാറ്റയും മായ്‌ക്കും.</translation>
	<translation id="4039091757234555415">ഡിസ്ക്</translation>
	<translation id="7783580523889684697">ഡിസ്കൊന്നും ലഭ്യമല്ല</translation>
	<translation id="8217653566575018388">ഇൻസ്റ്റലേഷൻ പൂർത്തിയായി</translation>
	<translation id="8846746259444262774">ഇൻസ്റ്റാളേഷൻ പരാജയപ്പെട്ടു</translation>
	<translation id="7263815009235541549">ഇൻസ്റ്റാളേഷൻ വിജയകരമായി പൂർത്തിയായി. ദയവായി ആദ്യം നിങ്ങളുടെ ഉപകരണം പവർ ഓഫ് ചെയ്യുക, തുടർന്ന് ഏതെങ്കിലും ഇൻസ്റ്റലേഷൻ മീഡിയ നീക്കം ചെയ്യുക, തുടർന്ന് <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ബൂട്ട് ചെയ്യുന്നതിന് അത് വീണ്ടും ഓണാക്കുക.</translation>
	<translation id="3380151284134965398">ക്ഷമിക്കണം, എന്തോ കുഴപ്പം സംഭവിച്ചു, ഇൻസ്റ്റാളേഷൻ പൂർത്തിയായില്ല. പ്രക്രിയ വീണ്ടും ശ്രമിക്കുക. ഇതേ പിശക് തുടരുകയാണെങ്കിൽ, മുകളിലുള്ള ലോഗ് ഉപയോഗിച്ച് JemaOS പിന്തുണയ്‌ക്കായി ബന്ധപ്പെടുക.</translation>
	<translation id="4683944976188707627">നിങ്ങളുടെ ഹാർഡ് ഡ്രൈവിൻ്റെ തിരഞ്ഞെടുത്ത പാർട്ടീഷനിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യപ്പെടും. നിലവിലെ മൾട്ടി-ബൂട്ട് സ്കീമിന് കീഴിൽ, നിങ്ങളുടെ ഉപകരണം UEFI പിന്തുണയ്ക്കുകയും നിങ്ങളുടെ ഹാർഡ് ഡിസ്കുകൾ GPT ഉപയോഗിച്ച് ഫോർമാറ്റ് ചെയ്യുകയും ചെയ്താൽ മാത്രമേ ഇത് തുടരാൻ കഴിയൂ.</translation>
	<translation id="7831363758161884243">ലക്ഷ്യം വിഭജനം തുടച്ചുനീക്കപ്പെടും; ഇൻസ്റ്റാളറിന് സിസ്റ്റം ബൂട്ട് കോൺഫിഗറേഷനുകൾ പരിഷ്കരിക്കേണ്ടതിനാൽ നിങ്ങളുടെ സജീവമായ EFI പാർട്ടീഷനും (സാധാരണയായി സ്വയമേവ ചെയ്യപ്പെടും) വ്യക്തമാക്കേണ്ടതുണ്ട്.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ടാർഗെറ്റ് പാർട്ടീഷൻ തിരഞ്ഞെടുക്കുക</translation>
	<translation id="3695537760133394753">വിഭജനം</translation>
	<translation id="5610519566593708119">EFI പാർട്ടീഷൻ തിരഞ്ഞെടുക്കുക</translation>
	<translation id="3367650349940010965">തിരഞ്ഞെടുത്ത ഡിസ്കിന് പാർട്ടീഷനുകളൊന്നും ലഭ്യമല്ല</translation>
	<translation id="7453223384507098390">തിരഞ്ഞെടുത്ത ഡിസ്കിന് EFI പാർട്ടീഷനുകളൊന്നും ലഭ്യമല്ല</translation>
	<translation id="1854532683465500847">തിരഞ്ഞെടുത്ത പാർട്ടീഷൻ്റെ വലുപ്പം 20GB-യിൽ കുറവാണ്, ഇൻസ്റ്റലേഷൻ പരാജയപ്പെടാം</translation>
	<translation id="4144613075340468247">തിരഞ്ഞെടുത്ത പാർട്ടീഷൻ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> മൾട്ടി-ബൂട്ടിലേക്ക് മൌണ്ട് ചെയ്‌തിരിക്കുന്നു, അതിലേക്ക് വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടേക്കാം</translation>
	<translation id="5793361052649920836">ഇൻസ്റ്റാളേഷന് ശേഷം, <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> എങ്ങനെ ബൂട്ട് ചെയ്യാൻ നിങ്ങൾ ആഗ്രഹിക്കുന്നു?</translation>
	<translation id="4273235330352963866">എനിക്കായി rEFInd ഇൻസ്റ്റാൾ ചെയ്ത് കോൺഫിഗർ ചെയ്യുക (ശുപാർശ ചെയ്യുന്നു)</translation>
	<translation id="1858708492548921044">നിങ്ങളുടെ പിസി ആരംഭിക്കുമ്പോൾ OS ബൂട്ട് ഓപ്‌ഷനുകൾക്കായി നല്ലൊരു ഗ്രാഫിക്കൽ ഇൻ്റർഫേസ് നൽകുന്ന ഒരു ബൂട്ട് മാനേജർ പ്രോഗ്രാമാണ് rEFInd, അത് ഉപയോഗിച്ച് ബൂട്ട് ചെയ്യുന്നതിന് നിങ്ങൾക്ക് ആവശ്യമുള്ള OS തിരഞ്ഞെടുക്കാൻ കഴിയും. rEFInd സംബന്ധിച്ച കൂടുതൽ വിവരങ്ങൾക്ക്, ദയവായി അതിൻ്റെ ഹോംപേജ് പരിശോധിക്കുക.</translation>
	<translation id="3861924051442564602">എനിക്കായി ഒരു UEFI ബൂട്ട് മെനു ഓപ്ഷൻ ചേർക്കുക</translation>
	<translation id="8622370666798589804">നിങ്ങളുടെ പിസി ആരംഭിക്കുമ്പോൾ നിങ്ങൾക്ക് UEFI ബൂട്ട് ഓപ്‌ഷൻ മെനുവിൽ പ്രവേശിക്കാൻ കഴിഞ്ഞേക്കും (മിക്കവാറും ഒരു ഹോട്ട്‌കീ അമർത്തിയാൽ), ഈ ഓപ്‌ഷൻ ആ മെനുവിലേക്ക് ഒരു എൻട്രിയായി <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ചേർക്കുന്നു. (ബയോസ്, യുഇഎഫ്ഐ ഫേംവെയർ എന്നിവയുടെ ചില മോഡലുകൾ മാത്രം പിന്തുണയ്ക്കുന്നു).</translation>
	<translation id="1569398690544416170">ഇവിടെ ഒന്നും ചെയ്യരുത്, ഞാൻ അത് സ്വയം ക്രമീകരിക്കും</translation>
	<translation id="3554866444001249532">ഈ ഇൻസ്റ്റലേഷൻ സ്ക്രിപ്റ്റ് നിങ്ങളുടെ EFI പാർട്ടീഷനിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ബൂട്ട് ചെയ്യുന്നതിന് ആവശ്യമായ .efi ഫയലുകൾ മാത്രമേ നൽകൂ, അത് എങ്ങനെ ബൂട്ട് ചെയ്യണമെന്ന് നിങ്ങൾ സ്വയം കോൺഫിഗർ ചെയ്യേണ്ടതുണ്ട്.</translation>
	<translation id="7492832751164189534">നിർബന്ധം വിട്ടു</translation>
	<translation id="5159534860632584026">ഇൻസ്റ്റലേഷൻ പ്രക്രിയ അവസാനിപ്പിച്ചു</translation>
	<translation id="8686749782014838344">ഡിസ്ക് വിവരങ്ങൾ നേടുന്നതിൽ പരാജയപ്പെട്ടു</translation>
	<translation id="5688543378771259173">ഇൻസ്റ്റാളേഷൻ അവസാനിപ്പിക്കുകയാണ്...</translation>
	<translation id="5350452134936384991">യുഎസ്ബിയിൽ ഇൻസ്റ്റാൾ ചെയ്യുക</translation>
	<translation id="8008470485414925603">ഒരു USB ഡിസ്കിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യുക; ടാർഗെറ്റ് USB ഡിസ്കിലെ എല്ലാ ഡാറ്റയും മായ്‌ക്കപ്പെടും.</translation>
	<translation id="1270668145107456127">നിങ്ങൾ തിരഞ്ഞെടുത്ത USB ഡിസ്കിൽ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ഇൻസ്റ്റാൾ ചെയ്യും; ടാർഗെറ്റ് ഡിസ്കിലെ എല്ലാ ഡാറ്റയും മായ്‌ക്കും.</translation>
	<translation id="5725593226060700263">USB ഡിസ്ക് ലഭ്യമല്ല</translation>
	<translation id="4357040841587078287">ഡൗൺലോഡ് ചെയ്‌ത ഇമേജ് ഫയലിൽ നിന്നാണ് നിങ്ങൾ JemaOS-ൻ്റെ ഈ പകർപ്പ് പ്രവർത്തിപ്പിക്കുന്നത് എന്ന് ഞങ്ങൾ കണ്ടെത്തി. JemaOS-ന് നൽകാൻ കഴിയുന്ന ഏറ്റവും സമഗ്രമായ പിന്തുണാ സവിശേഷതകൾ (ഓവർ-ദി-എയർ അപ്‌ഡേറ്റുകൾ ഉൾപ്പെടെ) ഉപയോഗപ്പെടുത്തുന്നതിന്, ഒരു പ്രത്യേക സ്റ്റോറേജ് ഉപകരണത്തിലേക്ക് JemaOS-ൻ്റെ പൂർണ്ണ-ഡിസ്‌ക് ഇൻസ്റ്റാളേഷൻ നടത്താൻ "ഇൻസ്റ്റാളർ" ഫംഗ്‌ഷൻ സമാരംഭിക്കാൻ ഞങ്ങൾ ശക്തമായി ശുപാർശ ചെയ്യുന്നു.</translation>
	<translation id="1246398339704431302">നിങ്ങൾക്ക് <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>എന്തായാലും JemaOS-ൻ്റെ ഈ പകർപ്പ് ഉപയോഗിക്കുന്നത് തുടരാം<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, ഇൻസ്റ്റലേഷൻ പ്രക്രിയ പിന്നീടുള്ള ഘട്ടത്തിൽ സിസ്റ്റത്തിൽ എക്‌സിക്യൂട്ട് ചെയ്യാൻ കഴിയും, എന്നിരുന്നാലും, ഈ പേജിൽ നിന്ന് നിങ്ങളുടെ എല്ലാ ഡാറ്റയും മായ്‌ക്കപ്പെടും.</translation>
	<translation id="3654532222088291133">സൈൻ ഇൻ ചെയ്യുന്നതിന് നിങ്ങളുടെ JemaOS അക്കൗണ്ട് പാസ്‌വേഡ് നൽകുന്നതിന് പകരം, ഈ ഉപകരണത്തിനായി നിങ്ങൾക്ക് ഒരു <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> പാസ്‌വേഡ് സൃഷ്‌ടിക്കാം.</translation>
	<translation id="8377684629839541977">JemaOS അക്കൗണ്ട് പാസ്‌വേഡ് ഉപയോഗിക്കുക</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" /> യാന്ത്രികമായി അപ്‌ഡേറ്റ് ചെയ്ത് സൂക്ഷിക്കുക</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> അപ്‌ഡേറ്റ് പ്രവർത്തനക്ഷമമാക്കി</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> അപ്‌ഡേറ്റ് പ്രവർത്തനരഹിതമാക്കി</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) പ്ലാറ്റ്‌ഫോം <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">റിമോട്ട് ഡെസ്ക്ടോപ്പ്</translation>
<translation id="6898090158927982244">നിങ്ങളുടെ Linux അപ്-റ്റു-ഡേറ്റ് ആണ്</translation>
<translation id="4886703929102211360">Linux (ബീറ്റ) ഘടകത്തിന് ഒരു നിർണായക അപ്‌ഡേറ്റ് ലഭ്യമാണ്. ഈ അപ്‌ഡേറ്റ് എത്രയും വേഗത്തിൽ ഇൻസ്റ്റാൾ ചെയ്യാൻ ശക്തമായി ശുപാർശ ചെയ്യുന്നു, അല്ലെങ്കിൽ നിങ്ങളുടെ Linux (ബീറ്റ) പ്രവർത്തിക്കുന്നത് നിർത്തിയേക്കാം.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> ക്രമീകരണങ്ങൾ</translation>
<translation id="8362858344151826493">JemaOS അക്കൗണ്ട്, ബാക്കപ്പ്, മറ്റുള്ളവ</translation>
<translation id="9150429437595727962">Wi-Fi ക്രമീകരണങ്ങൾ</translation>
<translation id="4938972461544498524">ടച്ച്പാഡ് ക്രമീകരണങ്ങൾ</translation>
<translation id="1210024513248363065">റിമോട്ട് സേവനങ്ങൾ</translation>
<translation id="2878862288885588535">റിമോട്ട് ഡയഗ്നോസ്റ്റിക് സേവനം</translation>
<translation id="7409197984340676806">ഔദ്യോഗിക JemaOS പിന്തുണ പ്രതിനിധികൾക്ക് സിസ്റ്റം പ്രശ്നങ്ങൾ തിരിച്ചറിയാൻ റിമോട്ട് ഡയഗ്നോസ്റ്റിക് സേവനം അനുവദിക്കുന്നു. നിലവിൽ, ഔദ്യോഗിക JemaOS പിന്തുണ പ്രതിനിധികൾക്ക് മാത്രമേ റിമോട്ട് ഡയഗ്നോസ്റ്റിക് സേവനം ആരംഭിക്കാൻ കഴിയൂ.</translation>
<translation id="1791028023086176332">ഈ നമ്പർ ഔദ്യോഗിക JemaOS പിന്തുണ പ്രതിനിധികളുമായി പങ്കിടുക</translation>
<translation id="6279304275399437025">റിമോട്ട് ഡയഗ്നോസ്റ്റിക് സേവനം ആരംഭിക്കുന്നു...</translation>
<translation id="1501882165699826662">ദയവായി റിമോട്ട് ഡയഗ്നോസ്റ്റിക് സേവനം നിർത്തി വീണ്ടും ശ്രമിക്കുക</translation>
<translation id="3100283258447375201">കൂടുതൽ വിവരങ്ങൾ</translation>
<translation id="4070039109671307724">മറ്റുള്ളവ</translation>
<translation id="7326893024940073254">"പുനരാരംഭിക്കുക" ബട്ടൺ</translation>
<translation id="3002423764319968103">സിസ്റ്റം മെനുവിൽ ഒരു "പുനരാരംഭിക്കുക" ബട്ടൺ കാണിക്കുക</translation>
<translation id="6243454903512423518">"സ്ക്രീൻ തിരിക്കുക" ബട്ടൺ</translation>
<translation id="6491049336868978729">നിങ്ങൾ ഇപ്പോൾ ടാബ്‌ലെറ്റ് മോഡിലല്ല, "സ്ക്രീൻ തിരിക്കുക" ബട്ടൺ മറച്ചിരിക്കുന്നു</translation>
<translation id="5496012402277579695">സിസ്റ്റം മെനുവിൽ ഒരു "സ്ക്രീൻ തിരിക്കുക" ബട്ടൺ കാണിക്കുക</translation>
<translation id="5882838977344999606">ടാബ്‌ലെറ്റ്/ലാപ്‌ടോപ്പ് മോഡ് സ്വിച്ച്</translation>
<translation id="472164133625585606">സിസ്റ്റം മെനുവിൽ ഒരു ടാബ്‌ലെറ്റ്/ലാപ്‌ടോപ്പ് മോഡ് സ്വിച്ച് കാണിക്കുക</translation>
<translation id="1851103550468466960">Widevine പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="4058176713282795846">സംരക്ഷിത പ്രീമിയം ഉള്ളടക്കം സ്ട്രീം ചെയ്യാൻ Widevine പ്രവർത്തനക്ഷമമാക്കുക. <ph name="BEGIN_LINK_LEARN_MORE" />കൂടുതൽ അറിയുക<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" തിരഞ്ഞെടുക്കുക</translation>
<translation id="4838463656205005584">Widevine പ്രവർത്തനക്ഷമമാക്കുന്നതിൽ പരാജയപ്പെട്ടു...</translation>
<translation id="2164041826798266548">Widevine CDM മൊഡ്യൂൾ ഇൻസ്റ്റാളേഷൻ പരാജയപ്പെട്ടു. ദയവായി നിങ്ങളുടെ കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4106982328079440606">JemaOS അക്കൗണ്ട് ക്രമീകരണങ്ങൾ</translation>
<translation id="6468776556018764845">പരീക്ഷണാത്മക സവിശേഷതകൾ</translation>
<translation id="3487615413425326553">Trusted Platform Module (TPM) പരിശോധനകൾ ഒഴിവാക്കുക</translation>
<translation id="4817176087932811573">നിങ്ങളുടെ ഉപകരണത്തിലെ പൊരുത്തമില്ലാത്ത TPM ചിപ്പ് കാരണം ചില സവിശേഷതകൾ പരാജയപ്പെടാം; ഒരു പരിഹാരമായി TPM പരിശോധനകൾ ഒഴിവാക്കാവുന്നതാണ്.</translation>
<translation id="3356003366173774486">യാന്ത്രിക സൈൻ-ഇൻ</translation>
<translation id="6218459410891191693">ഉപകരണം പുനരാരംഭിക്കുമ്പോൾ നിലവിലെ അക്കൗണ്ട് ഡെസ്ക്ടോപ്പിലേക്ക് യാന്ത്രികമായി സൈൻ ഇൻ ചെയ്യാൻ അനുവദിക്കുക</translation>
<translation id="6620839363422062843">ഈ അക്കൗണ്ടിനായി പ്രവർത്തനക്ഷമമാക്കാൻ കഴിയില്ല; ഈ ഉപകരണത്തിലെ മറ്റ് അക്കൗണ്ടുകൾക്കായി യാന്ത്രിക സൈൻ-ഇൻ ഇതിനകം സജീവമാണ്</translation>
<translation id="6734500226490446035">ഈ അക്കൗണ്ടിനായി പ്രവർത്തനക്ഷമമാക്കാൻ കഴിയില്ല; ഈ അക്കൗണ്ടിനുള്ള ഫയൽ സിസ്റ്റങ്ങൾ തുടക്കത്തിൽ അജ്ഞാത പിശക് സംഭവിച്ചു. ദയവായി പുനരാരംഭിക്കുന്നതിനോ പുതിയ അക്കൗണ്ട് സൃഷ്ടിക്കുന്നതിനോ ശ്രമിക്കുക</translation>
<translation id="5464880042146818691">ഈ അക്കൗണ്ടിനായി പ്രവർത്തനക്ഷമമാക്കാൻ കഴിയില്ല; യാന്ത്രിക സൈൻ-ഇൻ ഓപ്ഷൻ "പ്രാദേശിക അക്കൗണ്ട്" തരത്തിന് മാത്രമേ ലഭ്യമാകൂ.</translation>
<translation id="3335654854106476749">യാന്ത്രിക സൈൻ-ഇൻ പ്രവർത്തനക്ഷമമാക്കുന്നതിന് മുമ്പ് ദയവായി <ph name="BEGIN_LINK" />സ്വകാര്യതയും സുരക്ഷയും<ph name="END_LINK" /> ക്രമീകരണങ്ങളിൽ ഒരു സൈൻ-ഇൻ പാസ്‌വേഡ് ചേർക്കുക.</translation>
<translation id="5586831602198585601">JemaOS-ന്റെ ഒരു പുതിയ പതിപ്പ് ഇപ്പോൾ അപ്‌ഡേറ്റ് ചെയ്യാൻ ലഭ്യമാണ്. എന്നിരുന്നാലും, നിങ്ങളുടെ JemaOS for You സബ്‌സ്‌ക്രിപ്ഷൻ കാലാവധി കഴിഞ്ഞു; നിങ്ങളുടെ JemaOS അപ്‌ഡേറ്റ് ചെയ്യാൻ നിങ്ങൾക്ക് ഒരു സജീവ സബ്‌സ്‌ക്രിപ്ഷൻ ആവശ്യമാണ്.</translation>
<translation id="3869860597719956574">JemaOS-ന്റെ ഒരു പുതിയ പ്രധാന പതിപ്പ് ഇപ്പോൾ അപ്‌ഡേറ്റ് ചെയ്യാൻ ലഭ്യമാണ്. ഈ അപ്‌ഡേറ്റിൽ തുടരാൻ നിങ്ങൾ ഒറ്റത്തവണ ഫീസ് അടയ്ക്കേണ്ടതുണ്ട്.</translation>
<translation id="6523879681771260760">ബാക്കപ്പ് ഫയൽ സൂക്ഷിക്കാനുള്ള പാത്ത് ദയവായി വ്യക്തമാക്കുക</translation>
<translation id="2036152819788683293">ഈ അക്കൗണ്ടിനായി ഒരു ബാക്കപ്പ് ഫയൽ സൃഷ്ടിക്കുക (ബീറ്റ). <ph name="BEGIN_LINK_LEARN_MORE" />കൂടുതൽ അറിയുക<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">ബാക്കപ്പ് എടുക്കുക</translation>
<translation id="4267347174163690295">ഈ അക്കൗണ്ടിനായി ഒരു ബാക്കപ്പ് ഫയൽ സൃഷ്ടിക്കുക (ബീറ്റ).</translation>
<translation id="8112950994208888917">ഈ പ്രവർത്തനം ഈ അക്കൗണ്ടിനായി സമ്പൂർണ്ണ ഡിസ്ക് ബാക്കപ്പ് സൃഷ്ടിക്കുന്നു, അതിനാൽ ക്രമീകരണങ്ങൾ, ഇൻസ്റ്റാൾ ചെയ്ത ബ്രൗസർ എക്സ്റ്റൻഷനുകൾ, സബ്സിസ്റ്റം ആപ്പുകൾ എന്നിവയുൾപ്പെടെ ബാക്കപ്പ് സൃഷ്ടിച്ച സമയത്തെ അവസ്ഥയിലേക്ക് നിങ്ങളുടെ JemaOS പുനഃസ്ഥാപിക്കുന്നത് എളുപ്പമാക്കുന്നു. നിങ്ങളുടെ ആപ്പുകളും ഹോം ഫോൾഡറിലെ ഉള്ളടക്കവും അനുസരിച്ച് ബാക്കപ്പ് ഫയൽ വലുതായിരിക്കാം; ബാക്കപ്പ് ഫയൽ ഒരു ബാഹ്യ സ്റ്റോറേജ് ഉപകരണത്തിൽ സൂക്ഷിക്കാൻ ശുപാർശ ചെയ്യുന്നു. പോർട്ടബിൾ USB ഡ്രൈവ് ഉണ്ടെങ്കിൽ, ദയവായി ഇപ്പോൾ ബന്ധിപ്പിക്കുക. <ph name="BEGIN_LINK_LEARN_MORE" />കൂടുതൽ അറിയുക<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">ദയവായി ഈ അക്കൗണ്ടിന്റെ സൈൻ-ഇൻ പാസ്‌വേഡ് നൽകുക</translation>
<translation id="8663988871299316062">ദയവായി ഈ പാസ്‌വേഡ് ഓർമ്മിക്കുക, കാരണം ഈ ബാക്കപ്പ് ഫയൽ പുനഃസ്ഥാപിക്കുമ്പോൾ അത് ആവശ്യമാണ്</translation>
<translation id="6408904153044317846">പുനഃസ്ഥാപിക്കാനുള്ള ബാക്കപ്പ് ഫയൽ തിരഞ്ഞെടുക്കുക</translation>
<translation id="8062988348127771021">ഒരു ബാക്കപ്പ് ഫയലിൽ നിന്ന് നിങ്ങളുടെ JemaOS ഡാറ്റ പുനഃസ്ഥാപിക്കുക</translation>
<translation id="7309192418866543730">ബാക്കപ്പ് പാസ്‌വേഡ് നൽകുക</translation>
<translation id="3642408376366598984">ഈ ബാക്കപ്പ് ഫയൽ എൻക്രിപ്റ്റ് ചെയ്യാൻ ഉപയോഗിച്ച പാസ്‌വേഡ് നൽകുക</translation>
<translation id="7783974937157985523">ബാക്കപ്പ് പാസ്‌വേഡ്</translation>
<translation id="6583780301401541007">പുനഃസ്ഥാപിക്കൽ വിജയിച്ചു</translation>
<translation id="3514011352559420398">പുനഃസ്ഥാപിക്കൽ പരാജയപ്പെട്ടു</translation>
<translation id="7535980903266533458">ബാക്കപ്പ് നിങ്ങളുടെ ഉപകരണത്തിലോ ബാഹ്യ സ്റ്റോറേജിലോ സൂക്ഷിക്കുക</translation>
<translation id="604001903249547235">ക്ലൗഡ് ബാക്കപ്പ്</translation>
<translation id="8885702701336541611">ബാക്കപ്പ് JemaOS ക്ലൗഡ് സ്റ്റോറേജിലേക്ക് അപ്‌ലോഡ് ചെയ്യുക</translation>
<translation id="3939744430096549862">ക്ലൗഡിലേക്ക് ബാക്കപ്പ് എടുക്കുക</translation>
<translation id="619129431573254316">ഒരു പ്രാദേശിക ബാക്കപ്പ് ഫയലിൽ നിന്ന് പുനഃസ്ഥാപിക്കുക</translation>
<translation id="1859592711955106569">ക്ലൗഡ് പുനഃസ്ഥാപിക്കൽ</translation>
<translation id="38222223336741457">JemaOS ക്ലൗഡിൽ നിന്ന് ഡൗൺലോഡ് ചെയ്ത് പുനഃസ്ഥാപിക്കുക</translation>
<translation id="1241089811244416179">ക്ലൗഡിൽ നിന്ന് പുനഃസ്ഥാപിക്കുക</translation>
<translation id="652479689372703360">ബാക്കപ്പ് പുരോഗമിക്കുന്നു</translation>
<translation id="3655220146274872918">ബാക്കപ്പ് പൂർത്തിയായി</translation>
<translation id="4243579853635792694">നിങ്ങളുടെ ബാക്കപ്പ് വിജയകരമായി സൃഷ്ടിച്ചു</translation>
<translation id="4854179463174744546">ബാക്കപ്പ് പ്രക്രിയയ്ക്കിടെ ഒരു പിശക് സംഭവിച്ചു</translation>
<translation id="2410668771600309999">Connect API ഉപയോക്തൃ വിവരങ്ങൾ</translation>
<translation id="2223892939866251845">ഉപയോക്തൃ ID</translation>
<translation id="3850846286480935456">ബാക്കപ്പ് സ്റ്റോറേജ് വിശകലനം</translation>
<translation id="6244494465581273970">ഉപയോക്തൃ ID ആവശ്യമാണ്</translation>
<translation id="9204006549413740506">അവസാനം അപ്‌ഡേറ്റ് ചെയ്തത്</translation>
<translation id="476642412165431515">ഹാർഡ്‌വെയർ ഉപകരണങ്ങൾ</translation>
<translation id="3386337985825120901">ബാക്കപ്പ് ഡാറ്റയൊന്നും ലഭ്യമല്ല</translation>
<translation id="8490990067870590760">ബാക്കപ്പ് ഫയലുകൾ ലോഡ് ചെയ്യുന്നു...</translation>
<translation id="2955409026764742995">പുനഃസ്ഥാപിക്കാനുള്ള ബാക്കപ്പ് ഫയൽ തിരഞ്ഞെടുക്കുക:</translation>
<translation id="7414629348005657242">-- ഒരു ബാക്കപ്പ് ഫയൽ തിരഞ്ഞെടുക്കുക --</translation>
<translation id="918246516374174381">ബാക്കപ്പ് ഫയലുകളൊന്നും കണ്ടെത്തിയില്ല. ദയവായി ആദ്യം ഒരു ബാക്കപ്പ് സൃഷ്ടിക്കുക.</translation>
<translation id="77997252117517973">ഉടൻ വരുന്നു</translation>
<translation id="1930692852800776096">ഒരു നിഘണ്ടു ചേർക്കുക</translation>
<translation id="8793060353848771694">ഇടത് ഇയർബഡ് ചിത്രം</translation>
<translation id="6257440204887306255">ചാർജിംഗ് കേസ് ചിത്രം</translation>
<translation id="2754700616124958693">വലത് ഇയർബഡ് ചിത്രം</translation>
<translation id="1068676292264983586">ഡീഫോൾട്ട് ഉപകരണ ചിത്രം</translation>
<translation id="6364075396486660405">ബാറ്ററി ആയുസ് മെച്ചപ്പെടുത്താൻ എല്ലാ പാർട്ടീഷനുകളുടെയും മീഡിയ ഫയലുകളുടെ യാന്ത്രിക സ്കാനിംഗ് പ്രവർത്തനരഹിതമാക്കുക. <ph name="BEGIN_LINK_LEARN_MORE" />കൂടുതൽ അറിയുക<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">സുരക്ഷാ ഓപ്ഷനുകൾ</translation>
<translation id="5618366106086725045">കൂടുതൽ ഡെവലപ്പർ സവിശേഷതകളോടെ ഈ <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> ഇൻസ്റ്റാളേഷനായി "ഡെവലപ്പർ മോഡ്" പ്രവർത്തനക്ഷമമാക്കുക. <ph name="BEGIN_LINK_LEARN_MORE" />കൂടുതൽ അറിയുക<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">നിങ്ങൾ ഇതിനകം "ഡെവലപ്പർ മോഡ്"-il ആണ്</translation>
<translation id="6074549317340202195">"ഡെവലപ്പർ മോഡ്" പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="418781258674176053">മുന്നറിയിപ്പ്! "ഡെവലപ്പർ മോഡ്" പ്രവർത്തനക്ഷമമാക്കുന്നത് മടക്കിവരാൻ കഴിയാത്ത പ്രവർത്തനമാണ്. "ഡെവലപ്പർ മോഡ്" പ്രവർത്തനരഹിതമാക്കണമെങ്കിൽ നിങ്ങൾ JemaOS വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യേണ്ടതുണ്ട്, അത് എല്ലാ ഡാറ്റയും മായ്ക്കും. ദയവായി നിങ്ങളുടെ ഡാറ്റ ബാക്കപ്പ് ചെയ്ത് സ്വന്തം ഉത്തരവാദിത്തത്തിൽ തുടരുക.</translation>
