<translationbundle lang="cs">
	<translation id="7386402409475121504">Vytvořte si místní účet JemaOS</translation>
	<translation id="3760308806144055927">Přihlaste se k místnímu účtu JemaOS</translation>
	<translation id="3325117507482096812">Zadejte prosím heslo</translation>
	<translation id="1838206877831947154">Vaše hesla se neshodují</translation>
	<translation id="2158276988029582286">Vytvořte nový místní účet</translation>
	<translation id="8592849747346274067">Přihlaste se ke stávajícímu účtu</translation>
	<translation id="482190417986201746">Zadané uživatelské jméno nebo heslo je nesprávné</translation>
	<translation id="6603987686259425085">Můžete se <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>přihlásit pomocí místního účtu JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-mail <ph name="EMAIL_ADDRESS">$1</ph> již existuje. Zkuste to znovu s jiným e-mailem.</translation>
	<translation id="7215016743510876720">Použijte místní účet</translation>
	<translation id="6657635042185516718">Pokračujte v používání online účtu</translation>
	<translation id="6867476688065565618">Přepnout na místní účet?</translation>
	<translation id="4840454774882557974">Pokud se rozhodnete používat místní účet, užitečné funkce zahrnují synchronizaci vašich dat a předvoleb mezi více zařízeními a automatické přihlašování do webových aplikací pomocí vašeho účtu JemaOS nebude fungovat.</translation>
	<translation id="8951507920859729424">Pro plné využití JemaOS doporučujeme používat online účet.</translation>
	<translation id="479773200536372215">Nebudete moci přidat účty Google, protože chybí klíče Google API. Podrobnosti naleznete na stránce <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Nebudete moci přidat účty JemaOS, protože chybí klíče rozhraní API JemaOS. Podrobnosti naleznete na stránce <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Prohlášení o ochraně osobních údajů</translation>
	<translation id="4907736162587268100">Obsah prohlášení o ochraně osobních údajů</translation>
	<translation id="5988344732274877691">Přihlaste se k odběru (velmi málo častého, slibovaného) newsletteru pro JemaOS</translation>
	<translation id="1706203008474708805">Připojte se k plánu zlepšení uživatelské zkušenosti JemaOS</translation>
	<translation id="1147139514756087229">Přihlaste se pomocí místního účtu</translation>
	<translation id="2054784944085654098">Nyní se vytváří záložní soubor. To může chvíli trvat; prosím čekejte…</translation>
	<translation id="3554401467586751874">Záložní soubor byl úspěšně vytvořen</translation>
	<translation id="2349211327705667074">Zobrazit záložní soubor</translation>
	<translation id="3049367131589710124">Zobrazit protokol chyb</translation>
	<translation id="1079017345574916945">Vzdálená plocha</translation>
	<translation id="3064478898280877715">Obchod s aplikacemi</translation>
	<translation id="5890206344045530832">Instalátor</translation>
	<translation id="2173278076276376488">Tento nástroj vám pomůže nainstalovat <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> do interního úložiště tohoto zařízení.</translation>
	<translation id="5323182426977498659">Varování! Tento postup je destruktivní a nelze jej vrátit zpět. Vezměte prosím na vědomí, že neneseme žádnou odpovědnost za vaši potenciální ztrátu dat ani neposkytujeme naléhavou technickou podporu, postupujete na vlastní riziko.</translation>
	<translation id="8517836015601969896">Kompletní instalace disku</translation>
	<translation id="7300045760790370189">Nainstalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, aby zabral celý pevný disk, všechna data na cílovém pevném disku budou vymazána.</translation>
	<translation id="8762511733918256595">Instalace s více spouštěním</translation>
	<translation id="248900698427753678">Nainstalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na existující oddíl pevného disku, kde <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> může existovat paralelně s jinými OS. Všechna data na cílovém oddílu budou vymazána.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bude nainstalován na vámi vybraný pevný disk; všechna data na cílovém disku budou vymazána.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Není k dispozici žádný disk</translation>
	<translation id="8217653566575018388">Instalace dokončena</translation>
	<translation id="8846746259444262774">Instalace se nezdařila</translation>
	<translation id="7263815009235541549">Instalace byla úspěšně dokončena. Nejprve prosím vypněte zařízení, poté vyjměte všechna instalační média a znovu jej zapněte, aby se spustil <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Jejda, něco se pokazilo a instalace nebyla dokončena. Opakujte prosím proces. Pokud stejná chyba přetrvává, obraťte se na podporu JemaOS s výše uvedeným protokolem.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bude nainstalován na vybraný oddíl vašeho pevného disku. Podle aktuálního schématu s více spouštěním by to mohlo pokračovat pouze v případě, že vaše zařízení podporuje UEFI a vaše pevné disky jsou naformátovány pomocí GPT.</translation>
	<translation id="7831363758161884243">Cílový oddíl bude vymazán; musíte také určit váš aktivní oddíl EFI (obvykle automaticky), protože instalační program potřebuje upravit konfiguraci zavádění systému.</translation>
	<translation id="5670799238446305550">Vyberte cílový oddíl <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Oddíl</translation>
	<translation id="5610519566593708119">Vyberte oddíl EFI</translation>
	<translation id="3367650349940010965">Pro vybraný disk nejsou k dispozici žádné oddíly</translation>
	<translation id="7453223384507098390">Pro vybraný disk nejsou k dispozici žádné oddíly EFI</translation>
	<translation id="1854532683465500847">Velikost vybraného oddílu je menší než 20 GB, instalace může selhat</translation>
	<translation id="4144613075340468247">Vybraný oddíl byl připojen k <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, instalace do něj může selhat</translation>
	<translation id="5793361052649920836">Jak chcete po instalaci spustit <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Nainstalujte a nakonfigurujte rEFInd za mě (doporučeno)</translation>
	<translation id="1858708492548921044">rEFInd je program pro správu spouštění, který nabízí pěkné grafické rozhraní pro možnosti spouštění operačního systému, když se váš počítač spouští, budete si moci vybrat požadovaný operační systém, který se s ním spustí. Více informací o rEFInd naleznete na jeho domovské stránce.</translation>
	<translation id="3861924051442564602">Přidat možnost spouštěcí nabídky UEFI pro mě</translation>
	<translation id="8622370666798589804">Když se váš počítač spustí, možná budete moci vstoupit do nabídky možností spouštění UEFI (nejpravděpodobněji stisknutím klávesové zkratky), tato možnost přidá <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> jako položku do této nabídky. (Podporuje pouze některé modely firmwaru BIOS a UEFI).</translation>
	<translation id="1569398690544416170">Tady nic nedělej, nakonfiguruji si to sám</translation>
	<translation id="3554866444001249532">Tento instalační skript vloží pouze soubory .efi nezbytné pro zavedení <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> do vašeho oddílu EFI, budete si muset sami nakonfigurovat, jak jej zavést.</translation>
	<translation id="7492832751164189534">Vynutit ukončení</translation>
	<translation id="5159534860632584026">Proces instalace byl ukončen</translation>
	<translation id="8686749782014838344">Nepodařilo se získat informace o disku</translation>
	<translation id="5688543378771259173">Instalace se ukončuje...</translation>
	<translation id="5350452134936384991">Nainstalujte do USB</translation>
	<translation id="8008470485414925603">Nainstalujte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na USB disk; všechna data na cílovém USB disku budou vymazána.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bude nainstalován na vámi vybraný USB disk; všechna data na cílovém disku budou vymazána.</translation>
	<translation id="5725593226060700263">Není k dispozici žádný USB disk</translation>
	<translation id="4357040841587078287">Zjistili jsme, že používáte tuto kopii JemaOS ze staženého souboru obrázku. Chcete-li využít nejkomplexnější podpůrné funkce (včetně aktualizací Over-The-Air), které může JemaOS nabídnout, důrazně doporučujeme spustit funkci „Instalátor“ a provést instalaci JemaOS z celého disku na samostatné úložné zařízení.</translation>
	<translation id="1246398339704431302">Tuto kopii JemaOS můžete <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>přesto nadále používat<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proces instalace lze provést v pozdější fázi systému, po instalaci však budou všechna vaše data vymazána a začnete znovu z této stránky.</translation>
	<translation id="3654532222088291133">Místo zadávání hesla k účtu JemaOS pro přihlášení můžete pro toto zařízení vytvořit heslo <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph></translation>
	<translation id="8377684629839541977">Použijte heslo účtu JemaOS</translation>

