<translation id="3157931365184549694">ស្តារ</translation>
<translation id="8556278756526311953">កំពុងស្តារការបម្រុងទុក</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />យើងខ្ញុំកំពុងធ្វើការស្តារឯកសារបម្រុងទុករបស់អ្នក; វាអាចចំណាយពេលមួយរយៈ ដូច្នេះសូមអត់ធ្មត់រង់ចាំ។<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />សូមកត់សម្គាល់ថា UI នឹងចាប់ផ្តើមឡើងវិញដោយស្វ័យប្រវត្តិនៅពេលដំណើរការស្តារបានបញ្ចប់ដោយជោគជ័យ។<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ការស្តារការបម្រុងទុកបានបរាជ័យ</translation>
<translation id="5003531399442003695">សម្រាប់ព័ត៌មានលម្អិតបន្ថែម សូមចុចតំណខាងក្រោមដើម្បីមើលកំណត់ហេតុ។ ប្រសិនបើកំហុសនេះនៅតែបន្ត សូមទាក់ទងឆានែលគាំទ្របច្ចេកទេស JemaOS ហើយផ្តល់កំណត់ហេតុកំហុស។</translation>
