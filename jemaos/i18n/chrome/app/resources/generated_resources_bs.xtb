<translation id="652479689372703360">Pravljenje sigurnosne kopije u toku</translation>
<translation id="3655220146274872918">Sigurnosna kopija završena</translation>
<translation id="4243579853635792694">Vaša sigurnosna kopija je uspješno napravljena</translation>
<translation id="6337433855796857931">Pravljenje sigurnosne kopije nije uspjelo</translation>
<translation id="4854179463174744546">Došlo je do greške tokom pravljenja sigurnosne kopije</translation>
