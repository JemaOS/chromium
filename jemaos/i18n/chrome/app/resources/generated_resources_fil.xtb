<translationbundle lang="fil">
	<translation id="7386402409475121504">Create your local JemaOS account</translation>
	<translation id="3760308806144055927">Sign in your local JemaOS account</translation>
	<translation id="3325117507482096812">Please input a password</translation>
	<translation id="1838206877831947154">Your passwords do not match</translation>
	<translation id="2158276988029582286">Create a new local account</translation>
	<translation id="8592849747346274067">Sign in to an existing account</translation>
	<translation id="482190417986201746">The username or password you entered is incorrect</translation>
	<translation id="6603987686259425085">You can <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>sign in with a JemaOS local account<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Email <ph name="EMAIL_ADDRESS">$1</ph> already exists. Please retry with another email.</translation>
	<translation id="7215016743510876720">Use local account</translation>
	<translation id="6657635042185516718">Continue to use online account</translation>
	<translation id="6867476688065565618">Switch to local account?</translation>
	<translation id="4840454774882557974">If you opt to use a local account, useful features include synchronising your data and preferences across multiple devices and automatically signing in web apps using your JemaOS account will not work.</translation>
	<translation id="8951507920859729424">We recommend using an online account to utilise JemaOS to its fullest.</translation>
	<translation id="479773200536372215">You will not be able to add Google accounts because Google API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.</translation>
	<translation id="1198491307547164157">You will not be able to add JemaOS accounts because JemaOS API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.</translation>
	<translation id="5042404702659901995">Privacy statement</translation>
	<translation id="4907736162587268100">Privacy statement contents</translation>
	<translation id="5988344732274877691">Sign up for the (very infrequent, promised) newsletter for JemaOS</translation>
	<translation id="1706203008474708805">Join JemaOS user experience improvement plan</translation>
	<translation id="1147139514756087229">Sign in with a local account</translation>
	<translation id="2054784944085654098">Creating backup file now. This may take a while; please wait…</translation>
	<translation id="3554401467586751874">Backup file was created successfully</translation>
