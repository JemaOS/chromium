<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="hr">
	<translation id="7386402409475121504">Napravite svoj lokalni JemaOS račun</translation>
	<translation id="3760308806144055927">Prijavite se na svoj lokalni JemaOS račun</translation>
	<translation id="3325117507482096812">Molimo unesite lozinku</translation>
	<translation id="1838206877831947154">Vaše se lozinke ne podudaraju</translation>
	<translation id="2158276988029582286">Stvorite novi lokalni račun</translation>
	<translation id="8592849747346274067">Prijavite se na postojeći račun</translation>
	<translation id="482190417986201746">Korisničko ime ili lozinka koje ste unijeli nisu točni</translation>
	<translation id="6603987686259425085">Možete se <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>prijaviti JemaOS lokalnim računom<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-pošta <ph name="EMAIL_ADDRESS">$1</ph> već postoji. Pokušajte ponovno s drugom e-poštom.</translation>
	<translation id="7215016743510876720">Koristite lokalni račun</translation>
	<translation id="6657635042185516718">Nastavite koristiti online račun</translation>
	<translation id="6867476688065565618">Prebaciti se na lokalni račun?</translation>
	<translation id="4840454774882557974">Ako se odlučite za korištenje lokalnog računa, korisne značajke uključuju sinkronizaciju vaših podataka i postavki na više uređaja i automatsko prijavljivanje u web aplikacije pomoću vašeg JemaOS računa neće raditi.</translation>
	<translation id="8951507920859729424">Preporučamo korištenje mrežnog računa kako biste u potpunosti iskoristili JemaOS.</translation>
	<translation id="479773200536372215">Nećete moći dodati Google račune jer nedostaju Google API ključevi. Pogledajte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> za detalje.</translation>
	<translation id="1198491307547164157">Nećete moći dodati JemaOS račune jer nedostaju JemaOS API ključevi. Pogledajte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> za detalje.</translation>
	<translation id="5042404702659901995">Izjava o privatnosti</translation>
	<translation id="4907736162587268100">Sadržaj izjave o privatnosti</translation>
	<translation id="5988344732274877691">Prijavite se za (vrlo rijedak, obećan) bilten za JemaOS</translation>
	<translation id="1706203008474708805">Pridružite se JemaOS planu poboljšanja korisničkog iskustva</translation>
	<translation id="1147139514756087229">Prijavite se s lokalnim računom</translation>
	<translation id="2054784944085654098">Sada se stvara sigurnosna kopija datoteke. Ovo može potrajati; molim pričekajte…</translation>
	<translation id="3554401467586751874">Sigurnosna kopija je uspješno stvorena</translation>
	<translation id="2349211327705667074">Pogledajte datoteku sigurnosne kopije</translation>
	<translation id="3049367131589710124">Pogledajte zapisnik grešaka</translation>
	<translation id="1079017345574916945">Udaljena radna površina</translation>
	<translation id="3064478898280877715">Trgovina aplikacija</translation>
	<translation id="5890206344045530832">Instalater</translation>
	<translation id="2173278076276376488">Ovaj uslužni program pomoći će vam da instalirate <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na unutarnju pohranu ovog uređaja.</translation>
	<translation id="5323182426977498659">Upozorenje! Ovaj postupak je destruktivan i ne može se poništiti. Imajte na umu da nećemo snositi nikakvu odgovornost za vaš mogući gubitak podataka niti pružiti bilo kakvu hitnu tehničku podršku, nastavite na vlastitu odgovornost.</translation>
	<translation id="8517836015601969896">Instalacija na puni disk</translation>
	<translation id="7300045760790370189">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> da biste zauzeli cijeli tvrdi disk, svi podaci ciljnog tvrdog diska bit će izbrisani.</translation>
	<translation id="8762511733918256595">Multi-boot instalacija</translation>
	<translation id="248900698427753678">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na postojeću particiju tvrdog diska, gdje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> može postojati paralelno s drugim OS-om. Svi podaci na ciljnoj particiji bit će obrisani.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bit će instaliran na vašem odabranom tvrdom disku; svi podaci na ciljnom disku bit će izbrisani.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Nema dostupnog diska</translation>
	<translation id="8217653566575018388">Instalacija završena</translation>
	<translation id="8846746259444262774">Instalacija nije uspjela</translation>
	<translation id="7263815009235541549">Instalacija je uspješno završena. Prvo isključite svoj uređaj, zatim uklonite sve instalacijske medije i ponovno ga uključite da pokrenete <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, nešto nije u redu i instalacija nije dovršena. Molimo pokušajte ponovno. Ako se ista pogreška nastavi, obratite se JemaOS podršci s gornjim zapisnikom.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bit će instaliran na odabranoj particiji vašeg tvrdog diska. Pod trenutnom shemom višestrukog pokretanja, ovo se može nastaviti samo ako vaš uređaj podržava UEFI i vaši tvrdi diskovi su formatirani s GPT-om.</translation>
	<translation id="7831363758161884243">Ciljna particija bit će obrisana; također trebate navesti svoju aktivnu EFI particiju (obično se radi automatski) jer instalacijski program treba izmijeniti konfiguraciju pokretanja sustava.</translation>
	<translation id="5670799238446305550">Odaberite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ciljnu particiju</translation>
	<translation id="3695537760133394753">Pregrada</translation>
	<translation id="5610519566593708119">Odaberite EFI particiju</translation>
	<translation id="3367650349940010965">Nema dostupnih particija za odabrani disk</translation>
	<translation id="7453223384507098390">Nema dostupnih EFI particija za odabrani disk</translation>
	<translation id="1854532683465500847">Veličina odabrane particije manja je od 20 GB, instalacija možda neće uspjeti</translation>
	<translation id="4144613075340468247">Odabrana particija je montirana na <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> višestruko pokretanje, ponovna instalacija na nju možda neće uspjeti</translation>
	<translation id="5793361052649920836">Nakon instalacije, kako želite pokrenuti <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instalirajte i konfigurirajte rEFInd za mene (preporučeno)</translation>
	<translation id="1858708492548921044">rEFInd je program za upravljanje pokretanjem koji nudi lijepo grafičko sučelje za opcije pokretanja OS-a kada se vaše računalo pokrene, moći ćete odabrati željeni OS za pokretanje s njim. Za više informacija o rEFInd-u, pogledajte njegovu početnu stranicu.</translation>
	<translation id="3861924051442564602">Dodaj opciju UEFI izbornika za pokretanje za mene</translation>
	<translation id="8622370666798589804">Kada se vaše računalo pokrene, možda ćete moći ući u izbornik opcija pokretanja UEFI-ja (najvjerojatnije pritiskom na prečac), ova opcija dodaje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kao unos u taj izbornik. (Podržava samo neke modele BIOS-a i UEFI firmware-a).</translation>
	<translation id="1569398690544416170">Ne radi ništa ovdje, sam ću konfigurirati</translation>
	<translation id="3554866444001249532">Ova instalacijska skripta stavit će samo potrebne .efi datoteke za dizanje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na vašu EFI particiju, morat ćete konfigurirati kako da je sami pokrenete.</translation>
	<translation id="7492832751164189534">Prisilno odustati</translation>
	<translation id="5159534860632584026">Proces instalacije je prekinut</translation>
	<translation id="8686749782014838344">Dohvaćanje informacija o disku nije uspjelo</translation>
	<translation id="5688543378771259173">Instalacija se prekida...</translation>
	<translation id="5350452134936384991">Instalirajte u USB</translation>
	<translation id="8008470485414925603">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na USB disk; svi podaci na ciljanom USB disku bit će izbrisani.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bit će instaliran na vaš odabrani USB disk; svi podaci na ciljnom disku bit će izbrisani.</translation>
	<translation id="5725593226060700263">USB disk nije dostupan</translation>
	<translation id="4357040841587078287">Otkrili smo da izvodite ovu kopiju JemaOS-a iz preuzete slikovne datoteke. Za korištenje najsveobuhvatnijih značajki podrške (uključujući nadogradnje preko bežičnog prijenosa) koje JemaOS može ponuditi, toplo preporučamo da pokrenete funkciju "Instalater" kako biste izvršili instalaciju JemaOS-a na cijeli disk na poseban uređaj za pohranu.</translation>
	<translation id="1246398339704431302">Svejedno možete <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>nastaviti koristiti ovu kopiju JemaOS-a<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, postupak instalacije može se izvršiti u kasnijoj fazi sustava, međutim, svi vaši podaci bit će izbrisani nakon instalacije i počet ćete ispočetka s ove stranice.</translation>
	<translation id="3654532222088291133">Umjesto unosa zaporke vašeg JemaOS računa za prijavu, možete izraditi <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> lozinku za ovaj uređaj</translation>
	<translation id="8377684629839541977">Upotrijebite lozinku JemaOS računa</translation>

