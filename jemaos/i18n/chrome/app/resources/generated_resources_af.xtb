<translationbundle lang="af">
	<translation id="7386402409475121504">Skep jou plaaslike JemaOS-rekening</translation>
	<translation id="3760308806144055927">Meld aan by jou plaaslike JemaOS-rekening</translation>
	<translation id="3325117507482096812">Voer asseblief 'n wagwoord in</translation>
	<translation id="1838206877831947154">Jou wagwoorde stem nie ooreen nie</translation>
	<translation id="2158276988029582286">Skep 'n nuwe plaaslike rekening</translation>
	<translation id="8592849747346274067">Meld aan by 'n bestaande rekening</translation>
	<translation id="482190417986201746">Die gebruikersnaam of wagwoord wat jy ingevoer het, is verkeerd</translation>
	<translation id="6603987686259425085">Jy kan <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>aanmeld met 'n JemaOS plaaslike rekening<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-pos <ph name="EMAIL_ADDRESS">$1</ph> bestaan ​​reeds. Probeer asseblief weer met 'n ander e-pos.</translation>
	<translation id="7215016743510876720">Gebruik plaaslike rekening</translation>
	<translation id="6657635042185516718">Gaan voort om aanlyn rekening te gebruik</translation>
	<translation id="6867476688065565618">Skakel oor na plaaslike rekening?</translation>
	<translation id="4840454774882557974">As jy kies om 'n plaaslike rekening te gebruik, sluit nuttige kenmerke in om jou data en voorkeure oor verskeie toestelle te sinchroniseer en om outomaties aan te meld by webtoepassings met jou JemaOS-rekening sal nie werk nie.</translation>
	<translation id="8951507920859729424">Ons beveel aan om 'n aanlyn rekening te gebruik om JemaOS ten volle te gebruik.</translation>
	<translation id="479773200536372215">Jy sal nie Google-rekeninge kan byvoeg nie omdat Google API-sleutels ontbreek. Sien <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> vir besonderhede.</translation>
	<translation id="1198491307547164157">Jy sal nie JemaOS-rekeninge kan byvoeg nie omdat JemaOS API-sleutels ontbreek. Sien <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> vir besonderhede.</translation>
	<translation id="5042404702659901995">Privaatheidsverklaring</translation>
	<translation id="4907736162587268100">Privaatheidsverklaring inhoud</translation>
	<translation id="5988344732274877691">Teken in vir die (baie seldsame, beloofde) nuusbrief vir JemaOS</translation>
	<translation id="1706203008474708805">Sluit aan by JemaOS-gebruikerservaringverbeteringsplan</translation>
	<translation id="1147139514756087229">Meld aan met 'n plaaslike rekening</translation>
	<translation id="2054784944085654098">Skep tans rugsteunlêer. Dit kan 'n rukkie neem; wag asseblief...</translation>
	<translation id="3554401467586751874">Rugsteunlêer is suksesvol geskep</translation>
	<translation id="2349211327705667074">Bekyk rugsteunlêer</translation>
	<translation id="6337433855796857931">Rugsteun het misluk</translation>
	<translation id="3049367131589710124">Bekyk foutlogboek</translation>
	<translation id="1079017345574916945">Afgeleë lessenaar</translation>
	<translation id="3064478898280877715">Toepassingswinkel</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Installeerder</translation>
	<translation id="2173278076276376488">Hierdie nutsprogram sal jou help om <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> op die interne berging van hierdie toestel te installeer.</translation>
	<translation id="5323182426977498659">Waarskuwing! Hierdie prosedure is vernietigend en kan nie ongedaan gemaak word nie. Neem asseblief kennis dat ons geen verantwoordelikheid sal hou vir jou potensiële dataverlies nie en ook nie enige dringende tegniese ondersteuning sal verskaf nie, gaan voort op eie risiko.</translation>
	<translation id="8517836015601969896">Volledige skyfinstallasie</translation>
	<translation id="7300045760790370189">Installeer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> om 'n hele hardeskyf te beset, alle data van die teikenhardeskyf sal uitgevee word.</translation>
	<translation id="8762511733918256595">Multi-boot installasie</translation>
	<translation id="248900698427753678">Installeer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> op 'n bestaande partisie van 'n hardeskyf, waar <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> parallel met ander bedryfstelsels kan bestaan. Alle data op die teikenpartisie sal uitgevee word.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sal op jou geselekteerde hardeskyf geïnstalleer word; alle data op die teikenskyf sal uitgevee word.</translation>
	<translation id="4039091757234555415">Skyf</translation>
	<translation id="7783580523889684697">Geen skyf beskikbaar nie</translation>
	<translation id="8217653566575018388">Installasie voltooi</translation>
	<translation id="8846746259444262774">Installasie het misluk</translation>
	<translation id="7263815009235541549">Die installasie is suksesvol voltooi. Skakel asseblief eers jou toestel af, verwyder dan enige installasiemedia, en skakel dit weer aan om <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> te begin.</translation>
	<translation id="3380151284134965398">Oeps, iets het verkeerd geloop en die installasie het nie voltooi nie. Probeer asseblief die proses weer. As dieselfde fout voortduur, kontak asseblief JemaOS-ondersteuning met die bogenoemde logboek.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sal op die geselekteerde partisie van jou hardeskyf geïnstalleer word. Onder die huidige multi-boot-skema kan dit slegs voortgaan as jou toestel UEFI ondersteun en jou hardeskywe met GPT geformateer is.</translation>
	<translation id="7831363758161884243">Die teikenpartisie sal uitgevee word; jy moet ook jou aktiewe EFI-partisie spesifiseer (gewoonlik outomaties gedoen), aangesien die installeerder stelselselflaaikonfigurasies moet verander.</translation>
	<translation id="5670799238446305550">Kies <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> teikenpartisie</translation>
	<translation id="3695537760133394753">Afskorting</translation>
	<translation id="5610519566593708119">Kies EFI partisie</translation>
	<translation id="3367650349940010965">Daar is geen partisies beskikbaar vir die geselekteerde skyf nie</translation>
	<translation id="7453223384507098390">Daar is geen EFI partisies beskikbaar vir die geselekteerde skyf nie</translation>
	<translation id="1854532683465500847">Die grootte van die geselekteerde partisie is minder as 20 GB, installasie kan misluk</translation>
	<translation id="4144613075340468247">Die geselekteerde partisie is gemonteer op <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, installeer weer daarop kan dalk misluk</translation>
	<translation id="5793361052649920836">Na installasie, hoe wil jy <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> selflaai?</translation>
	<translation id="4273235330352963866">Installeer en konfigureer rEFInd vir my (aanbeveel)</translation>
	<translation id="1858708492548921044">rEFInd is 'n selflaaibestuurderprogram wat 'n mooi grafiese koppelvlak bied vir OS-opstartopsies wanneer jou rekenaar begin, sal jy jou verlangde bedryfstelsel kan kies om daarmee te begin. Vir meer inligting oor rEFInd, verwys asseblief na sy tuisblad.</translation>
	<translation id="3861924051442564602">Voeg 'n UEFI-opstartmenu-opsie vir my by</translation>
	<translation id="8622370666798589804">Wanneer jou rekenaar begin kan jy dalk die UEFI selflaai opsies kieslys binnegaan (heel waarskynlik deur 'n snelsleutel te druk), hierdie opsie voeg <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> as 'n inskrywing by daardie kieslys. (Ondersteun net sommige modelle van BIOS en UEFI-firmware).</translation>
	<translation id="1569398690544416170">Doen niks hier nie, ek sal dit self instel</translation>
	<translation id="3554866444001249532">Hierdie installasieskrip sal slegs die nodige .efi-lêers plaas vir die selflaai van <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na jou EFI-partisie, jy sal self moet konfigureer hoe om dit te selflaai.</translation>
	<translation id="7492832751164189534">Dwing om op te hou</translation>
	<translation id="5159534860632584026">Die installasieproses is beëindig</translation>
	<translation id="8686749782014838344">Kon nie skyfinligting kry nie</translation>
	<translation id="5688543378771259173">Die installasie word beëindig...</translation>
	<translation id="5350452134936384991">Installeer in USB</translation>
	<translation id="8008470485414925603">Installeer <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> op 'n USB-skyf; alle data op die teiken-USB-skyf sal uitgevee word.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sal op jou geselekteerde USB-skyf geïnstalleer word; alle data op die teikenskyf sal uitgevee word.</translation>
	<translation id="5725593226060700263">Geen USB-skyf beskikbaar nie</translation>
	<translation id="4357040841587078287">Ons het bespeur dat jy hierdie kopie van JemaOS vanaf 'n afgelaaide prentlêer laat loop. Om die mees omvattende ondersteuningskenmerke (insluitend oor-die-lug-opdaterings) wat JemaOS kan bied, te gebruik, beveel ons sterk aan dat jy die "Installeerder"-funksie begin om 'n volskyfinstallasie van JemaOS op 'n aparte stoortoestel uit te voer.</translation>
	<translation id="1246398339704431302">Jy kan <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>in elk geval voortgaan om hierdie kopie van JemaOS te gebruik<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, die installasieproses kan op 'n latere stadium in die stelsel uitgevoer word, al jou data sal egter weer van hierdie bladsy af uitgevee word en jy sal na die installasie begin.</translation>
	<translation id="3654532222088291133">In plaas daarvan om jou JemaOS-rekeningwagwoord in te voer om aan te meld, kan jy 'n <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph>-wagwoord vir hierdie toestel skep</translation>
	<translation id="8377684629839541977">Gebruik JemaOS-rekeningwagwoord</translation>

