<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="zu">
	<translation id="7386402409475121504">Dala i-akhawunti yakho yasendaweni ye-JemaOS</translation>
	<translation id="3760308806144055927">Ngena ngemvume ku-akhawunti yakho yasendaweni ye-JemaOS</translation>
	<translation id="3325117507482096812">Sicela ufake iphasiwedi</translation>
	<translation id="1838206877831947154">Amaphasiwedi akho awafani</translation>
	<translation id="2158276988029582286">Dala i-akhawunti yendawo entsha</translation>
	<translation id="8592849747346274067">Ngena ngemvume ku-akhawunti ekhona</translation>
	<translation id="482190417986201746">Igama lomsebenzisi noma iphasiwedi oyifakile ayilungile</translation>
	<translation id="6603987686259425085">Ungakwazi <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>ungene ngemvume nge-akhawunti yendawo ye-JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">I-imeyili <ph name="EMAIL_ADDRESS">$1</ph> isivele ikhona. Sicela uzame futhi ngenye i-imeyili.</translation>
	<translation id="7215016743510876720">Sebenzisa i-akhawunti yendawo</translation>
	<translation id="6657635042185516718">Qhubeka nokusebenzisa i-akhawunti eku-inthanethi</translation>
	<translation id="6867476688065565618">Shintshela ku-akhawunti yendawo?</translation>
	<translation id="4840454774882557974">Uma ukhetha ukusebenzisa i-akhawunti yasendaweni, izici eziwusizo zihlanganisa ukuvumelanisa idatha yakho nokuncamelayo kuwo wonke amadivayisi amaningi kanye nokungena ngokuzenzakalela kuzinhlelo zokusebenza zewebhu usebenzisa i-akhawunti yakho ye-JemaOS ngeke kusebenze.</translation>
	<translation id="8951507920859729424">Sincoma ukusebenzisa i-akhawunti eku-inthanethi ukusebenzisa i-JemaOS ngokugcwele.</translation>
	<translation id="479773200536372215">Ngeke ukwazi ukungeza ama-akhawunti e-Google ngoba okhiye be-Google API abekho. Bona i-<ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ukuze uthole imininingwane.</translation>
	<translation id="1198491307547164157">Ngeke ukwazi ukungeza ama-akhawunti e-JemaOS ngoba okhiye be-JemaOS API abekho. Bona i-<ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ukuze uthole imininingwane.</translation>
	<translation id="5042404702659901995">Isitatimende sobumfihlo</translation>
	<translation id="4907736162587268100">Okuqukethwe kwesitatimende sobumfihlo</translation>
	<translation id="5988344732274877691">Bhalisela i-newsletter (engavamile kakhulu, ethenjisiwe) ye-JemaOS</translation>
	<translation id="1706203008474708805">Joyina uhlelo lokuthuthukisa ulwazi lomsebenzisi lwe-JemaOS</translation>
	<translation id="1147139514756087229">Ngena ngemvume nge-akhawunti yendawo</translation>
	<translation id="2054784944085654098">Idala ifayela eliyisipele manje. Lokhu kungase kuthathe isikhashana; ngicela ulinde...</translation>
	<translation id="3554401467586751874">Ifayela eliyisipele lakhiwe ngempumelelo</translation>
	<translation id="2349211327705667074">Buka ifayela eliyisipele</translation>
	<translation id="6337433855796857931">Ukwenza isipele kuhlulekile</translation>
	<translation id="3049367131589710124">Buka ilogi yephutha</translation>
	<translation id="1079017345574916945">Ideskithophu yesilawuli kude</translation>
	<translation id="3064478898280877715">Isitolo sohlelo lokusebenza</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">Isifaki</translation>
	<translation id="2173278076276376488">Lolu hlelo lokusebenza luzokusiza ukuthi ufake i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kwisitoreji sangaphakathi sale divayisi.</translation>
	<translation id="5323182426977498659">Isexwayiso! Le nqubo iyingozi futhi ayikwazi ukuhlehliswa. Sicela wazi ukuthi ngeke sibe nesibopho ngokulahlekelwa kwakho kwedatha noma sikunikeze noma yiluphi usizo oluphuthumayo lwezobuchwepheshe, qhubeka ngokuzifaka wena engozini.</translation>
	<translation id="8517836015601969896">Ukufakwa kwediski ngokugcwele</translation>
	<translation id="7300045760790370189">Faka i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ukuze usebenzise yonke i-hard disk, yonke idatha ye-hard disk okuqondiwe izosulwa.</translation>
	<translation id="8762511733918256595">Ukufakwa kwamabhuthi amaningi</translation>
	<translation id="248900698427753678">Faka i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> engxenyeni ekhona ye-hard disk, lapho i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ingaba khona ngokufana nezinye i-OS. Yonke idatha ekuhlukaniseni okuqondiwe kuzosulwa.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> izofakwa kusigcinalwazi sakho esikhethiwe; yonke idatha kudiski okuqondiwe izosulwa.</translation>
	<translation id="4039091757234555415">Idiski</translation>
	<translation id="7783580523889684697">Alikho idiski elitholakalayo</translation>
	<translation id="8217653566575018388">Ukufaka kuqediwe</translation>
	<translation id="8846746259444262774">Ukufaka kuhlulekile</translation>
	<translation id="7263815009235541549">Ukufaka kuqede ngempumelelo. Sicela uvale idivayisi yakho kuqala, bese ususa noma iyiphi imidiya yokufaka, bese uyivula futhi ukuze uqalise i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Eshu, kukhona okungahambanga kahle futhi ukufakwa akuqedanga. Sicela uphinde uzame inqubo. Uma iphutha elifanayo liqhubeka, sicela ufinyelele Usekelo lwe-JemaOS ngelogi engenhla.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> izofakwa engxenyeni ekhethiwe yesigcinalwazi sakho. Ngaphansi kohlelo lwamanje lwama-boot amaningi, lokhu kungaqhubeka kuphela uma idivayisi yakho isekela i-UEFI futhi ama-hard disk akho afomethwe nge-GPT.</translation>
	<translation id="7831363758161884243">Ukwahlukanisa okuhlosiwe kuzosulwa; futhi udinga ukucacisa ukwahlukanisa kwakho kwe-EFI okusebenzayo (okuvame ukwenziwa ngokuzenzakalelayo) njengoba Isifaki sidinga ukuguqula izilungiselelo zokuqalisa isistimu.</translation>
	<translation id="5670799238446305550">Khetha <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ingxenye eqondiwe</translation>
	<translation id="3695537760133394753">Ukwahlukanisa</translation>
	<translation id="5610519566593708119">Khetha ukwahlukanisa kwe-EFI</translation>
	<translation id="3367650349940010965">Awekho ama-partitions atholakalayo kudiski ekhethiwe</translation>
	<translation id="7453223384507098390">Azikho izingxenye ze-EFI ezitholakalayo zediski ekhethiwe</translation>
	<translation id="1854532683465500847">Usayizi wengxenye ekhethiwe ungaphansi kuka-20GB, ukufakwa kungase kuhluleke</translation>
	<translation id="4144613075340468247">Ingxenye ekhethiwe ikhwezwe ku-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> i-multi-boot, ukufaka kuyo futhi kungase kwehluleke.</translation>
	<translation id="5793361052649920836">Ngemva kokufaka, ungathanda ukuyiqalisa kanjani i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Faka futhi ungilungisele i-reEFInd (kunconyiwe)</translation>
	<translation id="1858708492548921044">I-rEFInd iwuhlelo lwesiphathi sebhuthi olunikeza isikhombimsebenzisi esihle sokuqhafaza sezinketho zokuqalisa i-OS lapho i-PC yakho iqala, uzokwazi ukukhetha i-OS yakho oyithandayo ukuze uqalise ngayo. Ukuze uthole ulwazi olwengeziwe mayelana ne-reEFInd, sicela ubheke ikhasi layo eliyisiqalo.</translation>
	<translation id="3861924051442564602">Ngengezela inketho yemenyu yokuqalisa ye-UEFI</translation>
	<translation id="8622370666798589804">Uma i-PC yakho iqala ungase ukwazi ukufaka imenyu yezinketho zokuqalisa ze-UEFI (okungenzeka ngokucindezela i-hotkey), le nketho yengeza u-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> njengokungena kuleyo menyu. (Isekela kuphela amamodeli athile e-BIOS kanye ne-UEFI firmware).</translation>
	<translation id="1569398690544416170">Ungenzi lutho lapha, ngizoyilungiselela mina</translation>
	<translation id="3554866444001249532">Lesi skripthi sokufaka sizofaka kuphela amafayela e-efi adingekayo ukuze uqalise i-<ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ku-partition yakho ye-EFI, uzodinga ukulungisa ukuthi uyiqalisa kanjani uwedwa.</translation>
	<translation id="7492832751164189534">Phoqeleka ukuyeka</translation>
	<translation id="5159534860632584026">Inqubo yokufaka inqanyuliwe</translation>
	<translation id="8686749782014838344">Yehlulekile ukuthola ulwazi lwediski</translation>
	<translation id="5688543378771259173">Ukufakwa kuyanqanyulwa...</translation>
	<translation id="5350452134936384991">Faka ku-USB</translation>
	<translation id="8008470485414925603">Faka <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kudiski ye-USB; yonke idatha kudiski ye-USB eqondiwe izosulwa.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> izofakwa kudiski yakho ye-USB ekhethiwe; yonke idatha kudiski okuqondiwe izosulwa.</translation>
	<translation id="5725593226060700263">Alikho idiski le-USB elitholakalayo</translation>
	<translation id="4357040841587078287">Sithole ukuthi usebenzisa le khophi ye-JemaOS efayeleni lesithombe esilandiwe. Ukuze usebenzise izici eziphelele zosekelo (okuhlanganisa nezibuyekezo ze-Over-The-Air) ezinganikezwa yi-JemaOS, sincoma ngokuqinile ukuthi uqalise umsebenzi othi "Isifaki" ukuze ufake i-JemaOS ngediski egcwele kudivayisi ehlukile yokugcina.</translation>
	<translation id="1246398339704431302">Ungakwazi <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>ukuqhubeka nokusebenzisa le khophi ye-JemaOS noma kunjalo<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, inqubo yokufaka ingenziwa ngokuhamba kwesikhathi ohlelweni, nokho, yonke idatha yakho izosulwa ngemva kokufaka leli khasi futhi uzoqala futhi.</translation>
	<translation id="3654532222088291133">Esikhundleni sokufaka iphasiwedi ye-akhawunti yakho ye-JemaOS ukuze ungene ngemvume, ungakha <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> iphasiwedi yale divayisi.</translation>
	<translation id="8377684629839541977">Sebenzisa iphasiwedi ye-akhawunti ye-JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Gcina i-<ph name="DEVICE_OS" /> ibuyekezwa ngokuzenzakalelayo</translation>
<translation id="2347352406101856238">Isibuyekezo se-<ph name="DEVICE_OS" /> sinikwe amandla</translation>
<translation id="185834232609012804">Isibuyekezo se-<ph name="DEVICE_OS" /> sikhubazekile</translation>
<translation id="6224376838276776927">I-<ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Ipulatifomu <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Ideskithophu Ekude</translation>
<translation id="6898090158927982244">I-Linux yakho ibuyekeziwe</translation>
<translation id="4886703929102211360">Isibuyekezo esibalulekile siyatholakala sezingxenye ze-Linux (beta). Kunconywa kakhulu ukufaka lesi sibuyekezo ngokushesha okukhulu, kungenjalo i-Linux (beta) yakho ingase iyeki ukusebenza.</translation>
<translation id="6694016202036959050">Izilungiselelo ze-<ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">I-akhawunti ye-JemaOS, isipele, okuhlukahlukene</translation>
<translation id="9150429437595727962">Izilungiselelo ze-Wi-Fi</translation>
<translation id="4938972461544498524">Izilungiselelo zethatchiphedi</translation>
<translation id="1210024513248363065">Izinsizakalo zasendaweni ekude</translation>
<translation id="2878862288885588535">Insizakalo yokuxilonga yasendaweni ekude</translation>
<translation id="7409197984340676806">Insizakalo yokuxilonga yasendaweni ekude ivumela abameleli abasemthethweni base-JemaOS ukuthi bahlonze izinkinga zohlelo. Okwamanje, insizakalo yokuxilonga yasendaweni ekude ingaqalwa kuphela abameleli abasemthethweni base-JemaOS.</translation>
<translation id="1791028023086176332">Ngicela wabelane ngale nombolo nabameleli abasemthethweni base-JemaOS</translation>
<translation id="6279304275399437025">Qalisa insizakalo yokuxilonga yasendaweni ekude...</translation>
<translation id="1501882165699826662">Ngicela yeki insizakalo yokuxilonga yasendaweni ekude bese uzama futhi</translation>
<translation id="3100283258447375201">Ulwazi olwengeziwe</translation>
<translation id="4070039109671307724">Okuhlukahlukene</translation>
<translation id="7326893024940073254">Inkinobho ethi "Qala kabusha"</translation>
<translation id="3002423764319968103">Bonisa inkinobho ethi "Qala kabusha" kumenyu yohlelo</translation>
<translation id="6243454903512423518">Inkinobho ethi "Jika isikrini"</translation>
<translation id="6491049336868978729">Awukho kumodi yethebhulethi okwamanje, inkinobho ethi "Jika isikrini" ifihliwe</translation>
<translation id="5496012402277579695">Bonisa inkinobho ethi "Jika isikrini" kumenyu yohlelo</translation>
<translation id="5882838977344999606">Isishintshi semodi yethebhulethi/ilepthophu</translation>
<translation id="472164133625585606">Bonisa isishintshi semodi yethebhulethi/ilepthophu kumenyu yohlelo</translation>
<translation id="1851103550468466960">Nika amandla i-Widevine</translation>
<translation id="4058176713282795846">Nika amandla i-Widevine ukuze usakaze okuqukethwe okuvikelwe okuphakeme. <ph name="BEGIN_LINK_LEARN_MORE" />Funda kabanzi<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Khetha i-"libwidevine.so"</translation>
<translation id="4838463656205005584">Kwehlulekile ukunika amandla i-Widevine...</translation>
<translation id="2164041826798266548">Ukufakwa kwemojuli ye-Widevine CDM kwehlulekile. Ngicela uhlole ukuxhumeka kwakho bese uzama futhi.</translation>
<translation id="4106982328079440606">Izilungiselelo ze-akhawunti ye-JemaOS</translation>
<translation id="6468776556018764845">Izici zokuhlola</translation>
<translation id="3487615413425326553">Yeqa ukuhlolwa kwe-Trusted Platform Module (TPM)</translation>
<translation id="4817176087932811573">Ezinye izici zingase zehluleke ngenxa ye-chip ye-TPM engahambisani edivayisini yakho; ungayeqa ukuhlolwa kwe-TPM njengesixazululo esesikhashana.</translation>
<translation id="3356003366173774486">Ukungena ngokuzenzakalelayo</translation>
<translation id="6218459410891191693">Vumela le akhawunti ukuthi ingene ngokuzenzakalelayo kudeskhithophu lapho idivayisi iqala kabusha</translation>
<translation id="6620839363422062843">Ayikwazi ukunikwa amandla kwale akhawunti; ukungena ngokuzenzakalelayo sekuvele kusebenza kwabanye ama-akhawunti kule divayisi</translation>
<translation id="6734500226490446035">Ayikwazi ukunikwa amandla kwale akhawunti; kwenzeke iphutha elingaziwayo ngenkokuqala amasistimu amafayela ale akhawunti. Ngicela uzame ukuqala kabusha noma ukwenza i-akhawunti entsha</translation>
<translation id="5464880042146818691">Ayikwazi ukunikwa amandla kwale akhawunti; inketho yokungena ngokuzenzakalelayo itholakala kuphela ohlobeni oluthi "I-akhawunti yendawo".</translation>
<translation id="3335654854106476749">Ngicela wengeze iphasiwedi yokungena kwizilungiselelo ze<ph name="BEGIN_LINK" />Yimfihlo nokuphepha<ph name="END_LINK" /> ngaphambi kokunika amandla ukungena ngokuzenzakalelayo.</translation>
<translation id="5586831602198585601">Inguqulo entsha ye-JemaOS iyatholakala ukuze ibuyekezwe manje. Nokho, ubhaliso lwakho lwe-JemaOS for You seluphelelwe yisikhathi; udinga ubhaliso olusebenzayo ukuze ubuyekeze i-JemaOS yakho.</translation>
<translation id="3869860597719956574">Inguqulo entsha enkulu ye-JemaOS iyatholakala ukuze ibuyekezwe manje. Kufanele ukhokhe imali ekhokhwa kanye ukuze uqhubeke nalesi sibuyekezo.</translation>
<translation id="6523879681771260760">Ngicela ucacise indlela yokugcina ifayela lesipele</translation>
<translation id="2036152819788683293">Yenza ifayela lesipele kwale akhawunti (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Funda kabanzi<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Enza isipele</translation>
<translation id="4267347174163690295">Yenza ifayela lesipele kwale akhawunti (beta).</translation>
<translation id="8112950994208888917">Le nqubo idala isipele sediski esiphelele kwale akhawunti, okwenza kube lula ukubuyisela i-JemaOS yakho esimweni esayikuso lapho isipele sidalwa, kuhlanganise izilungiselelo, izandiso zesiphequluli ezifakiwe kanye nezinhlelo zohlelo olungaphansi. Kuye ngezinhlelo zakho kanye nokuqukethwe kwekhaya lakho, ifayela lesipele lingaba likhulu; kunconywa ukugcina ifayela lesipele kudivayisi yokugcina yangaphandle. Uma unayo i-USB drive ephathekayo, ngicela uxhume manje. <ph name="BEGIN_LINK_LEARN_MORE" />Funda kabanzi<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Ngicela ufake iphasiwedi yokungena kwale akhawunti</translation>
<translation id="8663988871299316062">Ngicela ukhumbule le phasiwedi, ngoba izodingeka lapho ubuyisela leli fayela lesipele</translation>
<translation id="6408904153044317846">Khetha ifayela lesipele ozolibuyisela</translation>
<translation id="8062988348127771021">Buyisela idatha ye-JemaOS yakho ivela kwifayela lesipele</translation>
<translation id="7309192418866543730">Faka iphasiwedi yesipele</translation>
<translation id="3642408376366598984">Faka iphasiwedi esetshenziselwa ukufihla leli fayela lesipele</translation>
<translation id="7783974937157985523">Iphasiwedi yesipele</translation>
<translation id="6583780301401541007">Ukubuyisela kuphumelele</translation>
<translation id="3514011352559420398">Ukubuyisela kwehlulekile</translation>
<translation id="7535980903266533458">Gcina isipele kudivayisi yakho noma kwindawo yokugcina yangaphandle</translation>
<translation id="604001903249547235">Isipele sefu</translation>
<translation id="8885702701336541611">Layisha isipele endaweni yokugcina yefu ye-JemaOS</translation>
<translation id="3939744430096549862">Enza isipele efini</translation>
<translation id="619129431573254316">Buyisela ivela kwifayela lesipele lendawo</translation>
<translation id="1859592711955106569">Ukubuyisela kwefu</translation>
<translation id="38222223336741457">Landa futhi ubuyisele ivela efini le-JemaOS</translation>
<translation id="1241089811244416179">Buyisela ivela efini</translation>
<translation id="652479689372703360">Isipele siyaqhubeka</translation>
<translation id="3655220146274872918">Isipele seqedile</translation>
<translation id="4243579853635792694">Isipele sakho sidalwe ngempumelelo</translation>
<translation id="4854179463174744546">Kwenzeke iphutha ngesikhathi senqubo yesipele</translation>
<translation id="2410668771600309999">Ulwazi lomsebenzisi lwe-Connect API</translation>
<translation id="2223892939866251845">I-ID yomsebenzisi</translation>
<translation id="3850846286480935456">Ukuhlaziywa kwesitoreji sesipele</translation>
<translation id="6244494465581273970">I-ID yomsebenzisi iyadingeka</translation>
<translation id="9204006549413740506">Igcine ukubuyekezwa</translation>
<translation id="476642412165431515">Amadivayisi e-hardware</translation>
<translation id="3386337985825120901">Ayikho idatha yesipele etholakalayo</translation>
<translation id="8490990067870590760">Ilayisha amafayela esipele...</translation>
<translation id="2955409026764742995">Khetha ifayela lesipele ozolibuyisela:</translation>
<translation id="7414629348005657242">-- Khetha ifayela lesipele --</translation>
<translation id="918246516374174381">Awekho amafayela esipele atholiwe. Ngicela udale isipele kuqala.</translation>
<translation id="77997252117517973">Iyeza maduze</translation>
<translation id="1930692852800776096">Yengeza isichazamazwi</translation>
<translation id="8793060353848771694">Isithombe se-earbud kwesobunxele</translation>
<translation id="6257440204887306255">Isithombe sekesi lokushaja</translation>
<translation id="2754700616124958693">Isithombe se-earbud kwesokudla</translation>
<translation id="1068676292264983586">Isithombe sedivayisi emisiwe</translation>
<translation id="6364075396486660405">Khubaza ukuhlelwa ngokuzenzakalelayo kwamafayela emedia kuzo zonke izinxenye ukuze kuthuthukiswe impilo yebhethri. <ph name="BEGIN_LINK_LEARN_MORE" />Funda kabanzi<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">Izinketho zokuphepha</translation>
<translation id="5618366106086725045">Nika amandla i-"Developer Mode" kule fakelwe ye-<ph name="IDS_SHORT_PRODUCT_OS_NAME" /> ngezici ezengeziwe zabathuthukisi. <ph name="BEGIN_LINK_LEARN_MORE" />Funda kabanzi<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">Usuvele ukhona ku-"Developer Mode"</translation>
<translation id="6074549317340202195">Nika amandla i-"Developer Mode"</translation>
<translation id="418781258674176053">Isexwayiso! Ukunika amandla i-"Developer Mode" yisinyathelo esingabuyiswa emuva. Uma ufuna ukukhubaza i-"Developer Mode", kufanele ufake kabusha i-JemaOS, okuzosula yonke idatha. Ngicela wenze isipele sedatha yakho futhi uqhubeke ngengcuphe yakho.</translation>
