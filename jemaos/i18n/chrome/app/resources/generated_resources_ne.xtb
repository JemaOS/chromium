<translationbundle lang="ne">
	<translation id="7386402409475121504">आफ्नो स्थानीय JemaOS खाता सिर्जना गर्नुहोस्</translation>
	<translation id="3760308806144055927">आफ्नो स्थानीय JemaOS खातामा साइन इन गर्नुहोस्</translation>
	<translation id="3325117507482096812">कृपया पासवर्ड प्रविष्ट गर्नुहोस्</translation>
	<translation id="1838206877831947154">तपाईंका पासवर्डहरू मेल खाँदैनन्</translation>
	<translation id="2158276988029582286">नयाँ स्थानीय खाता सिर्जना गर्नुहोस्</translation>
	<translation id="8592849747346274067">अवस्थित खातामा साइन इन गर्नुहोस्</translation>
	<translation id="482190417986201746">तपाईंले प्रविष्ट गर्नुभएको प्रयोगकर्ता नाम वा पासवर्ड गलत छ</translation>
	<translation id="6603987686259425085">तपाईं <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph> JemaOS स्थानीय खातासँग साइन इन गर्न सक्नुहुन्छ<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>।</translation>
	<translation id="3598802966230712759">इमेल <ph name="EMAIL_ADDRESS">$1</ph> पहिले नै अवस्थित छ। कृपया अर्को इमेल मार्फत पुन: प्रयास गर्नुहोस्।</translation>
	<translation id="7215016743510876720">स्थानीय खाता प्रयोग गर्नुहोस्</translation>
	<translation id="6657635042185516718">अनलाइन खाता प्रयोग गर्न जारी राख्नुहोस्</translation>
	<translation id="6867476688065565618">स्थानीय खातामा स्विच गर्ने हो?</translation>
	<translation id="4840454774882557974">यदि तपाइँ स्थानीय खाता प्रयोग गर्न रोज्नुहुन्छ भने, उपयोगी सुविधाहरूले धेरै यन्त्रहरूमा तपाइँको डेटा र प्राथमिकताहरू सिङ्क्रोनाइज गर्ने र तपाइँको JemaOS खाता प्रयोग गरेर वेब एपहरूमा स्वचालित रूपमा साइन इन गर्ने कार्य समावेश गर्दछ।</translation>
	<translation id="8951507920859729424">हामी JemaOS लाई पूर्ण रूपमा प्रयोग गर्न अनलाइन खाता प्रयोग गर्न सिफारिस गर्छौं।</translation>
	<translation id="479773200536372215">तपाईं Google खाताहरू थप्न सक्षम हुनुहुने छैन किनभने Google API कुञ्जीहरू हराइरहेका छन्। विवरणका लागि <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> हेर्नुहोस्।</translation>
	<translation id="1198491307547164157">तपाईं JemaOS खाताहरू थप्न सक्षम हुनुहुने छैन किनभने JemaOS API कुञ्जीहरू हराइरहेका छन्। विवरणका लागि <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> हेर्नुहोस्।</translation>
	<translation id="5042404702659901995">गोपनीयता कथन</translation>
	<translation id="4907736162587268100">गोपनीयता कथन सामग्री</translation>
	<translation id="5988344732274877691">JemaOS का लागि (धेरै दुर्लभ, प्रतिज्ञा गरिएको) न्यूजलेटरको लागि साइन अप गर्नुहोस्</translation>
	<translation id="1706203008474708805">JemaOS प्रयोगकर्ता अनुभव सुधार योजनामा सामेल हुनुहोस्</translation>
	<translation id="1147139514756087229">स्थानीय खाताको साथ साइन इन गर्नुहोस्</translation>
	<translation id="2054784944085654098">अहिले ब्याकअप फाइल सिर्जना गर्दै। यसले केही समय लिन सक्छ; कृपया प्रतीक्षा गर्नुहोस्…</translation>
	<translation id="3554401467586751874">ब्याकअप फाइल सफलतापूर्वक सिर्जना गरियो</translation>
	<translation id="2349211327705667074">ब्याकअप फाइल हेर्नुहोस्</translation>
	<translation id="6337433855796857931">ब्याकअप असफल भयो</translation>
	<translation id="3049367131589710124">त्रुटि लग हेर्नुहोस्</translation>
	<translation id="1079017345574916945">रिमोट डेस्कटप</translation>
	<translation id="3064478898280877715">एप स्टोर</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">स्थापनाकर्ता</translation>
	<translation id="2173278076276376488">यो उपयोगिताले तपाईंलाई यस यन्त्रको आन्तरिक भण्डारणमा <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापना गर्न मद्दत गर्नेछ।</translation>
	<translation id="5323182426977498659">चेतावनी! यो प्रक्रिया विनाशकारी छ र पूर्ववत गर्न सकिँदैन। कृपया ध्यान दिनुहोस् कि हामी तपाईंको सम्भावित डेटा हानिको लागि कुनै जिम्मेवारी लिने छैनौं वा कुनै पनि आवश्यक प्राविधिक समर्थन प्रदान गर्दैनौं, तपाईंको आफ्नै जोखिममा अगाडि बढ्नुहोस्।</translation>
	<translation id="8517836015601969896">पूर्ण डिस्क स्थापना</translation>
	<translation id="7300045760790370189">सम्पूर्ण हार्ड डिस्क ओगट्न <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> स्थापना गर्नुहोस्, लक्षित हार्ड डिस्कको सबै डाटा वाइप गरिनेछ।</translation>
	<translation id="8762511733918256595">बहु-बुट स्थापना</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> हार्ड डिस्कको अवस्थित विभाजनमा स्थापना गर्नुहोस्, जहाँ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> अन्य OS सँग समानान्तर रूपमा अवस्थित हुन सक्छ। लक्ष्य विभाजन मा सबै डाटा मेटाइनेछ।</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> तपाईँको चयन गरिएको हार्ड ड्राइभमा स्थापना हुनेछ; लक्ष्य डिस्क मा सबै डाटा मेटाइनेछ।</translation>
	<translation id="4039091757234555415">डिस्क</translation>
	<translation id="7783580523889684697">कुनै डिस्क उपलब्ध छैन</translation>
	<translation id="8217653566575018388">स्थापना सम्पन्न भयो</translation>
	<translation id="8846746259444262774">स्थापना असफल भयो</translation>
	<translation id="7263815009235541549">स्थापना सफलतापूर्वक समाप्त भएको छ। कृपया पहिले आफ्नो यन्त्रको पावर अफ गर्नुहोस्, त्यसपछि कुनै पनि स्थापना मिडिया हटाउनुहोस्, र <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> बुट गर्न यसलाई फेरि सक्रिय गर्नुहोस्।</translation>
	<translation id="3380151284134965398">हत्तेरिका, केहि गडबड भएको छ र स्थापना पूरा भएन। कृपया प्रक्रिया पुन: प्रयास गर्नुहोस्। यदि उही त्रुटि रहिरह्यो भने, कृपया माथिको लगसँग JemaOS समर्थनको लागि सम्पर्क गर्नुहोस्।</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> तपाईँको हार्ड ड्राइभको चयन गरिएको विभाजनमा स्थापना हुनेछ। हालको बहु-बुट योजना अन्तर्गत, यदि तपाईंको उपकरणले UEFI समर्थन गर्दछ र तपाईंको हार्ड डिस्कहरू GPT सँग ढाँचामा छन् भने मात्र यो अगाडि बढ्न सक्छ।</translation>
	<translation id="7831363758161884243">लक्ष्य विभाजन मेटाइनेछ; तपाईँले आफ्नो सक्रिय EFI विभाजन (सामान्यतया स्वचालित रूपमा गरिन्छ) निर्दिष्ट गर्न आवश्यक छ किनकि स्थापनाकर्ताले प्रणाली बुट कन्फिगरेसनहरू परिमार्जन गर्न आवश्यक छ।</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> लक्षित विभाजन चयन गर्नुहोस्</translation>
	<translation id="3695537760133394753">विभाजन</translation>
	<translation id="5610519566593708119">EFI विभाजन चयन गर्नुहोस्</translation>
	<translation id="3367650349940010965">चयन गरिएको डिस्कको लागि कुनै पनि विभाजन उपलब्ध छैन</translation>
	<translation id="7453223384507098390">चयन गरिएको डिस्कको लागि त्यहाँ कुनै EFI विभाजनहरू उपलब्ध छैनन्</translation>
	<translation id="1854532683465500847">चयन गरिएको विभाजनको आकार 20GB भन्दा कम छ, स्थापना असफल हुन सक्छ</translation>
	<translation id="4144613075340468247">चयन गरिएको विभाजनलाई <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> बहु-बुटमा माउन्ट गरिएको छ, यसलाई फेरि स्थापना गर्न असफल हुन सक्छ।</translation>
	<translation id="5793361052649920836">स्थापना पछि, तपाईं कसरी <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> बुट गर्न चाहनुहुन्छ?</translation>
	<translation id="4273235330352963866">मेरो लागि rEFInd स्थापना र कन्फिगर गर्नुहोस् (सिफारिस गरिएको)</translation>
	<translation id="1858708492548921044">rEFInd बुट प्रबन्धक कार्यक्रम हो जसले ओएस बुट विकल्पहरूको लागि राम्रो ग्राफिकल इन्टरफेस प्रदान गर्दछ जब तपाइँको पीसी सुरु हुन्छ, तपाइँ यसको साथ बुट गर्न तपाइँको मनपर्ने OS छनौट गर्न सक्षम हुनुहुनेछ। rEFInd को बारेमा थप जानकारीको लागि, कृपया यसको गृहपृष्ठलाई सन्दर्भ गर्नुहोस्।</translation>
	<translation id="3861924051442564602">मेरो लागि UEFI बुट मेनु विकल्प थप्नुहोस्</translation>
	<translation id="8622370666798589804">जब तपाइँको पीसी सुरु हुन्छ तपाइँ UEFI बुट विकल्प मेनुमा प्रवेश गर्न सक्षम हुन सक्नुहुन्छ (सम्भवतः हटकी थिचेर), यो विकल्पले <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> लाई त्यो मेनुमा प्रविष्टिको रूपमा थप्छ। (केवल BIOS र UEFI फर्मवेयर को केहि मोडेल समर्थन गर्दछ)।</translation>
	<translation id="1569398690544416170">यहाँ केहि नगर्नुहोस्, म आफैं कन्फिगर गर्नेछु</translation>
	<translation id="3554866444001249532">यो स्थापना स्क्रिप्टले तपाईको EFI विभाजनमा बुटिङका लागि आवश्यक .efi फाइलहरू मात्र राख्नेछ, तपाईले यसलाई कसरी बुट गर्ने भनेर कन्फिगर गर्न आवश्यक छ।</translation>
	<translation id="7492832751164189534">जबरजस्ती छोड्नुहोस्</translation>
	<translation id="5159534860632584026">स्थापना प्रक्रिया समाप्त भएको छ</translation>
	<translation id="8686749782014838344">डिस्क जानकारी प्राप्त गर्न असफल भयो</translation>
	<translation id="5688543378771259173">स्थापना समाप्त हुँदैछ ...</translation>
	<translation id="5350452134936384991">USB मा स्थापना गर्नुहोस्</translation>
	<translation id="8008470485414925603">स्थापना गर्नुहोस् <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> USB डिस्कमा; लक्षित USB डिस्कमा सबै डाटा मेटाइनेछ।</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> तपाईँको चयन गरिएको USB डिस्कमा स्थापना हुनेछ; लक्ष्य डिस्क मा सबै डाटा मेटाइनेछ।</translation>
	<translation id="5725593226060700263">कुनै USB डिस्क उपलब्ध छैन</translation>
	<translation id="4357040841587078287">हामीले पत्ता लगायौं कि तपाईंले डाउनलोड गरिएको छवि फाइलबाट JemaOS को यो प्रतिलिपि चलाइरहनुभएको छ। JemaOS ले प्रस्ताव गर्न सक्ने सबैभन्दा व्यापक समर्थन सुविधाहरू (ओभर-द-एयर अपडेटहरू सहित) को उपयोग गर्न, हामी तपाईंलाई एक छुट्टै भण्डारण उपकरणमा JemaOS को पूर्ण-डिस्क स्थापना गर्न "इन्स्टलर" प्रकार्य सुरु गर्न सिफारिस गर्छौं।</translation>
	<translation id="1246398339704431302">तपाईंले <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>जेमाओएसको यो प्रतिलिपि जसरी पनि प्रयोग गर्न जारी राख्न सक्नुहुन्छ<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, स्थापना प्रक्रिया प्रणालीमा पछिल्ला चरणमा कार्यान्वयन गर्न सकिन्छ, यद्यपि, स्थापना पछि तपाईंको सबै डेटा मेटाइनेछ र तपाईंले फेरि सुरु गर्नुहुनेछ।</translation>
	<translation id="3654532222088291133">साइन इन गर्न आफ्नो JemaOS खाता पासवर्ड प्रविष्ट गर्नुको सट्टा, तपाईंले यो यन्त्रको लागि <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> पासवर्ड सिर्जना गर्न सक्नुहुन्छ</translation>
	<translation id="8377684629839541977">JemaOS खाता पासवर्ड प्रयोग गर्नुहोस्</translation>

