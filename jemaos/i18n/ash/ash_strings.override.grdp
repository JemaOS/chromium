<?xml version="1.0" encoding="utf-8"?>
<grit-part>

  <if expr="openjema">
    <message name="IDS_GESTURE_NOTIFICATION_MESSAGE_LEARN_MORE" desc="The body of the notification to show off new gestures. This notification body links to the help page for the gestures.">
      Use gestures to quickly switch between apps and interact with your openJema device in tablet mode.
    </message>
  </if>
  <if expr="not openjema">
    <message name="IDS_GESTURE_NOTIFICATION_MESSAGE_LEARN_MORE" desc="The body of the notification to show off new gestures. This notification body links to the help page for the gestures.">
      Use gestures to quickly switch between apps and interact with your JemaOS device in tablet mode.
    </message>
  </if>
  <if expr="not _google_chrome">
    <if expr="openjema">
      <message name="IDS_ASH_MESSAGE_CENTER_SYSTEM_APP_NAME" desc="The source of a system-generated notification, as displayed to the user.">
        openJema
      </message>
    </if>
    <if expr="not openjema">
      <message name="IDS_ASH_MESSAGE_CENTER_SYSTEM_APP_NAME" desc="The source of a system-generated notification, as displayed to the user.">
        JemaOS
      </message>
    </if>
  </if>

  <message name="IDS_APP_LIST_START_ASSISTANT" desc="Tooltip for the button that starts JemaOS AI from the search box in the app list.">
    JemaOS AI
  </message>

  <if expr="openjema">
    <message name="IDS_ASH_STATUS_TRAY_CAST_ZERO_STATE_TITLE" desc="The main label for the system tray Cast view when no Chromecast devices are available.">
      Cast your screen from your openJema device
    </message>
    <message name="IDS_ASH_STATUS_TRAY_CAST_ZERO_STATE_SUBTITLE" desc="The secondary label for the system tray Cast view when no Chromecast devices are available.">
      Make sure your openJema device is on the same Wi-Fi network as your Chromecast device.
    </message>
    <message name="IDS_ASH_STATUS_TRAY_AUDIO_NBS_MESSAGE" desc="label used to warn that NBS is in use">
      Your openJema or Bluetooth device is using an older version of Bluetooth. Use the internal microphone for better audio quality.
    </message>
    <message name="IDS_ASH_BIRCH_RELEASE_NOTES_TITLE" desc="Title for the suggestion chip that links to release notes">
      openJema Updated
    </message>
    <message name="IDS_ASH_IN_SESSION_AUTH_SETTINGS_PROMPT" desc="Text shown in the settings auth dialog.">
      openJema Settings would like to confirm it's you
    </message>

    <message name="IDS_ASH_INFORMED_RESTORE_DIALOG_CRASH_DESCRIPTION" desc="Label of the description for the informed restore dialog, if the previous session ended with a crash. Gives a little more information than the title.">
      Your openJema restarted unexpectedly. Open your previous windows and apps.
    </message>
    <message name="IDS_ASH_INFORMED_RESTORE_DIALOG_UPDATE_DESCRIPTION" desc="Label of the description for the informed restore dialog, if the previous session was on a earlier version.">
      Your openJema has been updated. Open your previous windows and apps.
    </message>
  </if>
  <if expr="not openjema">
    <message name="IDS_ASH_STATUS_TRAY_CAST_ZERO_STATE_TITLE" desc="The main label for the system tray Cast view when no Chromecast devices are available.">
      Cast your screen from your JemaOS device
    </message>
    <message name="IDS_ASH_STATUS_TRAY_CAST_ZERO_STATE_SUBTITLE" desc="The secondary label for the system tray Cast view when no Chromecast devices are available.">
      Make sure your JemaOS device is on the same Wi-Fi network as your Chromecast device.
    </message>
    <message name="IDS_ASH_STATUS_TRAY_AUDIO_NBS_MESSAGE" desc="label used to warn that NBS is in use">
      Your JemaOS or Bluetooth device is using an older version of Bluetooth. Use the internal microphone for better audio quality.
    </message>
    <message name="IDS_ASH_BIRCH_RELEASE_NOTES_TITLE" desc="Title for the suggestion chip that links to release notes">
      JemaOS Updated
    </message>
    <message name="IDS_ASH_IN_SESSION_AUTH_SETTINGS_PROMPT" desc="Text shown in the settings auth dialog.">
      JemaOS Settings would like to confirm it's you
    </message>

    <message name="IDS_ASH_INFORMED_RESTORE_DIALOG_CRASH_DESCRIPTION" desc="Label of the description for the informed restore dialog, if the previous session ended with a crash. Gives a little more information than the title.">
      Your JemaOS restarted unexpectedly. Open your previous windows and apps.
    </message>
    <message name="IDS_ASH_INFORMED_RESTORE_DIALOG_UPDATE_DESCRIPTION" desc="Label of the description for the informed restore dialog, if the previous session was on a earlier version.">
      Your JemaOS has been updated. Open your previous windows and apps.
    </message>
  </if>

</grit-part>
