    <ph name="LINE_BREAK1" />
    தளம் <ph name="JEMAOS_PLATFORM_VERSION" />
    <ph name="LINE_BREAK2" />
    Chromium <ph name="PRODUCT_VERSION" /></translation>
<translation id="7938594894617528435">தற்போது ஆஃப்லைனில் உள்ளது</translation>
<translation id="2590678769628709242">உங்கள் JemaOS சந்தாவை ஆன்லைனில் சரிபார்க்கவும்</translation>
<translation id="4701836089682883918">JemaOS சந்தா தகவல்</translation>
<translation id="5891566673089952188">உங்கள் சாதன ID ஐப் பெறுவதில் பிழை ஏற்பட்டது</translation>
<translation id="4685086787606104322">சந்தா முடிவு</translation>
<translation id="3354919960795782984">சாதன ID</translation>
<translation id="5758632069869992306">உங்கள் சந்தாவை ஆன்லைனில் சரிபார்க்கவும்</translation>
<translation id="2664883181340330759"><ph name="DEVICE_OS" /> <ph name="DEVICE_VARIANT" />, <ph name="JEMAOS_MAJOR_VERSION" />, <ph name="JEMAOS_LICENSE_STATE_DESC" />
     <ph name="LINE_BREAK1" />
     தளம் <ph name="JEMAOS_PLATFORM_VERSION" />
     <ph name="LINE_BREAK2" />
