<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ru">
	<translation id="7386402409475121504">Создайте локальную учетную запись JemaOS.</translation>
	<translation id="3760308806144055927">Войдите в свою локальную учетную запись JemaOS.</translation>
	<translation id="3325117507482096812">Пожалуйста, введите пароль</translation>
	<translation id="1838206877831947154">Ваши пароли не совпадают</translation>
	<translation id="2158276988029582286">Создайте новую локальную учетную запись</translation>
	<translation id="8592849747346274067">Войдите в существующую учетную запись</translation>
	<translation id="482190417986201746">Введенное вами имя пользователя или пароль неверны</translation>
	<translation id="6603987686259425085">Вы можете <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>войти в систему с помощью локальной учетной записи JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Адрес электронной почты <ph name="EMAIL_ADDRESS">$1</ph> уже существует. Пожалуйста, повторите попытку с другим адресом электронной почты.</translation>
	<translation id="7215016743510876720">Использовать локальную учетную запись</translation>
	<translation id="6657635042185516718">Продолжать использовать онлайн-аккаунт</translation>
	<translation id="6867476688065565618">Переключиться на локальную учетную запись?</translation>
	<translation id="4840454774882557974">Если вы решите использовать локальную учетную запись, полезные функции включают синхронизацию ваших данных и настроек на нескольких устройствах, а автоматический вход в веб-приложения с использованием вашей учетной записи JemaOS не будет работать.</translation>
	<translation id="8951507920859729424">Мы рекомендуем использовать онлайн-учетную запись, чтобы использовать JemaOS в полной мере.</translation>
	<translation id="479773200536372215">Вы не сможете добавлять учетные записи Google, поскольку ключи API Google отсутствуют. Подробности см. на странице <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="1198491307547164157">Вы не сможете добавлять учетные записи JemaOS, поскольку ключи API JemaOS отсутствуют. Подробности см. на странице <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>.</translation>
	<translation id="5042404702659901995">Заявление о конфиденциальности</translation>
	<translation id="4907736162587268100">Содержание заявления о конфиденциальности</translation>
	<translation id="5988344732274877691">Подпишитесь на (очень редкую, обещанную) рассылку новостей о JemaOS.</translation>
	<translation id="1706203008474708805">Присоединяйтесь к плану улучшения пользовательского опыта JemaOS</translation>
	<translation id="1147139514756087229">Войдите с помощью локальной учетной записи</translation>
	<translation id="2054784944085654098">Создаю файл резервной копии сейчас. Это может занять некоторое время; пожалуйста, подождите…</translation>
	<translation id="3554401467586751874">Файл резервной копии успешно создан</translation>
	<translation id="2349211327705667074">Посмотреть файл резервной копии</translation>
	<translation id="3049367131589710124">Посмотреть журнал ошибок</translation>
	<translation id="1079017345574916945">Удаленный рабочий стол</translation>
	<translation id="3064478898280877715">Магазин приложений</translation>
	<translation id="5890206344045530832">Установщик</translation>
	<translation id="2173278076276376488">Эта утилита поможет вам установить <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> во внутреннюю память этого устройства.</translation>
	<translation id="5323182426977498659">Предупреждение! Эта процедура разрушительна и не может быть отменена. Обратите внимание, что мы не несем никакой ответственности за возможную потерю ваших данных и не предоставляем какую-либо срочную техническую поддержку. Действуйте на свой страх и риск.</translation>
	<translation id="8517836015601969896">Полная установка с диска</translation>
	<translation id="7300045760790370189">Установите <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, чтобы занять весь жесткий диск, все данные целевого жесткого диска будут удалены.</translation>
	<translation id="8762511733918256595">Мультизагрузочная установка</translation>
	<translation id="248900698427753678">Установите <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на существующий раздел жесткого диска, где <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> может существовать параллельно с другой ОС. Все данные в целевом разделе будут удалены.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будет установлен на выбранный вами жесткий диск; все данные на целевом диске будут удалены.</translation>
	<translation id="4039091757234555415">Диск</translation>
	<translation id="7783580523889684697">Нет доступного диска</translation>
	<translation id="8217653566575018388">Установка завершена</translation>
	<translation id="8846746259444262774">Установка не удалась</translation>
	<translation id="7263815009235541549">Установка завершилась успешно. Сначала выключите устройство, затем извлеките все установочные носители и снова включите его, чтобы загрузить <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">К сожалению, что-то пошло не так, и установка не завершилась. Пожалуйста, повторите процесс. Если та же ошибка не исчезнет, ​​обратитесь в службу поддержки JemaOS, используя приведенный выше журнал.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будет установлен на выбранный раздел вашего жесткого диска. В соответствии с текущей схемой мультизагрузки это может произойти только в том случае, если ваше устройство поддерживает UEFI и ваши жесткие диски отформатированы с использованием GPT.</translation>
	<translation id="7831363758161884243">Целевой раздел будет удален; вам также необходимо указать активный раздел EFI (обычно это делается автоматически), поскольку установщику необходимо изменить конфигурации загрузки системы.</translation>
	<translation id="5670799238446305550">Выберите целевой раздел <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3695537760133394753">Раздел</translation>
	<translation id="5610519566593708119">Выберите раздел EFI</translation>
	<translation id="3367650349940010965">На выбранном диске нет доступных разделов</translation>
	<translation id="7453223384507098390">Для выбранного диска нет доступных разделов EFI.</translation>
	<translation id="1854532683465500847">Размер выбранного раздела меньше 20 ГБ, установка может завершиться неудачно.</translation>
	<translation id="4144613075340468247">Выбранный раздел смонтирован в мультизагрузочную систему <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, повторная установка на него может завершиться неудачно.</translation>
	<translation id="5793361052649920836">Как бы вы хотели загрузить <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> после установки?</translation>
	<translation id="4273235330352963866">Установите и настройте rEFInd для меня (рекомендуется)</translation>
	<translation id="1858708492548921044">rEFInd — это программа-менеджер загрузки, которая предлагает удобный графический интерфейс для параметров загрузки ОС. При запуске вашего компьютера вы сможете выбрать желаемую ОС для загрузки с ней. Для получения дополнительной информации о rEFInd посетите его домашнюю страницу.</translation>
	<translation id="3861924051442564602">Добавьте мне опцию меню загрузки UEFI.</translation>
	<translation id="8622370666798589804">Когда ваш компьютер запускается, вы можете войти в меню параметров загрузки UEFI (скорее всего, нажав горячую клавишу), этот параметр добавляет <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> в качестве записи в это меню. (Поддерживается только некоторые модели прошивок BIOS и UEFI).</translation>
	<translation id="1569398690544416170">Ничего не делайте здесь, я настрою сам</translation>
	<translation id="3554866444001249532">Этот сценарий установки поместит в ваш раздел EFI только необходимые файлы .efi для загрузки <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, вам нужно будет настроить способ его загрузки самостоятельно.</translation>
	<translation id="7492832751164189534">Принудительно выйти</translation>
	<translation id="5159534860632584026">Процесс установки прерван</translation>
	<translation id="8686749782014838344">Не удалось получить информацию о диске</translation>
	<translation id="5688543378771259173">Установка прекращается...</translation>
	<translation id="5350452134936384991">Установить на USB</translation>
	<translation id="8008470485414925603">Установите <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на USB-диск; все данные на целевом USB-диске будут удалены.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> будет установлен на выбранный вами USB-диск; все данные на целевом диске будут удалены.</translation>
	<translation id="5725593226060700263">Нет USB-диска</translation>
	<translation id="4357040841587078287">Мы обнаружили, что вы используете эту копию JemaOS из загруженного файла образа. Чтобы использовать наиболее полные функции поддержки (включая обновления по беспроводной сети), которые может предложить JemaOS, мы настоятельно рекомендуем вам запустить функцию «Установщик», чтобы выполнить полную установку JemaOS на отдельное устройство хранения.</translation>
	<translation id="1246398339704431302">Вы можете <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>продолжать использовать эту копию JemaOS в любом случае<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, процесс установки можно выполнить на более позднем этапе в системе, однако все ваши данные будут удалены после установки, и вы начнете заново с этой страницы.</translation>
	<translation id="3654532222088291133">Вместо того, чтобы вводить пароль своей учетной записи JemaOS для входа, вы можете создать пароль <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> для этого устройства.</translation>
	<translation id="8377684629839541977">Используйте пароль учетной записи JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Автоматически поддерживать <ph name="DEVICE_OS" /> в актуальном состоянии</translation>
<translation id="2347352406101856238">Обновление <ph name="DEVICE_OS" /> включено</translation>
<translation id="185834232609012804">Обновление <ph name="DEVICE_OS" /> отключено</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Платформа <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Удалённый рабочий стол</translation>
<translation id="6898090158927982244">Ваша система Linux обновлена</translation>
<translation id="4886703929102211360">Доступно критическое обновление компонента Linux (beta). Настоятельно рекомендуется установить это обновление как можно скорее, иначе Linux (beta) может перестать работать.</translation>
<translation id="6694016202036959050">Настройки <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">Учётная запись JemaOS, резервное копирование, прочее</translation>
<translation id="9150429437595727962">Настройки Wi-Fi</translation>
<translation id="4938972461544498524">Настройки тачпада</translation>
<translation id="1210024513248363065">Удалённые службы</translation>
<translation id="2878862288885588535">Служба удалённой диагностики</translation>
<translation id="7409197984340676806">Служба удалённой диагностики позволяет официальным представителям службы поддержки JemaOS выявлять системные проблемы. В настоящее время службу удалённой диагностики могут запускать только официальные представители службы поддержки JemaOS.</translation>
<translation id="1791028023086176332">Поделитесь этим номером с официальными представителями службы поддержки JemaOS</translation>
<translation id="6279304275399437025">Запуск службы удалённой диагностики...</translation>
<translation id="1501882165699826662">Остановите службу удалённой диагностики и повторите попытку</translation>
<translation id="3100283258447375201">Дополнительная информация</translation>
<translation id="4070039109671307724">Прочее</translation>
<translation id="7326893024940073254">Кнопка «Перезапустить»</translation>
<translation id="3002423764319968103">Показывать кнопку «Перезапустить» в системном меню</translation>
<translation id="6243454903512423518">Кнопка «Повернуть экран»</translation>
<translation id="6491049336868978729">Вы сейчас не в режиме планшета, кнопка «Повернуть экран» скрыта</translation>
<translation id="5496012402277579695">Показывать кнопку «Повернуть экран» в системном меню</translation>
<translation id="5882838977344999606">Переключатель режима планшет/ноутбук</translation>
<translation id="472164133625585606">Показывать переключатель режима планшет/ноутбук в системном меню</translation>
<translation id="1851103550468466960">Включить Widevine</translation>
<translation id="4058176713282795846">Включите Widevine для потоковой передачи защищённого премиум-контента. <ph name="BEGIN_LINK_LEARN_MORE" />Подробнее<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Выберите «libwidevine.so»</translation>
<translation id="4838463656205005584">Не удалось включить Widevine...</translation>
<translation id="2164041826798266548">Не удалось установить модуль Widevine CDM. Проверьте подключение и повторите попытку.</translation>
<translation id="4106982328079440606">Настройки учётной записи JemaOS</translation>
<translation id="6468776556018764845">Экспериментальные функции</translation>
<translation id="3487615413425326553">Обойти проверки доверенного платформенного модуля (TPM)</translation>
<translation id="4817176087932811573">Некоторые функции могут не работать из-за несовместимого чипа TPM в вашем устройстве; в качестве обходного решения вы можете обойти проверки TPM.</translation>
<translation id="3356003366173774486">Автоматический вход</translation>
<translation id="6218459410891191693">Разрешить текущей учётной записи автоматически входить в систему при перезапуске устройства</translation>
<translation id="6620839363422062843">Невозможно включить для этой учётной записи; автоматический вход уже активен для других учётных записей на этом устройстве</translation>
<translation id="6734500226490446035">Невозможно включить для этой учётной записи; произошла неизвестная ошибка при инициализации файловых систем для этой учётной записи. Попробуйте перезапустить устройство или создать новую учётную запись</translation>
<translation id="5464880042146818691">Невозможно включить для этой учётной записи; опция автоматического входа доступна только для учётных записей типа «Локальная учётная запись».</translation>
<translation id="3335654854106476749">Перед включением автоматического входа добавьте пароль для входа в настройках <ph name="BEGIN_LINK" />Конфиденциальность и безопасность<ph name="END_LINK" />.</translation>
<translation id="5586831602198585601">Сейчас доступна новая версия JemaOS для обновления. Однако срок действия вашей подписки JemaOS for You истёк; для обновления JemaOS необходима активная подписка.</translation>
<translation id="3869860597719956574">Сейчас доступна новая основная версия JemaOS для обновления. Чтобы продолжить обновление, необходимо внести единовременную плату.</translation>
<translation id="6523879681771260760">Укажите путь для сохранения файла резервной копии</translation>
<translation id="2036152819788683293">Создать файл резервной копии для этой учётной записи (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Подробнее<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Создать резервную копию</translation>
<translation id="4267347174163690295">Создать файл резервной копии для этой учётной записи (beta).</translation>
<translation id="8112950994208888917">Эта операция создаёт полную резервную копию диска для этой учётной записи, что позволяет легко восстановить JemaOS до состояния на момент создания резервной копии, включая настройки, установленные расширения браузера и приложения подсистемы. В зависимости от ваших приложений и содержимого домашней папки файл резервной копии может быть большим; рекомендуется хранить файл резервной копии на внешнем запоминающем устройстве. Если у вас есть портативный USB-накопитель, подключите его сейчас. <ph name="BEGIN_LINK_LEARN_MORE" />Подробнее<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Введите пароль для входа в эту учётную запись</translation>
<translation id="8663988871299316062">Запомните этот пароль, так как он потребуется при восстановлении этого файла резервной копии</translation>
<translation id="6408904153044317846">Выберите файл резервной копии для восстановления</translation>
<translation id="8062988348127771021">Восстановить данные JemaOS из файла резервной копии</translation>
<translation id="7309192418866543730">Введите пароль резервной копии</translation>
<translation id="3642408376366598984">Введите пароль, использованный для шифрования этого файла резервной копии</translation>
<translation id="7783974937157985523">Пароль резервной копии</translation>
<translation id="6583780301401541007">Восстановление выполнено успешно</translation>
<translation id="3514011352559420398">Ошибка восстановления</translation>
<translation id="7535980903266533458">Сохранить резервную копию на устройстве или внешнем накопителе</translation>
<translation id="604001903249547235">Резервное копирование в облако</translation>
<translation id="8885702701336541611">Загрузить резервную копию в облачное хранилище JemaOS</translation>
<translation id="3939744430096549862">Создать резервную копию в облаке</translation>
<translation id="619129431573254316">Восстановить из локального файла резервной копии</translation>
<translation id="1859592711955106569">Восстановление из облака</translation>
<translation id="38222223336741457">Скачать и восстановить из облака JemaOS</translation>
<translation id="1241089811244416179">Восстановить из облака</translation>
<translation id="652479689372703360">Идёт создание резервной копии</translation>
<translation id="3655220146274872918">Резервное копирование завершено</translation>
<translation id="4243579853635792694">Резервная копия успешно создана</translation>
<translation id="6337433855796857931">Ошибка резервного копирования</translation>
<translation id="4854179463174744546">Во время резервного копирования произошла ошибка</translation>
<translation id="2410668771600309999">Информация о пользователе Connect API</translation>
<translation id="2223892939866251845">ID пользователя</translation>
<translation id="3850846286480935456">Анализ хранилища резервных копий</translation>
<translation id="6244494465581273970">Требуется ID пользователя</translation>
