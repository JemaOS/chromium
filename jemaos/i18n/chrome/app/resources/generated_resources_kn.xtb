<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="kn">
	<translation id="7386402409475121504">ನಿಮ್ಮ ಸ್ಥಳೀಯ JemaOS ಖಾತೆಯನ್ನು ರಚಿಸಿ</translation>
	<translation id="3760308806144055927">ನಿಮ್ಮ ಸ್ಥಳೀಯ JemaOS ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
	<translation id="3325117507482096812">ದಯವಿಟ್ಟು ಗುಪ್ತಪದವನ್ನು ನಮೂದಿಸಿ</translation>
	<translation id="1838206877831947154">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ</translation>
	<translation id="2158276988029582286">ಹೊಸ ಸ್ಥಳೀಯ ಖಾತೆಯನ್ನು ರಚಿಸಿ</translation>
	<translation id="8592849747346274067">ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
	<translation id="482190417986201746">ನೀವು ನಮೂದಿಸಿದ ಬಳಕೆದಾರಹೆಸರು ಅಥವಾ ಪಾಸ್‌ವರ್ಡ್ ತಪ್ಪಾಗಿದೆ</translation>
	<translation id="6603987686259425085">ನೀವು <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS ಸ್ಥಳೀಯ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">ಇಮೇಲ್ <ph name="EMAIL_ADDRESS">$1</ph> ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ. ದಯವಿಟ್ಟು ಇನ್ನೊಂದು ಇಮೇಲ್ ಮೂಲಕ ಮರುಪ್ರಯತ್ನಿಸಿ.</translation>
	<translation id="7215016743510876720">ಸ್ಥಳೀಯ ಖಾತೆಯನ್ನು ಬಳಸಿ</translation>
	<translation id="6657635042185516718">ಆನ್‌ಲೈನ್ ಖಾತೆಯನ್ನು ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಿ</translation>
	<translation id="6867476688065565618">ಸ್ಥಳೀಯ ಖಾತೆಗೆ ಬದಲಾಯಿಸುವುದೇ?</translation>
	<translation id="4840454774882557974">ನೀವು ಸ್ಥಳೀಯ ಖಾತೆಯನ್ನು ಬಳಸಲು ಆರಿಸಿಕೊಂಡರೆ, ಉಪಯುಕ್ತ ವೈಶಿಷ್ಟ್ಯಗಳು ಬಹು ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಡೇಟಾ ಮತ್ತು ಆದ್ಯತೆಗಳನ್ನು ಸಿಂಕ್ರೊನೈಸ್ ಮಾಡುವುದು ಮತ್ತು ನಿಮ್ಮ JemaOS ಖಾತೆಯನ್ನು ಬಳಸಿಕೊಂಡು ವೆಬ್ ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ಕಾರ್ಯನಿರ್ವಹಿಸುವುದಿಲ್ಲ.</translation>
	<translation id="8951507920859729424">JemaOS ಅನ್ನು ಪೂರ್ಣವಾಗಿ ಬಳಸಿಕೊಳ್ಳಲು ಆನ್‌ಲೈನ್ ಖಾತೆಯನ್ನು ಬಳಸಲು ನಾವು ಶಿಫಾರಸು ಮಾಡುತ್ತೇವೆ.</translation>
	<translation id="479773200536372215">Google API ಕೀಗಳು ಕಾಣೆಯಾಗಿರುವ ಕಾರಣ ನಿಮಗೆ Google ಖಾತೆಗಳನ್ನು ಸೇರಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ವಿವರಗಳಿಗಾಗಿ <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ಅನ್ನು ನೋಡಿ.</translation>
	<translation id="1198491307547164157">JemaOS API ಕೀಗಳು ಕಾಣೆಯಾಗಿರುವ ಕಾರಣ ನಿಮಗೆ JemaOS ಖಾತೆಗಳನ್ನು ಸೇರಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ವಿವರಗಳಿಗಾಗಿ <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ಅನ್ನು ನೋಡಿ.</translation>
	<translation id="5042404702659901995">ಗೌಪ್ಯತೆ ಹೇಳಿಕೆ</translation>
	<translation id="4907736162587268100">ಗೌಪ್ಯತೆ ಹೇಳಿಕೆ ವಿಷಯಗಳು</translation>
	<translation id="5988344732274877691">JemaOS ಗಾಗಿ (ಬಹಳ ಅಪರೂಪದ, ಭರವಸೆ) ಸುದ್ದಿಪತ್ರಕ್ಕಾಗಿ ಸೈನ್ ಅಪ್ ಮಾಡಿ</translation>
	<translation id="1706203008474708805">JemaOS ಬಳಕೆದಾರ ಅನುಭವ ಸುಧಾರಣೆ ಯೋಜನೆಗೆ ಸೇರಿ</translation>
	<translation id="1147139514756087229">ಸ್ಥಳೀಯ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
	<translation id="2054784944085654098">ಇದೀಗ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ರಚಿಸಲಾಗುತ್ತಿದೆ. ಇದು ಸ್ವಲ್ಪ ಸಮಯ ತೆಗೆದುಕೊಳ್ಳಬಹುದು; ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ…</translation>
	<translation id="3554401467586751874">ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಯಶಸ್ವಿಯಾಗಿ ರಚಿಸಲಾಗಿದೆ</translation>
	<translation id="2349211327705667074">ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ವೀಕ್ಷಿಸಿ</translation>
	<translation id="6337433855796857931">ಬ್ಯಾಕಪ್ ವಿಫಲವಾಗಿದೆ</translation>
	<translation id="3049367131589710124">ದೋಷ ಲಾಗ್ ಅನ್ನು ವೀಕ್ಷಿಸಿ</translation>
	<translation id="1079017345574916945">ರಿಮೋಟ್ ಡೆಸ್ಕ್ಟಾಪ್</translation>
	<translation id="3064478898280877715">ಆಪ್ ಸ್ಟೋರ್</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">ಅನುಸ್ಥಾಪಕ</translation>
	<translation id="2173278076276376488">ಈ ಸಾಧನದ ಆಂತರಿಕ ಸಂಗ್ರಹಣೆಯಲ್ಲಿ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಸ್ಥಾಪಿಸಲು ಈ ಉಪಯುಕ್ತತೆಯು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ.</translation>
	<translation id="5323182426977498659">ಎಚ್ಚರಿಕೆ! ಈ ವಿಧಾನವು ವಿನಾಶಕಾರಿಯಾಗಿದೆ ಮತ್ತು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಸಂಭಾವ್ಯ ಡೇಟಾ ನಷ್ಟಕ್ಕೆ ನಾವು ಯಾವುದೇ ಜವಾಬ್ದಾರಿಯನ್ನು ಹೊಂದಿರುವುದಿಲ್ಲ ಅಥವಾ ಯಾವುದೇ ತುರ್ತು ತಾಂತ್ರಿಕ ಬೆಂಬಲವನ್ನು ಒದಗಿಸುವುದಿಲ್ಲ ಎಂಬುದನ್ನು ದಯವಿಟ್ಟು ಗಮನಿಸಿ, ನಿಮ್ಮ ಸ್ವಂತ ಜವಾಬ್ದಾರಿಯಲ್ಲಿ ಮುಂದುವರಿಯಿರಿ.</translation>
	<translation id="8517836015601969896">ಪೂರ್ಣ ಡಿಸ್ಕ್ ಸ್ಥಾಪನೆ</translation>
	<translation id="7300045760790370189">ಸಂಪೂರ್ಣ ಹಾರ್ಡ್ ಡಿಸ್ಕ್ ಅನ್ನು ಆಕ್ರಮಿಸಲು <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಸ್ಥಾಪಿಸಿ, ಗುರಿ ಹಾರ್ಡ್ ಡಿಸ್ಕ್‌ನ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="8762511733918256595">ಬಹು-ಬೂಟ್ ಸ್ಥಾಪನೆ</translation>
	<translation id="248900698427753678">ಹಾರ್ಡ್ ಡಿಸ್ಕ್‌ನ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ವಿಭಾಗಕ್ಕೆ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಸ್ಥಾಪಿಸಿ, ಅಲ್ಲಿ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಇತರ OS ನೊಂದಿಗೆ ಸಮಾನಾಂತರವಾಗಿ ಅಸ್ತಿತ್ವದಲ್ಲಿರಬಹುದು. ಗುರಿ ವಿಭಾಗದ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ನಿಮ್ಮ ಆಯ್ಕೆಮಾಡಿದ ಹಾರ್ಡ್ ಡ್ರೈವ್‌ನಲ್ಲಿ ಸ್ಥಾಪಿಸಲಾಗುವುದು; ಗುರಿ ಡಿಸ್ಕ್‌ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="4039091757234555415">ಡಿಸ್ಕ್</translation>
	<translation id="7783580523889684697">ಯಾವುದೇ ಡಿಸ್ಕ್ ಲಭ್ಯವಿಲ್ಲ</translation>
	<translation id="8217653566575018388">ಅನುಸ್ಥಾಪನೆಯು ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
	<translation id="8846746259444262774">ಅನುಸ್ಥಾಪನೆಯು ವಿಫಲವಾಗಿದೆ</translation>
	<translation id="7263815009235541549">ಅನುಸ್ಥಾಪನೆಯು ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು ಮೊದಲು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಆಫ್ ಮಾಡಿ, ನಂತರ ಯಾವುದೇ ಅನುಸ್ಥಾಪನಾ ಮಾಧ್ಯಮವನ್ನು ತೆಗೆದುಹಾಕಿ ಮತ್ತು <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಬೂಟ್ ಮಾಡಲು ಅದನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡಿ.</translation>
	<translation id="3380151284134965398">ಓಹ್, ಏನೋ ತಪ್ಪಾಗಿದೆ ಮತ್ತು ಅನುಸ್ಥಾಪನೆಯು ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ದಯವಿಟ್ಟು ಪ್ರಕ್ರಿಯೆಯನ್ನು ಮರುಪ್ರಯತ್ನಿಸಿ. ಅದೇ ದೋಷವು ಮುಂದುವರಿದರೆ, ದಯವಿಟ್ಟು ಮೇಲಿನ ಲಾಗ್‌ನೊಂದಿಗೆ JemaOS ಬೆಂಬಲಕ್ಕಾಗಿ ಸಂಪರ್ಕಿಸಿ.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ನಿಮ್ಮ ಹಾರ್ಡ್ ಡ್ರೈವ್‌ನ ಆಯ್ಕೆಮಾಡಿದ ವಿಭಾಗದಲ್ಲಿ ಸ್ಥಾಪಿಸಲಾಗುತ್ತದೆ. ಪ್ರಸ್ತುತ ಮಲ್ಟಿ-ಬೂಟ್ ಸ್ಕೀಮ್ ಅಡಿಯಲ್ಲಿ, ನಿಮ್ಮ ಸಾಧನವು UEFI ಅನ್ನು ಬೆಂಬಲಿಸಿದರೆ ಮತ್ತು ನಿಮ್ಮ ಹಾರ್ಡ್ ಡಿಸ್ಕ್‌ಗಳನ್ನು GPT ಯೊಂದಿಗೆ ಫಾರ್ಮ್ಯಾಟ್ ಮಾಡಿದರೆ ಮಾತ್ರ ಇದು ಮುಂದುವರಿಯುತ್ತದೆ.</translation>
	<translation id="7831363758161884243">ಗುರಿ ವಿಭಾಗವನ್ನು ಅಳಿಸಿಹಾಕಲಾಗುತ್ತದೆ; ಅನುಸ್ಥಾಪಕವು ಸಿಸ್ಟಮ್ ಬೂಟ್ ಕಾನ್ಫಿಗರೇಶನ್‌ಗಳನ್ನು ಮಾರ್ಪಡಿಸುವ ಅಗತ್ಯವಿರುವುದರಿಂದ ನಿಮ್ಮ ಸಕ್ರಿಯ EFI ವಿಭಾಗವನ್ನು (ಸಾಮಾನ್ಯವಾಗಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮಾಡಲಾಗುತ್ತದೆ) ಸಹ ನೀವು ನಿರ್ದಿಷ್ಟಪಡಿಸಬೇಕಾಗಿದೆ.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಗುರಿ ವಿಭಾಗವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
	<translation id="3695537760133394753">ವಿಭಜನೆ</translation>
	<translation id="5610519566593708119">EFI ವಿಭಾಗವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
	<translation id="3367650349940010965">ಆಯ್ದ ಡಿಸ್ಕ್‌ಗೆ ಯಾವುದೇ ವಿಭಾಗಗಳು ಲಭ್ಯವಿಲ್ಲ</translation>
	<translation id="7453223384507098390">ಆಯ್ದ ಡಿಸ್ಕ್‌ಗೆ ಯಾವುದೇ EFI ವಿಭಾಗಗಳು ಲಭ್ಯವಿಲ್ಲ</translation>
	<translation id="1854532683465500847">ಆಯ್ಕೆಮಾಡಿದ ವಿಭಾಗದ ಗಾತ್ರವು 20GB ಗಿಂತ ಕಡಿಮೆಯಿದೆ, ಅನುಸ್ಥಾಪನೆಯು ವಿಫಲವಾಗಬಹುದು</translation>
	<translation id="4144613075340468247">ಆಯ್ಕೆಮಾಡಿದ ವಿಭಾಗವನ್ನು <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಮಲ್ಟಿ-ಬೂಟ್‌ಗೆ ಜೋಡಿಸಲಾಗಿದೆ, ಅದನ್ನು ಮತ್ತೆ ಸ್ಥಾಪಿಸುವುದು ವಿಫಲವಾಗಬಹುದು</translation>
	<translation id="5793361052649920836">ಅನುಸ್ಥಾಪನೆಯ ನಂತರ, ನೀವು <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಹೇಗೆ ಬೂಟ್ ಮಾಡಲು ಬಯಸುತ್ತೀರಿ?</translation>
	<translation id="4273235330352963866">ನನಗಾಗಿ rEFInd ಅನ್ನು ಸ್ಥಾಪಿಸಿ ಮತ್ತು ಕಾನ್ಫಿಗರ್ ಮಾಡಿ (ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ)</translation>
	<translation id="1858708492548921044">rEFInd ಎಂಬುದು ಬೂಟ್ ಮ್ಯಾನೇಜರ್ ಪ್ರೋಗ್ರಾಂ ಆಗಿದ್ದು ಅದು ನಿಮ್ಮ ಪಿಸಿ ಪ್ರಾರಂಭವಾದಾಗ OS ಬೂಟ್ ಆಯ್ಕೆಗಳಿಗಾಗಿ ಉತ್ತಮವಾದ ಚಿತ್ರಾತ್ಮಕ ಇಂಟರ್ಫೇಸ್ ಅನ್ನು ನೀಡುತ್ತದೆ, ಅದರೊಂದಿಗೆ ಬೂಟ್ ಮಾಡಲು ನೀವು ಬಯಸಿದ OS ಅನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ. rEFInd ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ, ದಯವಿಟ್ಟು ಅದರ ಮುಖಪುಟವನ್ನು ನೋಡಿ.</translation>
	<translation id="3861924051442564602">ನನಗಾಗಿ UEFI ಬೂಟ್ ಮೆನು ಆಯ್ಕೆಯನ್ನು ಸೇರಿಸಿ</translation>
	<translation id="8622370666798589804">ನಿಮ್ಮ PC ಪ್ರಾರಂಭವಾದಾಗ ನೀವು UEFI ಬೂಟ್ ಆಯ್ಕೆಗಳ ಮೆನುವನ್ನು ನಮೂದಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ (ಹೆಚ್ಚಾಗಿ ಹಾಟ್‌ಕೀ ಅನ್ನು ಒತ್ತುವ ಮೂಲಕ), ಈ ಆಯ್ಕೆಯು ಆ ಮೆನುಗೆ ಪ್ರವೇಶವಾಗಿ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಸೇರಿಸುತ್ತದೆ. (BIOS ಮತ್ತು UEFI ಫರ್ಮ್‌ವೇರ್‌ನ ಕೆಲವು ಮಾದರಿಗಳನ್ನು ಮಾತ್ರ ಬೆಂಬಲಿಸುತ್ತದೆ).</translation>
	<translation id="1569398690544416170">ಇಲ್ಲಿ ಏನನ್ನೂ ಮಾಡಬೇಡಿ, ನಾನೇ ಅದನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡುತ್ತೇನೆ</translation>
	<translation id="3554866444001249532">ಈ ಅನುಸ್ಥಾಪನಾ ಸ್ಕ್ರಿಪ್ಟ್ ನಿಮ್ಮ EFI ವಿಭಾಗಕ್ಕೆ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಬೂಟ್ ಮಾಡಲು ಅಗತ್ಯವಾದ .efi ಫೈಲ್‌ಗಳನ್ನು ಮಾತ್ರ ಇರಿಸುತ್ತದೆ, ಅದನ್ನು ನೀವೇ ಹೇಗೆ ಬೂಟ್ ಮಾಡಬೇಕೆಂದು ನೀವು ಕಾನ್ಫಿಗರ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ.</translation>
	<translation id="7492832751164189534">ಬಲವಂತವಾಗಿ ತ್ಯಜಿಸಿ</translation>
	<translation id="5159534860632584026">ಅನುಸ್ಥಾಪನಾ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗಿದೆ</translation>
	<translation id="8686749782014838344">ಡಿಸ್ಕ್ ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಲು ವಿಫಲವಾಗಿದೆ</translation>
	<translation id="5688543378771259173">ಅನುಸ್ಥಾಪನೆಯನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತಿದೆ...</translation>
	<translation id="5350452134936384991">USB ನಲ್ಲಿ ಸ್ಥಾಪಿಸಿ</translation>
	<translation id="8008470485414925603">USB ಡಿಸ್ಕ್‌ನಲ್ಲಿ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ಸ್ಥಾಪಿಸಿ; ಗುರಿ USB ಡಿಸ್ಕ್‌ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ಅನ್ನು ನಿಮ್ಮ ಆಯ್ಕೆಮಾಡಿದ USB ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಸ್ಥಾಪಿಸಲಾಗುವುದು; ಗುರಿ ಡಿಸ್ಕ್‌ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="5725593226060700263">ಯಾವುದೇ USB ಡಿಸ್ಕ್ ಲಭ್ಯವಿಲ್ಲ</translation>
	<translation id="4357040841587078287">ನೀವು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಇಮೇಜ್ ಫೈಲ್‌ನಿಂದ JemaOS ನ ಈ ನಕಲನ್ನು ಚಲಾಯಿಸುತ್ತಿರುವಿರಿ ಎಂದು ನಾವು ಪತ್ತೆಹಚ್ಚಿದ್ದೇವೆ. JemaOS ನೀಡಬಹುದಾದ ಅತ್ಯಂತ ವ್ಯಾಪಕವಾದ ಬೆಂಬಲ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು (ಓವರ್-ದಿ-ಏರ್ ಅಪ್‌ಡೇಟ್‌ಗಳು ಸೇರಿದಂತೆ) ಬಳಸಿಕೊಳ್ಳಲು, ಪ್ರತ್ಯೇಕ ಶೇಖರಣಾ ಸಾಧನಕ್ಕೆ JemaOS ನ ಪೂರ್ಣ-ಡಿಸ್ಕ್ ಸ್ಥಾಪನೆಯನ್ನು ನಿರ್ವಹಿಸಲು "Installer" ಕಾರ್ಯವನ್ನು ಪ್ರಾರಂಭಿಸಲು ನಾವು ಬಲವಾಗಿ ಶಿಫಾರಸು ಮಾಡುತ್ತೇವೆ.</translation>
	<translation id="1246398339704431302">ನೀವು <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>ಹೇಗಾದರೂ JemaOS ನ ಈ ನಕಲನ್ನು ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಬಹುದು<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, ಸಿಸ್ಟಮ್‌ನಲ್ಲಿ ಅನುಸ್ಥಾಪನಾ ಪ್ರಕ್ರಿಯೆಯನ್ನು ನಂತರದ ಹಂತದಲ್ಲಿ ಕಾರ್ಯಗತಗೊಳಿಸಬಹುದು, ಆದಾಗ್ಯೂ, ನಿಮ್ಮ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅನುಸ್ಥಾಪನೆಯ ನಂತರ ಮತ್ತೆ ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
	<translation id="3654532222088291133">ಸೈನ್ ಇನ್ ಮಾಡಲು ನಿಮ್ಮ JemaOS ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸುವ ಬದಲು, ನೀವು ಈ ಸಾಧನಕ್ಕಾಗಿ <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ರಚಿಸಬಹುದು</translation>
	<translation id="8377684629839541977">JemaOS ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" /> ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕೃತವಾಗಿರಿಸಿ</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> ನವೀಕರಣ ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> ನವೀಕರಣ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">ರಿಮೋಟ್ ಡೆಸ್ಕ್‌ಟಾಪ್</translation>
<translation id="6898090158927982244">ನಿಮ್ಮ Linux ನವೀಕೃತವಾಗಿದೆ</translation>
<translation id="4886703929102211360">Linux (ಬೀಟಾ) ಘಟಕಕ್ಕೆ ಒಂದು ನಿರ್ಣಾಯಕ ನವೀಕರಣ ಲಭ್ಯವಿದೆ. ಈ ನವೀಕರಣವನ್ನು ಸಾಧ್ಯವಾದಷ್ಟು ಬೇಗ ಸ್ಥಾಪಿಸಲು ಖಂಡಿತವಾಗಿಯೂ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ, ಇಲ್ಲದಿದ್ದರೆ ನಿಮ್ಮ Linux (ಬೀಟಾ) ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಬಹುದು.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="8362858344151826493">JemaOS ಖಾತೆ, ಬ್ಯಾಕಪ್, ಇತರೆ</translation>
<translation id="9150429437595727962">Wi-Fi ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="4938972461544498524">ಟಚ್‌ಪ್ಯಾಡ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="1210024513248363065">ರಿಮೋಟ್ ಸೇವೆಗಳು</translation>
<translation id="2878862288885588535">ರಿಮೋಟ್ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೇವೆ</translation>
<translation id="7409197984340676806">ರಿಮೋಟ್ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೇವೆಯು ಅಧಿಕೃತ JemaOS ಬೆಂಬಲ ಪ್ರತಿನಿಧಿಗಳು ಸಿಸ್ಟಂ ಸಮಸ್ಯೆಗಳನ್ನು ಗುರುತಿಸಲು ಅನುಮತಿಸುತ್ತದೆ. ಪ್ರಸ್ತುತ, ರಿಮೋಟ್ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೇವೆಯನ್ನು ಅಧಿಕೃತ JemaOS ಬೆಂಬಲ ಪ್ರತಿನಿಧಿಗಳು ಮಾತ್ರ ಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="1791028023086176332">ದಯವಿಟ್ಟು ಈ ಸಂಖ್ಯೆಯನ್ನು ಅಧಿಕೃತ JemaOS ಬೆಂಬಲ ಪ್ರತಿನಿಧಿಗಳೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="6279304275399437025">ರಿಮೋಟ್ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೇವೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="1501882165699826662">ದಯವಿಟ್ಟು ರಿಮೋಟ್ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೇವೆಯನ್ನು ನಿಲ್ಲಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="3100283258447375201">ಹೆಚ್ಚಿನ ಮಾಹಿತಿ</translation>
<translation id="4070039109671307724">ಇತರೆ</translation>
<translation id="7326893024940073254">"ಮರುಪ್ರಾರಂಭಿಸಿ" ಬಟನ್</translation>
<translation id="3002423764319968103">ಸಿಸ್ಟಂ ಮೆನುವಿನಲ್ಲಿ "ಮರುಪ್ರಾರಂಭಿಸಿ" ಬಟನ್ ತೋರಿಸಿ</translation>
<translation id="6243454903512423518">"ಪರದೆ ತಿರುಗಿಸಿ" ಬಟನ್</translation>
<translation id="6491049336868978729">ನೀವು ಈಗ ಟ್ಯಾಬ್ಲೆಟ್ ಮೋಡ್‌ನಲ್ಲಿ ಇಲ್ಲ, "ಪರದೆ ತಿರುಗಿಸಿ" ಬಟನ್ ಮರೆಮಾಡಲಾಗಿದೆ</translation>
<translation id="5496012402277579695">ಸಿಸ್ಟಂ ಮೆನುವಿನಲ್ಲಿ "ಪರದೆ ತಿರುಗಿಸಿ" ಬಟನ್ ತೋರಿಸಿ</translation>
<translation id="5882838977344999606">ಟ್ಯಾಬ್ಲೆಟ್/ಲ್ಯಾಪ್‌ಟಾಪ್ ಮೋಡ್ ಸ್ವಿಚ್</translation>
<translation id="472164133625585606">ಸಿಸ್ಟಂ ಮೆನುವಿನಲ್ಲಿ ಟ್ಯಾಬ್ಲೆಟ್/ಲ್ಯಾಪ್‌ಟಾಪ್ ಮೋಡ್ ಸ್ವಿಚ್ ತೋರಿಸಿ</translation>
<translation id="1851103550468466960">Widevine ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="4058176713282795846">ರಕ್ಷಿತ ಪ್ರೀಮಿಯಂ ವಿಷಯವನ್ನು ಸ್ಟ್ರೀಮ್ ಮಾಡಲು Widevine ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ. <ph name="BEGIN_LINK_LEARN_MORE" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="4838463656205005584">Widevine ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು ವಿಫಲವಾಗಿದೆ...</translation>
<translation id="2164041826798266548">Widevine CDM ಮಾಡ್ಯೂಲ್ ಸ್ಥಾಪನೆ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="4106982328079440606">JemaOS ಖಾತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="6468776556018764845">ಪ್ರಾಯೋಗಿಕ ವೈಶಿಷ್ಟ್ಯಗಳು</translation>
<translation id="3487615413425326553">Trusted Platform Module (TPM) ಪರಿಶೀಲನೆಗಳನ್ನು ಬೈಪಾಸ್ ಮಾಡಿ</translation>
<translation id="4817176087932811573">ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿನ ಹೊಂದಾಣಿಕೆಯಾಗದ TPM ಚಿಪ್‌ನಿಂದ ಕೆಲವು ವೈಶಿಷ್ಟ್ಯಗಳು ವಿಫಲವಾಗಬಹುದು; ನೀವು ಪರಿಹಾರವಾಗಿ TPM ಪರಿಶೀಲನೆಗಳನ್ನು ಬೈಪಾಸ್ ಮಾಡಬಹುದು.</translation>
<translation id="3356003366173774486">ಸ್ವಯಂಚಾಲಿತ ಸೈನ್-ಇನ್</translation>
<translation id="6218459410891191693">ಸಾಧನವನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ಪ್ರಸ್ತುತ ಖಾತೆಯು ಡೆಸ್ಕ್‌ಟಾಪ್‌ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಆಗಲು ಅನುಮತಿಸಿ</translation>
<translation id="6620839363422062843">ಈ ಖಾತೆಗೆ ಸಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ; ಈ ಸಾಧನದಲ್ಲಿ ಇತರ ಖಾತೆಗಳಿಗೆ ಸ್ವಯಂಚಾಲಿತ ಸೈನ್-ಇನ್ ಈಗಾಗಲೇ ಸಕ್ರಿಯವಾಗಿದೆ</translation>
<translation id="6734500226490446035">ಈ ಖಾತೆಗೆ ಸಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ; ಈ ಖಾತೆಗೆ ಫೈಲ್ ಸಿಸ್ಟಮ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸುವಾಗ ಅಜ್ಞಾತ ದೋಷ ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು ಮರುಪ್ರಾರಂಭಿಸಲು ಅಥವಾ ಹೊಸ ಖಾತೆಯನ್ನು ರಚಿಸಲು ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="5464880042146818691">ಈ ಖಾತೆಗೆ ಸಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ; ಸ್ವಯಂಚಾಲಿತ ಸೈನ್-ಇನ್ ಆಯ್ಕೆಯು "ಸ್ಥಳೀಯ ಖಾತೆ" ಪ್ರಕಾರಕ್ಕೆ ಮಾತ್ರ ಲಭ್ಯವಿದೆ.</translation>
<translation id="3335654854106476749">ಸ್ವಯಂಚಾಲಿತ ಸೈನ್-ಇನ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವ ಮೊದಲು ದಯವಿಟ್ಟು <ph name="BEGIN_LINK" />ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ<ph name="END_LINK" /> ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸೈನ್-ಇನ್ ಪಾಸ್‌ವರ್ಡ್ ಸೇರಿಸಿ.</translation>
<translation id="5586831602198585601">JemaOS ನ ಹೊಸ ಆವೃತ್ತಿಯು ಈಗ ನವೀಕರಿಸಲು ಲಭ್ಯವಿದೆ. ಆದರೆ, ನಿಮ್ಮ JemaOS for You ಚಂದಾದಾರಿಕೆಯು ಮುಗಿದಿದೆ; ನಿಮ್ಮ JemaOS ಅನ್ನು ನವೀಕರಿಸಲು ನಿಮಗೆ ಸಕ್ರಿಯ ಚಂದಾದಾರಿಕೆ ಬೇಕು.</translation>
<translation id="3869860597719956574">JemaOS ನ ಹೊಸ ಪ್ರಮುಖ ಆವೃತ್ತಿಯು ಈಗ ನವೀಕರಿಸಲು ಲಭ್ಯವಿದೆ. ಈ ನವೀಕರಣದೊಂದಿಗೆ ಮುಂದುವರಿಯಲು ನೀವು ಏಕಕಾಲಿಕ ಶುಲ್ಕವನ್ನು ಪಾವತಿಸಬೇಕು.</translation>
<translation id="6523879681771260760">ದಯವಿಟ್ಟು ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಸಂಗ್ರಹಿಸಲು ಮಾರ್ಗವನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ</translation>
<translation id="2036152819788683293">ಈ ಖಾತೆಗೆ ಬ್ಯಾಕಪ್ ಫೈಲ್ ರಚಿಸಿ (ಬೀಟಾ). <ph name="BEGIN_LINK_LEARN_MORE" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">ಬ್ಯಾಕಪ್ ಮಾಡಿ</translation>
<translation id="4267347174163690295">ಈ ಖಾತೆಗೆ ಬ್ಯಾಕಪ್ ಫೈಲ್ ರಚಿಸಿ (ಬೀಟಾ).</translation>
<translation id="8112950994208888917">ಈ ಕಾರ್ಯವು ಈ ಖಾತೆಗೆ ಸಂಪೂರ್ಣ ಡಿಸ್ಕ್ ಬ್ಯಾಕಪ್ ಅನ್ನು ರಚಿಸುತ್ತದೆ, ಇದು ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಸ್ಥಾಪಿತ ಬ್ರೌಸರ್ ವಿಸ್ತರಣೆಗಳು ಮತ್ತು ಸಬ್‌ಸಿಸ್ಟಂ ಆ್ಯಪ್‌ಗಳು ಸೇರಿದಂತೆ ಬ್ಯಾಕಪ್ ರಚಿಸಿದಾಗಿದ್ದ ಸ್ಥಿತಿಗೆ ನಿಮ್ಮ JemaOS ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಸುಲಭವಾಗಿಸುತ್ತದೆ. ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಹೋಮ್ ಫೋಲ್ಡರ್‌ನ ವಿಷಯಗಳನ್ನು ಅವಲಂಬಿಸಿ ಬ್ಯಾಕಪ್ ಫೈಲ್ ದೊಡ್ಡದಾಗಿರಬಹುದು; ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಹೊರಗಿನ ಸಂಗ್ರಹಣಾ ಸಾಧನದಲ್ಲಿ ಸಂಗ್ರಹಿಸಲು ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮಲ್ಲಿ ಪೋರ್ಟಬಲ್ USB ಡ್ರೈವ್ ಇದ್ದರೆ, ದಯವಿಟ್ಟು ಈಗ ಸಂಪರ್ಕಿಸಿ. <ph name="BEGIN_LINK_LEARN_MORE" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">ದಯವಿಟ್ಟು ಈ ಖಾತೆಯ ಸೈನ್-ಇನ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="8663988871299316062">ದಯವಿಟ್ಟು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಿ, ಏಕೆಂದರೆ ಈ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಮರುಸ್ಥಾಪಿಸುವಾಗ ಅದು ಬೇಕಾಗುತ್ತದೆ</translation>
<translation id="6408904153044317846">ಮರುಸ್ಥಾಪಿಸಲು ಬ್ಯಾಕಪ್ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8062988348127771021">ಬ್ಯಾಕಪ್ ಫೈಲ್‌ನಿಂದ ನಿಮ್ಮ JemaOS ಡೇಟಾವನ್ನು ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="7309192418866543730">ಬ್ಯಾಕಪ್ ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ</translation>
<translation id="3642408376366598984">ಈ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲು ಬಳಸಿದ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="7783974937157985523">ಬ್ಯಾಕಪ್ ಪಾಸ್‌ವರ್ಡ್</translation>
<translation id="6583780301401541007">ಮರುಸ್ಥಾಪನೆ ಯಶಸ್ವಿಯಾಗಿದೆ</translation>
<translation id="3514011352559420398">ಮರುಸ್ಥಾಪನೆ ವಿಫಲವಾಗಿದೆ</translation>
<translation id="7535980903266533458">ಬ್ಯಾಕಪ್ ಅನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಅಥವಾ ಹೊರಗಿನ ಸಂಗ್ರಹಣೆಯಲ್ಲಿ ಉಳಿಸಿ</translation>
<translation id="604001903249547235">ಕ್ಲೌಡ್ ಬ್ಯಾಕಪ್</translation>
<translation id="8885702701336541611">ಬ್ಯಾಕಪ್ ಅನ್ನು JemaOS ಕ್ಲೌಡ್ ಸಂಗ್ರಹಣೆಗೆ ಅಪ್‌ಲೋಡ್ ಮಾಡಿ</translation>
<translation id="3939744430096549862">ಕ್ಲೌಡ್‌ಗೆ ಬ್ಯಾಕಪ್ ಮಾಡಿ</translation>
<translation id="619129431573254316">ಸ್ಥಳೀಯ ಬ್ಯಾಕಪ್ ಫೈಲ್‌ನಿಂದ ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="1859592711955106569">ಕ್ಲೌಡ್ ಮರುಸ್ಥಾಪನೆ</translation>
<translation id="38222223336741457">JemaOS ಕ್ಲೌಡ್‌ನಿಂದ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="1241089811244416179">ಕ್ಲೌಡ್‌ನಿಂದ ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="652479689372703360">ಬ್ಯಾಕಪ್ ಪ್ರಗತಿಯಲ್ಲಿದೆ</translation>
<translation id="3655220146274872918">ಬ್ಯಾಕಪ್ ಮುಗಿದಿದೆ</translation>
<translation id="4243579853635792694">ನಿಮ್ಮ ಬ್ಯಾಕಪ್ ಯಶಸ್ವಿಯಾಗಿ ರಚಿಸಲಾಗಿದೆ</translation>
<translation id="4854179463174744546">ಬ್ಯಾಕಪ್ ಪ್ರಕ್ರಿಯೆಯ ಸಮಯದಲ್ಲಿ ದೋಷ ಸಂಭವಿಸಿದೆ</translation>
<translation id="2410668771600309999">Connect API ಬಳಕೆದಾರ ಮಾಹಿತಿ</translation>
<translation id="2223892939866251845">ಬಳಕೆದಾರ ID</translation>
<translation id="3850846286480935456">ಬ್ಯಾಕಪ್ ಸಂಗ್ರಹಣೆ ವಿಶ್ಲೇಷಣೆ</translation>
<translation id="6244494465581273970">ಬಳಕೆದಾರ ID ಅಗತ್ಯವಿದೆ</translation>
<translation id="9204006549413740506">ಕೊನೆಯದಾಗಿ ನವೀಕರಿಸಲಾಗಿದೆ</translation>
<translation id="476642412165431515">ಹಾರ್ಡ್‌ವೇರ್ ಸಾಧನಗಳು</translation>
<translation id="3386337985825120901">ಯಾವುದೇ ಬ್ಯಾಕಪ್ ಡೇಟಾ ಲಭ್ಯವಿಲ್ಲ</translation>
<translation id="8490990067870590760">ಬ್ಯಾಕಪ್ ಫೈಲ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ...</translation>
<translation id="2955409026764742995">ಮರುಸ್ಥಾಪಿಸಲು ಬ್ಯಾಕಪ್ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ:</translation>
<translation id="7414629348005657242">-- ಬ್ಯಾಕಪ್ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ --</translation>
<translation id="918246516374174381">ಯಾವುದೇ ಬ್ಯಾಕಪ್ ಫೈಲ್‌ಗಳು ಕಂಡುಬಂದಿಲ್ಲ. ದಯವಿಟ್ಟು ಮೊದಲು ಬ್ಯಾಕಪ್ ರಚಿಸಿ.</translation>
<translation id="77997252117517973">ಶೀಘ್ರದಲ್ಲೇ ಬರಲಿದೆ</translation>
<translation id="1930692852800776096">ನಿಘಂಟನ್ನು ಸೇರಿಸಿ</translation>
<translation id="8793060353848771694">ಎಡ ಇಯರ್‌ಬಡ್ ಚಿತ್ರ</translation>
<translation id="6257440204887306255">ಚಾರ್ಜಿಂಗ್ ಕೇಸ್ ಚಿತ್ರ</translation>
<translation id="2754700616124958693">ಬಲ ಇಯರ್‌ಬಡ್ ಚಿತ್ರ</translation>
<translation id="1068676292264983586">ಡೀಫಾಲ್ಟ್ ಸಾಧನದ ಚಿತ್ರ</translation>
<translation id="6364075396486660405">ಬ್ಯಾಟರಿ ಆಯುಷ್ಯವನ್ನು ಸುಧಾರಿಸಲು ಎಲ್ಲಾ ವಿಭಜನೆಗಳ ಮೀಡಿಯಾ ಫೈಲ್‌ಗಳ ಸ್ವಯಂಚಾಲಿತ ಸ್ಕ್ಯಾನಿಂಗ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ. <ph name="BEGIN_LINK_LEARN_MORE" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">ಭದ್ರತಾ ಆಯ್ಕೆಗಳು</translation>
<translation id="5618366106086725045">ಹೆಚ್ಚಿನ ಡೆವಲಪರ್ ವೈಶಿಷ್ಟ್ಯಗಳೊಂದಿಗೆ ಈ <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> ಸ್ಥಾಪನೆಗೆ "ಡೆವಲಪರ್ ಮೋಡ್" ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ. <ph name="BEGIN_LINK_LEARN_MORE" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">ನೀವು ಈಗಾಗಲೇ "ಡೆವಲಪರ್ ಮೋಡ್"‌ನಲ್ಲಿ ಇದ್ದೀರಿ</translation>
<translation id="6074549317340202195">"ಡೆವಲಪರ್ ಮೋಡ್" ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="418781258674176053">ಎಚ್ಚರಿಕೆ! "ಡೆವಲಪರ್ ಮೋಡ್" ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು ಹಿಮ್ಮುಖಗೊಳಿಸಲಾಗದ ಕ್ರಿಯೆಯಾಗಿದೆ. ನೀವು "ಡೆವಲಪರ್ ಮೋಡ್" ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಬಯಸಿದರೆ, ನೀವು JemaOS ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಬೇಕು, ಅದು ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ ಸ್ವಂತ ಅಪಾಯದಲ್ಲಿ ಮುಂದುವರಿಯಿರಿ.</translation>
