<translation id="2164041826798266548">התקנת מודול Widevine CDM נכשלה. בדוק את החיבור ונסה שוב.</translation>
<translation id="4106982328079440606">הגדרות חשבון JemaOS</translation>
<translation id="6468776556018764845">תכונות ניסיוניות</translation>
<translation id="3487615413425326553">עקיפת בדיקות Trusted Platform Module (TPM)</translation>
<translation id="4817176087932811573">חלק מהתכונות עלולות להיכשל עקב שבב TPM לא תואם במכשיר שלך; ניתן לעקוף את בדיקות ה-TPM כפתרון זמני.</translation>
<translation id="3356003366173774486">כניסה אוטומטית</translation>
<translation id="6218459410891191693">אפשר לחשבון הנוכחי להיכנס אוטומטית לשולחן העבודה בעת הפעלה מחדש של המכשיר</translation>
<translation id="6620839363422062843">לא ניתן להפעיל עבור חשבון זה; כניסה אוטומטית כבר פעילה עבור חשבונות אחרים במכשיר זה</translation>
<translation id="6734500226490446035">לא ניתן להפעיל עבור חשבון זה; אירעה שגיאה לא ידועה בעת אתחול מערכות הקבצים עבור חשבון זה. נסה להפעיל מחדש או ליצור חשבון חדש</translation>
<translation id="5464880042146818691">לא ניתן להפעיל עבור חשבון זה; אפשרות הכניסה האוטומטית זמינה רק עבור סוג "חשבון מקומי".</translation>
<translation id="3335654854106476749">הוסף סיסמת כניסה בהגדרות <ph name="BEGIN_LINK" />פרטיות ואבטחה<ph name="END_LINK" /> לפני הפעלת הכניסה האוטומטית.</translation>
<translation id="5586831602198585601">גרסה חדשה יותר של JemaOS זמינה לעדכון כעת. עם זאת, מנוי JemaOS for You שלך פג תוקף; דרוש מנוי פעיל כדי לעדכן את JemaOS שלך.</translation>
<translation id="3869860597719956574">גרסה ראשית חדשה של JemaOS זמינה לעדכון כעת. עליך לשלם תשלום חד-פעמי כדי להמשיך בעדכון זה.</translation>
<translation id="6523879681771260760">ציין את הנתיב לשמירת קובץ הגיבוי</translation>
<translation id="2036152819788683293">צור קובץ גיבוי עבור חשבון זה (בטא). <ph name="BEGIN_LINK_LEARN_MORE" />מידע נוסף<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">גיבוי</translation>
<translation id="4267347174163690295">צור קובץ גיבוי עבור חשבון זה (בטא).</translation>
<translation id="8112950994208888917">פעולה זו יוצרת גיבוי דיסק מלא עבור חשבון זה, ומקלה על שחזור JemaOS למצב שבו היה בעת יצירת הגיבוי, כולל הגדרות, תוספי דפדפן מותקנים ואפליקציות מערכת משנה. בהתאם לאפליקציות שלך ולתוכן תיקיית הבית, קובץ הגיבוי עשוי להיות גדול; מומלץ לשמור את קובץ הגיבוי בהתקן אחסון חיצוני. אם יש לך כונן USB נייד, חבר אותו כעת. <ph name="BEGIN_LINK_LEARN_MORE" />מידע נוסף<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">הזן את סיסמת הכניסה עבור חשבון זה</translation>
<translation id="8663988871299316062">זכור סיסמה זו, מכיוון שהיא תידרש בעת שחזור קובץ גיבוי זה</translation>
