<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="my">
	<translation id="7386402409475121504">သင်၏ဒေသခံ JemaOS အကောင့်ကိုဖန်တီးပါ။</translation>
	<translation id="3760308806144055927">သင့်ပြည်တွင်းရှိ JemaOS အကောင့်ကို ဝင်ရောက်ပါ။</translation>
	<translation id="3325117507482096812">စကားဝှက်တစ်ခုထည့်ပါ။</translation>
	<translation id="1838206877831947154">သင့်စကားဝှက်များ မတိုက်ဆိုင်ပါ။</translation>
	<translation id="2158276988029582286">ဒေသတွင်း အကောင့်အသစ်တစ်ခု ဖန်တီးပါ။</translation>
	<translation id="8592849747346274067">ရှိပြီးသားအကောင့်သို့ အကောင့်ဝင်ပါ။</translation>
	<translation id="482190417986201746">သင်ထည့်သွင်းထားသော အသုံးပြုသူအမည် သို့မဟုတ် စကားဝှက်သည် မမှန်ကန်ပါ။</translation>
	<translation id="6603987686259425085">သင်သည် <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS ဒေသတွင်းအကောင့်<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph> ဖြင့် ဝင်ရောက်နိုင်သည်။</translation>
	<translation id="3598802966230712759">အီးမေးလ် <ph name="EMAIL_ADDRESS">$1</ph> ရှိနှင့်ပြီးဖြစ်သည်။ ကျေးဇူးပြု၍ အခြားအီးမေးလ်ဖြင့် ပြန်ကြိုးစားပါ။</translation>
	<translation id="7215016743510876720">ဒေသတွင်းအကောင့်ကိုသုံးပါ။</translation>
	<translation id="6657635042185516718">အွန်လိုင်းအကောင့်ကို ဆက်လက်အသုံးပြုပါ။</translation>
	<translation id="6867476688065565618">ဒေသတွင်းအကောင့်သို့ ပြောင်းမလား။</translation>
	<translation id="4840454774882557974">ပြည်တွင်းအကောင့်ကို အသုံးပြုရန် ရွေးချယ်ပါက၊ စက်ပစ္စည်းအများအပြားတွင် သင့်ဒေတာနှင့် စိတ်ကြိုက်များကို ထပ်တူပြုခြင်း အပါအဝင် အသုံးဝင်သောအင်္ဂါရပ်များသည် သင့် JemaOS အကောင့်ကို အသုံးပြု၍ ဝဘ်အက်ပ်များတွင် အလိုအလျောက် လက်မှတ်ထိုးဝင်ရောက်ခြင်း အလုပ်မလုပ်ပါ။</translation>
	<translation id="8951507920859729424">JemaOS ကို အပြည့်အဝအသုံးချရန် အွန်လိုင်းအကောင့်ကို အသုံးပြုရန် အကြံပြုအပ်ပါသည်။</translation>
	<translation id="479773200536372215">Google API ကီးများ ပျောက်ဆုံးနေသောကြောင့် သင်သည် Google အကောင့်များကို ထည့်သွင်းနိုင်မည်မဟုတ်ပေ။ အသေးစိတ်အတွက် <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ကို ကြည့်ပါ။</translation>
	<translation id="1198491307547164157">JemaOS API သော့များ ပျောက်ဆုံးနေသောကြောင့် သင်သည် JemaOS အကောင့်များကို ထည့်နိုင်မည် မဟုတ်ပါ။ အသေးစိတ်အတွက် <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> ကို ကြည့်ပါ။</translation>
	<translation id="5042404702659901995">ကိုယ်ရေးကိုယ်တာ ထုတ်ပြန်ချက်</translation>
	<translation id="4907736162587268100">ကိုယ်ရေးကိုယ်တာ ထုတ်ပြန်ချက် အကြောင်းအရာများ</translation>
	<translation id="5988344732274877691">JemaOS အတွက် (မကြာခဏဆိုသလို၊ ကတိပြုထားသော) သတင်းလွှာအတွက် စာရင်းသွင်းပါ။</translation>
	<translation id="1706203008474708805">JemaOS အသုံးပြုသူ အတွေ့အကြုံ မြှင့်တင်မှု အစီအစဉ်တွင် ပါဝင်ပါ။</translation>
	<translation id="1147139514756087229">ဒေသတွင်းအကောင့်တစ်ခုဖြင့် ဝင်ရောက်ပါ။</translation>
	<translation id="2054784944085654098">အရန်ဖိုင်ကို ယခုဖန်တီးနေသည်။ ၎င်းသည် ခဏကြာနိုင်သည်။ စောင့်ပါ…</translation>
	<translation id="3554401467586751874">အရန်ဖိုင်ကို အောင်မြင်စွာ ဖန်တီးပြီးပါပြီ။</translation>
	<translation id="2349211327705667074">အရန်ဖိုင်ကို ကြည့်ပါ။</translation>
	<translation id="6337433855796857931">အရန်သိမ်းခြင်း မအောင်မြင်ပါ။</translation>
	<translation id="3049367131589710124">အမှားမှတ်တမ်းကို ကြည့်ပါ။</translation>
	<translation id="1079017345574916945">အဝေးထိန်း ဒက်စ်တော့</translation>
	<translation id="3064478898280877715">အက်ပ်စတိုး</translation>
	<translation id="2747689477259164256">JemaOS AI</translation>
	<translation id="5890206344045530832">တပ်ဆင်သူ</translation>
	<translation id="2173278076276376488">ဤကိရိယာသည် သင့်အား ဤစက်ပစ္စည်း၏ အတွင်းသိုလှောင်မှုတွင် <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို ထည့်သွင်းရန် ကူညီပေးပါမည်။</translation>
	<translation id="5323182426977498659">သတိပေးချက် ဤလုပ်ငန်းစဉ်သည် အဖျက်သဘောဖြစ်ပြီး ပြန်ပြင်၍မရပါ။ သင်၏ ဖြစ်နိုင်ချေရှိသော ဒေတာ ဆုံးရှုံးမှုအတွက် ကျွန်ုပ်တို့တွင် မည်သည့်တာဝန်မှ ထမ်းဆောင်မည်မဟုတ်သလို အရေးပေါ်နည်းပညာဆိုင်ရာ ပံ့ပိုးကူညီမှုများကိုလည်း ပေးဆောင်မည်မဟုတ်ပါ၊ သင့်ကိုယ်ပိုင်စွန့်စားလုပ်ဆောင်ပါ။</translation>
	<translation id="8517836015601969896">အပြည့်အဝဒစ်တပ်ဆင်ခြင်း။</translation>
	<translation id="7300045760790370189">ဟာ့ဒ်ဒစ်တစ်ခုလုံးကို သိမ်းပိုက်ရန် <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို ထည့်သွင်းပါ၊ ပစ်မှတ် ဟာ့ဒ်ဒစ်၏ ဒေတာအားလုံးကို ဖျက်ပစ်ပါမည်။</translation>
	<translation id="8762511733918256595">Multi-boot တပ်ဆင်ခြင်း။</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> သည် အခြားသော OS နှင့်အပြိုင် တည်ရှိနိုင်သည့် ဟာ့ဒစ်တစ်ခု၏ ရှိပြီးသားအပိုင်းတစ်ခုသို့ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို ထည့်သွင်းပါ။ ပစ်မှတ်အခန်းကန့်ရှိ ဒေတာအားလုံးကို ဖျက်ပစ်ပါမည်။</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို သင်ရွေးချယ်ထားသော ဟာ့ဒ်ဒရိုက်ပေါ်တွင် ထည့်သွင်းသွားပါမည်။ ပစ်မှတ်ဒစ်ပေါ်ရှိ ဒေတာအားလုံးကို ဖျက်ပစ်ပါမည်။</translation>
	<translation id="4039091757234555415">ဒစ်</translation>
	<translation id="7783580523889684697">ဒစ်ခ် မရရှိနိုင်ပါ။</translation>
	<translation id="8217653566575018388">တပ်ဆင်မှု ပြီးသွားပါပြီ။</translation>
	<translation id="8846746259444262774">ထည့်သွင်းခြင်း မအောင်မြင်ပါ။</translation>
	<translation id="7263815009235541549">ထည့်သွင်းမှု အောင်မြင်စွာပြီးဆုံးသွားပါပြီ။ ကျေးဇူးပြု၍ သင့်စက်ပစ္စည်းကို ဦးစွာပါဝါပိတ်ပါ၊ ထို့နောက် မည်သည့်တပ်ဆင်မှုမီဒီယာကိုမဆို ဖယ်ရှားကာ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို စတင်ရန် ထပ်မံ၍ ပါဝါဖွင့်ပါ။</translation>
	<translation id="3380151284134965398">အိုး၊ တစ်ခုခု မှားသွားပြီး ထည့်သွင်းမှု မပြီးမြောက်ပါ။ လုပ်ငန်းစဉ်ကို ပြန်စမ်းကြည့်ပါ။ တူညီသောအမှားအယွင်းဆက်လက်ရှိနေပါက၊ အထက်ပါမှတ်တမ်းနှင့်အတူ JemaOS ပံ့ပိုးကူညီမှုအတွက် ဆက်သွယ်ပါ။</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို သင်၏ hard drive ၏ ရွေးချယ်ထားသော အခန်းကန့်တွင် ထည့်သွင်းသွားပါမည်။ လက်ရှိ Multi-boot စနစ်အောက်တွင် သင့်စက်ပစ္စည်းသည် UEFI ကို ပံ့ပိုးပေးပြီး သင့် hard disk များကို GPT ဖြင့် ဖော်မတ်လုပ်ထားမှသာ ၎င်းသည် ဆက်လက်လုပ်ဆောင်နိုင်မည်ဖြစ်သည်။</translation>
	<translation id="7831363758161884243">ပစ်မှတ်အခန်းကန့်ကို သုတ်သင်လိုက်ပါမည်။ Installer သည် system boot configurations များကိုမွမ်းမံပြင်ဆင်ရန်လိုအပ်သောကြောင့် သင်၏တက်ကြွသော EFI partition (ပုံမှန်အားဖြင့်အလိုအလျောက်လုပ်ဆောင်သည်) ကိုသင်သတ်မှတ်ရန်လိုအပ်သည်။</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ပစ်မှတ်အပိုင်းကို ရွေးပါ။</translation>
	<translation id="3695537760133394753">အပိုင်းပိုင်း</translation>
	<translation id="5610519566593708119">EFI partition ကိုရွေးချယ်ပါ။</translation>
	<translation id="3367650349940010965">ရွေးချယ်ထားသော disk အတွက် အပိုင်းခွဲများ မရရှိနိုင်ပါ။</translation>
	<translation id="7453223384507098390">ရွေးချယ်ထားသောဒစ်အတွက် EFI အပိုင်းများမရရှိနိုင်ပါ။</translation>
	<translation id="1854532683465500847">ရွေးချယ်ထားသော အခန်းကန့်၏ အရွယ်အစားသည် 20GB ထက်နည်းသောကြောင့် တပ်ဆင်မှု မအောင်မြင်နိုင်ပါ။</translation>
	<translation id="4144613075340468247">ရွေးချယ်ထားသော အပိုင်းကို <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot တွင် တပ်ဆင်ထားပြီး၊ ၎င်းကို ထပ်မံထည့်သွင်းရန် မအောင်မြင်နိုင်ပါ။</translation>
	<translation id="5793361052649920836">ထည့်သွင်းပြီးနောက်၊ သင်သည် <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို မည်သို့စတင်လိုသနည်း။</translation>
	<translation id="4273235330352963866">ကျွန်ုပ်အတွက် rEFInd ကို ထည့်သွင်းပြီး စီစဉ်သတ်မှတ်ပါ (အကြံပြုထားသည်)</translation>
	<translation id="1858708492548921044">rEFInd သည် သင့် PC စတင်ချိန်တွင် OS boot options အတွက် ကောင်းမွန်သော ဂရပ်ဖစ် အင်တာဖေ့စ်ကို ပေးဆောင်သည့် boot manager ပရိုဂရမ်တစ်ခုဖြစ်ပြီး ၎င်းနှင့်အတူ သင်နှစ်သက်သော OS ကို ရွေးချယ်နိုင်မည်ဖြစ်သည်။ rEFInd နှင့်ပတ်သက်သော နောက်ထပ်အချက်အလက်များအတွက်၊ ၎င်း၏ပင်မစာမျက်နှာကို ကျေးဇူးပြု၍ ဖတ်ရှုပါ။</translation>
	<translation id="3861924051442564602">ကျွန်ုပ်အတွက် UEFI boot menu option ကိုထည့်ပါ။</translation>
	<translation id="8622370666798589804">သင့် PC စတင်သောအခါတွင် သင်သည် UEFI boot ရွေးချယ်စရာများ မီနူးကို ထည့်သွင်းနိုင်သည် (ဖြစ်နိုင်ချေ အများစုမှာ hotkey ကိုနှိပ်ခြင်းဖြင့်)၊ ဤရွေးချယ်မှုသည် <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို ထိုမီနူးသို့ ထည့်သွင်းမှုတစ်ခုအဖြစ် ပေါင်းထည့်ပါသည်။ (BIOS နှင့် UEFI firmware အချို့ကိုသာ ပံ့ပိုးသည်)။</translation>
	<translation id="1569398690544416170">ဒီမှာ ဘာမှမလုပ်ပါနဲ့၊ ငါကိုယ်တိုင် စီစဉ်ပေးမယ်။</translation>
	<translation id="3554866444001249532">ဤထည့်သွင်းမှု script သည် သင်၏ EFI အပိုင်းသို့ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို စတင်ရန်အတွက် လိုအပ်သော .efi ဖိုင်များကိုသာ ထည့်သွင်းပေးမည် ဖြစ်ပြီး ၎င်းကို သင်ကိုယ်တိုင် boot လုပ်နည်းကို ပြင်ဆင်ရန် လိုအပ်ပါသည်။</translation>
	<translation id="7492832751164189534">အတင်းထွက်</translation>
	<translation id="5159534860632584026">တပ်ဆင်ခြင်းလုပ်ငန်းစဉ်ကို ရပ်စဲလိုက်ပါပြီ။</translation>
	<translation id="8686749782014838344">ဒစ်ခ်အချက်အလက်ကို ရယူရန် မအောင်မြင်ပါ။</translation>
	<translation id="5688543378771259173">တပ်ဆင်ခြင်းအား ရပ်ဆိုင်းလိုက်သည်...</translation>
	<translation id="5350452134936384991">USB တွင် ထည့်သွင်းပါ။</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို USB ဒစ်ပေါ်တွင် ထည့်သွင်းပါ။ ပစ်မှတ် USB ဒစ်ခ်ပေါ်ရှိ ဒေတာအားလုံးကို ဖျက်ပစ်ပါမည်။</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ကို သင်ရွေးချယ်ထားသော USB ဒစ်ပေါ်တွင် ထည့်သွင်းပါမည်။ ပစ်မှတ်ဒစ်ပေါ်ရှိ ဒေတာအားလုံးကို ဖျက်ပစ်ပါမည်။</translation>
	<translation id="5725593226060700263">USB disk မရရှိနိုင်ပါ။</translation>
	<translation id="4357040841587078287">သင်သည် ဒေါင်းလုဒ်လုပ်ထားသော ပုံဖိုင်မှ JemaOS ၏ ဤမိတ္တူကို လုပ်ဆောင်နေကြောင်း ကျွန်ုပ်တို့ တွေ့ရှိထားပါသည်။ JemaOS ပေးဆောင်နိုင်သည့် အပြည့်စုံဆုံးပံ့ပိုးမှုအင်္ဂါရပ်များ (Over-The-Air အပ်ဒိတ်များအပါအဝင်) ကိုအသုံးပြုရန်၊ သီးခြားသိုလှောင်ကိရိယာတစ်ခုသို့ JemaOS ၏ဒစ်အပြည့်တပ်ဆင်ခြင်းကိုလုပ်ဆောင်ရန် "Installer" လုပ်ဆောင်ချက်ကို စတင်ရန် ကျွန်ုပ်တို့ အလေးအနက်အကြံပြုအပ်ပါသည်။</translation>
	<translation id="1246398339704431302">သင်သည် <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>မည်သို့ပင်ဖြစ်စေ ဤ JemaOS ၏ မိတ္တူကို ဆက်လက်အသုံးပြုနိုင်ပါသည်<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>၊ တပ်ဆင်ခြင်းလုပ်ငန်းစဉ်ကို နောက်ပိုင်းအဆင့်တွင် လုပ်ဆောင်နိုင်သည်၊ သို့သော်၊ သင်၏ဒေတာအားလုံးကို ဤစာမျက်နှာမှ ထည့်သွင်းပြီးနောက်တွင် ဖယ်ရှားလိုက်ပါမည်။ သင်ထပ်မံစတင်ပါမည်။</translation>
	<translation id="3654532222088291133">လက်မှတ်ထိုးဝင်ရန် သင်၏ JemaOS အကောင့် စကားဝှက်ကို ထည့်သွင်းမည့်အစား၊ သင်သည် ဤစက်ပစ္စည်းအတွက် <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> စကားဝှက်ကို ဖန်တီးနိုင်သည်။</translation>
	<translation id="8377684629839541977">JemaOS အကောင့် စကားဝှက်ကို အသုံးပြုပါ။</translation>

