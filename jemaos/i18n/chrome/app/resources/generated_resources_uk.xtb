<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="uk">
	<translation id="7386402409475121504">Створіть локальний обліковий запис JemaOS</translation>
	<translation id="3760308806144055927">Увійдіть у свій локальний обліковий запис JemaOS</translation>
	<translation id="3325117507482096812">Будь ласка, введіть пароль</translation>
	<translation id="1838206877831947154">Ваші паролі не збігаються</translation>
	<translation id="2158276988029582286">Створіть новий локальний обліковий запис</translation>
	<translation id="8592849747346274067">Увійдіть до існуючого облікового запису</translation>
	<translation id="482190417986201746">Ім'я користувача або пароль, які ви ввели, неправильні</translation>
	<translation id="6603987686259425085">Ви можете <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>увійти за допомогою локального облікового запису JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Електронна адреса <ph name="EMAIL_ADDRESS">$1</ph> уже існує. Повторіть спробу з іншою електронною адресою.</translation>
	<translation id="7215016743510876720">Використовуйте локальний обліковий запис</translation>
	<translation id="6657635042185516718">Продовжуйте використовувати онлайн-акаунт</translation>
	<translation id="6867476688065565618">Перейти на локальний обліковий запис?</translation>
	<translation id="4840454774882557974">Якщо ви вирішите використовувати локальний обліковий запис, такі корисні функції, як синхронізація ваших даних і налаштувань на кількох пристроях і автоматичний вхід у веб-програми за допомогою вашого облікового запису JemaOS, не працюватимуть.</translation>
	<translation id="8951507920859729424">Ми рекомендуємо використовувати обліковий запис онлайн, щоб використовувати JemaOS якомога повніше.</translation>
	<translation id="479773200536372215">Ви не зможете додавати облікові записи Google, оскільки відсутні ключі Google API. Див. <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>, щоб дізнатися більше.</translation>
	<translation id="1198491307547164157">Ви не зможете додавати облікові записи JemaOS, оскільки відсутні ключі JemaOS API. Див. <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>, щоб дізнатися більше.</translation>
	<translation id="5042404702659901995">Заява про конфіденційність</translation>
	<translation id="4907736162587268100">Зміст заяви про конфіденційність</translation>
	<translation id="5988344732274877691">Підпишіться на (дуже рідкісну, обіцяну) розсилку для JemaOS</translation>
	<translation id="1706203008474708805">Приєднуйтеся до плану покращення взаємодії з користувачем JemaOS</translation>
	<translation id="1147139514756087229">Увійдіть за допомогою локального облікового запису</translation>
	<translation id="2054784944085654098">Створення файлу резервної копії. Це може зайняти деякий час; будь ласка, зачекайте…</translation>
	<translation id="3554401467586751874">Файл резервної копії створено успішно</translation>
	<translation id="2349211327705667074">Переглянути файл резервної копії</translation>
	<translation id="3049367131589710124">Переглянути журнал помилок</translation>
	<translation id="1079017345574916945">Віддалений робочий стіл</translation>
	<translation id="3064478898280877715">Магазин додатків</translation>
	<translation id="5890206344045530832">Інсталятор</translation>
	<translation id="2173278076276376488">Ця утиліта допоможе вам встановити <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> у внутрішню пам’ять цього пристрою.</translation>
	<translation id="5323182426977498659">УВАГА! Ця процедура є руйнівною, і її неможливо скасувати. Зауважте, що ми не несемо жодної відповідальності за потенційну втрату ваших даних і не надаємо термінову технічну підтримку, продовжуйте на свій власний ризик.</translation>
	<translation id="8517836015601969896">Повна установка на диск</translation>
	<translation id="7300045760790370189">Установіть <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, щоб зайняти весь жорсткий диск, усі дані цільового жорсткого диска буде стерто.</translation>
	<translation id="8762511733918256595">Багатозавантажувальна установка</translation>
	<translation id="248900698427753678">Установіть <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на існуючий розділ жорсткого диска, де <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> може існувати паралельно з іншою ОС. Усі дані в цільовому розділі буде стерто.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> буде встановлено на вибраний жорсткий диск; усі дані на цільовому диску буде стерто.</translation>
	<translation id="4039091757234555415">диск</translation>
	<translation id="7783580523889684697">Диск відсутній</translation>
	<translation id="8217653566575018388">Встановлення завершено</translation>
	<translation id="8846746259444262774">Помилка встановлення</translation>
	<translation id="7263815009235541549">Встановлення успішно завершено. Будь ласка, спершу вимкніть свій пристрій, потім вийміть усі інсталяційні носії та знову ввімкніть його, щоб завантажити <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">На жаль, щось пішло не так, і встановлення не завершилося. Будь ласка, повторіть процес. Якщо та сама помилка не зникає, зверніться до служби підтримки JemaOS, надавши наведений вище журнал.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> буде встановлено на вибраний розділ вашого жорсткого диска. Згідно з поточною схемою мультизавантаження, це може відбуватися, лише якщо ваш пристрій підтримує UEFI, а ваші жорсткі диски відформатовано за допомогою GPT.</translation>
	<translation id="7831363758161884243">Цільовий розділ буде стерто; вам також потрібно вказати ваш активний розділ EFI (зазвичай робиться автоматично), оскільки програмі встановлення потрібно змінити конфігурації завантаження системи.</translation>
	<translation id="5670799238446305550">Виберіть <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> цільовий розділ</translation>
	<translation id="3695537760133394753">Перегородка</translation>
	<translation id="5610519566593708119">Виберіть розділ EFI</translation>
	<translation id="3367650349940010965">Для вибраного диска немає доступних розділів</translation>
	<translation id="7453223384507098390">Для вибраного диска немає доступних розділів EFI</translation>
	<translation id="1854532683465500847">Розмір вибраного розділу менший за 20 ГБ, інсталяція може бути невдалою</translation>
	<translation id="4144613075340468247">Вибраний розділ підключено до багатозавантажуваної <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, повторна інсталяція на ньому може не вдатися</translation>
	<translation id="5793361052649920836">Після встановлення, як би ви хотіли завантажити <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Встановити та налаштувати rEFInd для мене (рекомендовано)</translation>
	<translation id="1858708492548921044">rEFInd — це програма для керування завантаженням, яка пропонує гарний графічний інтерфейс для параметрів завантаження ОС під час запуску ПК, ви зможете вибрати потрібну ОС для завантаження з неї. Для отримання додаткової інформації про rEFInd зверніться до його домашньої сторінки.</translation>
	<translation id="3861924051442564602">Додайте для мене параметр меню завантаження UEFI</translation>
	<translation id="8622370666798589804">Коли ваш комп’ютер запускається, ви можете увійти в меню параметрів завантаження UEFI (швидше за все, натиснувши гарячу клавішу). Ця опція додає <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> як запис до цього меню. (Підтримує лише деякі моделі прошивки BIOS і UEFI).</translation>
	<translation id="1569398690544416170">Тут нічого не робити, я сам налаштую</translation>
	<translation id="3554866444001249532">Цей сценарій інсталяції помістить лише необхідні файли .efi для завантаження <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> у ваш розділ EFI, вам потрібно буде самостійно налаштувати його завантаження.</translation>
	<translation id="7492832751164189534">Примусово вийти</translation>
	<translation id="5159534860632584026">Процес інсталяції припинено</translation>
	<translation id="8686749782014838344">Не вдалося отримати інформацію про диск</translation>
	<translation id="5688543378771259173">Встановлення припиняється...</translation>
	<translation id="5350452134936384991">Встановити в USB</translation>
	<translation id="8008470485414925603">Установіть <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> на USB-диск; усі дані на цільовому USB-диску буде стерто.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> буде встановлено на вибраний USB-диск; усі дані на цільовому диску буде стерто.</translation>
	<translation id="5725593226060700263">USB-диск відсутній</translation>
	<translation id="4357040841587078287">Ми виявили, що ви використовуєте цю копію JemaOS із завантаженого файлу зображення. Щоб скористатися найповнішими функціями підтримки (включаючи оновлення по повітрю), які може запропонувати JemaOS, ми наполегливо рекомендуємо вам запустити функцію «Інсталятор», щоб виконати інсталяцію JemaOS на повний диск на окремий пристрій зберігання даних.</translation>
	<translation id="1246398339704431302">Ви все одно можете <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>продовжувати використовувати цю копію JemaOS<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, процес інсталяції можна виконати на пізнішому етапі в системі, проте після інсталяції всі ваші дані буде стерто, і ви почнете знову з цієї сторінки.</translation>
	<translation id="3654532222088291133">Замість того, щоб вводити пароль свого облікового запису JemaOS для входу, ви можете створити пароль <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> для цього пристрою</translation>
	<translation id="8377684629839541977">Використовуйте пароль облікового запису JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Автоматично підтримувати <ph name="DEVICE_OS" /> в актуальному стані</translation>
<translation id="2347352406101856238">Оновлення <ph name="DEVICE_OS" /> увімкнено</translation>
<translation id="185834232609012804">Оновлення <ph name="DEVICE_OS" /> вимкнено</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Платформа <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Віддалений робочий стіл</translation>
<translation id="6898090158927982244">Ваша система Linux оновлена</translation>
<translation id="4886703929102211360">Доступне критичне оновлення компонента Linux (beta). Наполегливо рекомендується встановити це оновлення якнайшвидше, інакше Linux (beta) може припинити роботу.</translation>
<translation id="6694016202036959050">Налаштування <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">Обліковий запис JemaOS, резервне копіювання, інше</translation>
<translation id="9150429437595727962">Налаштування Wi-Fi</translation>
<translation id="4938972461544498524">Налаштування тачпада</translation>
<translation id="1210024513248363065">Віддалені служби</translation>
<translation id="2878862288885588535">Служба віддаленої діагностики</translation>
<translation id="7409197984340676806">Служба віддаленої діагностики дозволяє офіційним представникам служби підтримки JemaOS виявляти системні проблеми. Наразі службу віддаленої діагностики можуть запускати лише офіційні представники служби підтримки JemaOS.</translation>
<translation id="1791028023086176332">Поділіться цим номером з офіційними представниками служби підтримки JemaOS</translation>
<translation id="6279304275399437025">Запуск служби віддаленої діагностики...</translation>
<translation id="1501882165699826662">Зупиніть службу віддаленої діагностики та спробуйте знову</translation>
<translation id="3100283258447375201">Додаткова інформація</translation>
<translation id="4070039109671307724">Інше</translation>
<translation id="7326893024940073254">Кнопка «Перезапустити»</translation>
<translation id="3002423764319968103">Показувати кнопку «Перезапустити» в системному меню</translation>
<translation id="6243454903512423518">Кнопка «Повернути екран»</translation>
<translation id="6491049336868978729">Ви зараз не в режимі планшета, кнопка «Повернути екран» прихована</translation>
<translation id="5496012402277579695">Показувати кнопку «Повернути екран» в системному меню</translation>
<translation id="5882838977344999606">Перемикач режиму планшет/ноутбук</translation>
<translation id="472164133625585606">Показувати перемикач режиму планшет/ноутбук у системному меню</translation>
<translation id="1851103550468466960">Увімкнути Widevine</translation>
<translation id="4058176713282795846">Увімкніть Widevine для потокової передачі захищеного преміум-вмісту. <ph name="BEGIN_LINK_LEARN_MORE" />Докладніше<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Виберіть «libwidevine.so»</translation>
<translation id="4838463656205005584">Не вдалося увімкнути Widevine...</translation>
<translation id="2164041826798266548">Не вдалося встановити модуль Widevine CDM. Перевірте з'єднання та спробуйте знову.</translation>
<translation id="4106982328079440606">Налаштування облікового запису JemaOS</translation>
<translation id="6468776556018764845">Експериментальні функції</translation>
<translation id="3487615413425326553">Обійти перевірки довіреного платформного модуля (TPM)</translation>
<translation id="4817176087932811573">Деякі функції можуть не працювати через несумісний чіп TPM у вашому пристрої; як обхідне рішення ви можете обійти перевірки TPM.</translation>
<translation id="3356003366173774486">Автоматичний вхід</translation>
<translation id="6218459410891191693">Дозволити поточному обліковому запису автоматично входити в систему під час перезапуску пристрою</translation>
<translation id="6620839363422062843">Неможливо ввімкнути для цього облікового запису; автоматичний вхід уже активний для інших облікових записів на цьому пристрої</translation>
<translation id="6734500226490446035">Неможливо ввімкнути для цього облікового запису; сталася невідома помилка під час ініціалізації файлових систем для цього облікового запису. Спробуйте перезапустити пристрій або створити новий обліковий запис</translation>
<translation id="5464880042146818691">Неможливо ввімкнути для цього облікового запису; опція автоматичного входу доступна лише для облікових записів типу «Локальний обліковий запис».</translation>
<translation id="3335654854106476749">Перед увімкненням автоматичного входу додайте пароль для входу в налаштуваннях <ph name="BEGIN_LINK" />Конфіденційність і безпека<ph name="END_LINK" />.</translation>
<translation id="5586831602198585601">Зараз доступна нова версія JemaOS для оновлення. Однак термін дії вашої підписки JemaOS for You закінчився; для оновлення JemaOS потрібна активна підписка.</translation>
<translation id="3869860597719956574">Зараз доступна нова основна версія JemaOS для оновлення. Щоб продовжити оновлення, необхідно сплатити одноразовий внесок.</translation>
<translation id="6523879681771260760">Вкажіть шлях для збереження файлу резервної копії</translation>
<translation id="2036152819788683293">Створити файл резервної копії для цього облікового запису (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Докладніше<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Створити резервну копію</translation>
<translation id="4267347174163690295">Створити файл резервної копії для цього облікового запису (beta).</translation>
<translation id="8112950994208888917">Ця операція створює повну резервну копію диска для цього облікового запису, що дозволяє легко відновити JemaOS до стану на момент створення резервної копії, включаючи налаштування, встановлені розширення браузера та програми підсистеми. Залежно від ваших програм і вмісту домашньої папки файл резервної копії може бути великим; рекомендується зберігати файл резервної копії на зовнішньому запам'ятовувальному пристрої. Якщо у вас є портативний USB-накопичувач, підключіть його зараз. <ph name="BEGIN_LINK_LEARN_MORE" />Докладніше<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Введіть пароль для входу в цей обліковий запис</translation>
<translation id="8663988871299316062">Запам'ятайте цей пароль, оскільки він знадобиться під час відновлення цього файлу резервної копії</translation>
<translation id="6408904153044317846">Виберіть файл резервної копії для відновлення</translation>
<translation id="8062988348127771021">Відновити дані JemaOS з файлу резервної копії</translation>
<translation id="7309192418866543730">Введіть пароль резервної копії</translation>
<translation id="3642408376366598984">Введіть пароль, використаний для шифрування цього файлу резервної копії</translation>
<translation id="7783974937157985523">Пароль резервної копії</translation>
<translation id="6583780301401541007">Відновлення виконано успішно</translation>
<translation id="3514011352559420398">Помилка відновлення</translation>
<translation id="7535980903266533458">Зберегти резервну копію на пристрої або зовнішньому накопичувачі</translation>
