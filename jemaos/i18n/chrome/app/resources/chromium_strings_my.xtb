<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot အကြောင်း</translation>
<translation id="5639860668557220477">Thot ဘရောက်ဇာအတွက် အကူအညီရယူပါ</translation>
<translation id="1692689520561928457">JemaOS အကြောင်း</translation>
<translation id="8692765844418174375">JemaOS ဗားရှင်း</translation>
<translation id="2943260250558374955">JemaOS အတွက် အကူအညီရယူပါ</translation>
<translation id="713321354492170993">ဘရောက်ဇာသည် အသုံးမပြုနေသော တပ်ဗ်များမှ မမ်မိုရီကို လွတ်လပ်စေပါသည်။ ၎င်းက အသုံးပြုနေသော တပ်ဗ်များနှင့် အခြားအက်ပ်များကို ကွန်ပျူတင်းအရင်းအမြစ်များ ပိုမိုရရှိစေပြီး ဘရောက်ဇာကို မြန်ဆန်စွာ ထိန်းထားပါသည်။ သင် ပြန်သွားသောအခါ သင်၏ အသုံးမပြုနေသော တပ်ဗ်များ အလိုအလျောက် ပြန်လည်အသက်ဝင်ပါမည်။</translation>
<translation id="1774190491044887444">ဘရောက်ဇာသည် ချောမွေ့စွာ ဆက်လိုက်ရွှေ့လျားခြင်းနှင့် ဗီဒီယိုဖရိမ်းနှုန်းများကဲ့သို့ နောက်ခံလုပ်ဆောင်ချက်များနှင့် မျက်နှာပြင်အကျိုးသက်ရောက်မှုများကို ကန့်သတ်ခြင်းဖြင့် ဘက်ထရီကို သက်သာစေပါသည်။</translation>
<translation id="180121268008059459">ဘရောက်ဇာသည် စာမျက်နှာများကို ကြိုတင်ဖွင့်ပေးပြီး browsing နှင့် ရှာဖွေမှုကို ပိုမိုမြန်ဆန်စေပါသည်။</translation>
<translation id="7127093527178692287">ဘက်ကပ် ပြန်လည်ရယူခြင်း (ဘီတာ)</translation>
<translation id="4439042171549201806">ဘက်ကပ်ဖိုင်မှ JemaOS ကို ပြန်လည်ရယူရန်၊ ကျေးဇူးပြု၍ ဘက်ကပ်ဖိုင်ပါဝင်သော ဖယ်ရှားနိုင်သော drive ကို သင့် JemaOS စက်ထဲသို့ ယခု ထည့်သွင်းပြီး မည်သည့် ဘက်ကပ်ဖိုင်ကို ပြန်လည်ရယူလိုသည်ကို သတ်မှတ်ပါ။ ဤ wizard က ရှာဖွေတွေ့ရှိနိုင်ရန် သင်၏ ဘက်ကပ်ဖိုင်သည် ဖယ်ရှားနိုင်သော drive ၏ root directory ထဲတွင် ရှိရမည်ဖြစ်ကြောင်း သတိပြုပါ။</translation>
<translation id="2955409026764742995">ပြန်လည်ရယူရန် ဘက်ကပ်ဖိုင်ကို ရွေးချယ်ပါ:</translation>
<translation id="7040434808685140085">ဝမ်းနည်းပါသည်၊ ရွေးချယ်ထားသော ဘက်ကပ်ဖိုင်ကို မသိရှိနိုင်ပါ; ကျေးဇူးပြု၍ အသစ်တစ်ခု ရွေးချယ်ပါ။</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />ရွေးချယ်ထားသော ဘက်ကပ်ဖိုင်မှ JemaOS ကို ပြန်လည်ရယူရန်အတွက် ဘက်ကပ်ကို ဖန်တီးစဉ်က ၎င်းအကြောင်း အတိအကျ အချက်အလက်များ ရှိရန် မရှိမဖြစ်လိုအပ်ပါသည်။ မဟုတ်ပါက ပြန်လည်ရယူခြင်း လုပ်ငန်းစဉ် မအောင်မြင်ပါမည်။<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"အကောင့်အမည်" သည် သင်၏ ဘက်ကပ်ဖိုင်ကို ဖန်တီးခဲ့သော အကောင့်၏ အဓိက အကောင့်ဝင်ရောက်ခြင်း အထောက်အထားဖြစ်ပါသည်။ ၎င်းသည် သင်၏ JemaOS/Google အကောင့်အတွက် ဆိုင်းအပ်အသုံးပြုခဲ့သော အီးမေးလ်လိပ်စာ ဖြစ်လေ့ရှိပါသည်။ ၎င်းသည် ဒေသတွင်းအကောင့်ဖြစ်ပါက "@jemaos.local" ပေါင်းထည့်ထားသော အသုံးပြုသူအမည် ဖြစ်ပါမည်။<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />စကားဝှက်သည် ဘက်ကပ်ကို ဖန်တီးစဉ် သင်ထည့်သွင်းရန် တောင်းဆိုခဲ့သော passphrase ဖြစ်ပါသည်။ ၎င်းသည် ဤအကောင့်အတွက် JemaOS desktop သို့ ဆိုင်းအင်ဝင်ရန် သင်အသုံးပြုခဲ့သော စကားဝှက်နှင့် အတူတူပင် ဖြစ်လေ့ရှိပါသည်။<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">အကောင့်အမည်</translation>
<translation id="5490570429039308155">ဝမ်းနည်းပါသည်၊ ကျေးဇူးပြု၍ မှန်ကန်သော အကောင့်အမည် ထည့်ပါ</translation>
<translation id="6657585470893396449">စကားဝှက်</translation>
<translation id="8200189938001188563">ဝမ်းနည်းပါသည်၊ စကားဝှက်သည် ဗလာမဖြစ်ရပါ</translation>
<translation id="3157931365184549694">ပြန်လည်ရယူပါ</translation>
<translation id="8556278756526311953">ဘက်ကပ်ကို ပြန်လည်ရယူနေပါသည်</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />ကျွန်ုပ်တို့သည် သင်၏ ဘက်ကပ်ဖိုင်ကို ပြန်လည်ရယူရန် လုပ်ဆောင်နေပါသည်; ၎င်းက အချိန်အနည်းငယ် ကြာနိုင်သဖြင့် ကျေးဇူးပြု၍ စိတ်ရှည်ပါ။<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />ပြန်လည်ရယူခြင်း လုပ်ငန်းစဉ် အောင်မြင်စွာ ပြီးဆုံးသောအခါ UI သည် အလိုအလျောက် ပြန်လည်စတင်မည်ဖြစ်ကြောင်း သတိပြုပါ။<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ဘက်ကပ် ပြန်လည်ရယူခြင်း မအောင်မြင်ပါ</translation>
<translation id="5003531399442003695">အသေးစိတ်အချက်အလက်များအတွက်၊ ကျေးဇူးပြု၍ အောက်ပါလင့်ခ်ကို နှိပ်၍ log များကို ကြည့်ပါ။ ဤအမှားက ဆက်လက်ဖြစ်နေပါက၊ ကျေးဇူးပြု၍ JemaOS နည်းပညာပိုင်း ပံ့ပိုးမှုချန်နယ်များနှင့် ဆက်သွယ်ပြီး အမှား log များကို ပေးပါ။</translation>
<translation id="6363786367719063276">Log များကြည့်ပါ</translation>
<translation id="8730621377337864115">ပြီးပါပြီ</translation>
<translation id="975238173507911396">ဒေတာ ပြန်လည်ရယူခြင်း အောင်မြင်ပါသည်</translation>
<translation id="6276879052695618521">ဘက်ကပ် ပြန်လည်ရယူခြင်း log များ</translation>
<translation id="4901207598072637766">JemaOS ကို <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> မှ ပံ့ပိုးပေးပါသည်</translation>
<translation id="7894910504474624324">JemaOS နှင့် ၎င်း၏ ဝန်ဆောင်မှုများသည် GDPR နှင့် ဥရောပ ဒေတာကာကွယ်ရေး ဥပဒေ ပြဋ္ဌာန်းချက်များကို လိုက်နာပါသည်။ နောက်ထပ် အချက်အလက်များအတွက်၊ ကျေးဇူးပြု၍ ကျွန်ုပ်တို့၏ <ph name="BEGIN_LINK_PRIVACY" />ကိုယ်ရေးအချက်အလက် မူဝါဒ<ph name="END_LINK_PRIVACY" /> နှင့် <ph name="BEGIN_LINK_TOS" />ဝန်ဆောင်မှု စည်းကမ်းချက်များ<ph name="END_LINK_TOS" /> ကို ကြည့်ပါ။</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, မူပိုင်ခွင့်များ အားလုံး ခွင့်ပြုထားပါသည်။</translation>
<translation id="370679569376308836">JemaOS သည် Jema စက်နှင့် ၎င်း၏ SaaS ကို အခြေခံထားသော စီးပွားဖြစ် ကမ်းလှမ်းမှု ဖြစ်ပါသည်။</translation>
<translation id="2773644194450163486">JemaOS သည် <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> open source ပရောဂျက်ကြောင့် ဖြစ်နိုင်ခဲ့ခြင်း ဖြစ်ပါသည်။</translation>
<translation id="2330680727776977160">Chromium သည်လည်း အခြား <ph name="BEGIN_LINK_1" />open source ဆော့ဖ်ဝဲလ်<ph name="END_LINK_1" /> နှင့် <ph name="BEGIN_LINK_2" />နောက်ထပ် open source ဆော့ဖ်ဝဲလ်<ph name="END_LINK_2" /> များကြောင့် ဖြစ်နိုင်ခဲ့ခြင်း ဖြစ်ပါသည်။</translation>
<translation id="1419954813084261088">Jema Technology မှ ဒီဇိုင်းထုတ်ပြီး ထုတ်လုပ်ထားပါသည်။</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, မူပိုင်ခွင့်များ အားလုံး ခွင့်ပြုထားပါသည်။</translation>
<translation id="6168072053306020326">Jema Technology သည် Jema Technology LTD နှင့် Jema Technology (Beijing) Limited ၏ ကုန်သွယ်ရေးအမည် ဖြစ်ပါသည်။
        <ph name="LINE_BREAK" />
        Jema Technology LTD သည် အင်္ဂလန်နှင့် ဝေးလ်တွင် ကုမ္ပဏီနံပါတ် 12273803 ဖြင့် မှတ်ပုံတင်ထားသော ကုမ္ပဏီ ဖြစ်ပါသည်။</translation>
<translation id="1251589813188467292">အရေးကြီးသော စက် warranty နှင့် ဝန်ဆောင်မှု အချက်အလက်များ</translation>
<translation id="4851115775198886021">စက် SN:</translation>
