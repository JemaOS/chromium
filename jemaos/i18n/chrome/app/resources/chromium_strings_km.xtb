<translation id="370679569376308836">JemaOS គឺជាការផ្តល់ជូនពាណិជ្ជកម្មដោយផ្អែកលើឧបករណ៍ Jema និង SaaS របស់វា។</translation>
<translation id="2773644194450163486">JemaOS អាចធ្វើទៅបានដោយគម្រោងចំណុះបើកចំហ <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" />។</translation>
<translation id="2330680727776977160">Chromium ក៏អាចធ្វើទៅបានដោយ<ph name="BEGIN_LINK_1" />កម្មវិធីចំណុះបើកចំហផ្សេងទៀត<ph name="END_LINK_1" /> និង<ph name="BEGIN_LINK_2" />កម្មវិធីចំណុះបើកចំហបន្ថែម<ph name="END_LINK_2" />ដែរ។</translation>
