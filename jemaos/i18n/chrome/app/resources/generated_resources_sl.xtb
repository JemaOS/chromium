<translation id="3514011352559420398">Obnova ni uspela</translation>
<translation id="7535980903266533458">Shranite varnostno kopijo v napravo ali zunanji pomnilnik</translation>
<translation id="604001903249547235">Varnostna kopija v oblaku</translation>
<translation id="8885702701336541611">Naložite varnostno kopijo v oblačno shrambo JemaOS</translation>
<translation id="3939744430096549862">Ustvari varnostno kopijo v oblaku</translation>
