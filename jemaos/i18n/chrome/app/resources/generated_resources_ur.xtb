	<translation id="2173278076276376488">یہ یوٹیلیٹی اس ڈیوائس کے اندرونی اسٹوریج پر <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> انسٹال کرنے میں آپ کی مدد کرے گی۔</translation>
	<translation id="5323182426977498659">وارننگ! یہ طریقہ کار تباہ کن ہے اور اسے کالعدم نہیں کیا جا سکتا۔ براہ کرم نوٹ کریں کہ ہم آپ کے ڈیٹا کے ممکنہ نقصان کی کوئی ذمہ داری نہیں لیں گے اور نہ ہی کوئی فوری تکنیکی مدد فراہم کریں گے، اپنے خطرے پر آگے بڑھیں۔</translation>
	<translation id="8517836015601969896">مکمل ڈسک کی تنصیب</translation>
	<translation id="7300045760790370189">پوری ہارڈ ڈسک پر قبضہ کرنے کے لیے <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> انسٹال کریں، ٹارگٹ ہارڈ ڈسک کا تمام ڈیٹا صاف کر دیا جائے گا۔</translation>
	<translation id="8762511733918256595">ملٹی بوٹ کی تنصیب</translation>
	<translation id="248900698427753678"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو ہارڈ ڈسک کے موجودہ پارٹیشن میں انسٹال کریں، جہاں <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> دوسرے OS کے متوازی طور پر موجود ہو سکتا ہے۔ ٹارگٹ پارٹیشن کا تمام ڈیٹا مٹا دیا جائے گا۔</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> آپ کی منتخب کردہ ہارڈ ڈرائیو پر انسٹال ہو جائے گا۔ ٹارگٹ ڈسک پر موجود تمام ڈیٹا کو صاف کر دیا جائے گا۔</translation>
	<translation id="4039091757234555415">ڈسک</translation>
	<translation id="7783580523889684697">کوئی ڈسک دستیاب نہیں ہے۔</translation>
	<translation id="8217653566575018388">تنصیب مکمل ہو گئی۔</translation>
	<translation id="8846746259444262774">تنصیب ناکام ہو گئی۔</translation>
	<translation id="7263815009235541549">تنصیب کامیابی سے ختم ہو گئی ہے۔ براہ کرم پہلے اپنے آلے کو پاور آف کریں، پھر کسی بھی انسٹالیشن میڈیا کو ہٹا دیں، اور <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو بوٹ کرنے کے لیے اسے دوبارہ آن کریں۔</translation>
	<translation id="3380151284134965398">افوہ، کچھ غلط ہو گیا ہے اور انسٹالیشن مکمل نہیں ہوئی۔ براہ کرم عمل کی دوبارہ کوشش کریں۔ اگر یہی خرابی برقرار رہتی ہے، تو براہ کرم اوپر والے لاگ کے ساتھ JemaOS سپورٹ کے لیے رابطہ کریں۔</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> آپ کی ہارڈ ڈرائیو کے منتخب کردہ پارٹیشن پر انسٹال ہوگا۔ موجودہ ملٹی بوٹ اسکیم کے تحت، یہ صرف اس صورت میں آگے بڑھ سکتا ہے جب آپ کا آلہ UEFI کو سپورٹ کرتا ہے اور آپ کی ہارڈ ڈسکیں GPT کے ساتھ فارمیٹ کی جاتی ہیں۔</translation>
	<translation id="7831363758161884243">ہدف کی تقسیم کو مٹا دیا جائے گا۔ آپ کو اپنے فعال EFI پارٹیشن کی بھی وضاحت کرنی ہوگی (عام طور پر خود بخود ہو جاتی ہے) کیونکہ انسٹالر کو سسٹم بوٹ کنفیگریشنز میں ترمیم کرنے کی ضرورت ہے۔</translation>
	<translation id="5670799238446305550">منتخب کریں <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ٹارگٹ پارٹیشن</translation>
	<translation id="3695537760133394753">تقسیم</translation>
	<translation id="5610519566593708119">EFI پارٹیشن کو منتخب کریں۔</translation>
	<translation id="3367650349940010965">منتخب کردہ ڈسک کے لیے کوئی پارٹیشن دستیاب نہیں ہیں۔</translation>
	<translation id="7453223384507098390">منتخب ڈسک کے لیے کوئی EFI پارٹیشن دستیاب نہیں ہے۔</translation>
	<translation id="1854532683465500847">منتخب پارٹیشن کا سائز 20GB سے کم ہے، انسٹالیشن ناکام ہو سکتی ہے۔</translation>
	<translation id="4144613075340468247">منتخب پارٹیشن کو <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ملٹی بوٹ پر لگا دیا گیا ہے، اسے دوبارہ انسٹال کرنا ناکام ہو سکتا ہے</translation>
	<translation id="5793361052649920836">انسٹالیشن کے بعد، آپ <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو کیسے بوٹ کرنا چاہیں گے؟</translation>
	<translation id="4273235330352963866">میرے لیے rEFInd انسٹال اور کنفیگر کریں (تجویز کردہ)</translation>
	<translation id="1858708492548921044">rEFInd ایک بوٹ مینیجر پروگرام ہے جو OS بوٹ کے اختیارات کے لیے ایک اچھا گرافیکل انٹرفیس پیش کرتا ہے جب آپ کا پی سی شروع ہوتا ہے، آپ اس کے ساتھ بوٹ کرنے کے لیے اپنے مطلوبہ OS کا انتخاب کر سکیں گے۔ rEFInd کے بارے میں مزید معلومات کے لیے، براہ کرم اس کے ہوم پیج سے رجوع کریں۔</translation>
	<translation id="3861924051442564602">میرے لیے UEFI بوٹ مینو آپشن شامل کریں۔</translation>
	<translation id="8622370666798589804">جب آپ کا پی سی شروع ہوتا ہے تو آپ UEFI بوٹ آپشنز مینو میں داخل ہو سکتے ہیں (زیادہ تر ممکنہ طور پر ہاٹ کی دبانے سے)، یہ آپشن <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو اس مینو میں بطور اندراج شامل کرتا ہے۔ (صرف BIOS اور UEFI فرم ویئر کے کچھ ماڈلز کو سپورٹ کرتا ہے)۔</translation>
	<translation id="1569398690544416170">یہاں کچھ نہ کریں، میں اسے خود ترتیب دوں گا۔</translation>
	<translation id="3554866444001249532">یہ انسٹالیشن اسکرپٹ آپ کے EFI پارٹیشن میں <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو بوٹ کرنے کے لیے صرف ضروری .efi فائلیں ڈالے گا، آپ کو خود سے اسے بوٹ کرنے کا طریقہ ترتیب دینا ہوگا۔</translation>
	<translation id="7492832751164189534">زبردستی چھوڑ دیں۔</translation>
	<translation id="5159534860632584026">تنصیب کا عمل ختم کر دیا گیا ہے۔</translation>
	<translation id="8686749782014838344">ڈسک کی معلومات حاصل کرنے میں ناکام</translation>
	<translation id="5688543378771259173">تنصیب کو ختم کیا جا رہا ہے...</translation>
	<translation id="5350452134936384991">USB میں انسٹال کریں۔</translation>
	<translation id="8008470485414925603"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> کو USB ڈسک پر انسٹال کریں۔ ٹارگٹ USB ڈسک پر موجود تمام ڈیٹا کو صاف کر دیا جائے گا۔</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> آپ کی منتخب کردہ USB ڈسک پر انسٹال ہو جائے گا۔ ٹارگٹ ڈسک پر موجود تمام ڈیٹا کو صاف کر دیا جائے گا۔</translation>
	<translation id="5725593226060700263">کوئی USB ڈسک دستیاب نہیں ہے۔</translation>
	<translation id="4357040841587078287">ہمیں پتہ چلا ہے کہ آپ JemaOS کی اس کاپی کو ڈاؤن لوڈ کردہ تصویری فائل سے چلا رہے ہیں۔ سب سے زیادہ جامع سپورٹ فیچرز (بشمول اوور دی ایئر اپ ڈیٹس) کو استعمال کرنے کے لیے جو JemaOS پیش کر سکتا ہے، ہم آپ کو پرزور مشورہ دیتے ہیں کہ آپ "Installer" فنکشن شروع کریں تاکہ JemaOS کی فل ڈسک انسٹالیشن کو علیحدہ اسٹوریج ڈیوائس پر انجام دیں۔</translation>
	<translation id="1246398339704431302">آپ <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>کسی بھی طرح JemaOS کی اس کاپی کو استعمال کرنا جاری رکھ سکتے ہیں<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>، انسٹالیشن کا عمل سسٹم میں بعد کے مرحلے پر عمل میں لایا جا سکتا ہے، تاہم، انسٹالیشن کے بعد آپ کا تمام ڈیٹا صاف کر دیا جائے گا اور آپ دوبارہ شروع کریں گے۔</translation>
	<translation id="3654532222088291133">سائن ان کرنے کے لیے اپنے JemaOS اکاؤنٹ کا پاس ورڈ درج کرنے کے بجائے، آپ اس ڈیوائس کے لیے ایک <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> پاس ورڈ بنا سکتے ہیں۔</translation>
	<translation id="8377684629839541977">JemaOS اکاؤنٹ کا پاس ورڈ استعمال کریں۔</translation>

