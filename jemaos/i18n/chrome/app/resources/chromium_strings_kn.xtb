<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">

<!-- jemaos_menus -->
<translation id="6953055153591205035">Thot ಬಗ್ಗೆ</translation>
<translation id="5639860668557220477">Thot ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="1692689520561928457">JemaOS ಬಗ್ಗೆ</translation>
<translation id="8692765844418174375">JemaOS ಆವೃತ್ತಿ</translation>
<translation id="2943260250558374955">JemaOS ನಲ್ಲಿ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="713321354492170993">ಬ್ರೌಸರ್ ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳಿಂದ ಮೆಮೊರಿಯನ್ನು ಬಿಡುಗಡೆ ಮಾಡುತ್ತದೆ. ಇದು ಸಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಹೆಚ್ಚಿನ ಕಂಪ್ಯೂಟಿಂಗ್ ಸಂಪನ್ಮೂಲಗಳನ್ನು ನೀಡುತ್ತದೆ ಮತ್ತು ಬ್ರೌಸರ್ ಅನ್ನು ವೇಗವಾಗಿಡುತ್ತದೆ. ನೀವು ಅವುಗಳಿಗೆ ಹಿಂದಿರುಗಿದಾಗ ನಿಮ್ಮ ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮತ್ತೆ ಸಕ್ರಿಯವಾಗುತ್ತವೆ.</translation>
<translation id="1774190491044887444">ಬ್ರೌಸರ್ ಹಿನ್ನೆಲೆ ಚಟುವಟಿಕೆ ಮತ್ತು ದೃಶ್ಯ ಪರಿಣಾಮಗಳನ್ನು, ಉದಾಹರಣೆಗೆ ಸುಗಮ ಸ್ಕ್ರಾಲಿಂಗ್ ಮತ್ತು ವೀಡಿಯೊ ಫ್ರೇಮ್ ದರಗಳನ್ನು ಸೀಮಿತಗೊಳಿಸುವ ಮೂಲಕ ಬ್ಯಾಟರಿಯನ್ನು ಉಳಿಸುತ್ತದೆ.</translation>
<translation id="180121268008059459">ಬ್ರೌಸರ್ ಪುಟಗಳನ್ನು ಮುಂಚಿತವಾಗಿ ಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಬ್ರೌಸಿಂಗ್ ಮತ್ತು ಹುಡುಕಾಟ ವೇಗವಾಗುತ್ತದೆ.</translation>
<translation id="7127093527178692287">ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪಿಸಿ (ಬೀಟಾ)</translation>
<translation id="4439042171549201806">ಬ್ಯಾಕಪ್ ಫೈಲ್‌ನಿಂದ JemaOS ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಲು, ದಯವಿಟ್ಟು ಈಗ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಒಳಗೊಂಡಿರುವ ತೆಗೆಯಬಹುದಾದ ಡ್ರೈವ್ ಅನ್ನು ನಿಮ್ಮ JemaOS ಸಾಧನಕ್ಕೆ ಸೇರಿಸಿ ಮತ್ತು ನೀವು ಯಾವ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಬಯಸುತ್ತೀರಿ ಎಂಬುದನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ. ಈ ವಿಜರ್ಡ್ ಪತ್ತೆ ಮಾಡಲು ನಿಮ್ಮ ಬ್ಯಾಕಪ್ ಫೈಲ್ ನಿಮ್ಮ ತೆಗೆಯಬಹುದಾದ ಡ್ರೈವ್‌ನ ರೂಟ್ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿರಬೇಕು ಎಂಬುದನ್ನು ದಯವಿಟ್ಟು ಗಮನಿಸಿ.</translation>
<translation id="2955409026764742995">ಮರುಸ್ಥಾಪಿಸಲು ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ:</translation>
<translation id="7040434808685140085">ಕ್ಷಮಿಸಿ, ಆಯ್ಕೆಮಾಡಿದ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಗುರುತಿಸಲಾಗುತ್ತಿಲ್ಲ; ದಯವಿಟ್ಟು ಹೊಸದನ್ನು ಆಯ್ಕೆಮಾಡಿ.</translation>
<translation id="6487486280704458238"><ph name="BEGIN_PARAGRAPH1" />ಆಯ್ಕೆಮಾಡಿದ ಬ್ಯಾಕಪ್ ಫೈಲ್‌ನಿಂದ JemaOS ಅನ್ನು ಮರುಸ್ಥಾಪಿಸಲು, ಬ್ಯಾಕಪ್ ರಚಿಸಿದಾಗಿನ ಕುರಿತು ನಿಖರವಾದ ಮಾಹಿತಿಯನ್ನು ಹೊಂದಿರುವುದು ಅತ್ಯಗತ್ಯ. ಇಲ್ಲದಿದ್ದರೆ, ಮರುಸ್ಥಾಪನೆ ಪ್ರಕ್ರಿಯೆ ವಿಫಲವಾಗುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />"ಖಾತೆ ಹೆಸರು" ಎಂದರೆ ನಿಮ್ಮ ಬ್ಯಾಕಪ್ ಫೈಲ್ ರಚಿಸಲಾದ ಖಾತೆಯ ಪ್ರಾಥಮಿಕ ಲಾಗಿನ್ ರುಜುವಾತು. ಇದು ಸಾಮಾನ್ಯವಾಗಿ ನಿಮ್ಮ JemaOS/Google ಖಾತೆಗೆ ಸೈನ್ ಅಪ್ ಮಾಡಲು ನೀವು ಬಳಸಿದ ಇಮెయిల್ ವಿಳಾಸವಾಗಿರುತ್ತದೆ. ಅದು ಸ್ಥಳೀಯ ಖಾತೆಯಾಗಿದ್ದರೆ, ಅದು "@jemaos.local" ನೊಂದಿಗೆ ಸೇರಿಸಲಾದ ಬಳಕೆದಾರ ಹೆಸರಾಗಿರುತ್ತದೆ.<ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />ಪಾಸ್‌ವರ್ಡ್ ಎಂದರೆ ಬ್ಯಾಕಪ್ ರಚಿಸಿದಾಗ ನಮೂದಿಸಲು ನಿಮ್ಮನ್ನು ಕೇಳಲಾದ ಪಾಸ್‌ಫ್ರೇಸ್. ಇದು ಸಾಮಾನ್ಯವಾಗಿ ಈ ಖಾತೆಗಾಗಿ JemaOS ಡೆಸ್ಕ್‌ಟಾಪ್‌ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನೀವು ಬಳಸಿದ ಅದೇ ಪಾಸ್‌ವರ್ಡ್ ಆಗಿರುತ್ತದೆ.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3067168166931605141">ಖಾತೆ ಹೆಸರು</translation>
<translation id="5490570429039308155">ಕ್ಷಮಿಸಿ, ದಯವಿಟ್ಟು ಸರಿಯಾದ ಖಾತೆ ಹೆಸರನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="6657585470893396449">ಪಾಸ್‌ವರ್ಡ್</translation>
<translation id="8200189938001188563">ಕ್ಷಮಿಸಿ, ಪಾಸ್‌ವರ್ಡ್ ಖಾಲಿ ಇರಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="3157931365184549694">ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="8556278756526311953">ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="6407461260359848947"><ph name="BEGIN_PARAGRAPH1" />ನಾವು ಈಗ ನಿಮ್ಮ ಬ್ಯಾಕಪ್ ಫೈಲ್ ಅನ್ನು ಮರುಸ್ಥಾಪಿಸುವ ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದೇವೆ; ಇದಕ್ಕೆ ಸ್ವಲ್ಪ ಸಮಯ ತಗುಲಬಹುದು, ಆದ್ದರಿಂದ ದಯವಿಟ್ಟು ತಾಳ್ಮೆಯಿಂದಿರಿ.<ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />ಮರುಸ್ಥಾಪನೆ ಪ್ರಕ್ರಿಯೆ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಂಡಾಗ UI ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ ಎಂಬುದನ್ನು ದಯವಿಟ್ಟು ಗಮನಿಸಿ.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8250446925353310209">ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪನೆ ವಿಫಲವಾಗಿದೆ</translation>
<translation id="5003531399442003695">ಹೆಚ್ಚಿನ ವಿವರಗಳಿಗಾಗಿ, ಲಾಗ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಲು ದಯವಿಟ್ಟು ಕೆಳಗಿನ ಲಿಂಕ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ಈ ದೋಷ ಮುಂದುವರಿದರೆ, ದಯವಿಟ್ಟು JemaOS ತಾಂತ್ರಿಕ ಬೆಂಬಲ ಚಾನಲ್‌ಗಳನ್ನು ಸಂಪರ್ಕಿಸಿ ಮತ್ತು ದೋಷ ಲಾಗ್‌ಗಳನ್ನು ಒದಗಿಸಿ.</translation>
<translation id="6363786367719063276">ಲಾಗ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ</translation>
<translation id="8730621377337864115">ಮುಗಿಯಿತು</translation>
<translation id="975238173507911396">ಡೇಟಾ ಮರುಸ್ಥಾಪನೆ ಯಶಸ್ವಿಯಾಗಿದೆ</translation>
<translation id="6276879052695618521">ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪನೆ ಲಾಗ್‌ಗಳು</translation>
<translation id="4901207598072637766">JemaOS, <ph name="BEGIN_LINK" />https://jematechnology.fr<ph name="END_LINK" /> ನಿಂದ ಒದಗಿಸಲಾಗಿದೆ</translation>
<translation id="7894910504474624324">JemaOS ಮತ್ತು ಅದರ ಸೇವೆಗಳು GDPR ಮತ್ತು ಯುರೋಪಿಯನ್ ಡೇಟಾ ರಕ್ಷಣೆ ಕಾನೂನಿನ ನಿಬಂಧನೆಗಳನ್ನು ಅನುಸರಿಸುತ್ತವೆ. ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ, ದಯವಿಟ್ಟು ನಮ್ಮ <ph name="BEGIN_LINK_PRIVACY" />ಗೌಪ್ಯತಾ ನೀತಿ<ph name="END_LINK_PRIVACY" /> ಮತ್ತು ನಮ್ಮ <ph name="BEGIN_LINK_TOS" />ಸೇವಾ ನಿಬಂಧನೆಗಳು.<ph name="END_LINK_TOS" /> ಅನ್ನು ನೋಡಿ.</translation>
<translation id="142388786713899398"><ph name="YEAR" />, Jema Technology, ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
<translation id="370679569376308836">JemaOS ಎಂಬುದು Jema ಸಾಧನ ಮತ್ತು ಅದರ SaaS ಅನ್ನು ಆಧರಿಸಿದ ವಾಣಿಜ್ಯ ಕೊಡುಗೆಯಾಗಿದೆ.</translation>
<translation id="2773644194450163486">JemaOS <ph name="BEGIN_LINK" />Chromium<ph name="END_LINK" /> ಓಪನ್ ಸೋರ್ಸ್ ಪ್ರಾಜೆಕ್ಟ್‌ನಿಂದ ಸಾಧ್ಯವಾಗಿದೆ.</translation>
<translation id="2330680727776977160">Chromium ಸಹ ಇತರ <ph name="BEGIN_LINK_1" />ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_1" /> ಮತ್ತು <ph name="BEGIN_LINK_2" />ಹೆಚ್ಚುವರಿ ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_2" />‌ಗಳಿಂದ ಸಾಧ್ಯವಾಗಿದೆ.</translation>
<translation id="1419954813084261088">Jema Technology ಯಿಂದ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ ಮತ್ತು ತಯಾರಿಸಲಾಗಿದೆ.</translation>
<translation id="5260524299337879315">©<ph name="YEAR" />, Jema Technology LTD, ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
<translation id="6168072053306020326">Jema Technology ಎಂಬುದು Jema Technology LTD ಮತ್ತು Jema Technology (Beijing) Limited ನ ವ್ಯಾಪಾರ ಹೆಸರಾಗಿದೆ.
        <ph name="LINE_BREAK" />
        Jema Technology LTD ಎಂಬುದು ಇಂಗ್ಲೆಂಡ್ ಮತ್ತು ವೇಲ್ಸ್‌ನಲ್ಲಿ 12273803 ಕಂಪನಿ ಸಂಖ್ಯೆಯೊಂದಿಗೆ ನೋಂದಾಯಿಸಲಾದ ಕಂಪನಿಯಾಗಿದೆ.</translation>
<translation id="1251589813188467292">ಪ್ರಮುಖ ಸಾಧನ ವಾರಂಟಿ ಮತ್ತು ಸೇವಾ ಮಾಹಿತಿ</translation>
<translation id="4851115775198886021">ಸಾಧನ SN:</translation>
</translationbundle>
