<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="id">
	<translation id="7386402409475121504">Buat akun JemaOS lokal Anda</translation>
	<translation id="3760308806144055927">Masuk ke akun JemaOS lokal Anda</translation>
	<translation id="3325117507482096812">Silakan masukkan kata sandi</translation>
	<translation id="1838206877831947154">Kata sandi Anda tidak cocok</translation>
	<translation id="2158276988029582286">Buat akun lokal baru</translation>
	<translation id="8592849747346274067">Masuk ke akun yang ada</translation>
	<translation id="482190417986201746">Nama pengguna atau kata sandi yang Anda masukkan salah</translation>
	<translation id="6603987686259425085">Anda dapat <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>masuk dengan akun lokal JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Email <ph name="EMAIL_ADDRESS">$1</ph> sudah ada. Silakan coba lagi dengan email lain.</translation>
	<translation id="7215016743510876720">Gunakan akun lokal</translation>
	<translation id="6657635042185516718">Terus gunakan akun online</translation>
	<translation id="6867476688065565618">Beralih ke akun lokal?</translation>
	<translation id="4840454774882557974">Jika Anda memilih untuk menggunakan akun lokal, fitur berguna termasuk menyinkronkan data dan preferensi Anda di beberapa perangkat dan masuk secara otomatis ke aplikasi web menggunakan akun JemaOS Anda tidak akan berfungsi.</translation>
	<translation id="8951507920859729424">Kami merekomendasikan penggunaan akun online untuk memanfaatkan JemaOS secara maksimal.</translation>
	<translation id="479773200536372215">Anda tidak akan dapat menambahkan akun Google karena kunci Google API tidak ada. Lihat <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> untuk detailnya.</translation>
	<translation id="1198491307547164157">Anda tidak akan dapat menambahkan akun JemaOS karena kunci API JemaOS tidak ada. Lihat <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> untuk detailnya.</translation>
	<translation id="5042404702659901995">Pernyataan privasi</translation>
	<translation id="4907736162587268100">Isi pernyataan privasi</translation>
	<translation id="5988344732274877691">Mendaftarlah untuk buletin (sangat jarang, dijanjikan) untuk JemaOS</translation>
	<translation id="1706203008474708805">Bergabunglah dengan rencana peningkatan pengalaman pengguna JemaOS</translation>
	<translation id="1147139514756087229">Masuk dengan akun lokal</translation>
	<translation id="2054784944085654098">Membuat file cadangan sekarang. Ini mungkin memakan waktu cukup lama; harap tunggu…</translation>
	<translation id="3554401467586751874">File cadangan berhasil dibuat</translation>
	<translation id="2349211327705667074">Lihat file cadangan</translation>
	<translation id="3049367131589710124">Lihat log kesalahan</translation>
	<translation id="1079017345574916945">Desktop jarak jauh</translation>
	<translation id="3064478898280877715">Toko aplikasi</translation>
	<translation id="5890206344045530832">Pemasang</translation>
	<translation id="2173278076276376488">Utilitas ini akan membantu Anda menginstal <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ke penyimpanan internal perangkat ini.</translation>
	<translation id="5323182426977498659">Peringatan! Prosedur ini bersifat merusak dan tidak dapat dibatalkan. Harap dicatat bahwa kami tidak akan bertanggung jawab atas potensi kehilangan data Anda atau memberikan dukungan teknis mendesak apa pun, risiko Anda tanggung sendiri.</translation>
	<translation id="8517836015601969896">Instalasi disk penuh</translation>
	<translation id="7300045760790370189">Instal <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> untuk menempati seluruh hard disk, semua data pada hard disk target akan dihapus.</translation>
	<translation id="8762511733918256595">Instalasi multi-boot</translation>
	<translation id="248900698427753678">Instal <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ke partisi hard disk yang sudah ada, sehingga <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> bisa ada secara paralel dengan OS lain. Semua data di partisi target akan dihapus.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan diinstal pada hard drive yang Anda pilih; semua data pada disk target akan dihapus.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Tidak ada disk yang tersedia</translation>
	<translation id="8217653566575018388">Instalasi selesai</translation>
	<translation id="8846746259444262774">Instalasi gagal</translation>
	<translation id="7263815009235541549">Instalasi telah selesai dengan sukses. Harap matikan perangkat Anda terlebih dahulu, lalu lepaskan media instalasi apa pun, dan hidupkan kembali untuk mem-boot <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, ada yang tidak beres dan instalasi tidak selesai. Silakan coba lagi prosesnya. Jika kesalahan yang sama masih terjadi, hubungi Dukungan JemaOS dengan log di atas.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan diinstal pada partisi hard drive Anda yang dipilih. Berdasarkan skema multi-boot saat ini, ini hanya dapat dilanjutkan jika perangkat Anda mendukung UEFI dan hard disk Anda diformat dengan GPT.</translation>
	<translation id="7831363758161884243">Partisi target akan dihapus; Anda juga perlu menentukan partisi EFI aktif Anda (biasanya dilakukan secara otomatis) karena Penginstal perlu mengubah konfigurasi boot sistem.</translation>
	<translation id="5670799238446305550">Pilih partisi target <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Partisi</translation>
	<translation id="5610519566593708119">Pilih partisi EFI</translation>
	<translation id="3367650349940010965">Tidak ada partisi yang tersedia untuk disk yang dipilih</translation>
	<translation id="7453223384507098390">Tidak ada partisi EFI yang tersedia untuk disk yang dipilih</translation>
	<translation id="1854532683465500847">Ukuran partisi yang dipilih kurang dari 20GB, instalasi mungkin gagal</translation>
	<translation id="4144613075340468247">Partisi yang dipilih telah dipasang ke multi-boot <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>, pemasangan lagi mungkin gagal</translation>
	<translation id="5793361052649920836">Setelah instalasi, bagaimana Anda ingin mem-boot <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instal dan konfigurasikan rEFInd untuk saya (disarankan)</translation>
	<translation id="1858708492548921044">rEFInd adalah program boot manager yang menawarkan antarmuka grafis bagus untuk opsi boot OS ketika PC Anda dinyalakan, Anda akan dapat memilih OS yang Anda inginkan untuk boot dengannya. Untuk informasi lebih lanjut mengenai rEFInd, silakan merujuk ke berandanya.</translation>
	<translation id="3861924051442564602">Tambahkan opsi menu boot UEFI untuk saya</translation>
	<translation id="8622370666798589804">Saat PC dinyalakan, Anda mungkin bisa masuk ke menu opsi boot UEFI (kemungkinan besar dengan menekan tombol pintas), opsi ini menambahkan <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> sebagai entri ke menu tersebut. (Hanya mendukung beberapa model firmware BIOS dan UEFI).</translation>
	<translation id="1569398690544416170">Jangan lakukan apa pun di sini, saya akan mengkonfigurasinya sendiri</translation>
	<translation id="3554866444001249532">Skrip instalasi ini hanya akan memasukkan file .efi yang diperlukan untuk mem-boot <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ke partisi EFI, Anda perlu mengonfigurasi cara mem-boot-nya sendiri.</translation>
	<translation id="7492832751164189534">Paksa berhenti</translation>
	<translation id="5159534860632584026">Proses instalasi telah dihentikan</translation>
	<translation id="8686749782014838344">Gagal mendapatkan informasi disk</translation>
	<translation id="5688543378771259173">Instalasi sedang dihentikan...</translation>
	<translation id="5350452134936384991">Instal di USB</translation>
	<translation id="8008470485414925603">Instal <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ke disk USB; semua data pada disk USB target akan dihapus.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> akan diinstal pada disk USB pilihan Anda; semua data pada disk target akan dihapus.</translation>
	<translation id="5725593226060700263">Tidak ada disk USB yang tersedia</translation>
	<translation id="4357040841587078287">Kami mendeteksi bahwa Anda menjalankan salinan JemaOS ini dari file gambar yang diunduh. Untuk memanfaatkan fitur dukungan terlengkap (termasuk pembaruan Over-The-Air) yang ditawarkan JemaOS, kami sangat menyarankan Anda meluncurkan fungsi "Penginstal" untuk melakukan instalasi JemaOS dalam disk penuh ke perangkat penyimpanan terpisah.</translation>
	<translation id="1246398339704431302">Anda dapat <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>tetap menggunakan salinan JemaOS ini<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proses instalasi dapat dijalankan pada tahap selanjutnya dalam sistem, namun, semua data Anda akan dihapus setelah instalasi dan Anda akan memulai lagi dari halaman ini.</translation>
	<translation id="3654532222088291133">Daripada memasukkan sandi akun JemaOS untuk masuk, Anda bisa membuat sandi <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> untuk perangkat ini</translation>
	<translation id="8377684629839541977">Gunakan kata sandi akun JemaOS</translation>

