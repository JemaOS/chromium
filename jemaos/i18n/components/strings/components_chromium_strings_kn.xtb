<!DOCTYPE translationbundle>
<translationbundle lang="kn">

<!-- jemaos_menus -->
<translation id="5027700305690795897">JemaOS ತನ್ನ ಆರಂಭಿಕ ಸೆಟಪ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿಲ್ಲ.</translation>
<translation id="4257170804800372451">JemaOS ಮತ್ತು Thot <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ಓಪನ್ ಸೋರ್ಸ್ ಪ್ರಾಜೆక್ಟ್ ಮತ್ತು ಇತರ <ph name="BEGIN_LINK_OSS" />ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_OSS" />‌ಗಳಿಂದ ಸಾಧ್ಯವಾಗಿವೆ.</translation>
</translationbundle>
