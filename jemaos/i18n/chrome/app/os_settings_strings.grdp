<?xml version="1.0" encoding="utf-8"?>
<!-- extend chrome/app/os_settings_strings.grdp, included from generated_resources.grd -->
<grit-part>
<if expr="chromeos_ash">
  <message name="IDS_SETTINGS_ABOUT_KEEP_JEMAOS_UPDATE_TO_DATE" desc="The text of keep jemaos update title in os-settings about section.">
    Automatically keep my <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> up to date
  </message>
  <message name="IDS_SETTINGS_ABOUT_JEMAOS_UPDATE_ENABLED" desc="The text of keep jemaos update status in os-settings about section.">
    <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> update enabled
  </message>
  <message name="IDS_SETTINGS_ABOUT_JEMAOS_UPDATE_DISABLED" desc="The text of disable jemaos update status in os-settings about section.">
    <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> update disabled
  </message>
  <message name="IDS_SETTINGS_ABOUT_PAGE_JEMAOS_VERSION" desc="The text label describing the version of the browser, example: Version 57.0.2937.0 (Developer Build) unknown (64-bit)">
    <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> <ph name="JEMAOS_MAJOR_VERSION">$2<ex>v9.0</ex></ph> (<ph name="PRODUCT_CHANNEL">$3<ex>Developer Build</ex></ph>) Platform <ph name="JEMAOS_PLATFORM_VERSION">$4<ex>12739.22.9.15</ex></ph> <ph name="PRODUCT_VERSION_BITS">$5</ph>
  </message>
  <message name="IDS_SETTINGS_JEMAOS_REMOTE_DESKTOP_APP_NAME" desc="Title of remote desktop app in os-settings menu">
    Remote desktop
  </message>
  <message name="IDS_SETTINGS_CROSTINI_VERSION" desc="Version label for crostini">
    Version
  </message>
  <message name="IDS_SETTINGS_CROSTINI_RELAUNCH" desc="The label for the relaunch button that relaunches the browser once update is complete">
    Restart
  </message>
  <message name="IDS_SETTINGS_CROSTINI_CHECK_FOR_UPDATES" desc="The button label to check for updates and apply (download and install) if found">
    Check for updates
  </message>
  <message name="IDS_SETTINGS_CROSTINI_UPDATE" desc="Status label: just do update">
    Update
  </message>
  <message name="IDS_SETTINGS_CROSTINI_UPGRADE_CHECK_STARTED" desc="Status label: About to start checking for updates">
    Checking for updates
  </message>
  <message name="IDS_SETTINGS_CROSTINI_UPGRADE_UP_TO_DATE" desc="Status label: Crostini Already up to date">
    Your Linux is up to date
  </message>
  <message name="IDS_SETTINGS_CROSTINI_UPDATE_AVAILABLE" desc="message of jemaos stateful update available in settings">
    Thers's a critical update available for the Linux(beta) component. It's strongly recommended to perform this update as soon as possible or your Linux(beta) may no longer work.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS" desc="jemaos settings page title">
    <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> settings
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_MENU_ITEM_DESCRIPTION" desc="jemaos settings sublabel">
    JemaOS account, backup, misc
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_WIFI_DRIVER_TITLE" desc="jemao settings wifi section title">
    Wifi settings
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_TOUCHPAD_MODE_TITLE" desc="jemao settings touchpad section title">
    Touchpad settings
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_ASSISTANCE_TITLE" desc="jemaos settings remote assist section title">
    Remote services
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_HELPER_SERVICE_TITLE" desc="jemaos settings remote helper service title">
    Remote diagnosis service
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_HELPER_SERVICE_DESC" desc="jemaos settings remote helper service desc">
    Remote diagnosis service enables official JemaOS support representatives to identify system issues. Currently remote diagnosis service can only be initialised by JemaOS official support representatives.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_HELPER_SERVICE_ENABLED_MESSAGE" desc="jemaos settings remote helper service message when it is enabled">
    Please share this number to official JemaOS support representatives
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_HELPER_SERVICE_STARGING_MESSAGE" desc="jemaos settings remote helper service message when it is starting">
    Starting remote diagnosis service...
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REMOTE_HELPER_SERVICE_REQUIRE_RESTART_MESSAGE" desc="jemaos settings remote helper service message when it requires restart">
    Please stop remote diagnosis service and try again
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_MORE_INFO_TITLE" desc="jemaos settings more_info title">
    More info
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_OTHER_TWEAKS_TITLE" desc="jemaos settings other tweaks title">
    Miscellaneous
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_REBOOT_BUTTON_IN_TRAY_LABEL" desc="jemaos settings label show reboot button in tray">
    "Restart" button
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_DISPLAY_REBOOT_BUTTON_IN_TRAY" desc="jemaos settings show reboot button in tray">
    Display a "Restart" button on the system menu
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_ROTATE_SCREEN_BUTTON_IN_TRAY_LABEL" desc="jemaos settings label show rotate screen button in tray">
    "Rotate screen" button
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_NOT_TABLET_STATE_DISABLE_ROTATE_SCREEN" desc="jemaos settings, not in tablet state, disable rotate screen">
    You are not on tablet-mode at the moment, "Rotate screen" button is now hidden
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_DISPLAY_ROTATE_SCREEN_BUTTON" desc="jemaos settings show rotate screen button in tray">
    Display a "Rotate screen" button on the system menu
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SWITCH_TABLET_LAPTOP_MODE_BUTTON_IN_TRAY_LABEL" desc="jemaos settings label show tablet/laptop mode switch button in tray">
    Tablet/Laptop switch
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_DISPLAY_SWITCH_TABLET_LAPTOP_MODE_BUTTON" desc="jemaos settings show tablet/laptop mode switch button in tray">
    Display a tablet/laptop switch on the system menu
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_ENABLE_LIBWIDEVINE_LABEL" desc="jemaos settings libwidevine switch label">
    Enable Widevine
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_TOGGLE_LIBWIDEVINE_HELP_MESSAGE" desc="jemaos settings libwidevine switch hint msg">
    Enable Widevine for streaming protected premium content. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$1"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SELECT_WIDEVINE_FILE_DIALOG_TITLE" desc="jemaos settings title of selecting libwidevine dialog">
    Select "libwidevine.so"
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_FAILED_ENABLE_WIDEVINE_TITLE" desc="jemaos settings title of failed enabling libwidevine">
    Failed to enable Widevine...
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_FAILED_ENABLE_WIDEVINE_MESSAGE" desc="jemaos settings message of failed enabling libwidevine">
    The selected "libwidevine.so" is not valid, please try again with a different file.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_ACCOUNT_TITLE" desc="jemaos settings account section title">
    JemaOS account settings
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_EXPERIMENTAL_FEATURES_TITLE" desc="title of jemaos settings experimental features title">
    Experimental features
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BYPASS_TPM_CHECKS_TITLE" desc="title of experimental feature bypass tpm checks">
    Bypass Trusted Platform Module(TPM) checks
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BYPASS_TPM_CHECKS_DESC" desc="short desc for experimental feature bypass tpm checks">
    Some of the features could fail due to incompatible TPM chip in your device, you can bypass TPM checks as a workaround.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_AUTO_SIGNIN_FOR_LOCAL_ACCOUNT_TITLE" desc="title of jemaos settings enable auto signin">
    Auto sign-in
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_ENABLE_AUTO_SIGNIN_FOR_LOCAL_ACCOUNT_MESSAGE" desc="message of jemaos settings enable auto signin">
    Allow the current account to sign-in to desktop automatically when the device reboots
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_AUTO_SIGNIN_FOR_LOCAL_ACCOUNT_ALREADY_ENABLED_BY_OTHER" desc="message of other user already enabled auto signin">
    Unable to activate for this account; there is an active auto sign-in configured for other accounts in this device
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_UNABLE_TO_SET_AUTO_SIGNIN_FOR_LOCAL_ACCOUNT" desc="message of unable to turn on auto signin">
    Unable to activate for this account; there is an unknown error when initialising the file systems for this account. Please try rebooting or creating a new account
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_UNABLE_TO_SET_AUTO_SIGNIN_FOR_NON_LOCAL_ACCOUNT" desc="message of unable to turn on auto signin for non-local account">
    Unable to activate for this account; auto sign-in option is only available for "Local account" type.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_UNABLE_TO_SET_AUTO_SIGNIN_WITHOUT_PASSWORD_AUTH_FACTOR" desc="message of unable to turn on auto signin without password auth factor">
    Please add a login password in the <ph name="BEGIN_LINK">&lt;a href="#"&gt;</ph>Privacy and security<ph name="END_LINK">&lt;/a&gt;</ph> settings before enabling automatic sign-in.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_OTA_DISALLOWED_BY_LICENSE_VALIDATION" desc="message of ota disallowed by license validation">
    A newer version of JemaOS is available to update now. However, your JemaOS for You subscription has expired, you need an active subscription to update your JemaOS.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_OTA_DISALLOWED_REQUIRES_ONE_TIME_PAYMENT" desc="message of ota disallowed requires one time payment">
    A new milestone version of JemaOS is available to update now. You need to pay a one-off fee to continue with this update.
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_SAVE_FILE_DIALOG_TITLE" desc="Title for backing up">
    Please specify the path to store the backup file
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_LABEL" desc="Label on os-settings jemaos backup section">
    Create a backup file for this account (beta). <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$1"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_BUTTON_LABEL" desc="Text on os-settings jemaos backup button">
    Backup
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_INTRO_TITLE" desc="Title for backup intro">
    Create a backup file for this account (beta)
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_INTRO_TEXT" desc="Text for backup intro">
    This operation creates a full disk backup for this account, making it easy to restore to the state of your JemaOS when the backup was created, including settings, installed browser extensions and subsystem apps. Depending on your apps and the contents of your personal folder, the backup file may be large; it is recommended to store the backup file on an external storage device. If you have a portable USB drive, please connect it now. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$1"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_PASSWORD_PROMPT_TITLE" desc="Title for backup password prompt">
    Please enter the login password for this account
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_PASSWORD_PROMPT_TEXT" desc="Text for backup password prompt">
    Please remember this password, as it will be required when restoring this backup file
  </message>
  
  <!-- Restore functionality strings -->
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_SELECT_FILE_DIALOG_TITLE" desc="Title for restore file picker">
    Select Backup File to Restore
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_LABEL" desc="Label on os-settings jemaos restore section">
    Restore your JemaOS data from a backup file
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_BUTTON_LABEL" desc="Text on os-settings jemaos restore button">
    Restore
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_PASSWORD_DIALOG_TITLE" desc="Title for restore password dialog">
    Enter Backup Password
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_PASSWORD_DIALOG_MESSAGE" desc="Message in restore password dialog">
    Enter the password used to encrypt this backup file
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_PASSWORD_LABEL" desc="Label for password field">
    Backup Password
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_PASSWORD_ERROR" desc="Error message for invalid password">
    Invalid password
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_SUCCESS_TITLE" desc="Title for successful restore">
    Restore Successful
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_ERROR_TITLE" desc="Title for failed restore">
    Restore Failed
  </message>
  
  <!-- Cloud backup/restore strings -->
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_LOCAL_DESC" desc="Description for local backup">
    Save backup to your device or external storage
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_BACKUP_LABEL" desc="Label for cloud backup section">
    Cloud Backup
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_BACKUP_DESC" desc="Description for cloud backup">
    Upload backup to JemaOS cloud storage
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_BACKUP_BUTTON_LABEL" desc="Text on cloud backup button">
    Backup to Cloud
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_RESTORE_LOCAL_DESC" desc="Description for local restore">
    Restore from local backup file
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_RESTORE_LABEL" desc="Label for cloud restore section">
    Cloud Restore
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_RESTORE_DESC" desc="Description for cloud restore">
    Download and restore from JemaOS cloud
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOUD_RESTORE_BUTTON_LABEL" desc="Text on cloud restore button">
    Restore from Cloud
  </message>
  
  <!-- Backup/Restore notification strings -->
  <message name="IDS_JEMAOS_BACKUP_NOTIFICATION_RUNNING_TITLE" desc="Title for backup running notification">
    Backup in Progress
  </message>
  <message name="IDS_JEMAOS_BACKUP_NOTIFICATION_FINISHED_TITLE" desc="Title for backup finished notification">
    Backup Complete
  </message>
  <message name="IDS_JEMAOS_BACKUP_NOTIFICATION_FINISHED_MESSAGE" desc="Message for backup finished notification">
    Your backup has been created successfully
  </message>
  <message name="IDS_JEMAOS_BACKUP_NOTIFICATION_FAILED_TITLE" desc="Title for backup failed notification">
    Backup Failed
  </message>
  <message name="IDS_JEMAOS_BACKUP_NOTIFICATION_FAILED_MESSAGE" desc="Message for backup failed notification">
    An error occurred during the backup process
  </message>
  
  <!-- Backup API and Storage strings -->
  <message name="IDS_OS_SETTINGS_JEMAOS_CONNECT_API_USER_INFO_TITLE" desc="Title for connect API user information section">
    Connect API User Information
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_LOADING" desc="Loading message">
    Loading...
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_USER_ID_LABEL" desc="Label for user ID">
    User ID
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_STATUS_LABEL" desc="Label for status">
    Status
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_BACKUP_STORAGE_ANALYSIS_TITLE" desc="Title for backup storage analysis section">
    Backup Storage Analysis
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_USER_ID_REQUIRED" desc="Message when user ID is required">
    User ID required
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_STORAGE_LABEL" desc="Label for storage information">
    Storage
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_LAST_UPDATED_LABEL" desc="Label for last updated time">
    Last updated
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_HARDWARE_DEVICES_LABEL" desc="Label for hardware devices count">
    Hardware devices
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_NO_BACKUP_DATA" desc="Message when no backup data is available">
    No backup data available
  </message>
  
  <!-- Restore dialog strings -->
  <message name="IDS_OS_SETTINGS_JEMAOS_CLOSE" desc="Close button text">
    Close
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_LOADING_BACKUP_FILES" desc="Message shown while loading backup files">
    Loading backup files...
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SELECT_BACKUP_FILE_LABEL" desc="Label for backup file selection">
    Select backup file to restore:
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SELECT_BACKUP_FILE_PLACEHOLDER" desc="Placeholder text for backup file selection">
    -- Select a backup file --
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_NO_BACKUP_FILES_FOUND" desc="Message when no backup files are found">
    No backup files found. Please create a backup first.
  </message>
  
  <!-- JemaOS AI Assistant strings -->
  <message name="IDS_OS_SETTINGS_JEMAOS_COMING_SOON" desc="Text shown for features coming soon">
    Coming Soon
  </message>
  
  <!-- Japanese Dictionary strings -->
  <message name="IDS_OS_SETTINGS_ADD_DICTIONARY" desc="Button text to add a new dictionary">
    Add dictionary
  </message>
  
  <!-- Bluetooth device image alt text -->
  <message name="IDS_OS_SETTINGS_BLUETOOTH_LEFT_BUD_IMAGE_ALT" desc="Alt text for left earbud device image">
    Left bud device image
  </message>
  <message name="IDS_OS_SETTINGS_BLUETOOTH_CASE_IMAGE_ALT" desc="Alt text for charging case device image">
    Case device image
  </message>
  <message name="IDS_OS_SETTINGS_BLUETOOTH_RIGHT_BUD_IMAGE_ALT" desc="Alt text for right earbud device image">
    Right bud device image
  </message>
  <message name="IDS_OS_SETTINGS_BLUETOOTH_DEFAULT_IMAGE_ALT" desc="Alt text for default device image">
    Default device image
  </message>
  
  <message name="IDS_OS_SETTINGS_JEMAOS_TOGGLE_ARC_MEDIA_AUTO_SCAN_LABEL" desc="Text for toggling arc media autoscan">
    Disable automatic media file scanning for all partitions to optimize battery life. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$1"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SECURITY_SECTION_TITLE" desc="Title of security section on os-settings jemaos">
    Security options
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_DEV_MODE_TRANSITION_LABEL" desc="Label on os-settings jemaos dev mode transition section">
    Enable "Developer mode" for this <ph name="IDS_SHORT_PRODUCT_OS_NAME">$1<ex>JemaOS</ex></ph> installation with more developer features. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$2"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_IN_DEV_MODE_TOOLTIP" desc="In dev mode message on os-settings jemaos dev mode transition section">
    You are already in "Developer mode"
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_ENABLE_DEV_MODE_BUTTON_TEXT" desc="Text on action button of os-settings jemaos dev mode transition section">
    Enable "Developer mode"
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_ENABLE_DEV_MODE_CONFIRM_TITLE" desc="confirm title of os-settings jemaos dev mode transition section">
    Warning
  </message>
  <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_ENABLE_DEV_MODE_CONFIRM_MESSAGE" desc="confirm message of os-settings jemaos dev mode transition section">
    Warning! Enabling “Developer mode“ is an irreversible operation. If you wish to disable “Developer mode“ you must reinstall JemaOS, resulting in all data being wiped. Please back up your data and proceed at your own risk.
  </message>
  <message name="IDS_SETTINGS_ABOUT_PAGE_NEW_JEMAOS_VERSION_WITHOUT_LICENSE_STATE" desc="The text label describing the version of the browser, example: JemaOS for PC (apu), v18.0-SP1, Platform 15662.71.18.6">
    <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> <ph name="DEVICE_VARIANT">$2<ex> for PC (apu)</ex></ph>, <ph name="JEMAOS_MAJOR_VERSION">$3<ex>v9.0</ex></ph>
    <ph name="LINE_BREAK1">&lt;br&gt;</ph>
    Platform <ph name="JEMAOS_PLATFORM_VERSION">$4<ex>12739.22.9.15</ex></ph>
    <ph name="LINE_BREAK2">&lt;br&gt;</ph>
    Chromium <ph name="PRODUCT_VERSION">$5<ex>57.0.2937.0</ex></ph>
  </message>
  <if expr="use_jemaos_license">
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_STATE_LOADING" desc="loading text of license info page">
     Loading...
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_RETRY_BUTTON" desc="text of retry button in license page">
     Retry
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_OFFLINE_HINT_MESSAGE" desc="offline message in license page">
     Currently offline
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_MENU" desc="title of license info menu in os about page">
     Check your JemaOS subscription online
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_TITLE" desc="title of license info page">
     JemaOS subscription information
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_ERROR_MACHINE_ID" desc="error message of reading machine id/(license info)">
     There is an error with getting your Device ID
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_EXPIRE_DATE_LABEL" desc="text of expire date label in license page">
     Subscription ends
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_ID_LABEL" desc="text of id label in license page">
     Device ID
   </message>
   <message name="IDS_OS_SETTINGS_JEMAOS_SETTINGS_JEMAOS_LICENSE_INFO_RETRY_WEBVIEW_BUTTON" desc="text of retry webview button in license page">
     Check your subscription online
   </message>
   <message name="IDS_SETTINGS_ABOUT_PAGE_NEW_JEMAOS_VERSION" desc="The text label describing the version of the browser, with license state info, example: JemaOS for PC (apu), v18.0-SP1, Unlicensed version, Platform 15662.71.18.6">
     <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> <ph name="DEVICE_VARIANT">$2<ex> for PC (apu)</ex></ph>, <ph name="JEMAOS_MAJOR_VERSION">$3<ex>v9.0</ex></ph>, <ph name="JEMAOS_LICENSE_STATE_DESC">$4<ex>Non-commercial Edition</ex></ph>
     <ph name="LINE_BREAK1">&lt;br&gt;</ph>
     Platform <ph name="JEMAOS_PLATFORM_VERSION">$5<ex>12739.22.9.15</ex></ph>
     <ph name="LINE_BREAK2">&lt;br&gt;</ph>
     Chromium <ph name="PRODUCT_VERSION">$6<ex>57.0.2937.0</ex></ph>
   </message>
   <message name="IDS_SETTINGS_ABOUT_PAGE_JEMAOS_LICENSE_STATE_FOR_YOU_TRIAL" desc="The text label describing jemaos license state for you trial">
     Trial subscription
   </message>
   <message name="IDS_SETTINGS_ABOUT_PAGE_JEMAOS_LICENSE_STATE_FOR_YOU_VALID" desc="The text label describing jemaos license state for you valid">
     Active subscription
   </message>
   <message name="IDS_SETTINGS_ABOUT_PAGE_JEMAOS_LICENSE_STATE_FOR_YOU_EXPIRED" desc="The text label describing jemaos license state for you expired">
