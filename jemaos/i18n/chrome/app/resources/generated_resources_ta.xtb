<translation id="2896503748067813182">சோதனை சந்தா</translation>
<translation id="4362781408813685579">செயலில் உள்ள சந்தா</translation>
<translation id="1141274201089997510">காலாவதியான சந்தா</translation>
<translation id="2553683254139782404">வணிகமற்ற பதிப்பு</translation>
<translation id="8466048683756385518">எண்டர்பிரைஸ் உரிம பதிப்பு (சோதனை)</translation>
<translation id="2853871047705932424">எண்டர்பிரைஸ் உரிம பதிப்பு</translation>
<translation id="5239675900317881945">எண்டர்பிரைஸ் உரிம பதிப்பு (காலாவதியானது)</translation>
<translation id="189101945990408398">லெகசி Intel</translation>
<translation id="6816405236809604904">நவீன Intel</translation>
<translation id="6169452478137972655">AMD கிராஃபிக்ஸ்</translation>
<translation id="6183637837838262693">Intel Slim</translation>
<translation id="1270291881045478104">JemaOS AI ஐ இயக்கவும்</translation>
<translation id="2013780539677437932">அனைத்து JemaOS AI-தொடர்பான அம்சங்களையும் இயக்கவும் அல்லது முடக்கவும்</translation>
<translation id="3398637633218757480">JemaOS AI விரைவு அழைப்பை இயக்கவும்</translation>
<translation id="8986197796475507452">Ctrl + C + C ஐ அழுத்தி தனிப்படுத்தப்பட்ட உள்ளடக்கத்திற்கான JemaOS AI விருப்பங்களை விரைவாகக் கொண்டு வரவும்</translation>
<translation id="6407628130593274137">JemaOS AI க்கான பிற அமைப்புகள் மற்றும் விருப்பங்கள்</translation>
<translation id="4005574560653331142">இந்த உள்ளூர் கணக்கின் PIN அல்லது உள்நுழைவு கடவுச்சொல்லை மாற்ற, <ph name="BEGIN_LINK" />தனியுரிமை மற்றும் பாதுகாப்பு<ph name="END_LINK" /> அமைப்புகளுக்குச் செல்லவும்.</translation>
<!-- login_strings (JemaOS) -->
<translation id="6419913024856619425">நீங்கள் <ph name="LINK_START" />JemaOS உள்ளூர் கணக்குடன் உள்நுழையலாம்<ph name="LINK_END" />.</translation>
<translation id="5291842596976929391">மின்னஞ்சல் <ph name="EMAIL_ADDRESS" /> ஏற்கனவே உள்ளது. வேறு மின்னஞ்சலுடன் மீண்டும் முயற்சிக்கவும்.</translation>
<translation id="4519800823932975782">JemaOS உதவி மையம்</translation>
<translation id="4737474693231655139">பொதுவான JemaOS கேள்விகளுக்கான பதில்களையும் உதவி கட்டுரைகளையும் கண்டறியவும்</translation>
</translationbundle>
