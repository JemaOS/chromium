<translationbundle lang="ro">
	<translation id="7386402409475121504">Creați-vă contul JemaOS local</translation>
	<translation id="3760308806144055927">Conectați-vă la contul local JemaOS</translation>
	<translation id="3325117507482096812">Vă rugăm să introduceți o parolă</translation>
	<translation id="1838206877831947154">Parolele tale nu se potrivesc</translation>
	<translation id="2158276988029582286">Creați un nou cont local</translation>
	<translation id="8592849747346274067">Conectați-vă la un cont existent</translation>
	<translation id="482190417986201746">Numele de utilizator sau parola pe care le-ați introdus sunt incorecte</translation>
	<translation id="6603987686259425085">Vă puteți <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>să vă conectați cu un cont local JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-mailul <ph name="EMAIL_ADDRESS">$1</ph> există deja. Vă rugăm să reîncercați cu un alt e-mail.</translation>
	<translation id="7215016743510876720">Utilizați contul local</translation>
	<translation id="6657635042185516718">Continuați să utilizați contul online</translation>
	<translation id="6867476688065565618">Treci la contul local?</translation>
	<translation id="4840454774882557974">Dacă alegeți să utilizați un cont local, caracteristicile utile includ sincronizarea datelor și preferințelor dvs. pe mai multe dispozitive și conectarea automată la aplicațiile web folosind contul dvs. JemaOS nu va funcționa.</translation>
	<translation id="8951507920859729424">Vă recomandăm să utilizați un cont online pentru a utiliza JemaOS la maximum.</translation>
	<translation id="479773200536372215">Nu veți putea adăuga conturi Google deoarece lipsesc cheile API Google. Consultați <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> pentru detalii.</translation>
	<translation id="1198491307547164157">Nu veți putea adăuga conturi JemaOS deoarece lipsesc cheile API JemaOS. Consultați <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> pentru detalii.</translation>
	<translation id="5042404702659901995">Declarație de confidențialitate</translation>
	<translation id="4907736162587268100">Conținutul declarației de confidențialitate</translation>
	<translation id="5988344732274877691">Abonați-vă la buletinul informativ (foarte rar, promis) pentru JemaOS</translation>
	<translation id="1706203008474708805">Alăturați-vă planului de îmbunătățire a experienței utilizatorului JemaOS</translation>
	<translation id="1147139514756087229">Conectați-vă cu un cont local</translation>
	<translation id="2054784944085654098">Se creează fișierul de rezervă acum. Acest lucru poate dura ceva timp; va rog asteptati...</translation>
	<translation id="3554401467586751874">Fișierul de rezervă a fost creat cu succes</translation>
	<translation id="2349211327705667074">Vizualizați fișierul de rezervă</translation>
	<translation id="3049367131589710124">Vizualizați jurnalul de erori</translation>
	<translation id="1079017345574916945">Desktop la distanță</translation>
	<translation id="3064478898280877715">Magazin de aplicații</translation>
	<translation id="5890206344045530832">Instalator</translation>
	<translation id="2173278076276376488">Acest utilitar vă va ajuta să instalați <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pe stocarea internă a acestui dispozitiv.</translation>
	<translation id="5323182426977498659">Avertizare! Această procedură este distructivă și nu poate fi anulată. Vă rugăm să rețineți că nu vom deține nicio responsabilitate pentru potențiala pierdere de date și nici nu vom oferi suport tehnic urgent, procedați pe propriul risc.</translation>
	<translation id="8517836015601969896">Instalare completă pe disc</translation>
	<translation id="7300045760790370189">Instalați <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pentru a ocupa un hard disk întreg, toate datele de pe hard disk-ul țintă vor fi șterse.</translation>
	<translation id="8762511733918256595">Instalare multi-boot</translation>
	<translation id="248900698427753678">Instalați <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pe o partiție existentă a unui hard disk, unde <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> poate exista în paralel cu alt sistem de operare. Toate datele de pe partiția țintă vor fi șterse.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> va fi instalat pe hard diskul selectat; toate datele de pe discul țintă vor fi șterse.</translation>
	<translation id="4039091757234555415">Disc</translation>
	<translation id="7783580523889684697">Niciun disc disponibil</translation>
	<translation id="8217653566575018388">Instalare finalizată</translation>
	<translation id="8846746259444262774">Instalarea a eșuat</translation>
	<translation id="7263815009235541549">Instalarea s-a încheiat cu succes. Opriți mai întâi dispozitivul, apoi eliminați orice mediu de instalare și porniți-l din nou pentru a porni <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Hopa, ceva a mers prost și instalarea nu s-a finalizat. Vă rugăm să reîncercați procesul. Dacă aceeași eroare persistă, vă rugăm să contactați asistența JemaOS cu jurnalul de mai sus.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> va fi instalat pe partiția selectată de pe hard disk. Conform schemei actuale de pornire multiplă, acest lucru ar putea continua numai dacă dispozitivul acceptă UEFI și hard disk-urile sunt formatate cu GPT.</translation>
	<translation id="7831363758161884243">Partiția țintă va fi ștearsă; de asemenea, trebuie să specificați partiția EFI activă (de obicei realizată automat), deoarece instalatorul trebuie să modifice configurațiile de pornire a sistemului.</translation>
	<translation id="5670799238446305550">Selectați partiția țintă <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Partiție</translation>
	<translation id="5610519566593708119">Selectați partiția EFI</translation>
	<translation id="3367650349940010965">Nu există partiții disponibile pentru discul selectat</translation>
	<translation id="7453223384507098390">Nu există partiții EFI disponibile pentru discul selectat</translation>
	<translation id="1854532683465500847">Dimensiunea partiției selectate este mai mică de 20 GB, instalarea poate eșua</translation>
	<translation id="4144613075340468247">Partiția selectată a fost montată pe <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, instalarea pe aceasta din nou poate eșua</translation>
	<translation id="5793361052649920836">După instalare, cum doriți să porniți <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instalați și configurați rEFInd pentru mine (recomandat)</translation>
	<translation id="1858708492548921044">rEFInd este un program de boot manager care oferă o interfață grafică frumoasă pentru opțiunile de pornire a sistemului de operare atunci când pornește computerul, veți putea alege sistemul de operare dorit pentru a porni cu acesta. Pentru mai multe informații despre rEFInd, vă rugăm să consultați pagina de pornire.</translation>
	<translation id="3861924051442564602">Adăugați o opțiune de meniu de boot UEFI pentru mine</translation>
	<translation id="8622370666798589804">Când pornește computerul, este posibil să puteți intra în meniul de opțiuni de pornire UEFI (cel mai probabil prin apăsarea unei taste rapide), această opțiune adaugă <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ca intrare în meniul respectiv. (Acceptă doar unele modele de firmware BIOS și UEFI).</translation>
	<translation id="1569398690544416170">Nu face nimic aici, o voi configura eu</translation>
	<translation id="3554866444001249532">Acest script de instalare va pune doar fișierele .efi necesare pentru pornirea <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pe partiția dvs. EFI, va trebui să configurați modul de pornire singur.</translation>
	<translation id="7492832751164189534">Forțați renunțarea</translation>
	<translation id="5159534860632584026">Procesul de instalare a fost încheiat</translation>
	<translation id="8686749782014838344">Nu s-au putut obține informații despre disc</translation>
	<translation id="5688543378771259173">Instalarea se încheie...</translation>
	<translation id="5350452134936384991">Instalați în USB</translation>
	<translation id="8008470485414925603">Instalați <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> pe un disc USB; toate datele de pe discul USB țintă vor fi șterse.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> va fi instalat pe discul USB selectat; toate datele de pe discul țintă vor fi șterse.</translation>
	<translation id="5725593226060700263">Nu este disponibil un disc USB</translation>
	<translation id="4357040841587078287">Am detectat că executați această copie a JemaOS dintr-un fișier imagine descărcat. Pentru a utiliza cele mai cuprinzătoare funcții de asistență (inclusiv actualizările Over-The-Air) pe care le poate oferi JemaOS, vă recomandăm insistent să lansați funcția „Installer” pentru a realiza o instalare completă a JemaOS pe disc pe un dispozitiv de stocare separat.</translation>
	<translation id="1246398339704431302">Puteți <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>continuați să utilizați această copie a JemaOS oricum<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, procesul de instalare poate fi executat într-o etapă ulterioară în sistem, cu toate acestea, toate datele dumneavoastră vor fi șterse din nou după instalare și veți începe din nou.</translation>
	<translation id="3654532222088291133">În loc să introduceți parola contului dvs. JemaOS pentru a vă conecta, puteți crea o parolă de <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> pentru acest dispozitiv</translation>
	<translation id="8377684629839541977">Utilizați parola contului JemaOS</translation>

