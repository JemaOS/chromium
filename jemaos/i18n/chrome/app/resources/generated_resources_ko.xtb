<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="ko">
	<translation id="7386402409475121504">로컬 JemaOS 계정 만들기</translation>
	<translation id="3760308806144055927">로컬 JemaOS 계정에 로그인하세요.</translation>
	<translation id="3325117507482096812">비밀번호를 입력해주세요</translation>
	<translation id="1838206877831947154">비밀번호가 일치하지 않습니다.</translation>
	<translation id="2158276988029582286">새 로컬 계정 만들기</translation>
	<translation id="8592849747346274067">기존 계정에 로그인</translation>
	<translation id="482190417986201746">입력한 사용자 이름 또는 비밀번호가 올바르지 않습니다.</translation>
	<translation id="6603987686259425085"><ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>JemaOS 로컬 계정<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>으로 로그인할 수 있습니다.</translation>
	<translation id="3598802966230712759">이메일 <ph name="EMAIL_ADDRESS">$1</ph>이(가) 이미 존재합니다. 다른 이메일로 다시 시도해 주세요.</translation>
	<translation id="7215016743510876720">로컬 계정 사용</translation>
	<translation id="6657635042185516718">온라인 계정을 계속 사용하세요</translation>
	<translation id="6867476688065565618">로컬 계정으로 전환하시겠습니까?</translation>
	<translation id="4840454774882557974">로컬 계정을 사용하기로 선택한 경우 여러 장치에서 데이터와 기본 설정을 동기화하는 유용한 기능이 있으며 JemaOS 계정을 사용하여 웹 앱에 자동으로 로그인하는 것은 작동하지 않습니다.</translation>
	<translation id="8951507920859729424">JemaOS를 최대한 활용하려면 온라인 계정을 사용하는 것이 좋습니다.</translation>
	<translation id="479773200536372215">Google API 키가 누락되어 Google 계정을 추가할 수 없습니다. 자세한 내용은 <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>를 참조하세요.</translation>
	<translation id="1198491307547164157">JemaOS API 키가 누락되어 JemaOS 계정을 추가할 수 없습니다. 자세한 내용은 <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph>를 참조하세요.</translation>
	<translation id="5042404702659901995">개인 정보 보호 정책</translation>
	<translation id="4907736162587268100">개인 정보 보호 정책 내용</translation>
	<translation id="5988344732274877691">JemaOS에 대한 (매우 드물지만 약속된) 뉴스레터에 가입하세요</translation>
	<translation id="1706203008474708805">JemaOS 사용자 경험 개선 계획에 동참하세요</translation>
	<translation id="1147139514756087229">로컬 계정으로 로그인</translation>
	<translation id="2054784944085654098">지금 백업 파일을 생성 중입니다. 시간이 좀 걸릴 수 있습니다. 기다려주세요…</translation>
	<translation id="3554401467586751874">백업 파일이 성공적으로 생성되었습니다</translation>
	<translation id="2349211327705667074">백업 파일 보기</translation>
	<translation id="3049367131589710124">오류 로그 보기</translation>
	<translation id="1079017345574916945">원격 데스크톱</translation>
	<translation id="3064478898280877715">앱스토어</translation>
	<translation id="5890206344045530832">설치자</translation>
	<translation id="2173278076276376488">이 유틸리티는 이 기기의 내부 저장소에 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 설치하는 데 도움이 됩니다.</translation>
	<translation id="5323182426977498659">경고! 이 절차는 파괴적이므로 취소할 수 없습니다. 귀하의 잠재적인 데이터 손실에 대해 당사는 어떠한 책임도 지지 않으며 긴급한 기술 지원도 제공하지 않으므로 책임은 귀하에게 있습니다.</translation>
	<translation id="8517836015601969896">Full disk installation</translation>
	<translation id="7300045760790370189"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 설치하여 전체 하드 디스크를 차지하면 대상 하드 디스크의 모든 데이터가 지워집니다.</translation>
	<translation id="8762511733918256595">다중 부팅 설치</translation>
	<translation id="248900698427753678">Install <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> to an existing partition of a hard disk, where <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> can exist in parallel with other OS. 대상 파티션의 모든 데이터가 지워집니다.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>가 선택한 하드 드라이브에 설치됩니다. 대상 디스크의 모든 데이터가 지워집니다.</translation>
	<translation id="4039091757234555415">디스크</translation>
	<translation id="7783580523889684697">사용 가능한 디스크가 없습니다.</translation>
	<translation id="8217653566575018388">설치 완료</translation>
	<translation id="8846746259444262774">설치 실패</translation>
	<translation id="7263815009235541549">설치가 성공적으로 완료되었습니다. 먼저 기기의 전원을 끄고 설치 미디어를 모두 제거한 후 다시 전원을 켜서 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 부팅하세요.</translation>
	<translation id="3380151284134965398">이런, 문제가 발생하여 설치가 완료되지 않았습니다. 프로세스를 다시 시도하십시오. 동일한 오류가 지속되면 위의 로그를 가지고 JemaOS 지원팀에 문의해 주세요.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>가 하드 드라이브의 선택한 파티션에 설치됩니다. 현재 다중 부팅 구성표에서는 장치가 UEFI를 지원하고 하드 디스크가 GPT로 포맷된 경우에만 진행할 수 있습니다.</translation>
	<translation id="7831363758161884243">대상 파티션이 지워집니다. 또한 설치 프로그램이 시스템 부팅 구성을 수정해야 하므로 활성 EFI 파티션(대개 자동으로 수행됨)을 지정해야 합니다.</translation>
	<translation id="5670799238446305550"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 대상 파티션을 선택하세요.</translation>
	<translation id="3695537760133394753">파티션</translation>
	<translation id="5610519566593708119">EFI 파티션 선택</translation>
	<translation id="3367650349940010965">선택한 디스크에 사용할 수 있는 파티션이 없습니다.</translation>
	<translation id="7453223384507098390">선택한 디스크에 사용할 수 있는 EFI 파티션이 없습니다.</translation>
	<translation id="1854532683465500847">선택한 파티션의 크기가 20GB 미만이므로 설치에 실패할 수 있습니다.</translation>
	<translation id="4144613075340468247">선택한 파티션이 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 멀티 부팅에 마운트되었습니다. 다시 설치하지 못할 수 있습니다.</translation>
	<translation id="5793361052649920836">설치 후 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 어떻게 부팅하시겠습니까?</translation>
	<translation id="4273235330352963866">rEFInd 설치 및 구성(권장)</translation>
	<translation id="1858708492548921044">rEFInd는 PC가 시작될 때 OS 부팅 옵션에 대한 멋진 그래픽 인터페이스를 제공하는 부팅 관리자 프로그램으로, 원하는 OS를 선택하여 부팅할 수 있습니다. rEFInd에 대한 자세한 내용은 홈페이지를 참조하시기 바랍니다.</translation>
	<translation id="3861924051442564602">나를 위한 UEFI 부팅 메뉴 옵션 추가</translation>
	<translation id="8622370666798589804">PC가 시작되면 UEFI 부팅 옵션 메뉴에 들어갈 수 있습니다(대개 단축키를 눌러). 이 옵션은 해당 메뉴에 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 항목으로 추가합니다. (일부 BIOS 및 UEFI 펌웨어 모델만 지원합니다).</translation>
	<translation id="1569398690544416170">여기서는 아무것도 하지 마세요. 제가 직접 구성하겠습니다.</translation>
	<translation id="3554866444001249532">이 설치 스크립트는 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> 부팅에 필요한 .efi 파일만 EFI 파티션에 저장하므로 부팅 방법을 직접 구성해야 합니다.</translation>
	<translation id="7492832751164189534">강제 종료</translation>
	<translation id="5159534860632584026">설치 프로세스가 종료되었습니다</translation>
	<translation id="8686749782014838344">디스크 정보를 가져오지 못했습니다.</translation>
	<translation id="5688543378771259173">설치가 종료됩니다...</translation>
	<translation id="5350452134936384991">USB에 설치</translation>
	<translation id="8008470485414925603">USB 디스크에 <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>를 설치합니다. 대상 USB 디스크의 모든 데이터가 지워집니다.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>가 선택한 USB 디스크에 설치됩니다. 대상 디스크의 모든 데이터가 지워집니다.</translation>
	<translation id="5725593226060700263">사용 가능한 USB 디스크가 없습니다.</translation>
	<translation id="4357040841587078287">다운로드한 이미지 파일에서 JemaOS 사본을 실행하고 있는 것을 감지했습니다. JemaOS가 제공할 수 있는 가장 포괄적인 지원 기능(Over-The-Air 업데이트 포함)을 활용하려면 "설치 프로그램" 기능을 실행하여 별도의 저장 장치에 JemaOS의 전체 디스크 설치를 수행하는 것이 좋습니다.</translation>
	<translation id="1246398339704431302"><ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>어쨌든 이 JemaOS 사본을 계속 사용할 수 있습니다<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>. 설치 프로세스는 시스템의 나중 단계에서 실행될 수 있습니다. 그러나 설치 후 모든 데이터가 지워지고 이 페이지에서 다시 시작하게 됩니다.</translation>
	<translation id="3654532222088291133">로그인하기 위해 JemaOS 계정 비밀번호를 입력하는 대신 이 기기에 대한 <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> 비밀번호를 생성할 수 있습니다.</translation>
	<translation id="8377684629839541977">JemaOS 계정 비밀번호 사용</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398"><ph name="DEVICE_OS" />를 자동으로 최신 상태로 유지</translation>
<translation id="2347352406101856238"><ph name="DEVICE_OS" /> 업데이트가 사용 설정됨</translation>
<translation id="185834232609012804"><ph name="DEVICE_OS" /> 업데이트가 사용 중지됨</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" />(<ph name="PRODUCT_CHANNEL" />) 플랫폼 <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">원격 데스크톱</translation>
<translation id="6898090158927982244">Linux가 최신 상태입니다</translation>
<translation id="4886703929102211360">Linux(베타) 구성요소에 대한 중요 업데이트가 있습니다. 이 업데이트를 최대한 빨리 설치하는 것을 강력히 권장합니다. 그렇지 않으면 Linux(베타)가 작동을 멈출 수 있습니다.</translation>
<translation id="6694016202036959050"><ph name="DEVICE_OS" /> 설정</translation>
<translation id="8362858344151826493">JemaOS 계정, 백업, 기타</translation>
<translation id="9150429437595727962">Wi-Fi 설정</translation>
<translation id="4938972461544498524">터치패드 설정</translation>
<translation id="1210024513248363065">원격 서비스</translation>
<translation id="2878862288885588535">원격 진단 서비스</translation>
<translation id="7409197984340676806">원격 진단 서비스를 통해 공식 JemaOS 지원 담당자가 시스템 문제를 식별할 수 있습니다. 현재 원격 진단 서비스는 공식 JemaOS 지원 담당자만 시작할 수 있습니다.</translation>
<translation id="1791028023086176332">이 번호를 공식 JemaOS 지원 담당자에게 알려 주세요</translation>
<translation id="6279304275399437025">원격 진단 서비스를 시작하는 중...</translation>
<translation id="1501882165699826662">원격 진단 서비스를 중지하고 다시 시도해 주세요</translation>
<translation id="3100283258447375201">자세한 정보</translation>
<translation id="4070039109671307724">기타</translation>
<translation id="7326893024940073254">"다시 시작" 버튼</translation>
<translation id="3002423764319968103">시스템 메뉴에 "다시 시작" 버튼 표시</translation>
<translation id="6243454903512423518">"화면 회전" 버튼</translation>
<translation id="6491049336868978729">현재 태블릿 모드가 아니므로 "화면 회전" 버튼이 숨겨져 있습니다</translation>
<translation id="5496012402277579695">시스템 메뉴에 "화면 회전" 버튼 표시</translation>
<translation id="5882838977344999606">태블릿/노트북 모드 전환</translation>
<translation id="472164133625585606">시스템 메뉴에 태블릿/노트북 모드 전환 표시</translation>
<translation id="1851103550468466960">Widevine 사용 설정</translation>
<translation id="4058176713282795846">보호된 프리미엄 콘텐츠를 스트리밍하려면 Widevine을 사용 설정하세요. <ph name="BEGIN_LINK_LEARN_MORE" />자세히 알아보기<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">"libwidevine.so" 선택</translation>
<translation id="4838463656205005584">Widevine을 사용 설정하지 못했습니다...</translation>
<translation id="2164041826798266548">Widevine CDM 모듈 설치에 실패했습니다. 연결을 확인하고 다시 시도해 주세요.</translation>
<translation id="4106982328079440606">JemaOS 계정 설정</translation>
<translation id="6468776556018764845">실험용 기능</translation>
<translation id="3487615413425326553">TPM(Trusted Platform Module) 검사 우회</translation>
<translation id="4817176087932811573">기기의 TPM 칩이 호환되지 않아 일부 기능이 실패할 수 있습니다. 해결 방법으로 TPM 검사를 우회할 수 있습니다.</translation>
<translation id="3356003366173774486">자동 로그인</translation>
<translation id="6218459410891191693">기기가 다시 시작될 때 현재 계정이 데스크톱에 자동으로 로그인하도록 허용</translation>
<translation id="6620839363422062843">이 계정에는 사용 설정할 수 없습니다. 이 기기의 다른 계정에 자동 로그인이 이미 활성화되어 있습니다</translation>
<translation id="6734500226490446035">이 계정에는 사용 설정할 수 없습니다. 이 계정의 파일 시스템을 초기화하는 동안 알 수 없는 오류가 발생했습니다. 다시 시작하거나 새 계정을 만들어 보세요</translation>
<translation id="5464880042146818691">이 계정에는 사용 설정할 수 없습니다. 자동 로그인 옵션은 "로컬 계정" 유형에서만 사용할 수 있습니다.</translation>
<translation id="3335654854106476749">자동 로그인을 사용 설정하기 전에 <ph name="BEGIN_LINK" />개인정보 및 보안<ph name="END_LINK" /> 설정에서 로그인 비밀번호를 추가해 주세요.</translation>
<translation id="5586831602198585601">지금 업데이트할 수 있는 새로운 버전의 JemaOS가 있습니다. 하지만 JemaOS for You 구독이 만료되었습니다. JemaOS를 업데이트하려면 활성 구독이 필요합니다.</translation>
<translation id="3869860597719956574">지금 업데이트할 수 있는 새로운 주요 버전의 JemaOS가 있습니다. 이 업데이트를 계속하려면 일회성 요금을 결제해야 합니다.</translation>
<translation id="6523879681771260760">백업 파일을 저장할 경로를 지정해 주세요</translation>
<translation id="2036152819788683293">이 계정의 백업 파일을 만듭니다(베타). <ph name="BEGIN_LINK_LEARN_MORE" />자세히 알아보기<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">백업</translation>
<translation id="4267347174163690295">이 계정의 백업 파일을 만듭니다(베타).</translation>
<translation id="8112950994208888917">이 작업은 이 계정의 전체 디스크 백업을 생성하여 설정, 설치된 브라우저 확장 프로그램, 하위 시스템 앱을 포함해 백업이 생성된 시점의 상태로 JemaOS를 쉽게 복원할 수 있게 해줍니다. 앱과 홈 폴더의 내용에 따라 백업 파일이 클 수 있으므로 백업 파일을 외부 저장소 기기에 저장하는 것이 좋습니다. 휴대용 USB 드라이브가 있다면 지금 연결해 주세요. <ph name="BEGIN_LINK_LEARN_MORE" />자세히 알아보기<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">이 계정의 로그인 비밀번호를 입력해 주세요</translation>
<translation id="8663988871299316062">이 비밀번호는 이 백업 파일을 복원할 때 필요하므로 반드시 기억해 두세요</translation>
<translation id="6408904153044317846">복원할 백업 파일을 선택해 주세요</translation>
<translation id="8062988348127771021">백업 파일에서 JemaOS 데이터 복원</translation>
<translation id="7309192418866543730">백업 비밀번호 입력</translation>
<translation id="3642408376366598984">이 백업 파일을 암호화하는 데 사용된 비밀번호를 입력해 주세요</translation>
<translation id="7783974937157985523">백업 비밀번호</translation>
<translation id="6583780301401541007">복원 성공</translation>
<translation id="3514011352559420398">복원 실패</translation>
<translation id="7535980903266533458">백업을 기기 또는 외부 저장소에 저장</translation>
