<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="el">
	<translation id="7386402409475121504">Δημιουργήστε τον τοπικό σας λογαριασμό JemaOS</translation>
	<translation id="3760308806144055927">Συνδεθείτε στον τοπικό σας λογαριασμό JemaOS</translation>
	<translation id="3325117507482096812">Εισαγάγετε έναν κωδικό πρόσβασης</translation>
	<translation id="1838206877831947154">Οι κωδικοί πρόσβασής σας δεν ταιριάζουν</translation>
	<translation id="2158276988029582286">Δημιουργήστε έναν νέο τοπικό λογαριασμό</translation>
	<translation id="8592849747346274067">Συνδεθείτε σε έναν υπάρχοντα λογαριασμό</translation>
	<translation id="482190417986201746">Το όνομα χρήστη ή ο κωδικός πρόσβασης που πληκτρολογήσατε είναι λάθος</translation>
	<translation id="6603987686259425085">Μπορείτε να <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>συνδεθείτε με έναν τοπικό λογαριασμό JemaOS<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">Το email <ph name="EMAIL_ADDRESS">$1</ph> υπάρχει ήδη. Δοκιμάστε ξανά με άλλο email.</translation>
	<translation id="7215016743510876720">Χρησιμοποιήστε τοπικό λογαριασμό</translation>
	<translation id="6657635042185516718">Συνεχίστε να χρησιμοποιείτε τον διαδικτυακό λογαριασμό</translation>
	<translation id="6867476688065565618">Αλλαγή σε τοπικό λογαριασμό;</translation>
	<translation id="4840454774882557974">Εάν επιλέξετε να χρησιμοποιήσετε έναν τοπικό λογαριασμό, οι χρήσιμες λειτουργίες περιλαμβάνουν τον συγχρονισμό των δεδομένων και των προτιμήσεών σας σε πολλές συσκευές και η αυτόματη σύνδεση σε εφαρμογές Ιστού χρησιμοποιώντας τον λογαριασμό σας JemaOS δεν θα λειτουργήσει.</translation>
	<translation id="8951507920859729424">Συνιστούμε να χρησιμοποιήσετε έναν διαδικτυακό λογαριασμό για να χρησιμοποιήσετε στο έπακρο το JemaOS.</translation>
	<translation id="479773200536372215">Δεν θα μπορείτε να προσθέσετε λογαριασμούς Google επειδή λείπουν τα κλειδιά Google API. Δείτε το <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> για λεπτομέρειες.</translation>
	<translation id="1198491307547164157">Δεν θα μπορείτε να προσθέσετε λογαριασμούς JemaOS επειδή λείπουν τα κλειδιά API JemaOS. Δείτε το <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> για λεπτομέρειες.</translation>
	<translation id="5042404702659901995">Δήλωση απορρήτου</translation>
	<translation id="4907736162587268100">Περιεχόμενα δήλωσης απορρήτου</translation>
	<translation id="5988344732274877691">Εγγραφείτε στο (πολύ σπάνιο, υποσχόμενο) ενημερωτικό δελτίο για το JemaOS</translation>
	<translation id="1706203008474708805">Εγγραφείτε στο σχέδιο βελτίωσης της εμπειρίας χρήστη JemaOS</translation>
	<translation id="1147139514756087229">Συνδεθείτε με έναν τοπικό λογαριασμό</translation>
	<translation id="2054784944085654098">Δημιουργία εφεδρικού αρχείου τώρα. Αυτό μπορεί να διαρκέσει λίγο. παρακαλώ περιμένετε…</translation>
	<translation id="3554401467586751874">Το αρχείο αντιγράφου ασφαλείας δημιουργήθηκε με επιτυχία</translation>
	<translation id="2349211327705667074">Προβολή αρχείου αντιγράφου ασφαλείας</translation>
	<translation id="3049367131589710124">Προβολή αρχείου καταγραφής σφαλμάτων</translation>
	<translation id="1079017345574916945">Απομακρυσμένη επιφάνεια εργασίας</translation>
	<translation id="3064478898280877715">Κατάστημα εφαρμογών</translation>
	<translation id="5890206344045530832">Εγκαταστάτης</translation>
	<translation id="2173278076276376488">Αυτό το βοηθητικό πρόγραμμα θα σας βοηθήσει να εγκαταστήσετε το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> στον εσωτερικό χώρο αποθήκευσης αυτής της συσκευής.</translation>
	<translation id="5323182426977498659">Προειδοποίηση! Αυτή η διαδικασία είναι καταστροφική και δεν μπορεί να αναιρεθεί. Λάβετε υπόψη ότι δεν φέρουμε καμία ευθύνη για πιθανή απώλεια δεδομένων σας ούτε παρέχουμε επείγουσα τεχνική υποστήριξη, προχωρήστε με δική σας ευθύνη.</translation>
	<translation id="8517836015601969896">Πλήρης εγκατάσταση δίσκου</translation>
	<translation id="7300045760790370189">Εγκαταστήστε το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> για να καταλάβετε έναν ολόκληρο σκληρό δίσκο, όλα τα δεδομένα του σκληρού δίσκου προορισμού θα διαγραφούν.</translation>
	<translation id="8762511733918256595">Εγκατάσταση πολλαπλών εκκινήσεων</translation>
	<translation id="248900698427753678">Εγκαταστήστε το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> σε ένα υπάρχον διαμέρισμα ενός σκληρού δίσκου, όπου το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> μπορεί να υπάρχει παράλληλα με άλλα λειτουργικά συστήματα. Όλα τα δεδομένα στο διαμέρισμα προορισμού θα διαγραφούν.</translation>
	<translation id="8445241586733258838">Το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> θα εγκατασταθεί στον επιλεγμένο σκληρό δίσκο σας. όλα τα δεδομένα στο δίσκο προορισμού θα διαγραφούν.</translation>
	<translation id="4039091757234555415">Δίσκος</translation>
	<translation id="7783580523889684697">Δεν υπάρχει διαθέσιμος δίσκος</translation>
	<translation id="8217653566575018388">Η εγκατάσταση ολοκληρώθηκε</translation>
	<translation id="8846746259444262774">Η εγκατάσταση απέτυχε</translation>
	<translation id="7263815009235541549">Η εγκατάσταση ολοκληρώθηκε με επιτυχία. Απενεργοποιήστε πρώτα τη συσκευή σας, στη συνέχεια αφαιρέστε τυχόν μέσα εγκατάστασης και ενεργοποιήστε την ξανά για εκκίνηση του <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ωχ, κάτι πήγε στραβά και η εγκατάσταση δεν ολοκληρώθηκε. Παρακαλώ δοκιμάστε ξανά τη διαδικασία. Εάν το ίδιο σφάλμα επιμένει, επικοινωνήστε με την Υποστήριξη JemaOS με το παραπάνω αρχείο καταγραφής.</translation>
	<translation id="4683944976188707627">Το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> θα εγκατασταθεί στο επιλεγμένο διαμέρισμα του σκληρού σας δίσκου. Σύμφωνα με τον τρέχοντα συνδυασμό πολλαπλών εκκινήσεων, αυτό θα μπορούσε να συνεχιστεί μόνο εάν η συσκευή σας υποστηρίζει UEFI και οι σκληροί σας δίσκοι έχουν μορφοποιηθεί με GPT.</translation>
	<translation id="7831363758161884243">Το διαμέρισμα προορισμού θα διαγραφεί. θα πρέπει επίσης να καθορίσετε το ενεργό διαμέρισμα EFI (συνήθως γίνεται αυτόματα) καθώς το πρόγραμμα εγκατάστασης πρέπει να τροποποιήσει τις διαμορφώσεις εκκίνησης του συστήματος.</translation>
	<translation id="5670799238446305550">Επιλέξτε το διαμέρισμα στόχου <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph></translation>
	<translation id="3695537760133394753">Διαμέρισμα</translation>
	<translation id="5610519566593708119">Επιλέξτε διαμέρισμα EFI</translation>
	<translation id="3367650349940010965">Δεν υπάρχουν διαθέσιμα διαμερίσματα για τον επιλεγμένο δίσκο</translation>
	<translation id="7453223384507098390">Δεν υπάρχουν διαθέσιμα διαμερίσματα EFI για τον επιλεγμένο δίσκο</translation>
	<translation id="1854532683465500847">Το μέγεθος του επιλεγμένου διαμερίσματος είναι μικρότερο από 20 GB, η εγκατάσταση ενδέχεται να αποτύχει</translation>
	<translation id="4144613075340468247">Το επιλεγμένο διαμέρισμα έχει προσαρτηθεί σε <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> multi-boot, η εγκατάσταση σε αυτό ξανά μπορεί να αποτύχει</translation>
	<translation id="5793361052649920836">Μετά την εγκατάσταση, πώς θα θέλατε να εκκινήσετε το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>;</translation>
	<translation id="4273235330352963866">Εγκατάσταση και διαμόρφωση του rEFInd για μένα (συνιστάται)</translation>
	<translation id="1858708492548921044">Το rEFInd είναι ένα πρόγραμμα διαχείρισης εκκίνησης που προσφέρει μια ωραία γραφική διεπαφή για τις επιλογές εκκίνησης του λειτουργικού συστήματος όταν ξεκινά ο υπολογιστής σας, θα μπορείτε να επιλέξετε το λειτουργικό σύστημα που επιθυμείτε για εκκίνηση με αυτό. Για περισσότερες πληροφορίες σχετικά με το reFInd, ανατρέξτε στην αρχική του σελίδα.</translation>
	<translation id="3861924051442564602">Προσθέστε μια επιλογή μενού εκκίνησης UEFI για μένα</translation>
	<translation id="8622370666798589804">Κατά την εκκίνηση του υπολογιστή σας, ενδέχεται να μπορείτε να εισέλθετε στο μενού επιλογών εκκίνησης UEFI (πιθανότατα πατώντας ένα πλήκτρο πρόσβασης), αυτή η επιλογή προσθέτει το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ως καταχώρηση σε αυτό το μενού. (Υποστηρίζει μόνο ορισμένα μοντέλα υλικολογισμικού BIOS και UEFI).</translation>
	<translation id="1569398690544416170">Μην κάνετε τίποτα εδώ, θα το ρυθμίσω μόνος μου</translation>
	<translation id="3554866444001249532">Αυτό το σενάριο εγκατάστασης θα τοποθετήσει μόνο τα απαραίτητα αρχεία .efi για την εκκίνηση του <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> στο διαμέρισμα EFI, θα πρέπει να διαμορφώσετε μόνοι σας τον τρόπο εκκίνησης.</translation>
	<translation id="7492832751164189534">Αναγκαστικά παραίτηση</translation>
	<translation id="5159534860632584026">Η διαδικασία εγκατάστασης έχει τερματιστεί</translation>
	<translation id="8686749782014838344">Αποτυχία λήψης πληροφοριών δίσκου</translation>
	<translation id="5688543378771259173">Η εγκατάσταση τερματίζεται...</translation>
	<translation id="5350452134936384991">Εγκατάσταση σε USB</translation>
	<translation id="8008470485414925603">Εγκαταστήστε το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> σε έναν δίσκο USB. όλα τα δεδομένα στον δίσκο USB-στόχου θα διαγραφούν.</translation>
	<translation id="1270668145107456127">Το <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> θα εγκατασταθεί στον επιλεγμένο σας δίσκο USB. όλα τα δεδομένα στο δίσκο προορισμού θα διαγραφούν.</translation>
	<translation id="5725593226060700263">Δεν υπάρχει διαθέσιμος δίσκος USB</translation>
	<translation id="4357040841587078287">Διαπιστώσαμε ότι εκτελείτε αυτό το αντίγραφο του JemaOS από ένα αρχείο εικόνας που έχετε λάβει. Για να χρησιμοποιήσετε τις πιο ολοκληρωμένες δυνατότητες υποστήριξης (συμπεριλαμβανομένων των ενημερώσεων Over-The-Air) που μπορεί να προσφέρει το JemaOS, σας συνιστούμε ανεπιφύλακτα να εκκινήσετε τη λειτουργία "Installer" για να πραγματοποιήσετε μια εγκατάσταση του JemaOS σε πλήρη δίσκο σε μια ξεχωριστή συσκευή αποθήκευσης.</translation>
	<translation id="1246398339704431302">Μπορείτε να <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>να συνεχίσετε να χρησιμοποιείτε αυτό το αντίγραφο του JemaOS ούτως ή άλλως<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, η διαδικασία εγκατάστασης μπορεί να εκτελεστεί σε μεταγενέστερο στάδιο στο σύστημα, ωστόσο, όλα τα δεδομένα σας θα ξεκινήσουν ξανά μετά την εγκατάσταση και θα ξεκινήσετε ξανά από αυτήν τη σελίδα.</translation>
	<translation id="3654532222088291133">Αντί να εισαγάγετε τον κωδικό πρόσβασης του λογαριασμού σας JemaOS για να συνδεθείτε, μπορείτε να δημιουργήσετε έναν κωδικό πρόσβασης <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> για αυτήν τη συσκευή</translation>
	<translation id="8377684629839541977">Χρησιμοποιήστε τον κωδικό πρόσβασης λογαριασμού JemaOS</translation>

<!-- os_settings_strings.grdp (JemaOS) -->
<translation id="2195238615593678398">Αυτόματη διατήρηση του <ph name="DEVICE_OS" /> ενημερωμένου</translation>
<translation id="2347352406101856238">Η ενημέρωση <ph name="DEVICE_OS" /> είναι ενεργοποιημένη</translation>
<translation id="185834232609012804">Η ενημέρωση <ph name="DEVICE_OS" /> είναι απενεργοποιημένη</translation>
<translation id="6224376838276776927"><ph name="DEVICE_OS" /> <ph name="JEMAOS_MAJOR_VERSION" /> (<ph name="PRODUCT_CHANNEL" />) Πλατφόρμα <ph name="JEMAOS_PLATFORM_VERSION" /> <ph name="PRODUCT_VERSION_BITS" /></translation>
<translation id="3197730452537982411">Απομακρυσμένη επιφάνεια εργασίας</translation>
<translation id="6898090158927982244">Το Linux σας είναι ενημερωμένο</translation>
<translation id="4886703929102211360">Διατίθεται κρίσιμη ενημέρωση για το στοιχείο Linux (beta). Συνιστάται ιδιαίτερα να εγκαταστήσετε αυτήν την ενημέρωση το συντομότερο δυνατό, διαφορετικά το Linux (beta) ενδέχεται να σταματήσει να λειτουργεί.</translation>
<translation id="6694016202036959050">Ρυθμίσεις <ph name="DEVICE_OS" /></translation>
<translation id="8362858344151826493">Λογαριασμός JemaOS, αντίγραφα ασφαλείας, διάφορα</translation>
<translation id="9150429437595727962">Ρυθμίσεις Wi-Fi</translation>
<translation id="4938972461544498524">Ρυθμίσεις επιφάνειας αφής</translation>
<translation id="1210024513248363065">Απομακρυσμένες υπηρεσίες</translation>
<translation id="2878862288885588535">Υπηρεσία απομακρυσμένης διάγνωσης</translation>
<translation id="7409197984340676806">Η υπηρεσία απομακρυσμένης διάγνωσης επιτρέπει στους επίσημους εκπροσώπους υποστήριξης του JemaOS να εντοπίζουν προβλήματα συστήματος. Προς το παρόν, η υπηρεσία απομακρυσμένης διάγνωσης μπορεί να ξεκινήσει μόνο από επίσημους εκπροσώπους υποστήριξης του JemaOS.</translation>
<translation id="1791028023086176332">Κοινοποιήστε αυτόν τον αριθμό στους επίσημους εκπροσώπους υποστήριξης του JemaOS</translation>
<translation id="6279304275399437025">Εκκίνηση της υπηρεσίας απομακρυσμένης διάγνωσης...</translation>
<translation id="1501882165699826662">Διακόψτε την υπηρεσία απομακρυσμένης διάγνωσης και δοκιμάστε ξανά</translation>
<translation id="3100283258447375201">Περισσότερες πληροφορίες</translation>
<translation id="4070039109671307724">Διάφορα</translation>
<translation id="7326893024940073254">Κουμπί "Επανεκκίνηση"</translation>
<translation id="3002423764319968103">Εμφάνιση κουμπιού "Επανεκκίνηση" στο μενού συστήματος</translation>
<translation id="6243454903512423518">Κουμπί "Περιστροφή οθόνης"</translation>
<translation id="6491049336868978729">Δεν βρίσκεστε σε λειτουργία tablet αυτήν τη στιγμή, το κουμπί "Περιστροφή οθόνης" είναι κρυφό</translation>
<translation id="5496012402277579695">Εμφάνιση κουμπιού "Περιστροφή οθόνης" στο μενού συστήματος</translation>
<translation id="5882838977344999606">Διακόπτης λειτουργίας tablet/laptop</translation>
<translation id="472164133625585606">Εμφάνιση διακόπτη λειτουργίας tablet/laptop στο μενού συστήματος</translation>
<translation id="1851103550468466960">Ενεργοποίηση Widevine</translation>
<translation id="4058176713282795846">Ενεργοποιήστε το Widevine για ροή προστατευόμενου premium περιεχομένου. <ph name="BEGIN_LINK_LEARN_MORE" />Μάθετε περισσότερα<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="8990695698551687522">Επιλέξτε "libwidevine.so"</translation>
<translation id="4838463656205005584">Η ενεργοποίηση του Widevine απέτυχε...</translation>
<translation id="2164041826798266548">Η εγκατάσταση της μονάδας Widevine CDM απέτυχε. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά.</translation>
<translation id="4106982328079440606">Ρυθμίσεις λογαριασμού JemaOS</translation>
<translation id="6468776556018764845">Πειραματικές δυνατότητες</translation>
<translation id="3487615413425326553">Παράκαμψη ελέγχων Trusted Platform Module (TPM)</translation>
<translation id="4817176087932811573">Ορισμένες δυνατότητες ενδέχεται να αποτύχουν λόγω ασύμβατου τσιπ TPM στη συσκευή σας· μπορείτε να παρακάμψετε τους ελέγχους TPM ως λύση.</translation>
<translation id="3356003366173774486">Αυτόματη σύνδεση</translation>
<translation id="6218459410891191693">Να επιτρέπεται στον τρέχοντα λογαριασμό η αυτόματη σύνδεση στην επιφάνεια εργασίας κατά την επανεκκίνηση της συσκευής</translation>
<translation id="6620839363422062843">Δεν είναι δυνατή η ενεργοποίηση για αυτόν τον λογαριασμό· η αυτόματη σύνδεση είναι ήδη ενεργή για άλλους λογαριασμούς σε αυτήν τη συσκευή</translation>
<translation id="6734500226490446035">Δεν είναι δυνατή η ενεργοποίηση για αυτόν τον λογαριασμό· προέκυψε άγνωστο σφάλμα κατά την προετοιμασία των συστημάτων αρχείων για αυτόν τον λογαριασμό. Δοκιμάστε επανεκκίνηση ή δημιουργία νέου λογαριασμού</translation>
<translation id="5464880042146818691">Δεν είναι δυνατή η ενεργοποίηση για αυτόν τον λογαριασμό· η επιλογή αυτόματης σύνδεσης είναι διαθέσιμη μόνο για τον τύπο "Τοπικός λογαριασμός".</translation>
<translation id="3335654854106476749">Προσθέστε κωδικό πρόσβασης σύνδεσης στις ρυθμίσεις <ph name="BEGIN_LINK" />Απόρρητο και ασφάλεια<ph name="END_LINK" /> πριν ενεργοποιήσετε την αυτόματη σύνδεση.</translation>
<translation id="5586831602198585601">Μια νεότερη έκδοση του JemaOS είναι διαθέσιμη για ενημέρωση τώρα. Ωστόσο, η συνδρομή σας JemaOS for You έχει λήξει· χρειάζεστε ενεργή συνδρομή για να ενημερώσετε το JemaOS σας.</translation>
<translation id="3869860597719956574">Μια νέα κύρια έκδοση του JemaOS είναι διαθέσιμη για ενημέρωση τώρα. Πρέπει να πληρώσετε ένα εφάπαξ τέλος για να συνεχίσετε με αυτήν την ενημέρωση.</translation>
<translation id="6523879681771260760">Καθορίστε τη διαδρομή αποθήκευσης του αρχείου αντιγράφου ασφαλείας</translation>
<translation id="2036152819788683293">Δημιουργία αρχείου αντιγράφου ασφαλείας για αυτόν τον λογαριασμό (beta). <ph name="BEGIN_LINK_LEARN_MORE" />Μάθετε περισσότερα<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2850124913210091882">Δημιουργία αντιγράφου ασφαλείας</translation>
<translation id="4267347174163690295">Δημιουργία αρχείου αντιγράφου ασφαλείας για αυτόν τον λογαριασμό (beta).</translation>
<translation id="8112950994208888917">Αυτή η λειτουργία δημιουργεί ένα πλήρες αντίγραφο ασφαλείας δίσκου για αυτόν τον λογαριασμό, διευκολύνοντας την επαναφορά του JemaOS στην κατάσταση που είχε κατά τη δημιουργία του αντιγράφου ασφαλείας, συμπεριλαμβανομένων ρυθμίσεων, εγκατεστημένων επεκτάσεων προγράμματος περιήγησης και εφαρμογών υποσυστήματος. Ανάλογα με τις εφαρμογές σας και τα περιεχόμενα του αρχικού σας φακέλου, το αρχείο αντιγράφου ασφαλείας ενδέχεται να είναι μεγάλο· συνιστάται η αποθήκευσή του σε εξωτερική συσκευή αποθήκευσης. Εάν διαθέτετε φορητή μονάδα USB, συνδέστε την τώρα. <ph name="BEGIN_LINK_LEARN_MORE" />Μάθετε περισσότερα<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="4522627203213317581">Εισαγάγετε τον κωδικό πρόσβασης σύνδεσης για αυτόν τον λογαριασμό</translation>
<translation id="8663988871299316062">Θυμηθείτε αυτόν τον κωδικό πρόσβασης, καθώς θα απαιτηθεί κατά την επαναφορά αυτού του αρχείου αντιγράφου ασφαλείας</translation>
<translation id="6408904153044317846">Επιλέξτε το αρχείο αντιγράφου ασφαλείας προς επαναφορά</translation>
<translation id="8062988348127771021">Επαναφορά δεδομένων JemaOS από αρχείο αντιγράφου ασφαλείας</translation>
<translation id="7309192418866543730">Εισαγάγετε τον κωδικό πρόσβασης αντιγράφου ασφαλείας</translation>
<translation id="3642408376366598984">Εισαγάγετε τον κωδικό πρόσβασης που χρησιμοποιήθηκε για την κρυπτογράφηση αυτού του αρχείου αντιγράφου ασφαλείας</translation>
<translation id="7783974937157985523">Κωδικός πρόσβασης αντιγράφου ασφαλείας</translation>
<translation id="6583780301401541007">Η επαναφορά ήταν επιτυχής</translation>
<translation id="3514011352559420398">Η επαναφορά απέτυχε</translation>
<translation id="7535980903266533458">Αποθήκευση του αντιγράφου ασφαλείας στη συσκευή σας ή σε εξωτερικό χώρο αποθήκευσης</translation>
<translation id="604001903249547235">Αντίγραφο ασφαλείας cloud</translation>
<translation id="8885702701336541611">Μεταφόρτωση του αντιγράφου ασφαλείας στον χώρο αποθήκευσης cloud του JemaOS</translation>
<translation id="3939744430096549862">Δημιουργία αντιγράφου ασφαλείας στο cloud</translation>
<translation id="619129431573254316">Επαναφορά από τοπικό αρχείο αντιγράφου ασφαλείας</translation>
<translation id="1859592711955106569">Επαναφορά από cloud</translation>
<translation id="38222223336741457">Λήψη και επαναφορά από το cloud του JemaOS</translation>
<translation id="1241089811244416179">Επαναφορά από το cloud</translation>
<translation id="652479689372703360">Δημιουργία αντιγράφου ασφαλείας σε εξέλιξη</translation>
<translation id="3655220146274872918">Η δημιουργία αντιγράφου ασφαλείας ολοκληρώθηκε</translation>
<translation id="4243579853635792694">Το αντίγραφο ασφαλείας σας δημιουργήθηκε με επιτυχία</translation>
<translation id="6337433855796857931">Η δημιουργία αντιγράφου ασφαλείας απέτυχε</translation>
<translation id="4854179463174744546">Προέκυψε σφάλμα κατά τη διαδικασία δημιουργίας αντιγράφου ασφαλείας</translation>
<translation id="2410668771600309999">Πληροφορίες χρήστη Connect API</translation>
<translation id="2223892939866251845">Αναγνωριστικό χρήστη</translation>
<translation id="3850846286480935456">Ανάλυση χώρου αποθήκευσης αντιγράφων ασφαλείας</translation>
<translation id="6244494465581273970">Απαιτείται αναγνωριστικό χρήστη</translation>
<translation id="9204006549413740506">Τελευταία ενημέρωση</translation>
<translation id="476642412165431515">Συσκευές υλικού</translation>
<translation id="3386337985825120901">Δεν υπάρχουν διαθέσιμα δεδομένα αντιγράφων ασφαλείας</translation>
<translation id="8490990067870590760">Φόρτωση αρχείων αντιγράφων ασφαλείας...</translation>
<translation id="2955409026764742995">Επιλέξτε το αρχείο αντιγράφου ασφαλείας προς επαναφορά:</translation>
<translation id="7414629348005657242">-- Επιλέξτε αρχείο αντιγράφου ασφαλείας --</translation>
<translation id="918246516374174381">Δεν βρέθηκαν αρχεία αντιγράφων ασφαλείας. Δημιουργήστε πρώτα ένα αντίγραφο ασφαλείας.</translation>
<translation id="77997252117517973">Σύντομα κοντά σας</translation>
<translation id="1930692852800776096">Προσθήκη λεξικού</translation>
<translation id="8793060353848771694">Εικόνα αριστερού ακουστικού</translation>
<translation id="6257440204887306255">Εικόνα θήκης φόρτισης</translation>
<translation id="2754700616124958693">Εικόνα δεξιού ακουστικού</translation>
<translation id="1068676292264983586">Προεπιλεγμένη εικόνα συσκευής</translation>
<translation id="6364075396486660405">Απενεργοποίηση αυτόματης σάρωσης αρχείων πολυμέσων για όλα τα διαμερίσματα για βελτιστοποίηση της διάρκειας ζωής της μπαταρίας. <ph name="BEGIN_LINK_LEARN_MORE" />Μάθετε περισσότερα<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="2237927770036822831">Επιλογές ασφαλείας</translation>
<translation id="5618366106086725045">Ενεργοποιήστε τη "Λειτουργία προγραμματιστή" για αυτήν την εγκατάσταση <ph name="IDS_SHORT_PRODUCT_OS_NAME" /> με περισσότερες δυνατότητες προγραμματιστή. <ph name="BEGIN_LINK_LEARN_MORE" />Μάθετε περισσότερα<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="5103485339909346204">Βρίσκεστε ήδη σε "Λειτουργία προγραμματιστή"</translation>
<translation id="6074549317340202195">Ενεργοποίηση "Λειτουργίας προγραμματιστή"</translation>
<translation id="418781258674176053">Προειδοποίηση! Η ενεργοποίηση της "Λειτουργίας προγραμματιστή" είναι μη αναστρέψιμη ενέργεια. Εάν θέλετε να απενεργοποιήσετε τη "Λειτουργία προγραμματιστή", πρέπει να επανεγκαταστήσετε το JemaOS, κάτι που θα διαγράψει όλα τα δεδομένα. Δημιουργήστε αντίγραφο ασφαλείας των δεδομένων σας και προχωρήστε με δική σας ευθύνη.</translation>
