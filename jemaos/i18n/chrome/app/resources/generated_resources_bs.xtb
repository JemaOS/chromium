<?xml version="1.0" encoding="UTF-8"?>
<translationbundle lang="bs">
	<translation id="7386402409475121504">Kreirajte svoj lokalni JemaOS nalog</translation>
	<translation id="3760308806144055927">Prijavite se na svoj lokalni JemaOS nalog</translation>
	<translation id="3325117507482096812">Unesite lozinku</translation>
	<translation id="1838206877831947154">Vaše lozinke se ne podudaraju</translation>
	<translation id="2158276988029582286">Kreirajte novi lokalni račun</translation>
	<translation id="8592849747346274067">Prijavite se na postojeći račun</translation>
	<translation id="482190417986201746">Korisničko ime ili lozinka koje ste unijeli nisu tačni</translation>
	<translation id="6603987686259425085">Možete se <ph name="LINK_START">$1<ex>&amp;gt;a&amp;lt;</ex></ph>prijaviti s JemaOS lokalnim računom<ph name="LINK_END">$2<ex>&amp;gt;/a&amp;lt;</ex></ph>.</translation>
	<translation id="3598802966230712759">E-pošta <ph name="EMAIL_ADDRESS">$1</ph> već postoji. Pokušajte ponovo s drugom e-poštom.</translation>
	<translation id="7215016743510876720">Koristite lokalni račun</translation>
	<translation id="6657635042185516718">Nastavite koristiti online račun</translation>
	<translation id="6867476688065565618">Prebaciti se na lokalni račun?</translation>
	<translation id="4840454774882557974">Ako se odlučite za korištenje lokalnog računa, korisne funkcije uključuju sinkronizaciju vaših podataka i postavki na više uređaja i automatsko prijavljivanje u web aplikacije pomoću vašeg JemaOS računa.</translation>
	<translation id="8951507920859729424">Preporučujemo korištenje online računa kako biste u potpunosti iskoristili JemaOS.</translation>
	<translation id="479773200536372215">Nećete moći dodati Google račune jer nedostaju Google API ključevi. Pogledajte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> za detalje.</translation>
	<translation id="1198491307547164157">Nećete moći dodati JemaOS naloge jer nedostaju JemaOS API ključevi. Pogledajte <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> za detalje.</translation>
	<translation id="5042404702659901995">Izjava o privatnosti</translation>
	<translation id="4907736162587268100">Sadržaj izjave o privatnosti</translation>
	<translation id="5988344732274877691">Prijavite se za (vrlo rijetke, obećane) biltene za JemaOS</translation>
	<translation id="1706203008474708805">Pridružite se JemaOS planu poboljšanja korisničkog iskustva</translation>
	<translation id="1147139514756087229">Prijavite se s lokalnim računom</translation>
	<translation id="2054784944085654098">Kreiranje sigurnosne kopije datoteke sada. Ovo može potrajati; molim sačekajte…</translation>
	<translation id="3554401467586751874">Datoteka sigurnosne kopije je uspješno kreirana</translation>
	<translation id="2349211327705667074">Pogledajte datoteku sigurnosne kopije</translation>
	<translation id="3049367131589710124">Pogledajte dnevnik grešaka</translation>
	<translation id="1079017345574916945">Remote desktop</translation>
	<translation id="3064478898280877715">App store</translation>
	<translation id="5890206344045530832">Instalater</translation>
	<translation id="2173278076276376488">Ovaj uslužni program će vam pomoći da instalirate <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na internu pohranu ovog uređaja.</translation>
	<translation id="5323182426977498659">Upozorenje! Ovaj postupak je destruktivan i ne može se poništiti. Imajte na umu da nećemo snositi nikakvu odgovornost za vaš potencijalni gubitak podataka niti pružiti hitnu tehničku podršku, nastavite na vlastitu odgovornost.</translation>
	<translation id="8517836015601969896">Kompletna instalacija diska</translation>
	<translation id="7300045760790370189">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> da zauzmete cijeli hard disk, svi podaci ciljnog tvrdog diska će biti obrisani.</translation>
	<translation id="8762511733918256595">Multi-boot instalacija</translation>
	<translation id="248900698427753678">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na postojeću particiju tvrdog diska, gdje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> može postojati paralelno sa drugim OS-om. Svi podaci na ciljnoj particiji će biti obrisani.</translation>
	<translation id="8445241586733258838"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> će biti instaliran na vaš odabrani čvrsti disk; svi podaci na ciljnom disku će biti obrisani.</translation>
	<translation id="4039091757234555415">Disk</translation>
	<translation id="7783580523889684697">Nije dostupan disk</translation>
	<translation id="8217653566575018388">Instalacija završena</translation>
	<translation id="8846746259444262774">Instalacija nije uspjela</translation>
	<translation id="7263815009235541549">Instalacija je uspješno završena. Prvo isključite svoj uređaj, zatim uklonite sve instalacione medije i ponovo ga uključite da pokrenete <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>.</translation>
	<translation id="3380151284134965398">Ups, nešto je pošlo po zlu i instalacija nije dovršena. Molimo pokušajte ponovo proces. Ako se ista greška nastavi, obratite se podršci za JemaOS pomoću gornje evidencije.</translation>
	<translation id="4683944976188707627"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> će biti instaliran na odabranoj particiji vašeg tvrdog diska. Prema trenutnoj shemi višestrukog pokretanja, ovo bi se moglo nastaviti samo ako vaš uređaj podržava UEFI i ako su vaši tvrdi diskovi formatirani GPT.</translation>
	<translation id="7831363758161884243">Ciljna particija će biti obrisana; također morate navesti svoju aktivnu EFI particiju (obično se radi automatski) jer instalater treba da izmijeni konfiguracije pokretanja sistema.</translation>
	<translation id="5670799238446305550">Odaberite <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> ciljnu particiju</translation>
	<translation id="3695537760133394753">Particija</translation>
	<translation id="5610519566593708119">Odaberite EFI particiju</translation>
	<translation id="3367650349940010965">Nema dostupnih particija za odabrani disk</translation>
	<translation id="7453223384507098390">Nema dostupnih EFI particija za odabrani disk</translation>
	<translation id="1854532683465500847">Veličina odabrane particije je manja od 20 GB, instalacija možda neće uspjeti</translation>
	<translation id="4144613075340468247">Odabrana particija je montirana na <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> višestruko pokretanje, ponovna instalacija na nju možda neće uspjeti</translation>
	<translation id="5793361052649920836">Nakon instalacije, kako biste htjeli pokrenuti <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph>?</translation>
	<translation id="4273235330352963866">Instalirajte i konfigurirajte rEFInd za mene (preporučeno)</translation>
	<translation id="1858708492548921044">rEFInd je program za upravljanje pokretanjem koji nudi lijepo grafičko sučelje za opcije pokretanja OS-a kada se vaš PC pokrene, moći ćete odabrati željeni OS za pokretanje s njim. Za više informacija o rEFInd-u, pogledajte njegovu početnu stranicu.</translation>
	<translation id="3861924051442564602">Dodajte opciju UEFI menija za pokretanje za mene</translation>
	<translation id="8622370666798589804">Kada se vaš računar pokrene, možda ćete moći da uđete u meni sa opcijama pokretanja UEFI (najverovatnije pritiskom na interventni taster), ova opcija dodaje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> kao ulaz u taj meni. (Podržava samo neke modele BIOS-a i UEFI firmvera).</translation>
	<translation id="1569398690544416170">Ne radite ništa ovdje, sam ću to konfigurirati</translation>
	<translation id="3554866444001249532">Ova instalacijska skripta će staviti samo potrebne .efi datoteke za pokretanje <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na vašu EFI particiju, morat ćete sami konfigurirati kako da ga pokrenete.</translation>
	<translation id="7492832751164189534">Prisilno odustati</translation>
	<translation id="5159534860632584026">Proces instalacije je prekinut</translation>
	<translation id="8686749782014838344">Dobijanje informacija o disku nije uspjelo</translation>
	<translation id="5688543378771259173">Instalacija se prekida...</translation>
	<translation id="5350452134936384991">Instalirajte na USB</translation>
	<translation id="8008470485414925603">Instalirajte <ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> na USB disk; svi podaci na ciljnom USB disku će biti obrisani.</translation>
	<translation id="1270668145107456127"><ph name="DEVICE_OS">$1<ex>JemaOS</ex></ph> će biti instaliran na odabranom USB disku; svi podaci na ciljnom disku će biti obrisani.</translation>
	<translation id="5725593226060700263">Nije dostupan USB disk</translation>
	<translation id="4357040841587078287">Otkrili smo da koristite ovu kopiju JemaOS-a iz preuzete slikovne datoteke. Da biste iskoristili najsveobuhvatnije značajke podrške (uključujući ažuriranja preko zraka) koje JemaOS može ponuditi, preporučujemo vam da pokrenete funkciju "Instalator" kako biste izvršili instalaciju JemaOS-a na cijelom disku na zasebnom uređaju za pohranu.</translation>
	<translation id="1246398339704431302">Možete <ph name="LINK_BEGIN">&amp;lt;span id="continue-anyway"&amp;gt;</ph>i dalje koristiti ovu kopiju JemaOS-a svejedno<ph name="LINK_END">&amp;lt;/span&amp;gt;</ph>, proces instalacije se može izvršiti u kasnijoj fazi u sistemu, međutim, svi vaši podaci će se ponovo obrisati nakon instalacije.</translation>
	<translation id="3654532222088291133">Umjesto da unesete lozinku svog JemaOS računa za prijavu, možete kreirati <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> lozinku za ovaj uređaj</translation>
	<translation id="8377684629839541977">Koristite lozinku JemaOS naloga</translation>

