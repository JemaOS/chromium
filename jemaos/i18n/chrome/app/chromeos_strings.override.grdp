  <!-- === Crostini / Linux === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_CROSTINI_INSTALLER_NEED_UPDATE_TITLE" desc="Title shown in the Crostini installer dialog when the VM fails to install because the device must be updated">
      Mise à jour JemaOS requise
    </message>
    <message name="IDS_CROSTINI_INSTALLER_NEED_UPDATE_ERROR" desc="Text shown in the Crostini installer dialog when the VM fails to install because the device must be updated first">
      Pour terminer la configuration de Linux, mettez à jour JemaOS et réessayez.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_CROSTINI_INSTALLER_NEED_UPDATE_TITLE" desc="Title shown in the Crostini installer dialog when the VM fails to install because the device must be updated">
      JemaOS update required
    </message>
    <message name="IDS_CROSTINI_INSTALLER_NEED_UPDATE_ERROR" desc="Text shown in the Crostini installer dialog when the VM fails to install because the device must be updated first">
      To finish setting up Linux, update JemaOS and try again.
    </message>
  </if>

  <!-- === Bluetooth pairing === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_BLUETOOTH_PAIRING_LEARN_MORE" desc="Bluetooth pairing dialog: Message informing the user on what actions to take in order to see a device in the list of available devices.">
      Assurez-vous que votre appareil Bluetooth est en mode d'appairage et à proximité. N'appairez que des appareils de confiance. Les appareils appairés sont visibles par tous les comptes sur cet <ph name="DEVICE_TYPE">$1</ph>. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$2"&gt;</ph>En savoir plus<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
    </message>
    <message name="IDS_BLUETOOTH_PAIRING_DESCRIPTION" desc="Bluetooth pairing dialog: Message informing the user on what actions to take in order to see a device in the list of available devices.">
      Assurez-vous que votre appareil Bluetooth est en mode d'appairage et à proximité. N'appairez que des appareils de confiance. Les appareils appairés sont visibles par tous les comptes sur cet <ph name="DEVICE_TYPE">$1</ph>.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_BLUETOOTH_PAIRING_LEARN_MORE" desc="Bluetooth pairing dialog: Message informing the user on what actions to take in order to see a device in the list of available devices.">
      Make sure your Bluetooth device is in pairing mode and nearby. Only pair with devices you trust. Paired devices are visible to all accounts on this <ph name="DEVICE_TYPE">$1</ph>. <ph name="BEGIN_LINK_LEARN_MORE">&lt;a target="_blank" href="$2"&gt;</ph>Learn more<ph name="END_LINK_LEARN_MORE">&lt;/a&gt;</ph>
    </message>
    <message name="IDS_BLUETOOTH_PAIRING_DESCRIPTION" desc="Bluetooth pairing dialog: Message informing the user on what actions to take in order to see a device in the list of available devices.">
      Make sure your Bluetooth device is in pairing mode and nearby. Only pair with devices you trust. Paired devices are visible to all accounts on this <ph name="DEVICE_TYPE">$1</ph>.
    </message>
  </if>

  <!-- === Enterprise enrollment === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_ENTERPRISE_ENROLLMENT_KIOSK_CONFIRM_MESSAGE" desc="Message of kiosk confirm enrollment screen.">
      Vous utiliserez une mise à niveau kiosque et affichage qui ne permet à l'appareil de fonctionner qu'en mode kiosque ou affichage. Si vous souhaitez que les utilisateurs se connectent à l'appareil, veuillez revenir en arrière et vous inscrire avec un appareil business+.
    </message>
    <message name="IDS_ENTERPRISE_ENROLLMENT_MISSING_LICENSES_ERROR" desc="Error message to show when the domain the device is trying to enroll into has expired or exhausted licenses.">
      Vous n'avez pas assez de licences pour inscrire cet appareil. Veuillez contacter le service commercial pour en acheter davantage. Si vous pensez que ce message est une erreur, veuillez contacter le support.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_ENTERPRISE_ENROLLMENT_KIOSK_CONFIRM_MESSAGE" desc="Message of kiosk confirm enrollment screen.">
      You will use a kiosk and signage upgrade which only allows the device to run in kiosk or signage mode. If you would like users to sign into the device, please go back and enroll using business+ device.
    </message>
    <message name="IDS_ENTERPRISE_ENROLLMENT_MISSING_LICENSES_ERROR" desc="Error message to show when the domain the device is trying to enroll into has expired or exhausted licenses.">
      You do not have enough license to enroll this device. Please contact sales to purchase more. If you believe you're seeing this message in error, please contact support.
    </message>
  </if>

  <!-- === Gemini / JemaOS AI === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_GEMINI_INTRO_TITLE" desc="The title of the gemini intro dialog">
      Découvrez JemaOS AI, votre assistant IA au niveau du système
    </message>
    <message name="IDS_GEMINI_INTRO_SUBTITLE" desc="The subtitle of the gemini intro dialog">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph>Lancez une conversation rapide dans JemaOS AI pour commencer à écrire, planifier, apprendre et bien plus encore en créant divers assistants IA. JemaOS AI est également accessible en appuyant sur Ctrl + C + C n'importe où pour des actions rapides personnalisables.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>Pour utiliser JemaOS AI, vous devez vous connecter avec un compte JemaOS. Si vous n'en avez pas encore, vous pouvez vous inscrire gratuitement.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_GEMINI_INTRO_TITLE" desc="The title of the gemini intro dialog">
      Introducing JemaOS AI, your OS level AI assistant
    </message>
    <message name="IDS_GEMINI_INTRO_SUBTITLE" desc="The subtitle of the gemini intro dialog">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph>Start a quick chat in JemaOS AI to begin writing, planning, learning, and more by creating various AI assistants. JemaOS AI is also accessible by pressing Ctrl + C + C anywhere for customisable quick actions.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>To use JemaOS AI, you'll need to sign in with a JemaOS account. If you don't have one yet, you can sign up for free.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>

  <!-- === ChromeVox (openjema) === -->
  <if expr="openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        Le lecteur d'écran openJema, ChromeVox, est principalement utilisé par les personnes aveugles ou malvoyantes pour lire le texte affiché à l'écran avec un synthétiseur vocal ou un afficheur braille. Appuyez sur la barre d'espace pour activer ChromeVox. Une fois ChromeVox activé, vous suivrez une visite guidée rapide.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        Le lecteur d'écran openJema, ChromeVox, est principalement utilisé par les personnes aveugles ou malvoyantes pour lire le texte affiché à l'écran avec un synthétiseur vocal ou un afficheur braille. Maintenez les deux touches de volume enfoncées pendant cinq secondes pour activer ChromeVox. Une fois ChromeVox activé, vous suivrez une visite guidée rapide.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        The screen reader on openJema, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press the space bar to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        The screen reader on openJema, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press and hold both volume keys for five seconds to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
    </if>
  </if>

  <!-- === ChromeVox (not openjema / JemaOS) === -->
  <if expr="not openjema">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        Le lecteur d'écran JemaOS, ChromeVox, est principalement utilisé par les personnes aveugles ou malvoyantes pour lire le texte affiché à l'écran avec un synthétiseur vocal ou un afficheur braille. Appuyez sur la barre d'espace pour activer ChromeVox. Une fois ChromeVox activé, vous suivrez une visite guidée rapide.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        Le lecteur d'écran JemaOS, ChromeVox, est principalement utilisé par les personnes aveugles ou malvoyantes pour lire le texte affiché à l'écran avec un synthétiseur vocal ou un afficheur braille. Maintenez les deux touches de volume enfoncées pendant cinq secondes pour activer ChromeVox. Une fois ChromeVox activé, vous suivrez une visite guidée rapide.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        The screen reader on JemaOS, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press the space bar to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        The screen reader on JemaOS, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press and hold both volume keys for five seconds to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
    </if>
  </if>

  <!-- === PIN setup === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_DISCOVER_PIN_SETUP_PIN_AS_MAIN_FACTOR_SUBTITLE" desc="A sub-title of the dialog asking the user to set up a PIN as the main factor for signing in.">
      Au lieu de saisir le mot de passe de votre compte en ligne pour vous connecter, vous pouvez créer un code PIN pour cet <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph>
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_DISCOVER_PIN_SETUP_PIN_AS_MAIN_FACTOR_SUBTITLE" desc="A sub-title of the dialog asking the user to set up a PIN as the main factor for signing in.">
      Instead of entering your online account password to sign in, you can create a PIN for this <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph>
    </message>
  </if>

  <!-- === OneDrive / Files app === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_CONNECT_TO_ONEDRIVE_BODY_TEXT" desc="Explanation text for a dialog which allows the user to connect Files app and Microsoft OneDrive storage.">
      Associez OneDrive à l'appli Fichiers pour gérer vos documents stockés depuis votre PC Jema. Vous devez vous connecter avec votre compte Microsoft.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_CONNECT_TO_ONEDRIVE_BODY_TEXT" desc="Explanation text for a dialog which allows the user to connect Files app and Microsoft OneDrive storage.">
      Connect OneDrive to the Files app to manage your stored documents from your Jema PC. You'll need to sign in with your Microsoft account.
    </message>
  </if>

</grit-part>
